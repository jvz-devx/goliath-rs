#!/usr/bin/env python3
"""E20 measurement contract tests without spawning a game fixture."""
import importlib.machinery
import importlib.util
from pathlib import Path
import tempfile
import json
from types import SimpleNamespace
import unittest
from unittest.mock import patch

loader=importlib.machinery.SourceFileLoader('e20_frontier',str(Path(__file__).with_name('e20-frontier')))
spec=importlib.util.spec_from_loader(loader.name,loader)
frontier=importlib.util.module_from_spec(spec)
loader.exec_module(frontier)

class Contract(unittest.TestCase):
    def test_io_pool_waits_for_a_complete_delayed_startup_line(self):
        with tempfile.TemporaryDirectory(dir=frontier.support.RUNS) as temporary:
            process=SimpleNamespace(poll=lambda:None)
            with patch.object(Path,'read_text',side_effect=['listening\n','E18 fixed IO pool: 4 drivers','E18 fixed IO pool: 4 drivers\n']):
                self.assertEqual(frontier.io_pool_ready(Path(temporary),process,True),['E18 fixed IO pool: 4 drivers'])

    def test_io_pool_wait_rejects_exit_and_has_a_finite_deadline(self):
        process=SimpleNamespace(poll=lambda:1)
        with self.assertRaisesRegex(RuntimeError,'proxy exited'):frontier.io_pool_ready(Path('.'),process,True)
        with patch.object(Path,'read_text',return_value='listening\n'),patch.object(frontier.support.time,'monotonic',side_effect=[100,111]):
            with self.assertRaisesRegex(RuntimeError,'within 10s'):
                frontier.io_pool_ready(Path('.'),SimpleNamespace(poll=lambda:None),True)

    def test_failed_attempts_keep_their_reason_and_fresh_attempt_name(self):
        results=frontier.load('e20_attempt_test_results',frontier.ROOT/'scripts/e20-results')
        with tempfile.TemporaryDirectory(dir=frontier.support.RUNS) as temporary:
            data=Path(temporary)
            for name in ['attempts-400-r1.json','attempts-400-r1-a1.json']:
                (data/name).write_text(json.dumps(dict(cells={'400':dict(status='failed',error='startup failure')})))
            with patch.object(results,'DATA',data):ledger=results.ledger('attempts',200)
            self.assertEqual([(row['repeat'],row['attempt'],row['valid'],row['failures']) for row in ledger['rows']],
                [(1,0,False,['startup failure']),(1,1,False,['startup failure'])])
            self.assertIsNone(ledger['frontier'])

    def test_cluster_loss_in_the_measured_span_is_a_failed_step_not_a_missing_one(self):
        results=frontier.load('e20_loss_test_results',frontier.ROOT/'scripts/e20-results')
        def cell(marks,error,d12=True,outside=0.,load=1.,exits=None):
            samples=[dict(at=10.*index,mark=mark,outside_cpu_s_delta={'77':outside*10} if index else {}) for index,mark in enumerate(marks)]
            return dict(status='failed',error=error,load_start=[load,0,0],processes=dict(error=None,samples=samples),
                d12=dict(valid=d12,reasons=[] if d12 else ['CPU 5 busy fraction at least 95%']),
                failure_evidence=dict(processes=exits or {'bots-a':dict(pid=1,exit=1),'tile-a':dict(pid=2,exit=None)}))
        measured=['cell-start','joined','steady-first',None,'failure-before-cleanup'];drop="RuntimeError('D9 bot exit/drop: ...')"
        with tempfile.TemporaryDirectory(dir=frontier.support.RUNS) as temporary:
            data=Path(temporary)
            rows={'loss-450-r0':cell(measured,drop),                                   # players dropped in a valid window
                'loss-450-r1':cell(['cell-start','joined','failure-before-cleanup'],drop),   # dropped while joining: startup fault
                'loss-475-r0':cell(measured,drop,d12=False),                            # dropped, but the window was not valid
                'loss-475-r1':cell(measured,drop,outside=.6),                           # an outside process above half a core
                'loss-500-r0':cell(measured,"RuntimeError('quiet identity lost')"),      # harness fault inside the span
                'loss-500-r1':cell(measured,'ProcessLookupError(5)',exits={'proxy':dict(pid=5,exit=-11)})}  # a server died
            for name,value in rows.items():(data/(name+'.json')).write_text(json.dumps(dict(cells={name.split('-')[1]:value})))
            with patch.object(results,'DATA',data):ledger=results.ledger('loss',200)
        got={(row['count'],row['repeat']):(row['valid'],row['passed'],row['classification'].split(':')[0]) for row in ledger['rows']}
        self.assertEqual(got,{(450,0):(True,False,'failed'),(450,1):(False,False,'invalid'),(475,0):(False,False,'invalid'),
            (475,1):(False,False,'invalid'),(500,0):(False,False,'invalid'),(500,1):(True,False,'failed')})
        loss=next(row for row in ledger['rows'] if (row['count'],row['repeat'])==(450,0))['cluster_loss']
        self.assertEqual((loss['bot_groups_exited'],loss['servers_exited'],loss['seconds_into_measured_span']),(['bots-a'],[],20.))
        # One counted failure at 450 beside one invalid row: the step is not stable either way.
        self.assertEqual((ledger['stable_failing_counts'],ledger['frontier']),([],None))

    def test_e28_bundle_needs_direct_bots_unless_shims_are_asked_for(self):
        with tempfile.TemporaryDirectory(dir=frontier.support.RUNS) as temporary:
            argv=['e20-frontier','--name','fresh','--counts','100','--data-dir',temporary,'--cpu-mode','pin']
            with patch.object(frontier.goliath_bundle,'is_e28',return_value=True),patch.object(frontier.goliath_bundle,'validate',return_value=dict(bundle='final')),patch.object(frontier.platform,'LINUX',True):
                with patch.object(frontier.os.sys,'argv',argv):
                    with self.assertRaisesRegex(SystemExit,'needs --direct-bots'):frontier.main()
                # With --shims the refusal is passed; the next check is the frozen-artifact read.
                with patch.object(frontier.os.sys,'argv',argv+['--shims']),patch.object(Path,'read_bytes',side_effect=KeyError('past the shim guard')):
                    with self.assertRaisesRegex(KeyError,'past the shim guard'):frontier.main()
            with patch.object(frontier.goliath_bundle,'is_e28',return_value=False),patch.object(frontier.os.sys,'argv',argv+['--proxy-terrain-poll']):
                with self.assertRaisesRegex(SystemExit,'control arm of the park proxy only'):frontier.main()

    def test_tick_time_splits_into_cpu_run_queue_wait_and_a_blocked_remainder(self):
        a=dict(at=0.,cpu_s=1.,user_cpu_s=1.,system_cpu_s=0.,name='horizon-client',is_main=True,run_delay_s=2.,timeslices=100)
        b=dict(at=60.,cpu_s=25.,user_cpu_s=20.,system_cpu_s=5.,name='horizon-client',is_main=True,run_delay_s=8.,timeslices=12100)
        with patch.object(frontier.platform,'LINUX',True):
            main=frontier.thread_deltas({'a':{'9':a}},{'a':{'9':b}})['a']['main']
        self.assertAlmostEqual(main['cores'],.4);self.assertAlmostEqual(main['run_delay_cores'],.1);self.assertAlmostEqual(main['timeslices_per_s'],200)
        # 20 TPS, mean tick 30 ms: 20 ms CPU, 5 ms waiting for a CPU, 5 ms neither.
        split=frontier.tick_schedule(main,[dict(ms=20),dict(ms=40)],20.)
        self.assertAlmostEqual(split['main_cpu_ms_per_tick'],20);self.assertAlmostEqual(split['run_delay_ms_per_tick'],5)
        self.assertAlmostEqual(split['blocked_ms_per_tick'],5);self.assertAlmostEqual(split['tick_wall_cores'],.6)
        self.assertAlmostEqual(split['blocked_cores'],.1);self.assertAlmostEqual(split['timeslices_per_tick'],10)
        # No schedstat (the Mac): the fields are absent, never zero.
        plain={key:value for key,value in a.items() if key not in ['run_delay_s','timeslices']}
        self.assertEqual(frontier.schedule_delta(plain,b),{});self.assertIsNone(frontier.tick_schedule(dict(cores=.4),[dict(ms=20)],20.))
        rows=[dict(name='proxy-io-1',cores=.2,run_delay_cores=.01,timeslices_per_s=900.),dict(name='proxy-io-2',cores=.1,run_delay_cores=.02,timeslices_per_s=800.),
            dict(name='terrain-manager',cores=.001,run_delay_cores=.003,timeslices_per_s=50.),dict(name='old',cores=1.)]
        roles=frontier.role_schedule(rows)
        self.assertEqual(roles['IO drivers']['threads'],2);self.assertAlmostEqual(roles['IO drivers']['run_delay_cores'],.03)
        self.assertEqual(set(roles),{'IO drivers','terrain managers'});self.assertEqual(frontier.extension(),0.)

    def test_compressed_frontier_cell_cannot_be_overwritten(self):
        with tempfile.TemporaryDirectory(dir=frontier.support.RUNS) as temporary:
            data=Path(temporary)
            retained=data/'fresh.json.gz';retained.write_bytes(b'retained')
            argv=['e20-frontier','--name','fresh','--counts','100','--data-dir',str(data)]
            with patch.object(frontier.os.sys,'argv',argv),patch.object(frontier.goliath_bundle,'is_e28',return_value=False):
                with self.assertRaisesRegex(SystemExit,'fresh result name'):frontier.main()
            self.assertEqual(retained.read_bytes(),b'retained')

    def test_mixed_band_is_kept_and_higher_double_failure_closes_bracket(self):
        results=frontier.load('e20_test_results',frontier.ROOT/'scripts/e20-results')
        row=lambda passed:dict(valid=True,passed=passed)
        result=results.endpoints({650:[row(True),row(True)],675:[row(True),row(False)],700:[row(False),row(False)]})
        self.assertEqual((result['frontier'],result['ratio_to_325'],result['bracket_fail'],result['unstable_counts']),(650,2.0,700,[675]))

    def test_mixed_step_gets_no_extra_repeat(self):
        staircase=frontier.load('e20_test_staircase',frontier.ROOT/'scripts/e20-staircase')
        row=lambda passed:dict(passed=passed)
        levels={650:[row(True)],675:[row(True),row(False)],700:[row(False)]}
        self.assertEqual(staircase.next_count(levels),650)
        levels[650].append(row(True))
        self.assertEqual(staircase.next_count(levels),700)
        levels[650]=[row(True),row(False)]
        self.assertEqual(staircase.next_count(levels),625)

    def test_combined_staircase_can_start_at650(self):
        staircase=frontier.load('e20_test_start',frontier.ROOT/'scripts/e20-staircase')
        self.assertEqual(staircase.next_count({},650),650)

    def test_regression_window_recognizes_only_its_descendants(self):
        window=frontier.load('e20_test_window',frontier.ROOT/'scripts/e20-window')
        sampler=window.FixtureSampler(observer=True)
        root=next(iter(sampler.roles.values()))
        row={'processes':{102:{'parent':101},101:{'parent':root},103:{'parent':1}}}
        with patch.object(window.OriginalProcessSampler,'capture',return_value=row):sampler.capture()
        self.assertEqual(set(sampler.roles.values()),{root,101,102})

    def test_server_cap_contains_proxy_store_sidecars_and_tiles(self):
        roles=['tile-a','tile-b','tile-c','tile-d','proxy','store','sidecar-0','sidecar-1','sidecar-2','sidecar-3']
        pids=list(range(10,20))
        self.assertEqual(frontier.server_cap(pids,roles,14,False),(pids,roles))

    def test_layout_scales_floor_ten_percent_crossers_and_fixed_pigs(self):
        baseline=frontier.load('e20_test_capacity',frontier.ROOT/'scripts/capacity-bench')
        for n in [500,600,700,725,750,775,800]:
            layout=frontier.plan(n,baseline.route_anchor)
            self.assertEqual(sum(g['count'] for g in layout['groups']),n)
            self.assertEqual(layout['crossing_players'],n//10)
            self.assertEqual(layout['pigs_per_tile'],64)
            self.assertEqual(layout['total_pigs'],256)
            self.assertEqual(layout['edge'],2048)

    def test_outside_process_redaction_preserves_cpu_and_pid(self):
        raw={'outside_process_names':{'90':'private-app'},'phases':{
            'steady':{'outside':[{'pid':90,'name':'private-app','cpu_s':12,'cores':.2}]},'warmup':None},
            'samples':[{'outside_cpu_s_delta':{'90':.1}}]}
        with patch.object(frontier.OriginalProcessSampler,'report',return_value=raw):
            result=frontier.ProcessSampler().report()
        self.assertEqual(result['outside_process_names'],{'90':'outside'})
        self.assertEqual(result['phases']['steady']['outside'],[{'pid':90,'name':'outside','cpu_s':12,'cores':.2}])
        self.assertEqual(result['samples'],[{'outside_cpu_s_delta':{'90':.1}}])

if __name__=='__main__':unittest.main()
