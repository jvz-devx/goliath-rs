#!/usr/bin/env python3
"""Check E26's measurement adapters without starting a build, server or load."""
import ast
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import re
import unittest

ROOT = Path(__file__).resolve().parent.parent


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


class Contract(unittest.TestCase):
    def test_every_patch_hunk_has_exactly_one_ledger_row(self):
        data = json.loads((ROOT / 'docs/experiments/data/E26/e26-hunk-coverage.json').read_text())
        expected = []
        paths = list(ROOT.glob('patches/horizon-*.patch')) + [ROOT / 'patches/e2-horizon-input-trace.patch']
        for path in paths:
            if path.name.startswith('horizon-') and int(path.name.split('-')[1]) > 11:
                continue
            for number, line in enumerate(path.read_text().splitlines(), 1):
                if line.startswith('@@ '):
                    expected.append(path.name + ':' + str(number))
        actual = [row['id'] for row in data['rows']]
        self.assertEqual(len(actual), len(set(actual)))
        self.assertEqual(set(actual), set(expected))
        self.assertTrue(all(row.get('accounting') for row in data['rows']))

    def test_kernel_has_one_warmup_and_one_collection_hook(self):
        module = load('e26_cell_test', ROOT / 'scripts/e26-cell')
        source = ast.parse((ROOT / 'scripts/e20-frontier').read_text())
        tree = ast.fix_missing_locations(module.Adapt().visit(source))
        compile(tree, 'e26-kernel-test', 'exec')
        calls = [node.func.id for node in ast.walk(tree) if isinstance(node, ast.Call) and isinstance(node.func, ast.Name)]
        self.assertEqual(calls.count('e26_warmup'), 1)
        self.assertEqual(calls.count('e26_collect'), 1)
        self.assertIn('native_threads', calls)
        self.assertIn('thread_deltas', calls)

    def test_caps_and_pass_lines_do_not_change(self):
        module = load('e26_cell_gate_test', ROOT / 'scripts/e26-cell')
        original = ast.parse((ROOT / 'scripts/e20-frontier').read_text())
        changed = ast.fix_missing_locations(module.Adapt().visit(original))
        code = ast.unparse(changed)
        self.assertIn('proxy.TrackedBudget(cap_pids, 4)', code)
        self.assertIn('proxy.TrackedBudget([p.pid for _, p in processes], 1)', code)
        self.assertIn('tps < 19.9', code)
        self.assertIn("row['p99_ms'] >= 50", code)
        self.assertIn("'--height', '2'", code)

    def test_all_published_evidence_names_and_paths_are_scoped(self):
        data = ROOT / 'docs/experiments/data/E26'
        for path in data.iterdir():
            self.assertTrue(path.name.startswith(('e26-', 'repro-')), path.name)
            if path.suffix in {'.json', '.md', '.py'}:
                text = path.read_text()
                self.assertNotRegex(text, r'/Users/[^/]+/')
                self.assertNotRegex(text, r'/home/[^/]+/')
                if path.suffix == '.md':
                    self.assertNotRegex(text, r'(?i)\b(?:parent|opus|sol)\b')

    def test_planted_cost_arithmetic_keeps_the_known_cost_in_both_clocks(self):
        module = load('e26_result_test', ROOT / 'scripts/e26-results')
        labels = ['site-' + str(i) for i in range(16)]
        rows = []
        for number in range(1,5):
            ns, calls = [0]*16, [0]*16
            ns[9], ns[0], ns[15] = 800_000, 100_000, 200_000
            calls[15] = 1
            rows.append(dict(sequence=number,tick=number,busy_ns=sum(ns),ns=ns,calls=calls))
        result = module.timers(dict(e26_timers=dict(rows=rows,dropped=0,labels=labels),
            e26_selection=dict(tile='a'),game_time_before=dict(a=dict(tick=0)),game_time_after=dict(a=dict(tick=4))))
        self.assertAlmostEqual(result['added_fraction'], 3/11)
        self.assertAlmostEqual(result['planted']['fraction_without_known_pulse'], 1/9)
        self.assertTrue(result['planted']['pass_control'])

    def test_timer_partition_and_missing_rows_cannot_pass(self):
        module = load('e26_result_gap_test', ROOT / 'scripts/e26-results')
        cell = dict(e26_timers=dict(rows=[],dropped=1,labels=[]), e26_selection=dict(tile='a'),
                    game_time_before=dict(a=dict(tick=0)),game_time_after=dict(a=dict(tick=4)))
        with self.assertRaises(RuntimeError):
            module.timers(cell)


if __name__ == '__main__':
    unittest.main()
