#!/usr/bin/env python3
"""Reserve one bounded read-only Darwin clock probe window and retain its evidence."""
import argparse
import gzip
import hashlib
import json
import os
from pathlib import Path
import subprocess
import time

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name', required=True)
    parser.add_argument('--seconds', type=int, default=1200)
    args = parser.parse_args()
    if not args.name or any(not (c.isalnum() or c in '-_') for c in args.name):
        raise ValueError('fresh simple evidence name required')
    if not 1 <= args.seconds <= 1500:
        raise ValueError('window must remain below thirty minutes')
    load = os.getloadavg()
    if load[0] > 4:
        raise RuntimeError('start load exceeds four')
    request = ROOT/'.local/quiet-request'
    folder = ROOT/'.local/evidence/E24'/args.name
    binary = ROOT/'.local/bin/goliath-e24/e24-clock-probe-r1'
    source = ROOT/'scripts/e24-clock-probe.rs'
    identity = json.dumps(dict(owner='E24', name=args.name, pid=os.getpid(), wall_ns=time.time_ns()))+'\n'
    with request.open('x') as output:
        output.write(identity)
    try:
        folder.mkdir(exist_ok=False)
        record = dict(command=[str(binary),str(args.seconds)],load_start=load,
            wall_start_ns=time.time_ns(),monotonic_start_ns=time.monotonic_ns(),
            identities={str(path.relative_to(ROOT)):hashlib.sha256(path.read_bytes()).hexdigest() for path in [source,binary,Path(__file__).resolve()]})
        with (folder/'clock.jsonl').open('x') as output, (folder/'stderr.txt').open('x') as error:
            record['exit'] = subprocess.run(record['command'],stdout=output,stderr=error,timeout=args.seconds+15).returncode
        record['wall_end_ns'] = time.time_ns()
        record['monotonic_end_ns'] = time.monotonic_ns()
        for path in folder.iterdir():
            if path.is_file() and path.stat().st_size>1_000_000:
                content=path.read_bytes()
                path.with_suffix(path.suffix+'.gz').write_bytes(gzip.compress(content,mtime=0))
                path.unlink()
        (folder/'window.json').write_text(json.dumps(record,indent=2)+'\n')
        print(json.dumps(record,indent=2),flush=True)
    finally:
        if request.read_text()==identity:
            request.unlink()


if __name__=='__main__':
    main()
