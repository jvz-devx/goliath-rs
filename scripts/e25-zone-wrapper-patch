#!/usr/bin/env python3
"""Prepare the approved isolated Darwin-interface revision without checkout writes."""
import difflib
import hashlib
import os
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parent.parent
PATCH = ROOT/'patches/meridian-12-zone-pressure-r2.patch'
ENV = dict(os.environ,GIT_INDEX_FILE=str(ROOT/'.local/evidence/E25/meridian-scheduler2-base/index'),GIT_OPTIONAL_LOCKS='0')


def git(*args):
    return subprocess.check_output(['git','--git-dir',str(ROOT/'.local/src/meridian/.git'),*args],cwd=ROOT,env=ENV)


def once(text,before,after):
    if text.count(before) != 1:
        raise ValueError('source anchor is not unique')
    return text.replace(before,after)


def main():
    if PATCH.exists():
        raise RuntimeError('wrapper patch already exists')
    names = ['Cargo.toml','Cargo.lock','crates/meridian-proxy/Cargo.toml','crates/meridian-proxy/src/main.rs','crates/meridian-proxy/src/serve.rs']
    before = {name:git('show',':'+name).decode() for name in names}
    after = dict(before)
    after['Cargo.toml'] = once(after['Cargo.toml'],'    "crates/meridian-handoff",\n','    "crates/meridian-handoff",\n    "crates/meridian-zone",\n')
    after['Cargo.toml'] = once(after['Cargo.toml'],'meridian-net = { path = "crates/meridian-net" }\n','meridian-net = { path = "crates/meridian-net" }\nmeridian-zone = { path = "crates/meridian-zone" }\n')
    manifest = 'crates/meridian-proxy/Cargo.toml'
    after[manifest] = once(after[manifest],'[dev-dependencies]\n','[target.\'cfg(target_os = "macos")\'.dependencies]\nmeridian-zone.workspace = true\n\n[dev-dependencies]\n')
    main_file = 'crates/meridian-proxy/src/main.rs'
    after[main_file] = once(after[main_file],'mod placing;\n','mod placing;\n#[cfg(target_os = "macos")]\nmod pressure;\n')
    serve = 'crates/meridian-proxy/src/serve.rs'
    after[serve] = once(after[serve],'''        .spawn(move || {
            while !proxy.stopping() && !ended.load(Ordering::Relaxed) {
                thread::sleep(POLL);
            }
''','''        .spawn(move || {
            #[cfg(target_os = "macos")]
            let mut pressure = crate::pressure::PressureRelief::new(Instant::now());
            while !proxy.stopping() && !ended.load(Ordering::Relaxed) {
                thread::sleep(POLL);
                #[cfg(target_os = "macos")]
                if !proxy.stopping() && !ended.load(Ordering::Relaxed) {
                    pressure.tick();
                }
            }
''')
    pressure = 'crates/meridian-proxy/src/pressure.rs'
    r1 = (ROOT/'patches/meridian-12-zone-pressure-r1.patch').read_text().split('+++ b/'+pressure+'\n',1)[1]
    body = '\n'.join(line[1:] for line in r1.splitlines() if line.startswith('+'))+'\n'
    body = once(body,'    ffi::c_void,\n','')
    body = once(body,'unsafe extern "C" {\n    fn malloc_zone_pressure_relief(zone: *mut c_void, goal: usize) -> usize;\n}\n\n','')
    body = once(body,'''        // SAFETY: Apple's API explicitly accepts a null zone to examine all zones.
        // GOAL is a best-effort byte target, not a memory address or a work bound.
        let released = unsafe { malloc_zone_pressure_relief(std::ptr::null_mut(), GOAL) };''','''        let released = meridian_zone::pressure_relief(GOAL);''')
    after[pressure] = body
    after['crates/meridian-zone/Cargo.toml'] = '''[package]
name = "meridian-zone"
description = "A safe fixed-null interface to Darwin allocator pressure relief."
version.workspace = true
edition.workspace = true
license.workspace = true
rust-version.workspace = true
repository.workspace = true

# Deliberate local OS-boundary exception. lib.rs denies unsafe code except
# one documented block; every existing crate keeps the workspace forbid.
[lints.clippy]
dbg_macro = "deny"
todo = "deny"
unimplemented = "deny"
'''
    after['crates/meridian-zone/src/lib.rs'] = '''//! Safe allocator pressure relief at the Darwin OS boundary, with no owned runtime.
#![deny(unsafe_code)]

/// Best-effort released bytes on macOS; zero without side effects elsewhere.
pub fn pressure_relief(goal: usize) -> usize {
    platform(goal)
}

#[cfg(target_os = "macos")]
fn platform(goal: usize) -> usize {
    // SAFETY: <malloc/malloc.h>, malloc_zone_pressure_relief, explicitly permits
    // NULL to examine all zones and any size_t goal. Zero requests maximal relief;
    // every other value is a best-effort target, not a pointer or a size to access.
    // Header: https://github.com/apple-oss-distributions/libmalloc/blob/main/include/malloc/malloc.h
    #[allow(unsafe_code)]
    unsafe {
        unsafe extern "C" {
            fn malloc_zone_pressure_relief(zone: *mut std::ffi::c_void, goal: usize) -> usize;
        }
        malloc_zone_pressure_relief(std::ptr::null_mut(), goal)
    }
}

#[cfg(not(target_os = "macos"))]
fn platform(_goal: usize) -> usize {
    0
}

#[cfg(test)]
mod tests {
    #[cfg(target_os = "macos")]
    #[test]
    fn native_call_returns() {
        let _ = std::hint::black_box(super::pressure_relief(1));
    }

    #[cfg(not(target_os = "macos"))]
    #[test]
    fn other_targets_are_noop_for_every_goal() {
        for goal in [0, 1, 16 * 1024 * 1024, usize::MAX] {
            assert_eq!(super::pressure_relief(goal), 0);
        }
    }
}
'''
    lock = after['Cargo.lock']
    start = lock.index('[[package]]\nname = "meridian-proxy"\n')
    end = lock.index('[[package]]',start+1)
    lock = lock[:start]+once(lock[start:end],' "meridian-websocket",\n',' "meridian-websocket",\n "meridian-zone",\n')+lock[end:]
    start = lock.index('[[package]]\nname = "meridian-websocket"\n')
    end = lock.index('[[package]]',start+1)
    after['Cargo.lock'] = lock[:end]+'[[package]]\nname = "meridian-zone"\nversion = "0.1.0"\n\n'+lock[end:]
    parts = []
    for name in sorted(after):
        original = before.get(name,'')
        content = after[name]
        if name.endswith('.rs'):
            content = subprocess.check_output(['rustfmt','--edition','2024','--emit','stdout','--config','skip_children=true'],input=content.encode()).decode()
        parts.append(f'diff --git a/{name} b/{name}\n')
        if not original:
            parts.append('new file mode 100644\n')
        parts.extend(difflib.unified_diff(original.splitlines(keepends=True),content.splitlines(keepends=True),fromfile='a/'+name if original else '/dev/null',tofile='b/'+name))
    text = ''.join(parts)
    subprocess.run(['git','--git-dir',str(ROOT/'.local/src/meridian/.git'),'apply','--cached','--check','-'],cwd=ROOT,env=ENV,input=text.encode(),check=True)
    PATCH.write_text(text)
    print(hashlib.sha256(PATCH.read_bytes()).hexdigest(),str(PATCH.relative_to(ROOT)))


if __name__ == '__main__':
    main()
