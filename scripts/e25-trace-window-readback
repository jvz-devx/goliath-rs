#!/usr/bin/env python3
"""Recover a fixed diagnostic window only when truncated trailers are provably later."""
import argparse
import gzip
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path

ROOT=Path(__file__).resolve().parent.parent


def load(name,path):
    loader=importlib.machinery.SourceFileLoader(name,str(path));spec=importlib.util.spec_from_loader(name,loader)
    module=importlib.util.module_from_spec(spec);loader.exec_module(module);return module


def read(path):
    raw=path.read_bytes()
    if path.suffix=='.gz':raw=gzip.decompress(raw)
    return json.loads(raw),hashlib.sha256(raw).hexdigest()


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run',required=True);parser.add_argument('--name',required=True)
    args=parser.parse_args()
    if any(not value.startswith(('e25-','repro-')) or not all(c.isalnum() or c in '-_' for c in value) for value in [args.run,args.name]):raise ValueError('fresh simple names required')
    target=ROOT/'docs/experiments/data/E25'/(args.name+'-summary.json')
    if target.exists():raise RuntimeError('readback exists')
    source=ROOT/'docs/experiments/data/E25'/(args.run+'-summary.json');summary,source_sha=read(source)
    if summary['error']!='partial native trace record' or summary['authority_events'] or summary['cleanup_errors']:raise RuntimeError('not the isolated post-window trace framing failure')
    raw,raw_sha=read(ROOT/summary['cell']['path']);cell=raw['cells']['650']
    if not cell['diagnostic_pass']:raise RuntimeError('load window did not pass retained checks')
    census,census_sha=read(ROOT/summary['per_tile_census']['path'])
    if len(census)!=len(cell['samples']):raise RuntimeError('raw clock anchors do not cover every counter endpoint')
    start,end=census[0]['at_ns'],census[-1]['at_ns'];drain=end+2_000_000_000
    # Every trace writer here is one event-loop bot process, as declared by every bot report.
    if any(not row.get('event_loop') or row.get('threads')!=1 for sample in cell['bot_samples'] for row in sample['groups'].values()):raise RuntimeError('single-thread bot writer proof is absent')
    parser_module=load('e25_eof_reader',ROOT/'scripts/e25-latency-cell')
    matcher=load('e25_eof_matcher',ROOT/'scripts/e25-latency-results')
    storage=load('e25_eof_storage',ROOT/'scripts/e25-memory')
    folder=ROOT/'.local/evidence/E25'/args.run/'stamps';proofs=[]
    sends=[row for path in sorted(folder.glob('e25-bots-*.jsonl')) for row in parser_module.trace_rows(path,'bot-write',drain,proofs,True)]
    decodes=[row for path in sorted(folder.glob('e25-tile-*.jsonl')) for row in parser_module.trace_rows(path,'tile-decode',drain,proofs)]
    plan=json.loads((ROOT/'docs/experiments/data/E25/e25-latency-plan-r1.json').read_text())
    timing=matcher.match(sends,decodes,start,end,drain,plan['witnesses'])
    result=dict(kind='E25-fixed-window-readback',status='diagnostic-recovered-window',
        original_failed_summary=dict(path=str(source.relative_to(ROOT)),sha256=source_sha,status=summary['status'],error=summary['error']),
        original_inputs_modified=False,post_drain_trailer_proofs=proofs,
        timing_window=dict(start_ns=start,end_ns=end,drain_end_ns=drain),census_decompressed_sha256=census_sha,
        original_cell_decompressed_sha256=raw_sha,overall=timing['overall'],per_tile=timing['tiles'],
        proxy=summary['proxy'],diagnostic_pass=summary['diagnostic_pass'],limiter=summary['limiter'],
        stop_brackets=summary['stop_brackets'],authority_events=[],diagnostic_only=True,
        verification_limits=summary['verification_limits'],horizon_lease_base=summary['horizon_lease_base'],m4_latency_qualified=False)
    result['sends']=storage.save(ROOT/'docs/experiments/data/E25'/(args.name+'-sends.json'),dict(schema='E25-latency-v1',dropped=0,events=sends))
    result['decodes']=storage.save(ROOT/'docs/experiments/data/E25'/(args.name+'-decodes.json'),dict(schema='E25-latency-v1',dropped=0,events=decodes))
    result['latency']=storage.save(ROOT/'docs/experiments/data/E25'/(args.name+'-latency.json'),timing)
    stored=storage.save(target,result)
    print(json.dumps(dict(result=stored,overall=timing['overall'],per_tile=timing['tiles'],trailer_proofs=proofs),indent=2),flush=True)


if __name__=='__main__':main()
