#!/usr/bin/env python3
"""Read-only650 diagnostics: per-role samples, CPU trace, native tile spikes and pauses."""
import argparse
import gzip
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import threading
import time
import xml.etree.ElementTree as ET
import e11_support as support

ROOT=Path(__file__).resolve().parent.parent
DATA=ROOT/'docs/experiments/data/E20'

def load(name,path):
    loader=importlib.machinery.SourceFileLoader(name,str(path));spec=importlib.util.spec_from_loader(name,loader)
    module=importlib.util.module_from_spec(spec);loader.exec_module(module);return module

def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--name',required=True);parser.add_argument('--bins',type=Path,required=True)
    parser.add_argument('--no-other-agents',action='store_true');parser.add_argument('--e22-peer',action='store_true');args=parser.parse_args()
    evidence=ROOT/'.local/evidence/E20'/args.name;evidence.mkdir(parents=True,exist_ok=False)
    frontier=load('e20_deep_frontier',ROOT/'scripts/e20-frontier')
    original_load=frontier.load;original_times=frontier.game_times;original_counters=frontier.counters
    state=dict(capacity_acceptance=False,profiling_perturbs_timing=True,spikes_threshold_ms=20,signals=[],samples=[],errors=[])
    holder={};collector=None;calls=0;time_calls=0;offsets={}
    def collect(proxy_pid):
        try:
            tile=holder['tile'];tile_pid=tile.server.process.pid
            state['pids']=dict(proxy=proxy_pid,tile_a=tile_pid)
            state['profile_began_ns']=time.time_ns()
            paths=list(tile.folder.rglob('*.log'));offsets.update({str(path):path.stat().st_size for path in paths})
            for role,pid in [('proxy',proxy_pid),('tile-a',tile_pid)]:
                path=evidence/(role+'-sample.txt');began=time.time_ns()
                command=['sample',str(pid),'5','1','-file',str(path)]
                completed=subprocess.run(command,capture_output=True,text=True,timeout=30)
                (evidence/(role+'-sample-command.txt')).write_text(completed.stdout+'\n'+completed.stderr)
                state['samples'].append(dict(role=role,pid=pid,began_ns=began,ended_ns=time.time_ns(),exit=completed.returncode,path=str(path.relative_to(ROOT)),sha256=hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else None))
            trace=evidence/'proxy.trace'
            command=['xcrun','xctrace','record','--template','Time Profiler','--attach',str(proxy_pid),'--time-limit','8s','--no-prompt','--output',str(trace)]
            began=time.time_ns();completed=subprocess.run(command,capture_output=True,text=True,timeout=75)
            (evidence/'instruments-command.txt').write_text(completed.stdout+'\n'+completed.stderr)
            state['instruments']=dict(target='proxy',began_ns=began,ended_ns=time.time_ns(),exit=completed.returncode,path=str(trace.relative_to(ROOT)))
            if completed.returncode==0:
                toc=subprocess.check_output(['xcrun','xctrace','export','--input',str(trace),'--toc'],text=True)
                (evidence/'toc.xml').write_text(toc)
                schemas=[table.get('schema') for table in ET.fromstring(toc).findall('.//table')]
                state['instruments']['schemas']=schemas
                for schema in schemas:
                    if schema in ['time-profile','cpu-profile']:
                        raw=subprocess.check_output(['xcrun','xctrace','export','--input',str(trace),'--xpath',f'/trace-toc/run[@number="1"]/data/table[@schema="{schema}"]'])
                        (evidence/(schema+'.xml.gz')).write_bytes(gzip.compress(raw,mtime=0))
            state['profile_ended_ns']=time.time_ns()
            lines=[]
            for path_string,offset in offsets.items():
                path=Path(path_string);raw=path.read_bytes()[offset:];end=raw.rfind(b'\n')
                for line in raw[:end+1].decode(errors='replace').splitlines():
                    if 'slow tick' in line:lines.append(dict(file=str(path.relative_to(tile.folder)),line=support.sanitize(line)))
            state['tile_a_native_spikes']=lines
        except BaseException as error:state['errors'].append(repr(error))
    def loaded(name,path):
        module=original_load(name,path)
        if Path(path).name=='e18-proxy':
            parent=module.TrackedBudget
            class TimedBudget(parent):
                def signal(self,action):
                    # Same allocation and accounting; retain each individual signal's bounds.
                    with self.tracking:
                        if action==signal.SIGSTOP:self.pause_began=time.monotonic();self.stop_cycles+=1
                        for pid in self.pids:
                            before=time.time_ns();os.kill(pid,action);after=time.time_ns();now=time.monotonic()
                            state['signals'].append(dict(pid=pid,signal='STOP' if action==signal.SIGSTOP else 'CONT',before_ns=before,after_ns=after))
                            if action==signal.SIGSTOP:self.paused[pid]=now;self.stop_signals+=1
                            elif pid in self.paused:self.process_pause[pid]+=now-self.paused.pop(pid)
                        if action==signal.SIGCONT and self.pause_began is not None:self.pause_wall+=time.monotonic()-self.pause_began;self.pause_began=None
            module.TrackedBudget=TimedBudget
        if Path(path).name=='e17-m4':
            cluster_module=module.cluster_module
            def cluster(bins):
                result=cluster_module(bins);start=result.Tile.start
                def spikes(tile):
                    if tile.label!='a':return start(tile)
                    previous=tile.cluster.tile_env;tile.cluster.tile_env=dict(previous,HORIZON_SPIKES='20')
                    try:return start(tile)
                    finally:tile.cluster.tile_env=previous
                result.Tile.start=spikes
                return result
            module.cluster_module=cluster
        return module
    def times(instance):
        nonlocal time_calls
        time_calls+=1;holder['tile']=instance.tiles['a']
        if time_calls==2 and collector:collector.join(100)
        return original_times(instance)
    def counters(pid):
        nonlocal calls,collector
        calls+=1
        if calls==2:
            collector=threading.Thread(target=collect,args=(pid,),daemon=True);collector.start()
        return original_counters(pid)
    frontier.load=loaded;frontier.game_times=times;frontier.counters=counters
    sys.argv=[str(ROOT/'scripts/e20-frontier'),'--name',args.name,'--counts','650','--bins',str(args.bins)]
    if args.no_other_agents:sys.argv+=['--no-other-agents']
    if args.e22_peer:sys.argv+=['--e22-peer']
    try:frontier.main()
    finally:
        if collector:collector.join(110)
        if collector and collector.is_alive():state['errors'].append('profile collector did not stop')
        state['runner_sha256']=hashlib.sha256(Path(__file__).read_bytes()).hexdigest()
        state['scope']='perturbed diagnostic only; sample occupancy is not CPU share; native spikes include named between-tick spans as well as tick work'
        support.save(DATA/(args.name+'-profile.json'),state)
        print(json.dumps({key:state.get(key) for key in ['pids','samples','instruments','errors']},indent=2))

if __name__=='__main__':main()
