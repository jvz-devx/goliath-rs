#!/usr/bin/env python3
"""Select a frozen scheduler-2 tree reversibly, preserving the existing dirty workspace."""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess

ROOT=Path(__file__).resolve().parent.parent
SOURCE=ROOT/'.local/src/meridian'
SAVED=ROOT/'.local/evidence/E25/meridian-11-source-backup'
BASE=ROOT/'.local/evidence/E25/meridian-scheduler2-base'
SNAPSHOT=ROOT/'.local/bin/meridian-e20/scheduler-2'


def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()


def git(*args,env=None):
    environment=dict(os.environ,**(env or {}));environment['GIT_OPTIONAL_LOCKS']='0'
    return subprocess.check_output(['git',*map(str,args)],cwd=SOURCE,env=environment)


def backup_helper():
    loader=importlib.machinery.SourceFileLoader('e25_meridian_backup',str(ROOT/'scripts/e24-proxy-build'))
    spec=importlib.util.spec_from_loader(loader.name,loader);module=importlib.util.module_from_spec(spec);loader.exec_module(module)
    module.git=git
    return module


def select():
    helper=backup_helper()
    if not SAVED.exists():helper.backup(SAVED)
    original=json.loads((SAVED/'identity.json').read_text())
    for name,digest in original['files'].items():
        if sha(SOURCE/name)!=digest:raise RuntimeError('dirty source differs before selection: '+name)
    if git('status','--porcelain=v1','-z')!=(SAVED/'status.bin').read_bytes():raise RuntimeError('dirty status differs')
    project=json.loads((SNAPSHOT/'candidate.json').read_text())['projects']['meridian']
    BASE.mkdir(exist_ok=True)
    index=BASE/'index'
    if not index.exists():
        shutil.copy2(ROOT/'.local/evidence/E25/e25-preparation-r1-frozen/index',index)
        env=dict(GIT_INDEX_FILE=str(index))
        for row in project['patches'][7:]:
            if sha(ROOT/row['path'])!=row['sha256']:raise RuntimeError('scheduler patch changed')
            git('apply','--cached',ROOT/row['path'],env=env)
    env=dict(GIT_INDEX_FILE=str(index))
    for name,digest in project['source_files'].items():
        content=git('show',':'+name,env=env)
        if hashlib.sha256(content).hexdigest()!=digest:raise RuntimeError('scheduler input differs: '+name)
        path=SOURCE/name;path.parent.mkdir(parents=True,exist_ok=True);path.write_bytes(content)
    (BASE/'identity.json').write_text(json.dumps(dict(project=project,source_equality='passed'),indent=2)+'\n')
    print('Selected exact frozen scheduler-2 source; existing dirty bytes/index are backed up.',flush=True)


def restore():
    helper=backup_helper();original=json.loads((SAVED/'identity.json').read_text())
    saved_env=dict(GIT_INDEX_FILE=str(SAVED/'index'))
    for args in [('ls-files','--stage','-z'),('ls-files','-v','-z'),('ls-files','--resolve-undo','-z')]:
        if git(*args)!=git(*args,env=saved_env):raise RuntimeError('logical index changed; refuse restoration')
    project=json.loads((BASE/'identity.json').read_text())['project']
    selected={name:sha(SOURCE/name) for name in project['source_files']}
    helper.restore(SAVED,original,selected)
    print('Original Meridian files, dirty status and exact saved index restored.',flush=True)


if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('action',choices=['select','restore'])
    args=parser.parse_args();(select if args.action=='select' else restore)()
