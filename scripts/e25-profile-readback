#!/usr/bin/env python3
"""Reclassify an existing local CPU export; never rerun a profile to change its result."""
import argparse
import hashlib
import json
from pathlib import Path
from e25_proxy_profile import running

ROOT=Path(__file__).resolve().parent.parent


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--export',type=Path,required=True)
    parser.add_argument('--name',required=True)
    args=parser.parse_args()
    if not args.name.startswith(('e25-','repro-')) or not all(c.isalnum() or c in '-_' for c in args.name):raise ValueError('fresh simple name required')
    target=ROOT/'docs/experiments/data/E25'/(args.name+'.json')
    if target.exists():raise RuntimeError('readback exists')
    result=running(args.export)
    result.update(kind='E25-existing-proxy-profile-readback',source_local=str(args.export.resolve().relative_to(ROOT)),
        original_capture_modified=False,classification_note='v2 explicitly classifies semwait/nanosleep Running weights as readiness/synchronization and separates clock reads')
    raw=(json.dumps(result,indent=2).replace(str(ROOT),'$REPO').replace(str(Path.home()),'$HOME')+'\n').encode()
    target.write_bytes(raw)
    print(json.dumps(dict(path=str(target.relative_to(ROOT)),sha256=hashlib.sha256(raw).hexdigest(),categories=result['categories']),indent=2))


if __name__=='__main__':main()
