#!/usr/bin/env python3
"""Retain a compact, reproducible frontier ledger from immutable E20 raw cells."""
import argparse
import hashlib
import json
from pathlib import Path
import re
import gzip
import e11_support as support

ROOT=Path(__file__).resolve().parent.parent
DATA=ROOT/'docs/experiments/data/E20'

def endpoints(levels, baseline=None):
    valid_levels={n:[c for c in cells if c['valid']] for n,cells in levels.items()}
    stable_pass=[n for n,cells in valid_levels.items() if len(cells)>=2 and all(c['passed'] for c in cells)]
    stable_fail=[n for n,cells in valid_levels.items() if len(cells)>=2 and all(not c['passed'] for c in cells)]
    unstable=sorted(n for n,cells in valid_levels.items() if any(c['passed'] for c in cells) and any(not c['passed'] for c in cells))
    frontier=max((n for n in stable_pass if any(failed>n for failed in stable_fail)),default=None)
    bracket=min((n for n in stable_fail if frontier and n>frontier),default=None)
    result = dict(frontier=frontier,ratio_to_325=frontier/325 if frontier else None,
        tested_grid_step=25,bracket_fail=bracket,bracket_width=bracket-frontier if bracket else None,
        unstable_counts=unstable,stable_passing_counts=sorted(stable_pass),stable_failing_counts=sorted(stable_fail))
    if baseline is not None:
        result.pop('ratio_to_325')
        result.update(baseline=baseline,ratio_to_baseline=frontier/baseline if frontier else None)
    return result

def cluster_loss(cell):
    """A loss of players or a server inside the measured span of an otherwise valid window.

    The frontier rule says players stay online, so this is a failed step. A
    fault before the measured span or while collecting stays a missing
    measurement. Returns None, or the evidence for the classification.
    """
    report=cell.get('processes') or {}
    samples=report.get('samples') or []
    marks=[sample.get('mark') for sample in samples]
    if 'steady-first' not in marks or 'steady-last' in marks:return None
    processes=(cell.get('failure_evidence') or {}).get('processes',{})
    servers=sorted(role for role,row in processes.items() if row.get('exit') is not None and role.startswith(('tile-','proxy','store','sidecar-')))
    error=cell.get('error') or ''
    if 'D9 bot exit/drop' not in error and not servers:return None
    start=samples[0]['at'];duration=samples[-1]['at']-start;outside={}
    for sample in samples:
        for pid,seconds in sample.get('outside_cpu_s_delta',{}).items():outside[pid]=outside.get(pid,0)+seconds
    worst=max(outside.values(),default=0)/duration if duration>0 else None
    d12=cell.get('d12')
    reasons=[]
    if cell['load_start'][0]>4:reasons.append('start load above 4')
    if report.get('error'):reasons.append('outside-process sampler failed')
    if worst is None or worst>.5:reasons.append('outside process above 0.5 core')
    if d12 is not None and not d12['valid']:reasons+=d12['reasons']
    first=next(sample['at'] for sample in samples if sample.get('mark')=='steady-first')
    return dict(valid=not reasons,invalid_reasons=reasons,seconds_into_measured_span=samples[-1]['at']-first,
        servers_exited=servers,bot_groups_exited=sorted(role for role,row in processes.items() if role.startswith('bots-') and row.get('exit') is not None),
        outside_max_process_cores=worst)


def ledger(prefix, baseline=None):
    rows=[];levels={};modes=set()
    pattern=re.compile(re.escape(prefix)+r'-(\d+)-r(\d+)(?:-a(\d+))?\.json(?:\.gz)?$')
    for path in DATA.glob(prefix+'-*-r*.json*'):
        match=pattern.fullmatch(path.name)
        if not match:continue
        count,repeat=map(int,match.groups()[:2]);attempt=int(match.group(3) or 0);data=support.read_json(path)
        if data.get('e28_bundle') and baseline is None:
            raise ValueError('E28 needs --baseline from this machine; never reuse the Mac baseline')
        if data.get('e28_bundle'):
            modes.add(data['cpu_mode'])
            if len(modes)>1:raise ValueError('do not mix pin and limiter cells in one frontier ledger')
        cell=data['cells'][str(count)]
        raw=path.read_bytes();raw=gzip.decompress(raw) if path.suffix=='.gz' else raw
        row=dict(count=count,repeat=repeat,attempt=attempt,path=str(path.relative_to(ROOT)),sha256=hashlib.sha256(raw).hexdigest(),status=cell['status'],
            valid=False,passed=False,failures=[cell.get('error',data.get('error','incomplete cell'))],
            classification='invalid: startup or collection fault, no measurement')
        loss=cluster_loss(cell) if cell['status']!='complete' else None
        if loss:
            # Counted against the step: valid, not passed.
            row.update(valid=loss['valid'],cluster_loss=loss,classification='failed: cluster lost players or a server in the measured span'
                if loss['valid'] else 'invalid: cluster loss in a window that was not valid')
            if loss['valid']:levels.setdefault(count,[]).append(row)
        if cell['status']=='complete':
            steady=cell['processes']['phases']['steady']
            cpu={name:value['cores'] for name,value in steady['fixture'].items()}
            row.update(passed=cell['diagnostic_pass'],valid=cell['noise_valid'] and cell['load_start'][0]<=4,
                failures=cell['diagnostic_failures'],tile_cores={name:cpu['tile-'+name] for name in cell['before']},
                proxy_cores=cell['proxy']['cores'],proxy_user_cores=cell['proxy']['user_s'],proxy_system_cores=cell['proxy']['system_s'],
                store_cores=cpu['store'],sidecar_cores={name:value for name,value in cpu.items() if name.startswith('sidecar-')},
                server_cores=steady['server_cores'],tile_tps=cell['game_time_tps'],
                tile_p99_ms={name:value['p99_ms'] for name,value in cell['tick_summary'].items()},
                tile_population={name:{key:value[key] for key in ['placed','held','readers','chunks','population']} for name,value in cell['before'].items()},
                limiter=cell['limiter_window'],activations=len(cell['activations_in_window']),
                load_start=cell['load_start'][0],outside_max_steady=steady['outside_max_process_cores'],
                outside_max_whole=cell['processes']['phases']['whole_cell']['outside_max_process_cores'],
                quiet_seconds=data['seconds'],binaries=data['binaries'])
            row['classification']=('passed' if row['passed'] else 'failed: frontier rule') if row['valid'] else 'invalid: window validity'
            d12=cell.get('d12') or {}
            if d12.get('cpu5_busy_fraction'):row.update(cpu5_busy_fraction=d12['cpu5_busy_fraction'],server_cpus=d12.get('server_cpus'))
            levels.setdefault(count,[]).append(row)
        rows.append(row)
    rows.sort(key=lambda row:(row['count'],row['repeat'],row['attempt']))
    return dict(kind='E20-frontier-ledger',prefix=prefix,**endpoints(levels,baseline),rows=rows,
        authority='builder evidence; reviewer independently verifies milestone acceptance')

def main():
    global DATA
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('prefix')
    parser.add_argument('--baseline',type=int)
    parser.add_argument('--data-dir',type=Path,default=DATA)
    args=parser.parse_args();DATA=args.data_dir.resolve()
    if args.baseline is not None and args.baseline<=0:parser.error('--baseline must be positive')
    result=ledger(args.prefix,args.baseline)
    (DATA/(args.prefix+'-staircase.json')).write_text(json.dumps(result,indent=2)+'\n')
    print(json.dumps({key:value for key,value in result.items() if key!='rows'},indent=2))
    for row in result['rows']:
        print(json.dumps({key:row.get(key) for key in ['count','repeat','passed','valid','classification','server_cores','proxy_cores','tile_tps','tile_p99_ms','failures']}))

if __name__=='__main__':main()
