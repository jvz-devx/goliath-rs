#!/usr/bin/env python3
"""Mechanically save and verify the E8 delta after E2 and E4, without staging or committing."""
import difflib
import hashlib
import io
import json
from pathlib import Path
import subprocess
import tarfile
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / ".local/src/meridian"
BASE = "902dcf195e0a8bbd3f39a5f560684af00e64bf5d"


def git(*args):
    return subprocess.check_output(["git", "-C", SOURCE, *args])


def main():
    candidates = set(git("diff", "--name-only", "-z").decode().strip("\0").split("\0"))
    candidates.update(git("ls-files", "--others", "--exclude-standard", "-z").decode().strip("\0").split("\0"))
    candidates = sorted(p for p in candidates if p and (p.startswith("crates/") or p == "Cargo.lock"))
    archive = git("archive", BASE)
    output = ROOT / "patches/meridian-02-fast-crossing.patch"
    with tempfile.TemporaryDirectory(prefix="E8-patch-", dir=ROOT / ".local/runs") as temporary:
        baseline = Path(temporary)
        with tarfile.open(fileobj=io.BytesIO(archive)) as bundle:
            bundle.extractall(baseline, filter="data")
        # Otherwise git discovers goliath-rs above this scratch directory and
        # silently skips patch paths outside its current-directory prefix.
        subprocess.run(["git", "init", "--quiet", baseline], check=True)
        for patch in ("e2-meridian-client.patch", "meridian-01-wall-trigger.patch"):
            subprocess.run(["git", "apply", ROOT / "patches" / patch], cwd=baseline, check=True)
        parts = []
        changed = []
        for relative in candidates:
            before = (baseline / relative).read_bytes().decode() if (baseline / relative).exists() else ""
            after = (SOURCE / relative).read_bytes().decode() if (SOURCE / relative).exists() else ""
            if before == after:
                continue
            changed.append(relative)
            parts.append(f"diff --git a/{relative} b/{relative}\n")
            if not (baseline / relative).exists():
                parts.append("new file mode 100644\n")
            parts.extend(difflib.unified_diff(before.splitlines(keepends=True), after.splitlines(keepends=True),
                fromfile=f"a/{relative}" if before else "/dev/null", tofile=f"b/{relative}"))
        output.write_text("".join(parts))
        subprocess.run(["git", "apply", "--check", output], cwd=baseline, check=True)
        subprocess.run(["git", "apply", output], cwd=baseline, check=True)
        for relative in candidates:
            if (SOURCE / relative).is_file() and (baseline / relative).read_bytes() != (SOURCE / relative).read_bytes():
                old, new = (baseline / relative).read_bytes(), (SOURCE / relative).read_bytes()
                raise RuntimeError(f"patch roundtrip differs: {relative}, lengths {len(old)}/{len(new)}, CRLF {old.count(bytes([13,10]))}/{new.count(bytes([13,10]))}, first difference {next((i for i,(a,b) in enumerate(zip(old,new)) if a != b), None)}")
    evidence = {"base": BASE, "order": ["e2-meridian-client.patch", "meridian-01-wall-trigger.patch", output.name],
                "sha256": hashlib.sha256(output.read_bytes()).hexdigest(), "bytes": output.stat().st_size,
                "changed": changed, "apply_check": "passed", "source_equality": "passed"}
    (ROOT / "docs/experiments/data/E8/patch.json").write_text(json.dumps(evidence, indent=2) + "\n")
    print(json.dumps(evidence, indent=2))


if __name__ == "__main__":
    main()
