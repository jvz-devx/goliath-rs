#!/usr/bin/env python3
"""Freeze one unchanged proxy with the gated tile/bot measurement overlay."""
import argparse
import json
from pathlib import Path
import re
import shutil

from e14_snapshot_support import validate_snapshot, sha256

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name',required=True)
    parser.add_argument('--fixture',type=Path,required=True)
    parser.add_argument('--stamps',type=Path,required=True)
    parser.add_argument('--diagnostic-reader-test-limit',action='store_true')
    args = parser.parse_args()
    if not re.fullmatch(r'(?:e25-|repro-)[A-Za-z0-9_-]+',args.name):
        raise ValueError('fresh e25- or repro- name required')
    fixture,stamps = args.fixture.resolve(),args.stamps.resolve()
    original = validate_snapshot(fixture)
    build = json.loads((stamps/'build.json').read_text())
    limits = build.get('verification_limits',[])
    if args.diagnostic_reader_test_limit:
        if build['status'] != 'release-with-reader-test-compile-limit' or not build['source_restored'] or not limits:
            raise RuntimeError('explicit diagnostic release contract is absent')
        if any(row['exit'] for row in build['commands'][:-1]) or build['commands'][-1]['label'] != 'reader-tests':
            raise RuntimeError('failure is not isolated to the stated reader-test limit')
    elif build['status'] != 'complete' or not build['source_restored'] or any(row['exit'] for row in build['commands']):
        raise RuntimeError('timestamp gates or restoration are incomplete')
    for name,digest in build['binaries'].items():
        if sha256(stamps/name) != digest:
            raise RuntimeError('measurement executable changed: ' + name)
    target = ROOT/'.local/bin/meridian-e25'/args.name
    shutil.copytree(fixture,target)
    for name in ['horizon-client','horizon-bots']:
        shutil.copy2(stamps/name,target/name)
    binaries = {name:sha256(target/name) for name in [*original['binaries'],'horizon-bots']}
    for name in ['FINAL.json','canonical.json','candidate.json']:
        record = json.loads((target/name).read_text())
        record['binaries'] = binaries if name != 'FINAL.json' else {
            binary:dict(path=str((target/binary).relative_to(ROOT)),sha256=binaries[binary]) for binary in original['binaries']}
        record['e25_measurement_stamps'] = dict(path=str((stamps/'build.json').relative_to(ROOT)),sha256=sha256(stamps/'build.json'))
        record['kind'] = 'E25-no-hop-measurement-not-new-capacity-qualification'
        record['e25_measurement_verification_limits'] = limits
        record['e25_diagnostic_only'] = bool(args.diagnostic_reader_test_limit)
        record['horizon_lease_base'] = Path(build.get('lease_fixture','lease-fixed-r1')).name
        (target/name).write_text(json.dumps(record,indent=2)+'\n')
    (target/'manifest.json').write_text(json.dumps({name:binaries[name] for name in original['binaries']},indent=2)+'\n')
    validate_snapshot(target)
    print(json.dumps(dict(directory=str(target.relative_to(ROOT)),binaries=binaries)),flush=True)


if __name__ == '__main__':
    main()
