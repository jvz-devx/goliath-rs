#!/usr/bin/env python3
"""Read-only publication and frozen-input audit; never edits another builder's source."""
import argparse
import gzip
import hashlib
import json
from pathlib import Path
import e11_support as support

ROOT=Path(__file__).resolve().parent.parent
DATA=ROOT/'docs/experiments/data/E20'
def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()

def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--name',required=True);args=parser.parse_args()
    output=DATA/(args.name+'.json')
    if output.exists():raise RuntimeError('audit output exists; preserve it and use a new name')
    failures=[];files=0;outside_entries=0;phase_entries=0
    def walk(value,path,location=''):
        nonlocal outside_entries,phase_entries
        if isinstance(value,dict):
            names=value.get('outside_process_names')
            if isinstance(names,dict):
                for pid,name in names.items():
                    outside_entries+=1
                    if name!='outside':failures.append(dict(path=path,location=location,pid=pid,error='outside name not redacted'))
            outside=value.get('outside')
            if isinstance(outside,list):
                for row in outside:
                    if isinstance(row,dict) and 'name' in row:
                        phase_entries+=1
                        if row['name']!='outside':failures.append(dict(path=path,location=location,error='outside phase name not redacted'))
            for key,item in value.items():walk(item,path,location+'/'+str(key))
        elif isinstance(value,list):
            for index,item in enumerate(value):walk(item,path,location+'/'+str(index))
    for path in sorted(DATA.rglob('*')):
        if not path.is_file() or not (path.name.endswith('.json') or path.name.endswith('.json.gz')):continue
        raw=path.read_bytes()
        try:value=json.loads(gzip.decompress(raw) if path.name.endswith('.gz') else raw)
        except (ValueError,OSError) as error:failures.append(dict(path=str(path.relative_to(ROOT)),error=repr(error)));continue
        files+=1;walk(value,str(path.relative_to(ROOT)))
    frozen={}
    for folder in [ROOT/'.local/bin/meridian-e18/reactor-1',ROOT/'.local/bin/meridian-e20/scheduler-1',ROOT/'.local/bin/meridian-e20/scheduler-2',ROOT/'.local/bin/meridian-e20/combined-1']:
        record=json.loads((folder/'candidate.json').read_text());values={}
        for name,digest in record['binaries'].items():
            actual=sha(folder/name);values[name]=actual
            if actual!=digest:failures.append(dict(path=str((folder/name).relative_to(ROOT)),error='frozen binary hash mismatch'))
        for project in record['projects'].values():
            for patch in project['patches']:
                if sha(ROOT/patch['path'])!=patch['sha256']:failures.append(dict(path=patch['path'],error='frozen patch hash mismatch'))
        frozen[str(folder.relative_to(ROOT))]=dict(binaries=values,candidate_sha256=sha(folder/'candidate.json'),canonical_sha256=sha(folder/'canonical.json'))
    preserved={'scripts/e14-analyse':'1fede9ca000943725500f1f0fcc661788fd65d421e1b4fa80010b34d1793cb99',
        'scripts/e14-build10-check':'45c4d415ca24a80f06022518fbd601ba8806b9733df36f7e697f4d0a6cc691f7',
        'docs/experiments/data/E20/physics/combined1-physics-off.json.gz':'8f43195b5b6d0d6f388c4a89fc67a81c251b12f5f06f1204fdb32b527de8547c'}
    for name,digest in preserved.items():
        if sha(ROOT/name)!=digest:failures.append(dict(path=name,error='preserved v1 input changed'))
    manifest=DATA/'analysis-v2/physics-v2-audit-1/manifest.json'
    for row in json.loads(manifest.read_text())['runs']:
        if sha(ROOT/row['path'])!=row['sha256']:failures.append(dict(path=row['path'],error='retained physics input changed'))
    result=dict(status='passed' if not failures else 'failed',json_files=files,outside_name_entries=outside_entries,outside_phase_rows=phase_entries,
        frozen=frozen,preserved_v1=preserved,failures=failures,
        ownership='no current Meridian or Horizon worktree comparison; those checkouts are now owned by E22')
    support.save(output,result)
    print(json.dumps({key:result[key] for key in ['status','json_files','outside_name_entries','outside_phase_rows','failures']},indent=2))
    raise SystemExit(0 if not failures else 1)

if __name__=='__main__':main()
