#!/usr/bin/env python3
"""Publish small E24 endpoint arithmetic while keeping raw observations local."""
import argparse
import gzip
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT/'docs/experiments/data/E24'


def read(path):
    data = path.read_bytes()
    return json.loads(gzip.decompress(data) if path.suffix=='.gz' else data)


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name',required=True)
    args = parser.parse_args()
    folder = ROOT/'.local/evidence/E24'/args.name
    causal = read(DATA/(args.name+'-causal-readback.json'))
    summary = read(DATA/(args.name+'-summary.json'))
    memory = read(folder/'process-memory.json.gz')
    origin = memory[0]['at']
    before = min(memory,key=lambda row:abs(row['at']-origin-300))
    minute30 = min(memory,key=lambda row:abs(row['at']-origin-1800))
    endpoint = memory[-1]
    def growth(after):
        result = {}
        for role,row in before['processes'].items():
            old,new = row['rss_mb'],after['processes'][role]['rss_mb']
            result[role] = dict(before_seconds=before['at']-origin,after_seconds=after['at']-origin,
                before_mib=old,after_mib=new,growth_fraction=(new-old)/old,under_10_percent=(new-old)/old<.1)
        return result
    cell_path = next(path for path in [folder/(args.name+'.json'),folder/(args.name+'.json.gz')] if path.exists())
    cell = read(cell_path)['cells']['650']
    samples = cell.get('bot_samples',[])
    populations = [sum(group['online'] for group in sample['groups'].values()) for sample in samples]
    failures = sum(group.get('failed',0) for sample in samples for group in sample['groups'].values())
    result = dict(kind='E24-step1-results',name=args.name,
        verdict='bounded-non-reproduction-not-an-availability-fix',
        total_window_seconds=summary['seconds'],measured_seconds=causal['window']['steady_noise']['seconds'],
        termination=summary['error'],authority_latch=any(row['first_stop'] for row in causal['tiles'].values()),
        clock_anomalies=sum(row['clock_anomaly_count'] for row in causal['tiles'].values()),
        renewal_replies=sum(row['renewal_replies'] for row in causal['tiles'].values()),
        renewal_installs=sum(row['renewal_installs'] for row in causal['tiles'].values()),
        maximum_reply_ms=max(row['maximum_reply_ms'] for row in causal['tiles'].values()),
        minimum_old_deadline_slack_ms=min(row['minimum_installed_old_deadline_slack_ms'] for row in causal['tiles'].values()),
        noise={phase:causal['window'][phase] for phase in ['whole_noise','steady_noise']},
        online_samples=dict(count=len(samples),minimum=min(populations),maximum=max(populations),sum_failed_fields=failures),
        memory_minute5_to30=growth(minute30),memory_minute5_to_endpoint=growth(endpoint),
        store=causal['store'],binaries_unchanged=summary['binaries_unchanged'],cleanup_errors=summary['cleanup_errors'],
        source_and_index_restored=True,fix_approved=False,fixed_soak_run=False,m3_rerun=False)
    archives = []
    for native in [ROOT/'.local/evidence/E24'/(args.name+'-native'),ROOT/'.local/evidence/E24'/(args.name+'-anticheat-native')]:
        index = native/'archive-index.json'
        record = read(index)
        if any(row['roundtrip']!='byte-equal' for row in record['files']):
            raise RuntimeError('native archive verification incomplete')
        archives.append(dict(index=str(index.relative_to(ROOT)),sha256=sha(index),
            raw_bytes=sum(row['bytes'] for row in record['files']),files=len(record['files'])))
    result['native_archives'] = archives
    result['evidence'] = {str(path.relative_to(ROOT)):sha(path) for path in sorted(folder.rglob('*')) if path.is_file()}
    result['scripts'] = {str(path.relative_to(ROOT)):sha(path) for path in sorted((ROOT/'scripts').glob('e24*')) if path.is_file()}
    target = DATA/(args.name+'-results.json')
    if target.exists():
        raise RuntimeError('result already exists')
    target.write_text(json.dumps(result,indent=2)+'\n')
    print(json.dumps({key:result[key] for key in ['verdict','measured_seconds','renewal_installs','maximum_reply_ms','minimum_old_deadline_slack_ms','online_samples','native_archives']},indent=2))


if __name__ == '__main__':
    main()
