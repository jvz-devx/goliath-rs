#!/usr/bin/env python3
"""Run unchanged E18/E12 terrain regressions against an E22 frozen snapshot."""
import argparse
import gzip
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import tempfile
import time
import e11_support as support
from e14_snapshot_support import validate_snapshot
from e22_availability import Availability

ROOT = support.ROOT
DATA = ROOT / 'docs/experiments/data/E22'


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['proof','terrain','items','borders','live','teleport','lifecycle'])
    parser.add_argument('--bins', type=Path, required=True)
    parser.add_argument('--name', required=True)
    parser.add_argument('--crossings', type=int, default=14)
    args = parser.parse_args()
    request = ROOT / '.local/quiet-request'
    if not request.exists() or request.read_text() != os.environ.get('E22_QUIET_IDENTITY'):
        raise RuntimeError('run through scripts/e22-window with a fresh E20 acknowledgement')
    validate_snapshot(args.bins)
    if (DATA / (args.name + '.json')).exists():
        raise RuntimeError('use a fresh result name')
    availability=Availability(args.name)
    adapter = availability.instrument_load(load)('e22_e17_adapter', ROOT / 'scripts/e17-m4')
    adapter.DATA = DATA
    module = adapter.cluster_module(args.bins)
    fixtures = load('e22_e12_fixtures', ROOT / 'scripts' / ('e18_fixtures.py' if args.action == 'lifecycle' else 'e12_fixtures.py'))
    original_save = module.save
    def save(name,value):
        value['acknowledgement_waiver'] = os.environ.get('E22_QUIET_WAIVER') or None
        original_save(name,value)
    module.save = save
    args.timeout = 30
    args.materialize = args.normal = args.terrain_off = args.initial_off = args.trace_terrain = False
    outcome = dict(action=args.action, status='running', load_start=os.getloadavg(),
        binaries={name: adapter.sha(args.bins / name) for name in ['meridian', 'horizon-client', 'goliath-store', 'e4-client']})
    began = time.monotonic()
    try:
        with tempfile.TemporaryDirectory(prefix='E22-check-', dir=ROOT / '.local/runs') as temporary:
            instance = module.Cluster.__new__(module.Cluster)
            try:
                instance.__init__(Path(temporary), module.RESOURCES, 512 if args.action in ['borders','teleport','lifecycle'] else 64)
                if args.action in ['proof','items']:
                    getattr(module,args.action)(instance,args)
                else:
                    getattr(fixtures, args.action)(module, instance, args)
                candidate=json.loads((args.bins/'candidate.json').read_text())
                if args.action=='terrain' and any(record['path'].endswith('meridian-08-cache-source-retention.patch') for record in candidate['projects']['meridian']['patches']):
                    log=instance.root/'proxy.log';offset=log.stat().st_size
                    instance.proxy.send('e22-views')
                    def telemetry():
                        with log.open('rb') as stream:stream.seek(offset);raw=stream.read()
                        for line in raw[:raw.rfind(b'\n')+1].decode(errors='replace').splitlines():
                            if 'E22_VIEWS ' in line:return json.loads(line.split('E22_VIEWS ',1)[1])
                    outcome['cache_console_probe']=support.wait(telemetry,5,'source-cache console probe timeout')
                outcome['status'] = 'complete'
            except BaseException:
                capture = load('e22_native_capture', ROOT / 'scripts/e18-production-slope')
                evidence = capture.failure_evidence(Path(temporary), instance, [], [])
                path = DATA / (args.name + '-failure-native.json.gz')
                path.write_bytes(gzip.compress(support.sanitize(json.dumps(evidence)).encode(), mtime=0))
                outcome['failure_evidence'] = str(path.relative_to(ROOT))
                raise
            finally:
                instance.stop()
    except BaseException as error:
        outcome.update(status='failed', error=support.sanitize(str(error)))
        raise
    finally:
        outcome.update(seconds=time.monotonic() - began, load_end=os.getloadavg())
        module.save(args.name + '-outcome.json', outcome)
        captured=availability.finish(DATA/(args.name+'-outcome.json'))
        if captured['lease_expiry_observed']:
            raise RuntimeError('lease expiry observed; stop M2 and report availability evidence')
        if not captured['complete']:
            raise RuntimeError('functional availability capture incomplete')


if __name__ == '__main__':
    main()
