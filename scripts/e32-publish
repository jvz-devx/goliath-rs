#!/usr/bin/env python3
"""Copy a soak's small evidence from its private run folder into the published data folder.

Text is sanitised to $REPO and $HOME and refused if a home path remains. JSON
over 1 MB and every trace are stored gzipped. The index records, per file, the
hash of the stored bytes and of the decompressed bytes.
"""
import argparse
import gzip
import hashlib
import json
from pathlib import Path

import e11_support as support

ROOT = support.ROOT
FILES = ['{name}-collection.json', '{name}-whole-window.json', '{name}/mutation-rate-watch.json',
         '{name}/{name}-425-failure-native.json', '{name}/store-batches.csv', '{name}/store-batches.renewals.csv',
         '{name}/store-batches.origin.json']


def content(path):
    path = path if path.exists() else path.with_name(path.name+'.gz')
    if not path.exists():
        return None
    raw = path.read_bytes()
    return gzip.decompress(raw) if path.suffix == '.gz' else raw


def publish(name, source, target, raw, index):
    text = support.sanitize(raw.decode())
    if '/home/' in text or '/Users/' in text:
        raise SystemExit('a home path survived sanitising: '+source)
    raw = text.encode()
    packed = len(raw) > 1_000_000 or not target.name.endswith('.json')
    if packed:
        target = target.with_name(target.name+'.gz')
    if target.exists():
        raise SystemExit('already published: '+target.name)
    stored = gzip.compress(raw, mtime=0) if packed else raw
    target.write_bytes(stored)
    index[target.name] = dict(source=source, stored_sha256=hashlib.sha256(stored).hexdigest(),
        decompressed_sha256=hashlib.sha256(raw).hexdigest(), decompressed_bytes=len(raw), stored_bytes=len(stored))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name', required=True)
    parser.add_argument('--evidence', type=Path, required=True, help='the private soak folder, such as .local/evidence/E32/soak')
    parser.add_argument('--data-dir', type=Path, required=True)
    args = parser.parse_args()
    evidence, data = args.evidence.resolve(), args.data_dir.resolve()
    index = {}
    for pattern in FILES:
        relative = pattern.format(name=args.name)
        raw = content(evidence/relative)
        if raw is None:
            index[relative] = dict(source=relative, absent=True)
            continue
        label = Path(relative).name
        publish(args.name, relative, data/(label if label.startswith(args.name) else args.name+'-'+label), raw, index)
    for trace in sorted((evidence/args.name/'tiles').glob('*-lease.jsonl*')):
        tile = 'abcd'[int(trace.name.split('-')[1])]
        publish(args.name, 'tiles/'+trace.name.replace('.gz', ''), data/f'{args.name}-lease-{tile}-{trace.name.split("-")[2]}.jsonl',
            content(trace.with_name(trace.name.replace('.gz', ''))), index)
    support.save(data/(args.name+'-evidence-index.json'), dict(kind='soak-evidence-index', name=args.name,
        hash_note='stored_sha256 is the file on disk; decompressed_sha256 is the content after gzip -dc', files=index))
    print(json.dumps({name:row.get('stored_bytes', 'absent') for name, row in index.items()}, indent=1))


if __name__ == '__main__':
    main()
