#!/usr/bin/env python3
"""Retain the exact internal-crate build inputs outside mutable source and frozen executables."""
import argparse
import hashlib
import json
from pathlib import Path
import subprocess
import tarfile

ROOT = Path(__file__).resolve().parent.parent


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--build',required=True)
    args = parser.parse_args()
    record = json.loads((ROOT/'docs/experiments/data/E24'/(args.build+'-build.json')).read_text())
    if record['status'] != 'complete':
        raise RuntimeError('only completed builds can be archived')
    expected = record['source']['internal_files']
    for name,digest in expected.items():
        if sha(ROOT/name) != digest:
            raise RuntimeError('compiled dependency changed before input archive: '+name)
    extra = ['Cargo.toml','Cargo.lock','clippy.toml']
    names = sorted(set(expected) | set(extra) | {str(path.relative_to(ROOT))
        for path in (ROOT/'crates').rglob('*') if path.is_file() and 'tests' in path.parts})
    target = ROOT/'.local/evidence/E24'/(args.build+'-internal-source.tar.gz')
    with tarfile.open(target,'x:gz') as archive:
        for name in names:
            archive.add(ROOT/name,arcname=name,recursive=False)
    report = dict(kind='E24-retained-compiled-inputs',build=args.build,
        root_revision=subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip(),
        source_archive=dict(path=str(target.relative_to(ROOT)),sha256=sha(target)),
        files={name:sha(ROOT/name) for name in names},
        horizon_source_proof=record['source'],binaries=record['binaries'])
    output = ROOT/'docs/experiments/data/E24'/(args.build+'-inputs.json')
    if output.exists():
        raise RuntimeError('input record already exists')
    output.write_text(json.dumps(report,indent=2)+'\n')
    print(json.dumps(dict(archive=str(target.relative_to(ROOT)),sha256=sha(target),files=len(names))))


if __name__ == '__main__':
    main()
