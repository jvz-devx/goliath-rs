#!/usr/bin/env python3
"""Build the exact E25 control or allocator delta, then restore source and index."""
import argparse
import difflib
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tarfile
import time
import tomllib

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / '.local/src/meridian'
BASE = ROOT / '.local/bin/meridian-e18/reactor-1'
EVIDENCE = ROOT / '.local/evidence/E25'
DATA = ROOT / 'docs/experiments/data/E25'
DEPS = EVIDENCE / 'reactor-dependencies'
DEPENDENCY_REVISION = 'a7988a4'
TEMPLATE = ROOT / 'patches/meridian-10-mimalloc.patch.in'
PATCH = ROOT / 'patches/meridian-10-mimalloc.patch'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def save(path, value):
    raw = json.dumps(value, indent=2, allow_nan=False) + '\n'
    if str(Path.home()) in raw or str(ROOT) in raw:
        raise RuntimeError('private path in published build record')
    path.write_text(raw)


def archive_dependencies():
    """Select original dependencies from Git, never the live root checkout."""
    canonical = json.loads((BASE / 'canonical.json').read_text())['internal_crates']
    paths = ['Cargo.toml', 'Cargo.lock', 'clippy.toml', 'crates/goliath-store', 'crates/goliath-model']
    archive = EVIDENCE / 'e25-reactor-dependencies.tar'
    commit = subprocess.check_output(['git', 'rev-parse', DEPENDENCY_REVISION], cwd=ROOT, text=True).strip()
    if not archive.exists():
        subprocess.run(['git', 'archive', commit, *paths, '-o', str(archive)], cwd=ROOT, check=True)
    expected_archive = subprocess.check_output(['git', 'archive', commit, *paths], cwd=ROOT)
    if sha(archive) != hashlib.sha256(expected_archive).hexdigest():
        raise RuntimeError('existing dependency archive differs from Git')
    if not DEPS.exists():
        DEPS.mkdir()
        with tarfile.open(archive) as bundle:
            bundle.extractall(DEPS, filter='data')
    expected = {name: value for name, value in canonical['files'].items()
                if name in paths or name.startswith(('crates/goliath-store/', 'crates/goliath-model/'))}
    for name, digest in expected.items():
        if sha(DEPS / name) != digest:
            raise RuntimeError('dependency bytes differ from reactor-1: ' + name)
    return dict(commit=commit, archive=str(archive.relative_to(ROOT)), archive_sha256=sha(archive), files=expected)


def private_stack(name, manifest):
    folder = EVIDENCE / (name + '-frozen')
    folder.mkdir(exist_ok=False)
    env = dict(os.environ, GIT_INDEX_FILE=str(folder / 'index'))
    def git(*args):
        return subprocess.check_output(['git', *map(str, args)], cwd=SOURCE, env=env)
    if git('rev-parse', 'HEAD').decode().strip() != manifest['pin']:
        raise RuntimeError('Meridian HEAD differs from frozen pin')
    git('read-tree', manifest['pin'])
    for row in manifest['patches']:
        if sha(ROOT / row['path']) != row['sha256']:
            raise RuntimeError('frozen patch changed: ' + row['path'])
        git('apply', '--cached', '--check', ROOT / row['path'])
        git('apply', '--cached', ROOT / row['path'])
    files = {}
    differences = []
    for path, digest in manifest['source_files'].items():
        content = git('show', ':' + path)
        if hashlib.sha256(content).hexdigest() != digest:
            raise RuntimeError('patch stack differs from frozen manifest: ' + path)
        files[path] = content
        if not (SOURCE / path).is_file() or sha(SOURCE / path) != digest:
            differences.append(path)
    return files, differences


def allocator_delta(before, after):
    parts = []
    for name in sorted(before):
        if before[name] != after[name]:
            parts.append('diff --git a/' + name + ' b/' + name + '\n')
            parts.extend(difflib.unified_diff(before[name].decode().splitlines(keepends=True),
                after[name].decode().splitlines(keepends=True), fromfile='a/' + name, tofile='b/' + name))
    return ''.join(parts).encode()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name', required=True)
    parser.add_argument('--kind', required=True, choices=['control', 'mimalloc'])
    parser.add_argument('--prepare-only', action='store_true')
    parser.add_argument('--matched-scheduler-targets', action='store_true',
        help='control only: use the same release targets as the scheduler/writev builder')
    args = parser.parse_args()
    if args.matched_scheduler_targets and args.kind != 'control':
        raise ValueError('matched scheduler target selection is a separate reactor control only')
    if not re.fullmatch(r'(?:e25-|repro-)[A-Za-z0-9_-]+', args.name):
        raise ValueError('fresh e25- or repro- name required')
    EVIDENCE.mkdir(parents=True, exist_ok=True)
    DATA.mkdir(parents=True, exist_ok=True)
    record_path = DATA / (args.name + '-build.json')
    target = ROOT / '.local/bin/meridian-e25' / args.name
    if record_path.exists() or target.exists():
        raise RuntimeError('attempt already exists')
    runner_copy = EVIDENCE / (args.name + '-runner.py')
    if runner_copy.exists():
        raise RuntimeError('executed runner already exists')
    shutil.copy2(Path(__file__), runner_copy)
    baseline = json.loads((BASE / 'candidate.json').read_text())['projects']['meridian']
    files, differences = private_stack(args.name, baseline)
    dependencies = archive_dependencies()
    result = dict(kind=args.kind, status='prepared', profile='release', incremental=False,
        runner_sha256=sha(Path(__file__)), template_sha256=sha(TEMPLATE),
        reactor_manifest_sha256=sha(BASE / 'candidate.json'), frozen_proxy_sha256=sha(BASE / 'meridian'),
        frozen_stack=baseline, checkout_differences_before_selection=differences,
        dependencies=dependencies, commands=[], source_restored=False)
    if args.prepare_only:
        result['checkout_changed'] = False
        save(record_path, result)
        print(json.dumps(dict(status='prepared', frozen_source_files=len(files),
            checkout_differences=len(differences), dependencies_archive_sha256=dependencies['archive_sha256'])), flush=True)
        return
    # E24's existing backup/restoration kernels include exact dirty-status and index checks.
    helper = load('e25_source_backup', ROOT / 'scripts/e24-proxy-build')
    helper.EVIDENCE = EVIDENCE
    result['backup_helper_sha256'] = sha(ROOT / 'scripts/e24-proxy-build')
    saved = EVIDENCE / (args.name + '-source-backup')
    original = helper.backup(saved)
    settings = {k: v for k, v in os.environ.items() if k not in ['CI', 'CARGO_TARGET_DIR', 'RUSTFLAGS', 'CARGO_ENCODED_RUSTFLAGS']
                and not k.startswith(('CARGO_PROFILE_', 'MIMALLOC_', 'MI_'))}
    settings.update(CARGO_INCREMENTAL='0', CARGO_BUILD_JOBS='6', CARGO_PROFILE_RELEASE_LTO='thin',
        CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1', CARGO_PROFILE_RELEASE_DEBUG='0')
    result['build_settings'] = {k: v for k, v in settings.items() if k.startswith(('CARGO_INCREMENTAL', 'CARGO_BUILD_JOBS', 'CARGO_PROFILE_'))}
    result['rustc'] = subprocess.check_output(['rustc', '-Vv'], text=True)
    result['cargo'] = subprocess.check_output(['cargo', '-V'], text=True).strip()
    selected = {}
    try:
        for name, content in files.items():
            path = SOURCE / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(content)
            selected[name] = sha(path)
        if args.kind == 'mimalloc':
            subprocess.run(['git', 'apply', '--check', str(TEMPLATE)], cwd=SOURCE, check=True)
            subprocess.run(['git', 'apply', str(TEMPLATE)], cwd=SOURCE, check=True)
            for name in ['crates/meridian-proxy/Cargo.toml', 'crates/meridian-proxy/src/main.rs']:
                selected[name] = sha(SOURCE / name)
        cargo_path = SOURCE / 'crates/meridian-proxy/Cargo.toml'
        original_path = '../../../../../crates/goliath-store'
        relocated_path = '../../../../../.local/evidence/E25/reactor-dependencies/crates/goliath-store'
        content = cargo_path.read_text()
        if content.count(original_path) != 1:
            raise RuntimeError('unexpected original dependency path')
        cargo_path.write_text(content.replace(original_path, relocated_path))
        selected.update({name: sha(SOURCE / name) for name in files})
        packages_before = tomllib.loads(files['Cargo.lock'].decode())['package']
        commands = [('release', ['cargo', 'build', '--release', '-p', 'meridian-proxy', '--bin', 'meridian'])]
        if args.kind == 'control':
            commands[0][1].insert(2, '--locked')
        if args.matched_scheduler_targets:
            commands[0] = ('release', ['cargo', 'build', '--locked', '--release',
                '-p', 'meridian-proxy', '--bin', 'meridian', '-p', 'meridian-sidecar',
                '--bin', 'meridian-sidecar', '-p', 'meridian-testkit', '--bin', 'e4-client'])
        commands += [
            ('fmt', ['rustfmt', '--edition', '2024', '--check', '--config', 'skip_children=true', 'crates/meridian-proxy/src/main.rs']),
            ('clippy', ['cargo', 'clippy', '--locked', '--release', '-p', 'meridian-proxy', '--all-targets', '--', '-D', 'warnings']),
            ('tests', ['cargo', 'test', '--locked', '--release', '-p', 'meridian-proxy', '-p', 'meridian-handoff', '-p', 'meridian-net', '--', '--skip', 'serve::tests::the_listener_queues_a_large_burst'])]
        for label, command in commands:
            log = EVIDENCE / (args.name + '-' + label + '.log')
            print('E25_GATE ' + args.name + ' ' + label, flush=True)
            began = time.monotonic()
            invocation = [str(ROOT / '.local/bin/host-window'), 'build', 'E25', '--', *command] if command[0] == 'cargo' else command
            with log.open('x') as stream:
                completed = subprocess.run(invocation, cwd=SOURCE, env=settings, stdout=stream, stderr=subprocess.STDOUT)
            output = log.read_text(errors='replace')
            row = dict(label=label, command=command, exit=completed.returncode, elapsed_with_queue_seconds=time.monotonic()-began,
                log=str(log.relative_to(ROOT)), log_sha256=sha(log), test_results=re.findall(r'test result: .*', output))
            result['commands'].append(row)
            save(record_path, result)
            print(json.dumps(row), flush=True)
            if completed.returncode:
                raise RuntimeError('gate failed: ' + label + ', see local evidence log')
        compiled = {name: (SOURCE / name).read_bytes() for name in files}
        compiled['crates/meridian-proxy/Cargo.toml'] = compiled['crates/meridian-proxy/Cargo.toml'].replace(relocated_path.encode(), original_path.encode())
        packages_after = tomllib.loads(compiled['Cargo.lock'].decode())['package']
        key = lambda package: (package['name'], package['version'], package.get('source'))
        old = {key(package): package for package in packages_before}
        new = {key(package): package for package in packages_after}
        if any(new.get(identity) != package for identity, package in old.items() if identity[0] != 'meridian-proxy'):
            raise RuntimeError('existing dependency resolution changed')
        result['added_packages'] = [package for identity, package in new.items() if identity not in old]
        if args.kind == 'mimalloc':
            native = next(package for package in result['added_packages'] if package['name'] == 'libmimalloc-sys')
            if native['version'] != '0.1.49':
                raise RuntimeError('native version needs a separately reviewed pin: ' + native['version'])
            delta = allocator_delta(files, compiled)
            if PATCH.exists() and PATCH.read_bytes() != delta:
                raise RuntimeError('existing allocator patch differs; never overwrite it')
            if not PATCH.exists():
                PATCH.write_bytes(delta)
            result['patch'] = dict(path=str(PATCH.relative_to(ROOT)), sha256=sha(PATCH))
        elif allocator_delta(files, compiled):
            raise RuntimeError('control source differs beyond dependency relocation')
        result['compiled_files'] = {name: sha(SOURCE / name) for name in files}
        result['source_path_only_change'] = dict(path='crates/meridian-proxy/Cargo.toml', original=original_path, relocated=relocated_path)
        target.mkdir(parents=True, exist_ok=False)
        shutil.copy2(SOURCE / 'target/release/meridian', target / 'meridian')
        shutil.copy2(SOURCE / 'Cargo.lock', target / 'Cargo.lock')
        result.update(status='complete', directory=str(target.relative_to(ROOT)), binary_sha256=sha(target / 'meridian'))
        result['frozen_binary_identical'] = result['binary_sha256'] == result['frozen_proxy_sha256']
    except BaseException as error:
        result.update(status='failed', error=str(error).replace(str(ROOT), '$REPO').replace(str(Path.home()), '$HOME'))
        raise
    finally:
        helper.restore(saved, original, selected)
        result['source_restored'] = True
        save(record_path, result)
        if result['status'] == 'complete':
            shutil.copy2(record_path, target / 'build.json')


if __name__ == '__main__':
    main()
