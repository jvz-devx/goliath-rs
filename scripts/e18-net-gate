#!/usr/bin/env python3
"""One bounded native reactor test command, with sanitized retained evidence."""
import argparse
import gzip
import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import tempfile
import time
import e11_support as support

ROOT=Path(__file__).resolve().parent.parent
SOURCE=ROOT/'.local/src/meridian'
DATA=ROOT/'docs/experiments/data/E18'


def main():
    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--name',required=True);parser.add_argument('--clippy',action='store_true');parser.add_argument('--handoff',action='store_true');args=parser.parse_args()
    if (ROOT/'.local/quiet-request').exists():raise SystemExit('quiet marker exists; no cargo started')
    target=DATA/(args.name+'.json')
    if target.exists():raise SystemExit('use a fresh result name')
    command=['cargo','clippy','--offline','--release','-p','meridian-net','--all-targets','--','-D','warnings'] if args.clippy else ['cargo','test','--offline','--release','-p','meridian-net','--lib','io_pool','--','--test-threads=1']
    if args.handoff:
        at=command.index('--')
        command[at:at]=['-p','meridian-handoff']
        if not args.clippy:command.remove('io_pool')
    env=dict(os.environ,CARGO_INCREMENTAL='0',CARGO_PROFILE_RELEASE_LTO='thin',CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1');env.pop('CARGO_TARGET_DIR',None);env.pop('CI',None)
    result=dict(command=command,bound_seconds=300,profile='native release, ThinLTO, one codegen unit, incremental disabled',
        sources={path:hashlib.sha256((SOURCE/path).read_bytes()).hexdigest() for path in ['crates/meridian-net/src/io_pool.rs','crates/meridian-net/src/lib.rs','crates/meridian-net/Cargo.toml']})
    began=time.monotonic()
    with tempfile.TemporaryDirectory(prefix='E18-net-gate-',dir=support.RUNS) as temporary:
        log=Path(temporary)/'cargo.log'
        with log.open('w') as stream:
            process=subprocess.Popen(command,cwd=SOURCE,env=env,stdout=stream,stderr=subprocess.STDOUT,start_new_session=True)
            try:result['exit']=process.wait(timeout=300)
            except subprocess.TimeoutExpired:
                os.killpg(process.pid,signal.SIGTERM)
                try:process.wait(10)
                except subprocess.TimeoutExpired:os.killpg(process.pid,signal.SIGKILL);process.wait(10)
                result.update(exit=process.returncode,timeout=True)
        raw=support.sanitize(log.read_text());result['seconds']=time.monotonic()-began
        (DATA/(args.name+'.log.gz')).write_bytes(gzip.compress(raw.encode(),mtime=0));support.save(target,result)
        print(raw[-6000:]);print(json.dumps(result,indent=2))
    raise SystemExit(0 if result['exit']==0 else 1)


if __name__=='__main__':main()
