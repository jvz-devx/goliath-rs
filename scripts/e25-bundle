#!/usr/bin/env python3
"""Combine one frozen fixture with one E25 proxy in a fresh immutable bundle."""
import argparse
import json
from pathlib import Path
import re
import shutil

from e14_snapshot_support import validate_snapshot, sha256

ROOT = Path(__file__).resolve().parent.parent


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name', required=True)
    parser.add_argument('--fixture', type=Path, required=True)
    parser.add_argument('--proxy', type=Path, required=True)
    args = parser.parse_args()
    if not re.fullmatch(r'(?:e25-|repro-)[A-Za-z0-9_-]+', args.name):
        raise ValueError('fresh e25- or repro- name required')
    fixture, proxy = args.fixture.resolve(), args.proxy.resolve()
    identity = validate_snapshot(fixture)
    build = json.loads((proxy / 'build.json').read_text())
    if build['status'] != 'complete' or not build['source_restored'] or sha256(proxy / 'meridian') != build['binary_sha256']:
        raise RuntimeError('proxy build contract does not match executable')
    target = ROOT / '.local/bin/meridian-e25' / args.name
    target.mkdir(parents=True, exist_ok=False)
    names = ['horizon-client', 'meridian-sidecar', 'e4-client', 'goliath-store', 'horizon-bots', 'LEASES', 'cluster-launcher.py']
    for name in names:
        shutil.copy2(fixture / name, target / name)
    shutil.copy2(proxy / 'meridian', target / 'meridian')
    binaries = {name: sha256(target / name) for name in [*identity['binaries'], 'horizon-bots']}
    for name in ['canonical.json', 'candidate.json', 'FINAL.json']:
        record = json.loads((fixture / name).read_text())
        record['binaries'] = binaries if name != 'FINAL.json' else {
            binary: dict(path=str((target / binary).relative_to(ROOT)), sha256=binaries[binary])
            for binary in identity['binaries']}
        record['e25_proxy_build'] = dict(path=str((proxy / 'build.json').relative_to(ROOT)), sha256=sha256(proxy / 'build.json'))
        record['e25_fixture'] = dict(path=str(fixture.relative_to(ROOT)), final_sha256=sha256(fixture / 'FINAL.json'))
        if name == 'candidate.json':
            project = record['projects']['meridian'] = build['frozen_stack']
            if build.get('patch'):
                project['patches'] = [*project['patches'], build['patch']]
            project['source_files'] = build['compiled_files']
        (target / name).write_text(json.dumps(record, indent=2) + '\n')
    (target / 'manifest.json').write_text(json.dumps({name: binaries[name] for name in identity['binaries']}, indent=2) + '\n')
    validate_snapshot(target)
    print(json.dumps(dict(directory=str(target.relative_to(ROOT)), binaries=binaries)), flush=True)


if __name__ == '__main__':
    main()
