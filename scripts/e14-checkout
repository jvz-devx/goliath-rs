#!/usr/bin/env python3
"""Prove E14's existing Horizon checkout is reproduced by its saved patches."""

import hashlib
import json
import os
from pathlib import Path
import subprocess
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / '.local/src/horizon-tiles'
PIN = 'fc2868b2b26d56ec76e17414909fe58a3b87bb92'
PATCHES = [
    'e2-horizon-input-trace.patch',
    'horizon-02-tile-ownership.patch',
    'horizon-03-bots.patch',
    'horizon-04-digest.patch',
]


def git(*args, env=None):
    return subprocess.check_output(['git', '-C', str(SOURCE), *args], env=env)


def names(raw):
    return set(filter(None, raw.decode().split('\0')))


def digest(raw):
    return hashlib.sha256(raw).hexdigest()


def main():
    assert git('rev-parse', 'HEAD').decode().strip() == PIN
    status = git('status', '--porcelain=v1', '-z')
    working_diff = git('diff', 'HEAD', '--binary')
    staged_diff = git('diff', '--cached', '--binary')
    paths = names(git('diff', 'HEAD', '--name-only', '-z'))
    paths |= names(git('ls-files', '--others', '--exclude-standard', '-z'))
    records = []
    patch_records = []
    with tempfile.TemporaryDirectory(prefix='E14-index-', dir=ROOT / '.local/runs') as temporary:
        env = dict(os.environ, GIT_INDEX_FILE=str(Path(temporary) / 'index'))
        git('read-tree', PIN, env=env)
        for name in PATCHES:
            patch = ROOT / 'patches' / name
            git('apply', '--cached', '--check', str(patch), env=env)
            git('apply', '--cached', str(patch), env=env)
            patch_records.append({'file': 'patches/' + name, 'sha256': digest(patch.read_bytes())})
        paths |= names(git('diff', '--cached', PIN, '--name-only', '-z', env=env))
        for relative in sorted(paths):
            path = SOURCE / relative
            actual = os.fsencode(os.readlink(path)) if path.is_symlink() else path.read_bytes() if path.is_file() else None
            blob = subprocess.run(
                ['git', '-C', str(SOURCE), 'show', ':' + relative],
                env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            )
            expected = blob.stdout if blob.returncode == 0 else None
            records.append({'file': relative, 'match': actual == expected,
                            'working_sha256': digest(actual) if actual is not None else None,
                            'patch_sha256': digest(expected) if expected is not None else None})
    assert status == git('status', '--porcelain=v1', '-z'), 'checkout status changed during comparison'
    assert working_diff == git('diff', 'HEAD', '--binary'), 'working diff changed during comparison'
    assert staged_diff == git('diff', '--cached', '--binary'), 'staged diff changed during comparison'
    result = {'pin': PIN, 'patches': patch_records, 'files': records,
              'all_match': all(row['match'] for row in records),
              'baseline': {'status_sha256': digest(status), 'working_diff_sha256': digest(working_diff),
                           'staged_diff_sha256': digest(staged_diff)}}
    output = ROOT / 'docs/experiments/data/E14/preflight.json'
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(result, indent=2) + '\n')
    print(json.dumps({'all_match': result['all_match'], 'files': len(records),
                      'differences': [row['file'] for row in records if not row['match']]}))
    return 0 if result['all_match'] else 1


if __name__ == '__main__':
    raise SystemExit(main())
