#!/usr/bin/env python3
"""Freeze the approved bounded store with exact source and completed root-gate evidence."""
import argparse
import difflib
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import tarfile
import time

ROOT = Path(__file__).resolve().parent.parent
EVIDENCE = ROOT/'.local/evidence/E24'
DATA = ROOT/'docs/experiments/data/E24'


def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name',required=True)
    parser.add_argument('--gates',default='store-gates-r3')
    parser.add_argument('--expected-tests',type=int,default=73)
    parser.add_argument('--capacity',type=int,default=20480)
    parser.add_argument('--base-source',type=Path)
    parser.add_argument('--patch',type=Path)
    args = parser.parse_args()
    if not re.fullmatch('[A-Za-z0-9_-]+',args.name):raise ValueError('simple fresh name required')
    owner=ROOT/'.local/host/quiet/owner'
    if owner.exists() and owner.read_text().splitlines()[0]=='E24':raise RuntimeError('release own measurement window before build')
    revision = subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip()
    target = ROOT/'.local/bin'/('goliath-store-e24-'+revision[:9])/args.name
    output = DATA/(args.name+'-store-build.json')
    if target.exists() or output.exists():raise RuntimeError('build name already exists')
    gates = {kind:EVIDENCE/(args.gates+'-'+kind+'.log') for kind in ['fmt','clippy','test']}
    if any(not p.exists() for p in gates.values()):raise RuntimeError('missing root gate record')
    counts = [int(n) for n in re.findall(r'test result: ok\. (\d+) passed;',gates['test'].read_text())]
    if sum(counts)!=args.expected_tests or 'error:' in gates['clippy'].read_text():
        raise RuntimeError('expected final passing root gates')
    files = {str(path.relative_to(ROOT)):sha(path) for path in sorted((ROOT/'crates').rglob('*'))
        if path.is_file() and path.suffix in ['.rs','.toml']}
    files.update({name:sha(ROOT/name) for name in ['Cargo.toml','Cargo.lock','clippy.toml']})
    result = dict(kind='E24-bounded-store-release',status='running',revision=revision,
        source_identity='working-source-sha256',files=files,capacity=args.capacity,
        gates={kind:dict(path=str(path.relative_to(ROOT)),sha256=sha(path)) for kind,path in gates.items()},
        root_tests_passed=sum(counts),profile='release',incremental=False)
    env = {k:v for k,v in os.environ.items() if k not in ['CI','CARGO_TARGET_DIR'] and not k.startswith('CARGO_PROFILE_')}
    env.update(CARGO_INCREMENTAL='0',CARGO_BUILD_JOBS='2')
    if args.patch:
        if not args.base_source or args.patch.exists():raise RuntimeError('fresh patch and baseline source required')
        parts=[]
        with tarfile.open(args.base_source,'r:gz') as archive:
            for name in sorted(files):
                if not name.startswith('crates/goliath-store/'):continue
                before=archive.extractfile(name).read().decode()
                after=(ROOT/name).read_text()
                if before!=after:
                    parts.append(f'diff --git a/{name} b/{name}\n')
                    parts.extend(difflib.unified_diff(before.splitlines(keepends=True),after.splitlines(keepends=True),fromfile='a/'+name,tofile='b/'+name))
        args.patch.write_text(''.join(parts))
        result['memory_patch']=dict(path=str(args.patch),sha256=sha(args.patch),baseline=str(args.base_source),baseline_sha256=sha(args.base_source))
    command = [str(ROOT/'.local/bin/host-window'),'build','E24','--','cargo','build','--locked','--release','-p','goliath-store','--bin','goliath-store']
    began = time.monotonic()
    log = EVIDENCE/(args.name+'-store-release.log')
    try:
        with log.open('x') as stream:
            completed = subprocess.run(command,cwd=ROOT,env=env,stdout=stream,stderr=subprocess.STDOUT)
        result['release'] = dict(command=command,exit=completed.returncode,seconds=time.monotonic()-began,
            log=str(log.relative_to(ROOT)),sha256=sha(log))
        if completed.returncode:
            print(log.read_text()[-5000:]);raise RuntimeError('store release failed')
        if any(sha(ROOT/name)!=digest for name,digest in files.items()):
            raise RuntimeError('store source changed during build')
        target.mkdir(parents=True)
        shutil.copy2(ROOT/'target/release/goliath-store',target/'goliath-store')
        archive = EVIDENCE/(args.name+'-store-source.tar.gz')
        with tarfile.open(archive,'x:gz') as bundle:
            for name in files:bundle.add(ROOT/name,arcname=name,recursive=False)
        result.update(status='complete',directory=str(target.relative_to(ROOT)),
            binary_sha256=sha(target/'goliath-store'),source_archive=dict(path=str(archive.relative_to(ROOT)),sha256=sha(archive)))
    finally:
        output.write_text(json.dumps(result,indent=2)+'\n')
        if result['status']=='complete':shutil.copy2(output,target/'build.json')
    print(json.dumps({k:result.get(k) for k in ['status','directory','binary_sha256','root_tests_passed']},indent=2))


if __name__=='__main__':main()
