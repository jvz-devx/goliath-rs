#!/usr/bin/env python3
"""Checks native thread CPU units and the post-09 noise rule without game load."""
import copy
import os
import threading
import time
import unittest
import importlib.machinery
import importlib.util
import tempfile
import json
import io
from contextlib import redirect_stdout
from pathlib import Path
from types import SimpleNamespace
from unittest.mock import patch
from e17_flat09_metrics import thread_ids,thread_usage,outside_validity

loader=importlib.machinery.SourceFileLoader('flat09_runner',str(Path(__file__).with_name('e17-flat09-baseline')))
spec=importlib.util.spec_from_loader(loader.name,loader)
runner=importlib.util.module_from_spec(spec)
loader.exec_module(runner)


class MetricsTests(unittest.TestCase):
    def test_between_step_resume_preserves_rows_and_refuses_changed_measurement(self):
        stable=['canonical_sha256','build_sha256','harness_sha256','limiter_sha256','process_sampler_sha256','thread_metrics_sha256']
        current={key:'same' for key in stable}
        current['runner_sha256']='new-scheduler-only'
        with tempfile.TemporaryDirectory() as temporary:
            root=Path(temporary)
            data=root/'data'
            data.mkdir()
            (root/'previous.json').write_text(json.dumps({'build':current}))
            checkpoint={'status':'running','active_count':300,'frontier_pass':200,'frontier_fail':400,
                'rows':[{'bots':200,'path':'previous.json'},{'bots':400,'path':'previous.json'}]}
            (data/'staircase.json').write_text(json.dumps(checkpoint))
            with patch.object(runner,'ROOT',root),patch.object(runner,'DATA',data), \
                    patch.object(runner,'provenance',return_value=current), \
                    patch.object(runner,'quiet',side_effect=RuntimeError('test stops before fixture')) as quiet:
                with self.assertRaisesRegex(RuntimeError,'stops before fixture'):
                    runner.run(SimpleNamespace(resume=True))
                quiet.assert_called_once_with(300)
                changed=dict(current,harness_sha256='changed')
                with patch.object(runner,'provenance',return_value=changed):
                    with self.assertRaisesRegex(RuntimeError,'checkpoint instrumentation'):
                        runner.run(SimpleNamespace(resume=True))

    def test_cell_wrapper_keeps_w1_workload_and_fixed_budgets(self):
        class Engine:
            def __init__(self,*args,**kwargs): self.pid=os.getpid()
        class Sampler:
            def __init__(self): self.marks={}
            def start(self): return self
            def stop(self): pass
            def register(self,*args): pass
            def capture(self,name): self.marks[name]=True
            def report(self): return {'error':None,'phases':{name:{'outside_max_process_cores':.1} for name in ['steady','whole_cell']}}
        bench=SimpleNamespace(Engine=Engine,wait=lambda predicate,*args:predicate(),snapshot=lambda *args:{'at':time.monotonic()})
        def native_cell(config,count,repeat,options):
            self.assertEqual((config['seed'],config['spread'],config['mobs'],config['speed']),(12345,[-64,-64,64,64],64,4))
            self.assertEqual((options.warmup,options.seconds,options.server_cores,options.bot_cores),(30,60,4,1))
            self.assertEqual(options.max_load,float('inf'))
            self.assertEqual(bench.subprocess.STDOUT,runner.subprocess.STDOUT)
            child=bench.subprocess.Popen(['not-executed-test-client'],stderr=bench.subprocess.STDOUT)
            self.assertEqual(child.pid,os.getpid())
            engine=bench.Engine()
            self.assertIsInstance(engine,Engine)
            bench.wait(lambda:True)
            samples=[bench.snapshot(),bench.snapshot()]
            return {'pass':True,'valid':True,'reasons':[],'samples':samples,'server_cpu_cores':.2,'bot_cpu_cores':.01}
        bench.cell=native_cell
        with tempfile.TemporaryDirectory() as temporary:
            folder=Path(temporary)
            request=folder/'request'
            request.write_text(json.dumps({'owner':'E17'}))
            ack=folder/'ack'
            ack.write_text('idle')
            with patch.object(runner,'REQUEST',request),patch.object(runner,'ACK',ack), \
                    patch.object(runner,'provenance',return_value={'test':True}), \
                    patch.object(runner,'load_bench',return_value=bench),patch.object(runner,'ProcessSampler',Sampler), \
                    patch.object(runner.subprocess,'Popen',return_value=SimpleNamespace(pid=os.getpid())), \
                    patch.object(runner.os,'getloadavg',return_value=(1.,1.,1.)):
                with redirect_stdout(io.StringIO()):
                    row=runner.cell(SimpleNamespace(cell=200,repeat=0,out=folder/'row.json'))
            self.assertTrue(row['pass'])
            self.assertIn('main_thread_cpu_cores',row)

    def test_main_thread_identity_and_units_match_python_thread_clock(self):
        identity=min(thread_ids(os.getpid()))
        self.assertEqual(identity,threading.get_native_id())
        first=thread_usage(os.getpid(),identity)
        reference=time.thread_time()
        sum(i*i for i in range(800000))
        elapsed=time.thread_time()-reference
        last=thread_usage(os.getpid(),identity)
        self.assertAlmostEqual(last['cpu_s']-first['cpu_s'],elapsed,delta=.003)

    def test_half_core_boundary_and_both_measurement_phases(self):
        report={'error':None,'phases':{name:{'outside_max_process_cores':.5} for name in ['steady','whole_cell']}}
        self.assertTrue(outside_validity(report)[0])
        for name in report['phases']:
            changed=copy.deepcopy(report)
            changed['phases'][name]['outside_max_process_cores']=.5001
            self.assertFalse(outside_validity(changed)[0])

    def test_sampler_error_or_missing_coverage_cannot_pass(self):
        self.assertFalse(outside_validity({'error':'probe failed'})[0])
        self.assertFalse(outside_validity({'error':None,'phases':{}})[0])


if __name__=='__main__': unittest.main()
