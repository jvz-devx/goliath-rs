#!/usr/bin/env python3
"""Read a collected E25 soak after release; retain the native unjudged proxy record."""
import argparse
import json

import e25_soak_harness as harness
import goliath_platform as platform


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name',required=True)
    parser.add_argument('--owner',choices=sorted({'E25','reviewer',platform.window_owner('E25')}),default=platform.window_owner('E25'))
    args = parser.parse_args()
    owner = harness.ROOT / '.local/host/quiet/owner'
    if owner.exists() and owner.read_text().splitlines()[0] == args.owner:
        raise RuntimeError('release the measurement owner before soak analysis')
    result = harness.readback(args.name)
    print(json.dumps(result),flush=True)


if __name__ == '__main__':
    main()
