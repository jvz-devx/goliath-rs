#!/usr/bin/env python3
"""Prove and freeze E24's diagnostic-only release overlay in the owned workspace."""
import argparse
import difflib
import gzip
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import time

from e14_snapshot_support import validate_snapshot

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT/'.local/src/horizon'
REFERENCE = ROOT/'.local/bin/meridian-e18/reactor-1'
DATA = ROOT/'docs/experiments/data/E24'
EVIDENCE = ROOT/'.local/evidence/E24'
PATCH = ROOT/'patches/horizon-12-lease-diagnostics-r2.patch'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def proof():
    original = json.loads((EVIDENCE/'source-backup/final09-proof.json').read_text())
    env = dict(os.environ, GIT_INDEX_FILE=str(EVIDENCE/'source-backup/final09-index'))
    names = set(original['files']) | {'crates/horizon-client/src/game/dedicated/cluster/lease/trace.rs'}
    parts = []
    for name in sorted(names):
        old = subprocess.run(['git','show',':'+name],cwd=SOURCE,env=env,capture_output=True)
        before = old.stdout.decode() if old.returncode == 0 else ''
        after = (SOURCE/name).read_text()
        if before != after:
            parts.append(f'diff --git a/{name} b/{name}\n')
            if old.returncode:
                parts.append('new file mode 100644\n')
            parts.extend(difflib.unified_diff(before.splitlines(keepends=True),after.splitlines(keepends=True),
                fromfile='a/'+name if before else '/dev/null',tofile='b/'+name))
    patch = ''.join(parts)
    if PATCH.exists() and PATCH.read_text() != patch:
        raise RuntimeError('diagnostic patch already frozen; use a new explicit version')
    PATCH.write_text(patch)
    test_index = EVIDENCE/'diagnostic-index'
    shutil.copy2(EVIDENCE/'source-backup/final09-index',test_index)
    env['GIT_INDEX_FILE'] = str(test_index)
    subprocess.run(['git','apply','--cached','--check',PATCH],cwd=SOURCE,env=env,check=True)
    subprocess.run(['git','apply','--cached',PATCH],cwd=SOURCE,env=env,check=True)
    for name in names:
        expected = subprocess.check_output(['git','show',':'+name],cwd=SOURCE,env=env)
        if expected != (SOURCE/name).read_bytes():
            raise RuntimeError('overlay byte mismatch: '+name)
    internal = {str(path.relative_to(ROOT)):sha(path) for path in sorted((ROOT/'crates').rglob('*'))
        if path.is_file() and ('src' in path.parts or path.name == 'Cargo.toml')}
    return dict(source_equality='passed',files={name:sha(SOURCE/name) for name in sorted(names)},
        patch_sha256=sha(PATCH),internal_files=internal,final09_tree=original['tree'])


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name',required=True)
    parser.add_argument('--reuse-gates-from',help='reuse only completed matching gates on byte-identical source')
    args = parser.parse_args()
    if not re.fullmatch('[A-Za-z0-9_-]+',args.name):
        raise ValueError('simple fresh name required')
    target = ROOT/'.local/bin/goliath-e24'/args.name
    DATA.mkdir(parents=True,exist_ok=True)
    result_path = DATA/(args.name+'-build.json')
    if target.exists() or result_path.exists():
        raise RuntimeError('build already exists')
    if (ROOT/'.local/quiet-request').exists():
        raise RuntimeError('no build during a quiet window')
    source = proof()
    (DATA/(args.name+'-source-proof.json')).write_text(json.dumps(source,indent=2)+'\n')
    result = dict(kind='E24-diagnostic-overlay',status='running',profile='release',incremental=False,
        lease_rules_changed=False,source=source,commands=[])
    prior = None
    if args.reuse_gates_from:
        prior_path = DATA/(args.reuse_gates_from+'-build.json')
        prior = json.loads(prior_path.read_text())
        if prior['source'] != source or prior['profile'] != 'release':
            raise RuntimeError('prior gates are not from byte-identical source')
        result['reused_gates'] = dict(path=str(prior_path.relative_to(ROOT)),sha256=sha(prior_path))
    env = {k:v for k,v in os.environ.items() if k not in ['CI','CARGO_TARGET_DIR'] and not k.startswith('CARGO_PROFILE_')}
    env.update(CARGO_INCREMENTAL='0',CARGO_BUILD_JOBS='6',CARGO_PROFILE_RELEASE_LTO='thin',CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1')
    commands = [
        ('root-fmt',ROOT,['cargo','fmt','--all','--check']),
        ('root-clippy',ROOT,['cargo','clippy','--workspace','--all-targets','--','-D','warnings']),
        ('root-test',ROOT,['just','test']),
        ('horizon-fmt',SOURCE,['cargo','fmt','--all','--check']),
        ('horizon-clippy',SOURCE,['cargo','clippy','--locked','--release','--no-default-features','-p','horizon-client','--lib','--','-D','warnings']),
        ('horizon-lease-tests',SOURCE,['cargo','test','--locked','--release','--no-default-features','-p','horizon-client','--lib','game::dedicated::cluster::lease::tests::']),
        ('horizon-release',SOURCE,['cargo','build','--locked','--release','--no-default-features','-p','horizon-client','--bin','horizon-client'])]
    try:
        for label,cwd,command in commands:
            matching = [row for row in prior['commands'] if row['label']==label and row['command']==command and row['exit']==0] if prior else []
            if matching:
                result['commands'].append(dict(matching[0],reused_from=args.reuse_gates_from))
                continue
            if (ROOT/'.local/quiet-request').exists():
                raise RuntimeError('quiet window appeared before '+label)
            log = EVIDENCE/(args.name+'-'+label+'.log')
            print('E24_GATE '+label,flush=True)
            began = time.monotonic()
            with log.open('x') as output:
                completed = subprocess.run(command,cwd=cwd,env=env,stdout=output,stderr=subprocess.STDOUT)
            text = log.read_text(errors='replace')
            row = dict(label=label,command=command,exit=completed.returncode,seconds=time.monotonic()-began,
                log=str(log.relative_to(ROOT)),test_results=re.findall(r'test result: .*',text))
            result['commands'].append(row)
            result_path.write_text(json.dumps(result,indent=2)+'\n')
            print(json.dumps(row),flush=True)
            if completed.returncode or label == 'horizon-lease-tests' and not any('4 passed;' in s for s in row['test_results']):
                print('\n'.join(text.splitlines()[-65:]),flush=True)
                raise RuntimeError('gate failed: '+label)
        for name,digest in source['files'].items():
            if sha(SOURCE/name) != digest:
                raise RuntimeError('source changed during build: '+name)
        target.mkdir(parents=True)
        for name in ['meridian','meridian-sidecar','horizon-bots','goliath-store','e4-client','LEASES','cluster-launcher.py']:
            shutil.copy2(REFERENCE/name,target/name)
        shutil.copy2(SOURCE/'target/release/horizon-client',target/'horizon-client')
        binaries = {name:sha(target/name) for name in ['horizon-client','meridian','meridian-sidecar','goliath-store','horizon-bots','e4-client']}
        for name in ['canonical.json','candidate.json','FINAL.json']:
            record = json.loads((REFERENCE/name).read_text())
            record['binaries'] = binaries if name != 'FINAL.json' else {
                binary:dict(path=str((target/binary).relative_to(ROOT)),sha256=binaries[binary]) for binary in record['binaries']}
            record.update(kind='E24-diagnostic-only-not-availability-accepted',e24_source=source)
            project = record.get('projects',{}).get('horizon')
            if project:
                project['patches'].append(dict(path=str(PATCH.relative_to(ROOT)),sha256=sha(PATCH)))
            (target/name).write_text(json.dumps(record,indent=2)+'\n')
        required = ['horizon-client','meridian','meridian-sidecar','goliath-store','e4-client']
        (target/'manifest.json').write_text(json.dumps({n:binaries[n] for n in required},indent=2)+'\n')
        (target/'source-proof.json').write_text(json.dumps(source,indent=2)+'\n')
        validate_snapshot(target)
        result.update(status='complete',directory=str(target.relative_to(ROOT)),binaries=binaries)
    except BaseException as error:
        result.update(status='failed',error=str(error))
        raise
    finally:
        result_path.write_text(json.dumps(result,indent=2)+'\n')
        if result['status'] == 'complete':
            shutil.copy2(result_path,target/'build.json')


if __name__ == '__main__':
    main()
