#!/usr/bin/env python3
"""Run one fixed E12 vehicle row on the frozen final stack, with lease capture."""
import argparse
import gzip
import json
import os
import tempfile
import time
from pathlib import Path

from e23_support import (BINS, DATA, ROOT, availability, finish_availability,
    frozen, instrument_cluster, load, pack, quiet, save)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name', required=True)
    parser.add_argument('--kind', choices=['boat', 'minecart', 'horse'], required=True)
    args = parser.parse_args()
    quiet()
    identity = frozen()
    target = DATA / (args.name + '.json')
    outcome_path = DATA / (args.name + '-outcome.json')
    if any(p.exists() for p in [target, target.with_suffix('.json.gz'), outcome_path]):
        raise RuntimeError('use a fresh vehicle attempt name')
    trace = availability(args.name)
    adapter = load('e23_vehicle_adapter', ROOT / 'scripts/e17-m4')
    adapter.DATA = DATA
    module = instrument_cluster(trace, adapter.cluster_module)(BINS)
    fixture = load('e23_vehicle_fixture', ROOT / 'scripts/e12_fixtures.py')
    args.crossings = 100
    args.timeout = 30
    outcome = dict(status='running', kind=args.kind, requested=100, frozen=identity,
        fixture_sha256=__import__('hashlib').sha256((ROOT / 'scripts/e12_fixtures.py').read_bytes()).hexdigest(),
        native_vehicle_physics=False, load_start=os.getloadavg())
    began = time.monotonic()
    try:
        with tempfile.TemporaryDirectory(prefix='E23-vehicle-', dir=ROOT / '.local/runs') as folder:
            instance = module.Cluster.__new__(module.Cluster)
            try:
                instance.__init__(Path(folder), module.RESOURCES, 64)
                fixture.vehicles(module, instance, args)
                outcome['status'] = 'complete'
            except BaseException:
                capture = load('e23_vehicle_failure', ROOT / 'scripts/e20-frontier')
                evidence = capture.failure_evidence(Path(folder), instance, [], [])
                path = DATA / (args.name + '-failure-native.json.gz')
                save(path, evidence)
                outcome['failure_evidence'] = str(path.relative_to(ROOT))
                raise
            finally:
                instance.stop()
    except BaseException as error:
        outcome.update(status='failed', error=str(error))
        raise
    finally:
        outcome.update(seconds=time.monotonic() - began, load_end=os.getloadavg(), frozen_after=frozen())
        save(outcome_path, outcome)
        captured = finish_availability(trace, outcome_path)
        pack(target)
        if captured['lease_expiry_observed'] or not captured['complete']:
            raise RuntimeError('vehicle availability failure; stop this plan')


if __name__ == '__main__':
    main()
