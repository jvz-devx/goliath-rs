#!/usr/bin/env python3
"""Publish the store-side readback of an E29 soak: barrier tail, renewal replies, early renewals."""
import argparse
import gzip
import json
from pathlib import Path

import e25_soak_harness as harness
import e29_renewals


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name', required=True)
    parser.add_argument('--data-dir', type=Path, required=True)
    args = parser.parse_args()
    harness.configure(args.data_dir)
    folder = harness.EVIDENCE/args.name
    target = harness.DATA/(args.name+'-store-renewals.json')
    if target.exists():
        raise RuntimeError('store readback already exists')
    path = folder/(args.name+'.json')
    measurement = json.loads(path.read_text() if path.exists() else gzip.decompress(path.with_suffix('.json.gz').read_bytes()))
    cell = next(iter(measurement['cells'].values()))
    summary = harness.read(harness.DERIVED/(args.name+'-summary.json'))
    mode = summary.get('store_renewals', 'default')
    end_ns = cell.get('end_ns')
    partial = end_ns is None
    if partial:
        # A run that stopped early has no end mark; read up to its last proxy sample.
        end_ns = cell['start_ns']+round((cell['samples'][-1]['at']-cell['samples'][0]['at'])*1e9)
    result = e29_renewals.report(folder, cell['start_ns'], end_ns, mode)
    result.update(name=args.name, loaded_interval_complete=not partial, store_arguments=summary.get('store_arguments'))
    target.write_text(json.dumps(result, indent=2)+'\n')
    print(json.dumps({key: result[key] for key in ['store_renewals', 'barriers', 'early_renewals', 'accounting', 'authority_events', 'complete', 'problems']
        if key != 'accounting'} | {'accounting': {key: value for key, value in result['accounting'].items() if key != 'in_neither_trace_rows'},
        'tile_renewals': {key: value for key, value in result['tile_renewals'].items() if key != 'tiles'}}, indent=2))
    if not result['complete']:
        raise SystemExit(1)


if __name__ == '__main__':
    main()
