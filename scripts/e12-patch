#!/usr/bin/env python3
"""Save E12 deltas after E10, prove clean application and exact source bytes."""
import difflib
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import subprocess
import tempfile

ROOT=Path(__file__).resolve().parent.parent


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--status-delta',action='store_true')
    args=parser.parse_args()
    loader=importlib.machinery.SourceFileLoader('e12_patch_base',str(ROOT/'scripts/e10-patch'))
    spec=importlib.util.spec_from_loader('e12_patch_base',loader)
    base=importlib.util.module_from_spec(spec)
    loader.exec_module(base)
    evidence=[]
    for project,name in [('horizon','horizon-05-m2.patch'),('meridian','meridian-04-m2.patch')]:
        if project=='meridian' and (ROOT/'.local/bin/goliath-e12/MERIDIAN-HANDOVER').exists():
            frozen=json.loads((ROOT/'docs/experiments/data/E12/meridian-handover.json').read_text())
            for patch in frozen['patches']:
                if hashlib.sha256((ROOT/patch['path']).read_bytes()).hexdigest()!=patch['sha256']:
                    raise RuntimeError('frozen Meridian handover patch changed: '+patch['path'])
            with tempfile.TemporaryDirectory(prefix='E12-meridian-handover-',dir=ROOT/'.local/runs') as temporary:
                baseline=Path(temporary)
                base.export('meridian',baseline,integration=True)
                subprocess.run(['git','apply','--check',ROOT/frozen['patches'][-1]['path']],cwd=baseline,check=True)
                subprocess.run(['git','apply',ROOT/frozen['patches'][-1]['path']],cwd=baseline,check=True)
                for relative,expected in frozen['source_files'].items():
                    if hashlib.sha256((baseline/relative).read_bytes()).hexdigest()!=expected:
                        raise RuntimeError('Meridian handover source mismatch: '+relative)
            evidence.append(dict(frozen['prior_clean_application_and_source_equality'],ownership='E18',source_identity='meridian-handover.json'))
            continue
        source=ROOT/'.local/src'/project
        lease_delta=project=='horizon' and (source/'crates/horizon-client/src/game/dedicated/cluster/lease.rs').exists()
        extra=[]
        inherited=[]
        if lease_delta:
            extra=['horizon-05-m2.patch']
            inherited=[line.split('\t',2)[2] for line in subprocess.check_output(['git','apply','--numstat',ROOT/'patches/horizon-05-m2.patch'],text=True).splitlines()]
            name='horizon-06-leases.patch'
            if args.status_delta or (ROOT/'patches/horizon-07-observer-status.patch').exists():
                extra.append('horizon-06-leases.patch')
                inherited.extend(line.split('\t',2)[2] for line in subprocess.check_output(['git','apply','--numstat',ROOT/'patches/horizon-06-leases.patch'],text=True).splitlines())
                name='horizon-07-observer-status.patch'
        candidates=set()
        for command in [['diff','--name-only','-z'],['ls-files','--others','--exclude-standard','-z']]:
            candidates.update(subprocess.check_output(['git','-C',source,*command]).decode().strip('\0').split('\0'))
        candidates=sorted(p for p in candidates if p and (p.startswith('crates/') or p=='Cargo.lock'))
        with tempfile.TemporaryDirectory(prefix='E12-patch-',dir=ROOT/'.local/runs') as temporary:
            baseline=Path(temporary)
            base.export(project,baseline,integration=True)
            for parent in extra:
                subprocess.run(['git','apply',ROOT/'patches'/parent],cwd=baseline,check=True)
            parts=[]
            changed=[]
            for relative in candidates:
                old,new=baseline/relative,source/relative
                before=old.read_text() if old.exists() else ''
                after=new.read_text() if new.exists() else ''
                if before==after:
                    continue
                changed.append(relative)
                parts.append(f'diff --git a/{relative} b/{relative}\n')
                if not old.exists():
                    parts.append('new file mode 100644\n')
                parts.extend(difflib.unified_diff(before.splitlines(keepends=True),after.splitlines(keepends=True),
                    fromfile=f'a/{relative}' if old.exists() else '/dev/null',tofile=f'b/{relative}' if new.exists() else '/dev/null'))
            patch=ROOT/'patches'/name
            patch.write_text(''.join(parts))
            subprocess.run(['git','apply','--check',patch],cwd=baseline,check=True)
            subprocess.run(['git','apply',patch],cwd=baseline,check=True)
            for relative in candidates:
                old,new=baseline/relative,source/relative
                if old.exists()!=new.exists() or (new.is_file() and new.read_bytes()!=old.read_bytes()):
                    raise RuntimeError(f'source byte mismatch: {project}/{relative}')
        pin,stack,delta=base.PROJECTS[project]
        evidence.append(dict(project=project,pin=pin,order=stack+[delta]+extra+[name],changed=sorted(set(inherited+changed)),delta_changed=changed,
            bytes=patch.stat().st_size,sha256=hashlib.sha256(patch.read_bytes()).hexdigest(),apply_check='passed',source_equality='passed'))
    output=ROOT/'docs/experiments/data/E12/patch.json'
    output.parent.mkdir(parents=True,exist_ok=True)
    output.write_text(json.dumps(evidence,indent=2)+'\n')
    print(json.dumps(evidence,indent=2))


if __name__=='__main__':
    main()
