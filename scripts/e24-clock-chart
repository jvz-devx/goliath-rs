#!/usr/bin/env python3
"""Generate the bounded clock comparison figure from a frozen completed readback."""
import argparse
import json
from pathlib import Path

ROOT=Path(__file__).resolve().parent.parent


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--input',type=Path,required=True)
    parser.add_argument('--output',type=Path,required=True)
    args=parser.parse_args()
    data=json.loads(args.input.read_text())
    if not data['complete']:raise RuntimeError('completed probe required')
    keep={key:data[key] for key in ['elapsed_seconds','sample_pairs','clocks']}
    for row in keep['clocks'].values():
        row['points']=row['points'][::10]+row['points'][-1:]
    template=(ROOT/'scripts/e24-clock-chart.html').read_text()
    html=template.replace('__E24_CLOCK_DATA__',json.dumps(keep,separators=(',',':')))
    if args.output.exists():raise RuntimeError('figure already exists')
    args.output.write_text(html)
    print(args.output)


if __name__=='__main__':main()
