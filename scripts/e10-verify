#!/usr/bin/env python3
"""Run E10's scoped Rust gates serially and retain small command outcomes."""
import json
import os
from pathlib import Path
import subprocess
import time

ROOT=Path(__file__).resolve().parent.parent
DATA=ROOT/'docs/experiments/data/E10'


def main():
    env=dict(os.environ,CARGO_INCREMENTAL='0',CARGO_PROFILE_FAST_INHERITS='release',
        CARGO_PROFILE_FAST_LTO='false',CARGO_PROFILE_FAST_CODEGEN_UNITS='16',E3_TEST_ROOT=str(ROOT/'.local/runs'))
    env.pop('CI',None)
    commands=[
        ('.',['cargo','fmt','--all','--check']),
        ('.',['cargo','clippy','--workspace','--all-targets','--all-features','--','-D','warnings']),
        ('.',['cargo','test','--workspace','--all-features']),
        ('.local/src/horizon',['cargo','clippy','--locked','--profile','fast','--no-default-features','-p','horizon-client','--lib','--bin','horizon-client','--','-D','warnings']),
        ('.local/src/horizon',['cargo','test','--locked','--profile','fast','--no-default-features','-p','horizon-client','--lib','game::dedicated::tile_cut::store::tests']),
        ('.local/src/horizon',['cargo','test','--locked','--profile','fast','--no-default-features','-p','horizon-core','--lib','tile_ownership']),
        ('.local/src/horizon',['cargo','test','--locked','--profile','fast','--no-default-features','-p','horizon-client-render','--lib','tile_unknown_reads_are_solid_without_materializing_a_chunk']),
        ('.local/src/meridian',['cargo','clippy','--locked','--profile','fast','-p','meridian-handoff','-p','meridian-proxy','-p','meridian-testkit','--all-targets','--','-D','warnings']),
        ('.local/src/meridian',['cargo','test','--locked','--profile','fast','-p','meridian-config','-p','meridian-ghost','-p','meridian-handoff','-p','meridian-proxy','--lib','--bins','--','--skip','serve::tests::the_listener_queues_a_large_burst']),
    ]
    patches=json.loads((DATA/'patch.json').read_text())
    for project in patches:
        paths=[p for p in project['changed'] if p.endswith('.rs')]
        commands.append(('.local/src/'+project['project'],['rustfmt','--edition','2024','--config','skip_children=true','--check',*paths]))
    outcomes=[]
    for cwd,command in commands:
        print('E10 verify',cwd,' '.join(command),flush=True)
        started=time.monotonic()
        result=subprocess.run(command,cwd=ROOT/cwd,env=env,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT)
        lines=result.stdout.replace(str(ROOT),'$REPO').replace(str(Path.home()),'$HOME').splitlines()
        outcome={'cwd':cwd,'command':command,'exit':result.returncode,'seconds':time.monotonic()-started,
            'summary':[line for line in lines if line.startswith(('test result:','error:','error[','    Finished'))],
            'tail':lines[-25:] if result.returncode else []}
        outcomes.append(outcome)
        (DATA/'verification.json').write_text(json.dumps(outcomes,indent=2)+'\n')
        print(json.dumps(outcome),flush=True)
    if any(o['exit'] for o in outcomes):
        raise SystemExit(1)


if __name__=='__main__':
    main()
