#!/usr/bin/env python3
"""Keep the E26 D9 controller unchanged except for patch-10 arm identities and probes."""
import ast
import fcntl
import hashlib
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT / 'docs/experiments/data/E26'
ENGINES = {
    False: {'A': 'b2f1ea65ebf47658b24c55b52880ff609c658fbd9ab139d9421f9d99964bd16d',
            'B': 'ea4537868c90771e0d030ccfff1dbe36dace215a2c70d652dd86b38b84434090'},
    True: {'A': '92af479e9047649281819c52e6b7cc2a7a1b4b0ba91156c2724fb1d0fb2323d3',
           'B': '06b3b567aedcc92191d89046d8c957beba4859cae8ae4b0e554848a75f03c4b8'},
}


class WarmCell(ast.NodeTransformer):
    def __init__(self, timed):
        self.timed = timed

    def visit_Constant(self, node):
        if isinstance(node.value, str):
            value = node.value.replace('e26-timers on', 'e26-lite on').replace('e26-timers drain', 'e26-lite drain')
            if value == 'e26_timers':
                value = 'e26_lite'
            if value == ENGINES[False]['A']:
                value = ENGINES[self.timed]['A']
            if value == 'unchanged FINAL-09' and self.timed:
                value = 'FINAL-09 with lite timers; no warm-tick patch'
            return ast.copy_location(ast.Constant(value), node)
        return node

    def visit_If(self, node):
        if any(isinstance(statement, ast.Raise) and any(
                isinstance(item, ast.Constant) and item.value == 'diagnostic and planted bundles must not be mixed'
                for item in ast.walk(statement)) for statement in node.body):
            kind = 'E26-lite-native-release' if self.timed else 'E26-retained-patch10-qualification-not-capacity-accepted'
            node.test = ast.parse(f'build["status"] != "complete" or build["kind"] != {kind!r}').body[0].value
        # There are three arm-B-only blocks: build proof, timer enable, timer drain.
        # Timed arms both collect; untimed arms neither collect, but B keeps its proof check.
        if ast.dump(node.test) == ast.dump(ast.parse("args.arm != 'A'").body[0].value):
            proof = any(isinstance(item, ast.Name) and item.id == 'build'
                        for statement in node.body for item in ast.walk(statement))
            node.test = ast.Constant(True) if self.timed else node.test if proof else ast.Constant(False)
        return self.generic_visit(node)

    def visit_Subscript(self, node):
        if isinstance(node.value, ast.Name) and node.value.id == 'build' and isinstance(node.slice, ast.Constant) and node.slice.value == 'source_proof_sha256':
            return ast.copy_location(ast.parse('build.get("source_proof_sha256", build.get("source_proof", {}).get("sha256"))').body[0].value, node)
        return self.generic_visit(node)

    def visit_BinOp(self, node):
        if not self.timed and isinstance(node.op, ast.Div) and isinstance(node.left, ast.Name) and node.left.id == 'bins' and isinstance(node.right, ast.Constant) and node.right.value == 'source-proof.json':
            return ast.copy_location(ast.parse("ROOT / 'docs/experiments/data/E21/stack-proof.json'").body[0].value, node)
        return self.generic_visit(node)


def main():
    timed = '--timed' in sys.argv
    if timed:
        sys.argv.remove('--timed')
    name = sys.argv[sys.argv.index('--name') + 1]
    arm = sys.argv[sys.argv.index('--arm') + 1]
    bins = Path(sys.argv[sys.argv.index('--bins') + 1])
    if '/' in name or not name.startswith(('e26-', 'repro-')) or arm not in {'A', 'B'}:
        raise RuntimeError('fresh scoped name and A/B arm required')
    if hashlib.sha256((bins / 'horizon-client').read_bytes()).hexdigest() != ENGINES[timed][arm]:
        raise RuntimeError('patch-10 arm identity mismatch')
    if timed or arm == 'B':
        build = json.loads((bins / 'build.json').read_text())
        proof = bins / 'source-proof.json' if timed else ROOT / 'docs/experiments/data/E21/stack-proof.json'
        expected = build.get('source_proof_sha256', build.get('source_proof', {}).get('sha256'))
        if hashlib.sha256(proof.read_bytes()).hexdigest() != expected:
            raise RuntimeError('patch-10 source proof mismatch before queueing')
    source = ROOT / 'scripts/e26-cell'
    tree = ast.fix_missing_locations(WarmCell(timed).visit(ast.parse(source.read_text())))
    executed = DATA / (name + '-warm-driver.py')
    with executed.open('x') as stream:
        stream.write(ast.unparse(tree) + '\n')
    namespace = dict(__name__='e26b_warm_runtime', __file__=str(executed))
    exec(compile(tree, str(executed), 'exec'), namespace)
    with (ROOT / '.local/evidence/E26/operation.lock').open('a') as operation:
        fcntl.flock(operation, fcntl.LOCK_EX)
        namespace['main']()


if __name__ == '__main__':
    main()
