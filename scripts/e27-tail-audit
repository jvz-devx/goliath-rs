#!/usr/bin/env python3
"""Account for all driver-lifetime switches beyond E27's fixed audit boundary."""
import argparse
import json
from pathlib import Path

from e23_support import ROOT, load, pack, save


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--raw', type=Path, required=True)
    parser.add_argument('--name', required=True)
    args = parser.parse_args()
    if not args.name.startswith(('e27-', 'repro-')):
        parser.error('data names start e27- or repro-')
    output = ROOT/'docs/experiments/data/E27'/(args.name+'.json')
    if output.exists() or output.with_suffix('.json.gz').exists():
        parser.error('use a fresh name')
    audit = load('e27_tail_checker', ROOT/'scripts/e27-audit')
    raw = audit.read(args.raw)
    planned_end = raw['audit_end_ns']
    raw['audit_end_ns'] = raw['route_end_ns']
    bots = [audit.evaluate_bot(raw, 'E27BotX'+str(i), i) for i in range(40)]
    result = dict(scope='supplemental full 90-second switch ledger, not the fixed 75-second pass line',
        raw=audit.identity(args.raw), checker=audit.identity(ROOT/'scripts/e27-audit'),
        reader=audit.identity(Path(__file__)), planned_end_ns=planned_end,
        full_driver_end_ns=raw['route_end_ns'],
        switches=sum(b['backend_switches'] for b in bots),
        confirmed=sum(b['switches_confirmed'] for b in bots), bots=bots,
        insufficient_progress=[dict(name=b['name'], ns=s['ns'], blocks=s['target_advancement_blocks'],
            after_planned_boundary=s['ns']>planned_end, target_samples=s['target_placed_samples'],
            backend_packets=s['backend_movement_packets'])
            for b in bots for s in b['switches'] if not s['continued_route']])
    save(output, result)
    print(json.dumps(dict(path=str(pack(output).relative_to(ROOT)), switches=result['switches'],
        confirmed=result['confirmed'], insufficient_progress=result['insufficient_progress'])))
