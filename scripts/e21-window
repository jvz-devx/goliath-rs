#!/usr/bin/env python3
"""Run one E21 regression in an acknowledged, bounded quiet window."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import signal
import time
import importlib.machinery
import importlib.util
import e11_support as support

ROOT=support.ROOT
DATA=ROOT/'docs/experiments/data/E21'


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name',required=True)
    parser.add_argument('command',nargs=argparse.REMAINDER)
    args=parser.parse_args()
    command=args.command[1:] if args.command[:1]==['--'] else args.command
    if not command:parser.error('a command is required')
    loader=importlib.machinery.SourceFileLoader('e21_window_profile',str(ROOT/'scripts/e21-tile-profile'))
    spec=importlib.util.spec_from_loader(loader.name,loader)
    profile=importlib.util.module_from_spec(spec);loader.exec_module(profile)
    target=DATA/(args.name+'-quiet.json')
    if target.exists():raise RuntimeError('quiet result already exists')
    request=ROOT/'.local/quiet-request';ack=ROOT/'.local/quiet-ack-E20'
    if request.exists() or ack.exists():raise RuntimeError('quiet state already exists')
    identity=json.dumps(dict(owner='E21',name=args.name,pid=os.getpid()))+'\n'
    with request.open('x') as stream:stream.write(identity)
    began=time.monotonic();deadline=began+1500;process=None;monitor=None
    result=dict(status='waiting',command=command)
    try:
        while not ack.exists() or os.getloadavg()[0]>4:
            if time.monotonic()>deadline-180:raise TimeoutError('quiet acquisition deadline')
            time.sleep(.5)
        result.update(status='running',load_start=os.getloadavg(),ack_E20=ack.read_text())
        monitor=profile.ProcessSampler(observer=True).start()
        monitor.capture('steady-first')
        process=subprocess.Popen(command,cwd=ROOT)
        monitor.register('regression-driver',process.pid)
        descendants={process.pid}
        while process.poll() is None:
            for row in subprocess.check_output(['ps','-axo','pid=,ppid='],text=True).splitlines():
                pid,parent=map(int,row.split())
                if parent in descendants:
                    descendants.add(pid);monitor.register('fixture-'+str(pid),pid)
            if not request.exists() or request.read_text()!=identity:raise RuntimeError('quiet identity lost')
            if time.monotonic()>deadline-60:raise TimeoutError('regression quiet deadline')
            try:process.wait(timeout=1)
            except subprocess.TimeoutExpired:pass
        result.update(status='complete' if process.returncode==0 else 'failed',exit=process.returncode)
        monitor.capture('steady-last')
        if process.returncode:raise subprocess.CalledProcessError(process.returncode,command)
    except BaseException as error:
        result.update(status='failed',error=repr(error));raise
    finally:
        if process and process.poll() is None:
            # Python fixture drivers use finally blocks to stop their own children.
            # SIGINT gives that cleanup a chance; SIGTERM would bypass it.
            process.send_signal(signal.SIGINT)
            try:process.wait(timeout=30)
            except subprocess.TimeoutExpired:process.terminate();process.wait(timeout=10)
        if monitor:
            monitor.stop();result['processes']=monitor.report()
        if request.exists() and request.read_text()==identity:request.unlink();ack.unlink(missing_ok=True)
        result.update(seconds=time.monotonic()-began,load_end=os.getloadavg())
        support.save(target,result)


if __name__=='__main__':main()
