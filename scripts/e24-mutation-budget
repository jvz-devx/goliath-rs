#!/usr/bin/env python3
"""Bound accepted mutations by barrier-bearing batch intervals, including new cadence headroom."""
import argparse
import csv
import gzip
import hashlib
import io
import json
import math
from pathlib import Path

ROOT=Path(__file__).resolve().parent.parent


def interval_peak(batches,width_us):
    events=[]
    for row in batches:
        start=int(row['start_us']);end=start+math.ceil(float(row['execute_ms'])*1000)+2
        count=int(row['count'])
        # Count the whole batch if ANY possible apply time overlaps the window.
        events.extend([(start-width_us,0,count),(end,1,-count)])
    total=maximum=0;where=None
    for at,order,amount in sorted(events):
        total+=amount
        if total>maximum:maximum,where=total,at
    return dict(commands=maximum,window_start_us=where)


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--trace',action='append',required=True)
    parser.add_argument('--capacity',type=int,default=9216)
    parser.add_argument('--cadence-extra',type=int,default=20)
    parser.add_argument('--output',type=Path,required=True)
    args=parser.parse_args()
    if args.output.exists():raise RuntimeError('budget already frozen')
    result=dict(kind='E24-barrier-bearing-mutation-budget',proposed_capacity=args.capacity,retry_seconds=27,
        cadence_extra_upper_per_second=args.cadence_extra,required_margin=4,traces={},
        proof=['SyncMode Full, normal binary; append_batch resets last_barrier to zero and skips it iff records are empty',
            'positive-barrier batches contain at least one accepted change; count ALL their commands as mutations conservatively',
            'weighted interval overlap counts whole boundary batches, without assuming individual prepare timestamps',
            'cadence planning allowance adds16scheduled renewals/s plus4carried calls, without subtracting any old renewals'],
        limits=['measured workload planning margin, not an arbitrary future workload guarantee',
            '1050 trace is overloaded around5.5TPS, never a1050/20TPS qualification',
            'requires unchanged durable-journal semantics; not valid for a nondurable renewal path'])
    for item in args.trace:
        label,name=item.split('=',1);path=ROOT/name;content=path.read_bytes()
        raw=gzip.decompress(content) if path.suffix=='.gz'else content
        all_rows=list(csv.DictReader(io.StringIO(raw.decode())))
        rows=[row for row in all_rows if float(row['barrier_ms'])>0]
        one=interval_peak(rows,1_000_000);span=interval_peak(rows,27_000_000)
        rate=one['commands']+args.cadence_extra;budget=max(27*rate,span['commands']+27*args.cadence_extra)
        result['traces'][label]=dict(path=str(path.relative_to(ROOT)),sha256=hashlib.sha256(content).hexdigest(),
            all_batches=len(all_rows),barrier_bearing_batches=len(rows),mutation_upper_total=sum(int(row['count'])for row in rows),
            one_second_interval_upper=one,twenty_seven_second_interval_upper=span,
            rate_with_full_extra_cadence=rate,retry_budget=budget,required_capacity=4*budget+1,
            effective_margin=(args.capacity-1)/budget,qualified=args.capacity>=4*budget+1)
    result['all_qualified']=all(row['qualified']for row in result['traces'].values())
    args.output.write_text(json.dumps(result,indent=2)+'\n')
    print(json.dumps({label:{key:row[key]for key in ['rate_with_full_extra_cadence','required_capacity','effective_margin','qualified']}
        for label,row in result['traces'].items()},indent=2))


if __name__=='__main__':main()
