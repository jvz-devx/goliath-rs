#!/usr/bin/env python3
"""Freeze a byte-verified proxy candidate with E17's fresh release prerequisites."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT/'docs/experiments/data/E18'


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name', required=True)
    parser.add_argument('--event-loop',action='store_true')
    parser.add_argument('--flat09',action='store_true')
    parser.add_argument('--gates')
    args = parser.parse_args()
    source = ROOT/'.local/src/meridian'
    prerequisite = ROOT/('.local/bin/meridian-e18/flat09-tiles' if args.flat09 else '.local/bin/goliath-e17-release')
    provenance_path=prerequisite/('canonical.json' if args.flat09 else 'prereqs.json')
    provenance = json.loads(provenance_path.read_text())
    if args.flat09:
        if provenance['status'] not in ['complete','build-ready-not-capacity-accepted'] or provenance['source_equality']!='passed':raise SystemExit('FINAL09 prerequisites not verified')
        final_sha=provenance['base_final_sha256']
        for name,digest in provenance['binaries'].items():
            if sha(prerequisite/name)!=digest:raise SystemExit('FINAL09 prerequisite changed: '+name)
    else:
        if provenance['status'] != 'complete' or provenance['profile'] != 'release':raise SystemExit('release prerequisites not complete')
        final_sha=provenance['final_sha256']
    if sha(ROOT/'.local/bin/goliath-e12/FINAL.json') != final_sha:
        raise SystemExit('E12 FINAL changed since release prerequisites')
    manifest = json.loads((DATA/('event-patch.json' if args.event_loop else 'patch.json')).read_text())
    gates=json.loads((DATA/(args.gates+'.json')).read_text()) if args.gates else None
    if args.event_loop and (not gates or len(gates)!=4 or any(row['exit'] for row in gates) or gates[-1]['command'][:2]!=['cargo','build']):raise SystemExit('event-loop freeze requires all release gates including binary build')
    for name, digest in manifest['source_files'].items():
        if sha(source/name) != digest:
            raise SystemExit('source changed after byte verification: '+name)
    for record in manifest['patches']:
        if sha(ROOT/record['path']) != record['sha256']:
            raise SystemExit('patch changed after byte verification')
    target = ROOT/'.local/bin/meridian-e18'/args.name
    target.mkdir(parents=True, exist_ok=False)
    for name in ['horizon-client', 'horizon-bots', 'goliath-store', 'LEASES']:
        shutil.copy2(prerequisite/name, target/name)
    for name in ['meridian', 'meridian-sidecar', 'e4-client']:
        shutil.copy2(source/'target/release'/name, target/name)
    if args.flat09:shutil.copy2(provenance_path,target/'canonical.json')
    record = dict(projects={'meridian': manifest}, profile='release',
        prereqs_sha256=sha(provenance_path), final_sha256=final_sha,
        binaries={name: sha(target/name) for name in ['horizon-client','horizon-bots','goliath-store','meridian','meridian-sidecar','e4-client']},
        source_equality='passed', candidate=True)
    if args.flat09:
        record['projects']['horizon']=provenance['projects']['horizon'];record['measurement_patches']=provenance['measurement_patches']
    if gates:record['gates']=dict(path=args.gates+'.json',sha256=sha(DATA/(args.gates+'.json')),commands=gates)
    (target/'candidate.json').write_text(json.dumps(record, indent=2)+'\n')
    (DATA/(args.name+'-build.json')).write_text(json.dumps(record, indent=2)+'\n')
    print(json.dumps(dict(directory=str(target.relative_to(ROOT)), binaries=record['binaries']), indent=2))


if __name__ == '__main__':
    main()
