#!/usr/bin/env python3
"""E21's isolated adapter for unchanged E10/E12 M2 fixtures."""
import argparse
import importlib.machinery
import importlib.util
from pathlib import Path
import os
import tempfile
import time
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))

ROOT = Path(__file__).resolve().parent.parent
DATA = ROOT/'docs/experiments/data/E21'


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def warm_cut(module,instance,args):
    """A same-tick mutation must bypass speculative snapshots, including after a crash."""
    tile=instance.tiles['a']
    x,z=tile.marker
    result=dict(status='running',cuts=[],position=[x,-59,z])
    def cut():
        reply=tile.ask('tile-cut '+tile.token)
        if reply.get('ok') is not True:raise RuntimeError('freshness cut refused: '+str(reply))
        result['cuts'].append(reply)
        return reply
    try:
        tile.ask(f'console setblock {x} -59 {z} minecraft:gold_block')
        cut()
        time.sleep(.2)
        tile.ask('console tick freeze')
        first=cut()
        # Let the normal idle prelude prepare this image before the next mutation.
        time.sleep(.2)
        for block in ['diamond_block','emerald_block']:
            tile.ask(f'console setblock {x} -59 {z} minecraft:{block}')
            reply=cut()
            if reply['tick']!=first['tick']:raise RuntimeError('freshness fixture crossed a simulation tick')
        tile.server.process.kill();tile.server.process.wait(timeout=10)
        tile.control[0].close();tile.control[1].close()
        tile.server.stop()
        tile.start();instance.publish_state()
        reply=tile.ask(f'console execute if block {x} -59 {z} minecraft:emerald_block run say E21_FRESH_AFTER_CRASH')
        if not any('E21_FRESH_AFTER_CRASH' in line for line in reply.get('output',[])):
            raise RuntimeError('latest same-tick block mutation was not recovered: '+str(reply))
        result.update(status='complete',restart_reply=reply)
    except BaseException as error:
        result.update(status='failed',error=repr(error));raise
    finally:module.save(args.name+'.json',result)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['proof', 'items', 'terrain', 'borders', 'live', 'teleport', 'lifecycle','warm-cut'])
    parser.add_argument('--bins', type=Path, required=True)
    parser.add_argument('--name', required=True)
    parser.add_argument('--crossings', type=int, default=14)
    parser.add_argument('--edge', type=int)
    args = parser.parse_args()
    import json
    request=ROOT/'.local/quiet-request'
    if not request.exists() or json.loads(request.read_text()).get('owner')!='E21' or not (ROOT/'.local/quiet-ack-E20').exists():
        raise SystemExit('E21 quiet window and E20 acknowledgement required')
    if (DATA/(args.name+'.json')).exists():
        raise SystemExit('result exists; use a distinct name')
    adapter = load('e18_check_e17', ROOT/'scripts/e17-m4')
    adapter.DATA = DATA
    module = adapter.cluster_module(args.bins)
    args.timeout = 30
    args.materialize = False
    args.normal = False
    args.terrain_off = False
    args.initial_off = False
    args.trace_terrain = False
    outcome = dict(action=args.action, status='running', load_start=os.getloadavg(),
        binaries={name: adapter.sha(args.bins/name) for name in ['meridian', 'horizon-client', 'goliath-store', 'e4-client']})
    began = time.monotonic()
    try:
        with tempfile.TemporaryDirectory(prefix='E18-check-', dir=ROOT/'.local/runs') as temporary:
            instance = module.Cluster.__new__(module.Cluster)
            try:
                instance.__init__(Path(temporary), module.RESOURCES,
                    args.edge or (512 if args.action in ['borders', 'teleport', 'lifecycle'] else 64))
                log=(Path(temporary)/'proxy.log').read_text().rpartition('\n')[0]
                outcome['io_pool_started']=[line for line in log.splitlines() if 'E18 fixed IO pool:' in line]
                if args.action=='warm-cut':
                    warm_cut(module,instance,args)
                elif args.action in ['proof', 'items']:
                    getattr(module, args.action)(instance, args)
                else:
                    fixtures = load('e18_check_fixtures', ROOT/'scripts'/('e18_fixtures.py' if args.action == 'lifecycle' else 'e12_fixtures.py'))
                    getattr(fixtures, args.action)(module, instance, args)
                outcome['status'] = 'complete'
            except BaseException:
                capture=load('e18_check_capture',ROOT/'scripts/e18-production-slope')
                import gzip,json
                evidence=capture.failure_evidence(Path(temporary),instance,[],[])
                path=DATA/(args.name+'-failure-native.json.gz')
                import e11_support
                path.write_bytes(gzip.compress(e11_support.sanitize(json.dumps(evidence,indent=2)).encode(),mtime=0))
                outcome['failure_evidence']=str(path.relative_to(ROOT))
                raise
            finally:
                instance.stop()
    except BaseException as error:
        outcome.update(status='failed', error=str(error))
        raise
    finally:
        outcome.update(seconds=time.monotonic()-began, load_end=os.getloadavg())
        module.save(args.name+'-outcome.json', outcome)


if __name__ == '__main__':
    main()
