#!/usr/bin/env python3
"""Keep large native logs by inode, then archive them with bounded memory."""
import argparse
import base64
import gzip
import hashlib
import json
import os
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def retain(name,run,anticheat=False):
    folder = ROOT/'.local/evidence/E24'/(name+'-native')
    folder.mkdir(parents=True,exist_ok=False)
    rows = []
    paths = [run/label/'logs/anticheat.log' for label in 'abcd'] if anticheat else sorted(run.glob('server-*.log'))
    for path in paths:
        label = path.relative_to(run).parts[0]+'-' if anticheat else ''
        target = folder/(label+path.name+'.raw')
        os.link(path,target)
        before = path.stat()
        path.rename(path.with_suffix('.raw'))
        after = target.stat()
        if (before.st_dev,before.st_ino) != (after.st_dev,after.st_ino):
            raise RuntimeError('native log inode changed')
        rows.append(dict(original=str(path.relative_to(ROOT)),retained=str(target.relative_to(ROOT)),
            device=after.st_dev,inode=after.st_ino,initial_bytes=after.st_size))
    if len(rows)!=4:
        raise RuntimeError('expected exactly four native engine logs')
    (folder/'retention.json').write_text(json.dumps(dict(kind='E24-native-log-inode-retention',files=rows),indent=2)+'\n')
    print(json.dumps(dict(files=len(rows),same_open_inodes=True,folder=str(folder.relative_to(ROOT)))))


def pack_file(source,target,original):
    digest,size = hashlib.sha256(),0
    with source.open('rb') as input_file,target.open('xb') as output_file:
        with gzip.GzipFile(fileobj=output_file,mode='wb',compresslevel=1,mtime=0) as compressed:
            compressed.write((json.dumps(dict(encoding='base64-chunks',original=original))[:-1]+',"chunks":[\n').encode())
            first = True
            while chunk := input_file.read(256*1024):
                digest.update(chunk)
                size += len(chunk)
                compressed.write(('' if first else ',').encode()+json.dumps(base64.b64encode(chunk).decode()).encode()+b'\n')
                first = False
            compressed.write(('],"bytes":'+str(size)+',"raw_sha256":'+json.dumps(digest.hexdigest())+'}\n').encode())
    checked,checked_size = hashlib.sha256(),0
    with gzip.open(target,'rt') as compressed:
        next(compressed)
        for line in compressed:
            if line.startswith(']'):
                break
            chunk = base64.b64decode(json.loads(line.lstrip(',')))
            checked.update(chunk)
            checked_size += len(chunk)
    if checked.hexdigest()!=digest.hexdigest() or checked_size!=size or source.stat().st_size!=size:
        raise RuntimeError('native log archive differs or writer is still active')
    with target.open('rb') as archived:
        archive_digest = hashlib.file_digest(archived,'sha256').hexdigest()
    return dict(archive=str(target.relative_to(ROOT)),archive_sha256=archive_digest,
        bytes=size,raw_sha256=digest.hexdigest(),roundtrip='byte-equal')


def pack(name):
    folder = ROOT/'.local/evidence/E24'/(name+'-native')
    index = json.loads((folder/'retention.json').read_text())
    for row in index['files']:
        source = ROOT/row['retained']
        target = source.with_suffix('.json.gz')
        row.update(pack_file(source,target,row['original']))
        source.unlink()
        print(json.dumps(dict(path=row['archive'],raw_bytes=row['bytes'],roundtrip='byte-equal')),flush=True)
    (folder/'archive-index.json').write_text(json.dumps(index,indent=2)+'\n')


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action',choices=['retain','pack'])
    parser.add_argument('--name',required=True)
    parser.add_argument('--run',type=Path)
    parser.add_argument('--anticheat',action='store_true')
    args = parser.parse_args()
    if args.action == 'retain':
        if not args.run or not args.run.resolve().is_relative_to(ROOT/'.local/runs'):
            raise ValueError('exact owned run path required')
        retain(args.name,args.run.resolve(),args.anticheat)
    else:
        pack(args.name)
