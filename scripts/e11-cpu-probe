#!/usr/bin/env python3
"""Calibrate Darwin CPU accounting and the equal-total-budget limiter on disposable workers."""
import argparse
import os
import resource
import shutil
import subprocess
import sys
import time
from e11_support import CpuBudget, DATA, save, usage


def probe(workers, cores, seconds, qos=False):
    children=[]
    limiter=None
    try:
        for _ in range(workers):
            command=[sys.executable,'-c','while True: pass']
            if qos: command=[shutil.which('taskpolicy') or '/usr/sbin/taskpolicy','-b']+command
            children.append(subprocess.Popen(command,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL))
        pids=[p.pid for p in children]
        if cores: limiter=CpuBudget(pids,cores).start()
        start=[usage(pid) for pid in pids]
        at=time.monotonic()
        time.sleep(seconds)
        wall=time.monotonic()-at
        end=[usage(pid) for pid in pids]
        cpu=sum(b['cpu_s']-a['cpu_s'] for a,b in zip(start,end))
        return {'workers':workers,'budget_cores':cores,'taskpolicy_background':qos,'seconds':wall,
            'cpu_s':cpu,'cpu_cores':cpu/wall,'load':os.getloadavg(),
            'limiter':limiter.report() if limiter else None}
    finally:
        if limiter: limiter.stop()
        for p in children:
            p.terminate()
        for p in children: p.wait()


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--seconds',type=float,default=5)
    args=parser.parse_args()
    pid=os.getpid()
    before=usage(pid)['cpu_s']
    r=resource.getrusage(resource.RUSAGE_SELF)
    sum(i*i for i in range(2_000_000))
    after=usage(pid)['cpu_s']
    q=resource.getrusage(resource.RUSAGE_SELF)
    calibration={'proc_cpu_s':after-before,'rusage_cpu_s':q.ru_utime+q.ru_stime-r.ru_utime-r.ru_stime}
    rows=[probe(1,None,args.seconds),probe(4,None,args.seconds,True),
        probe(1,1,args.seconds),probe(4,1,args.seconds)]
    output={'accounting':calibration,'runs':rows,'passed':
        abs(calibration['proc_cpu_s']-calibration['rusage_cpu_s'])<.002 and all(
            .90<r['cpu_cores']<1.05 for r in rows if r['budget_cores'])}
    save(DATA/'cpu-probe.json',output)
    print(output)
    if not output['passed']: raise SystemExit(1)


if __name__=='__main__': main()
