#!/usr/bin/env python3
"""Retain exactly the E12 executables named in READY, so a rebuild cannot mix a run."""

import hashlib
import json
from pathlib import Path
import re
import shutil

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / '.local/bin/goliath-e12'


def main():
    ready = (SOURCE / 'READY').read_text()
    records = dict(re.findall(r'\.local/bin/goliath-e12/(\S+) sha256=([0-9a-f]{64})', ready))
    required = {'horizon-client', 'meridian', 'meridian-sidecar', 'e4-client', 'goliath-store'}
    if set(records) != required:
        raise RuntimeError('READY does not identify every required executable')
    identity = hashlib.sha256(json.dumps(records, sort_keys=True).encode()).hexdigest()[:12]
    target = ROOT / '.local/bin/horizon-e14-client' / ('cluster-e12-' + identity)
    target.mkdir(exist_ok=True)
    for name, expected in records.items():
        output = target / name
        if not output.exists():
            shutil.copy2(SOURCE / name, output)
        if hashlib.sha256(output.read_bytes()).hexdigest() != expected:
            raise RuntimeError('READY and copied executable differ: ' + name)
    if ready != (SOURCE / 'READY').read_text():
        raise RuntimeError('READY changed during snapshot; do not run this snapshot')
    (target / 'READY').write_text(ready)
    (target / 'manifest.json').write_text(json.dumps(records, indent=2) + '\n')
    print(target.relative_to(ROOT))


if __name__ == '__main__':
    main()
