#!/usr/bin/env python3
"""Retain E12's final executable and lease contract, or a legacy READY publication."""

from pathlib import Path

from e14_snapshot_support import create_snapshot

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / '.local/bin/goliath-e12'


def main():
    target = create_snapshot(SOURCE, ROOT / '.local/bin/horizon-e14-client', ROOT / 'scripts/goliath-cluster')
    print(target.relative_to(ROOT))


if __name__ == '__main__':
    main()
