#!/usr/bin/env python3
"""Execute every pre-registered row of one E23 plan, retaining failures and stops."""
import argparse
import json
from pathlib import Path
import subprocess
import sys
import time

from e23_support import BINS, DATA, ROOT, frozen, name_check, save, sha, timestamp


def rows(plan,prefix):
    if plan=='identical':
        return [(f'{prefix}-t{tiles}-r{repeat}',
            ['scripts/e23-cell','identical','--tiles',str(tiles)]) for tiles in [1,2,4] for repeat in [1,2]]
    if plan=='physics':
        return [(f'{prefix}-{setting}-r1',['scripts/e23-physics','--snapshot',str(BINS),'--variant','e12','--suite']
            + (['--particles'] if setting=='on' else [])) for setting in ['off','on']]
    if plan=='latency':
        return [(f'{prefix}-{mode}-r1',['scripts/e23-cell',mode]) for mode in ['control','latency']]
    if plan=='profile':
        return [(f'{prefix}-r1',['scripts/e23-cell','profile'])]
    if plan=='soak':
        return [(f'{prefix}-r1',['scripts/e23-cell','soak'])]
    raise ValueError('unknown plan')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('plan',choices=['physics','identical','latency','profile','soak'])
    parser.add_argument('--name',required=True)
    parser.add_argument('--host-released',action='store_true',required=True)
    args = parser.parse_args()
    name_check(args.name)
    target = DATA/(args.name+'-plan.json')
    if target.exists():
        raise RuntimeError('plan ledger already exists; never silently resume or replace rows')
    fixed = []
    for name,fixture in rows(args.plan,args.name):
        command = [sys.executable,'-B','scripts/e23-window','--name',name,'--host-released']
        if args.plan=='soak':
            command.append('--soak')
        command += ['--',sys.executable,'-B',*fixture,'--name',name]
        fixed.append(dict(name=name,command=command,status='not-run'))
    result = dict(kind='E23-fixed-plan',plan=args.plan,status='registered',created=timestamp(),
        frozen=frozen(),rows=fixed,all_attempts_retained=True,
        harnesses={path.name:sha(path) for path in sorted((ROOT/'scripts').glob('e23*')) if path.is_file()})
    save(target,result)
    result['status'] = 'running'
    for row in result['rows']:
        row.update(status='running',started=timestamp())
        save(target,result)
        began = time.monotonic()
        print('E23 '+args.plan+': '+row['name'],flush=True)
        completed = subprocess.run(row['command'],cwd=ROOT)
        row.update(exit=completed.returncode,seconds=time.monotonic()-began,
            status='complete' if completed.returncode==0 else 'failed')
        availability = DATA/(row['name']+'-availability.json')
        capture = json.loads(availability.read_text()) if availability.exists() else None
        if capture:
            row['availability'] = dict(path=str(availability.relative_to(ROOT)),complete=capture['complete'],lease_expiry_observed=capture['lease_expiry_observed'])
        save(target,result)
        if capture and capture['lease_expiry_observed']:
            result.update(status='stopped-availability-event',stopped_after=row['name'])
            for remaining in result['rows']:
                if remaining['status']=='not-run':
                    remaining['reason']='plan stopped after lease expiry'
            save(target,result)
            raise SystemExit('lease expiry observed; plan stopped with every remaining row retained')
        if capture and not capture['complete']:
            result.update(status='stopped-incomplete-telemetry',stopped_after=row['name'])
            save(target,result)
            raise SystemExit('availability capture incomplete; later rows retained but not started')
    result.update(status='complete',finished=timestamp())
    save(target,result)
    raise SystemExit(0 if all(row['exit']==0 for row in fixed) else 1)


if __name__=='__main__':
    main()
