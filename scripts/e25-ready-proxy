#!/usr/bin/env python3
"""Verify a frozen scheduler proxy against reactor-1 plus its two recorded deltas."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

from e14_snapshot_support import validate_snapshot,sha256

ROOT=Path(__file__).resolve().parent.parent


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name',required=True)
    parser.add_argument('--measurement',type=Path,required=True)
    parser.add_argument('--proxy',type=Path,required=True)
    args=parser.parse_args()
    if not args.name.startswith(('e25-','repro-')) or not all(c.isalnum() or c in '-_' for c in args.name):raise ValueError('fresh simple name required')
    target=ROOT/'.local/bin/meridian-e25'/args.name
    proof=ROOT/'docs/experiments/data/E25'/(args.name+'-provenance.json')
    if target.exists() or proof.exists():raise RuntimeError('candidate name exists')
    measurement,proxy=args.measurement.resolve(),args.proxy.resolve()
    before=validate_snapshot(measurement)
    validate_snapshot(proxy)
    base=json.loads((ROOT/'.local/bin/meridian-e18/reactor-1/candidate.json').read_text())['projects']['meridian']
    candidate=json.loads((proxy/'candidate.json').read_text())
    project=candidate['projects']['meridian']
    extras=['patches/meridian-07-terrain-scheduler.patch','patches/meridian-07-scheduler-stop-race.patch']
    if project['pin']!=base['pin'] or project['patches'][:len(base['patches'])]!=base['patches'] or [row['path'] for row in project['patches'][len(base['patches']):]]!=extras:
        raise RuntimeError('candidate is not reactor-1 plus exactly the two scheduler patches')
    gates=candidate['gates']
    if sha256(ROOT/gates['path'])!=gates['sha256'] or any(row['exit'] for row in gates['commands']):raise RuntimeError('frozen release gate proof differs')
    with tempfile.TemporaryDirectory(prefix='e25-ready-proxy-',dir=ROOT/'.local/evidence/E25') as folder:
        index=Path(folder)/'index'
        shutil.copy2(ROOT/'.local/evidence/E25/e25-preparation-r1-frozen/index',index)
        env=dict(os.environ,GIT_INDEX_FILE=str(index),GIT_OPTIONAL_LOCKS='0')
        def git(*a):return subprocess.check_output(['git','--git-dir',str(ROOT/'.local/src/meridian/.git'),*a],cwd=ROOT,env=env)
        for row in project['patches'][len(base['patches']):]:
            if sha256(ROOT/row['path'])!=row['sha256']:raise RuntimeError('scheduler patch changed')
            git('apply','--cached','--check',str(ROOT/row['path']))
            git('apply','--cached',str(ROOT/row['path']))
        for name,digest in project['source_files'].items():
            if hashlib.sha256(git('show',':'+name)).hexdigest()!=digest:raise RuntimeError('frozen source differs: '+name)
    actual=sha256(proxy/'meridian')
    if actual!=candidate['binaries']['meridian']:raise RuntimeError('proxy executable differs')
    shutil.copytree(measurement,target)
    shutil.copy2(proxy/'meridian',target/'meridian')
    binaries={name:sha256(target/name) for name in [*before['binaries'],'horizon-bots']}
    for name in ['FINAL.json','canonical.json','candidate.json']:
        value=json.loads((target/name).read_text())
        value['binaries']=binaries if name!='FINAL.json' else {binary:dict(path=str((target/binary).relative_to(ROOT)),sha256=binaries[binary]) for binary in before['binaries']}
        value['e25_proxy_candidate']=dict(path=str(proxy.relative_to(ROOT)),candidate_sha256=sha256(proxy/'candidate.json'))
        if name=='candidate.json':value['projects']['meridian']=project
        (target/name).write_text(json.dumps(value,indent=2)+'\n')
    (target/'manifest.json').write_text(json.dumps({name:binaries[name] for name in before['binaries']},indent=2)+'\n')
    validate_snapshot(target)
    result=dict(kind='E25-ready-scheduler-proxy-proof',pin=base['pin'],base_patches=len(base['patches']),
        additional_patches=project['patches'][len(base['patches']):],source_files_checked=len(project['source_files']),
        source_equality='passed',release_gate_sha256=gates['sha256'],proxy_sha256=actual,
        frozen_candidate_sha256=sha256(proxy/'candidate.json'),measurement_directory=str(target.relative_to(ROOT)),
        only_measurement_binary_changed='meridian',diagnostic_only=True)
    proof.write_text(json.dumps(result,indent=2)+'\n')
    print(json.dumps(dict(path=str(proof.relative_to(ROOT)),sha256=sha256(proof),proxy_sha256=actual,source_files=len(project['source_files']))),flush=True)


if __name__=='__main__':main()
