#!/usr/bin/env python3
"""Remove only E18's inspected disposable scratch, retaining its small diagnostic trace."""
import gzip
from pathlib import Path
import re
import shutil
import e11_support as support

ROOT=Path(__file__).resolve().parent.parent
RUNS=ROOT/'.local/runs'
DATA=ROOT/'docs/experiments/data/E18'


def main():
    sample=RUNS/'E18-hung-sidecar-sample.txt'
    if sample.exists():
        if sample.is_symlink():raise SystemExit('unexpected sample symlink')
        raw=support.sanitize(sample.read_text()).encode()
        raw=re.sub(rb'/Users/[^/\s<>\x00]+|/home/[^/\s<>\x00]+',b'$USER_HOME',raw)
        target=DATA/'sidecar-hung-sample.txt.gz'
        if target.exists() and gzip.decompress(target.read_bytes())!=raw:raise SystemExit('retained sample differs')
        target.write_bytes(gzip.compress(raw,mtime=0));sample.unlink()
        print('Archived and removed E18 hung-sidecar scratch trace; retained compressed evidence.')
    scratch=RUNS/'E18-flat-light-src-4uiDQX'
    if scratch.exists():
        expected={'crates/horizon-client/src/flatgen.rs','crates/horizon-client/tests/flat_light.rs','crates/horizon-client-lib/Cargo.toml'}
        if scratch.is_symlink() or any(path.is_symlink() for path in scratch.rglob('*')):raise SystemExit('unexpected scratch symlink')
        if {str(path.relative_to(scratch)) for path in scratch.rglob('*') if path.is_file()}!=expected:raise SystemExit('scratch contents changed')
        shutil.rmtree(scratch)
        print('Removed three generated flat-light scratch source files; patch09 and source hashes retain their reconstruction.')


if __name__=='__main__':main()
