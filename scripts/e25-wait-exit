#!/usr/bin/env python3
"""Block on macOS process-exit events, without a process polling loop."""
import argparse
import errno
import select


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('pids',type=int,nargs='+')
    args = parser.parse_args()
    queue = select.kqueue()
    try:
        remaining = set(args.pids)
        for pid in sorted(remaining.copy()):
            event = select.kevent(pid,filter=select.KQ_FILTER_PROC,
                flags=select.KQ_EV_ADD | select.KQ_EV_ONESHOT,fflags=select.KQ_NOTE_EXIT)
            try:
                queue.control([event],0,0)
            except OSError as error:
                if error.errno != errno.ESRCH:
                    raise
                remaining.remove(pid)
                print(f'E25_PROCESS_ALREADY_EXITED {pid}',flush=True)
        while remaining:
            # This blocks in the kernel until a registered process exits.
            for event in queue.control(None,len(remaining),None):
                if event.ident in remaining:
                    remaining.remove(event.ident)
                    print(f'E25_PROCESS_EXIT {event.ident}',flush=True)
    finally:
        queue.close()


if __name__ == '__main__':
    main()
