#!/usr/bin/env python3
"""Build one lite variant and its clock probe under one serial build marker."""
import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import time
import e11_support as support
from e14_snapshot_support import validate_snapshot

ROOT=support.ROOT
SOURCE=ROOT/'.local/src/horizon-tiles'
LOCAL=ROOT/'.local/evidence/E26'
DATA=ROOT/'docs/experiments/data/E26'


def sha(path):return hashlib.sha256(path.read_bytes()).hexdigest()


def verify(path):
    proof=json.loads(path.read_text())
    if proof['source_equality']!='passed':raise RuntimeError('source proof required')
    for name,expected in proof['files'].items():
        if name==proof['build_overlay']['path']:expected=proof['build_overlay']['build_sha256']
        if sha(SOURCE/name)!=expected:raise RuntimeError('source differs: '+name)
    return proof


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name',required=True)
    parser.add_argument('--proof',default='e26-lite-source.json')
    parser.add_argument('--warm-tests',action='store_true')
    parser.add_argument('--unlocked-queue',action='store_true',help='host-window still gates the build; caller guarantees no other Cargo pipeline in this workspace')
    args=parser.parse_args()
    if not re.fullmatch(r'e26-[a-z0-9-]+',args.name) or '/' in args.proof:raise RuntimeError('scoped fresh names required')
    target=DATA/(args.name+'-build.json')
    frozen=ROOT/'.local/bin/horizon-e26'/args.name
    if target.exists() or frozen.exists():raise RuntimeError('build already exists')
    proof_path=DATA/args.proof
    proof=verify(proof_path)
    common=['cargo','test','--locked','--release','--no-default-features','-p','horizon-client','--lib']
    commands=[('fmt',['cargo','fmt','--all','--check']),
        ('lite-tests',common+['game::dedicated::e26_lite::tests::'])]
    if args.warm_tests:commands.append(('warm-tests',common+['game::dedicated::tile_cut::tests::']))
    commands += [
        ('clippy',['cargo','clippy','--locked','--release','--no-default-features','-p','horizon-client','--lib','--','-D','warnings']),
        ('clock-clippy',['cargo','clippy','--locked','--release','--no-default-features','-p','horizon-client-render','--example','e26_clock_probe','--','-D','warnings']),
        ('release',['cargo','build','--locked','--release','--no-default-features','-p','horizon-client','-p','horizon-client-render','--bin','horizon-client','--example','e26_clock_probe'])]
    env={k:v for k,v in os.environ.items() if k not in {'CI','CARGO_TARGET_DIR','HORIZON_E26_PLANTED_COST'} and not k.startswith('CARGO_PROFILE_')}
    env.update(CARGO_INCREMENTAL='0',CARGO_PROFILE_RELEASE_LTO='thin',CARGO_PROFILE_RELEASE_CODEGEN_UNITS='1',CARGO_BUILD_JOBS='6')
    groups=[]
    for label,command in commands:
        groups.append("{ printf '%s\\n' "+shlex.quote('E26_PHASE_BEGIN '+label)+' && '+shlex.join(command)+
            " && printf '%s\\n' "+shlex.quote('E26_PHASE_END '+label)+'; }')
    chain=' && '.join(groups)
    result=dict(kind='E26-lite-native-release',status='running',profile='release',incremental=False,lto='thin',codegen_units=1,
        source_proof=dict(path=str(proof_path.relative_to(ROOT)),sha256=sha(proof_path)),commands=[],one_build_marker=True)
    began=time.monotonic()
    try:
        log=LOCAL/(args.name+'-serial.log')
        print('E26_LITE_BATCH queued',flush=True)
        with log.open('x') as stream:
            done=subprocess.run([str(ROOT/'.local/bin/host-window'),'build','E26','--','bash','-c',chain],
                cwd=SOURCE,env=env,stdout=stream,stderr=subprocess.STDOUT)
        text=log.read_text(errors='replace')
        for label,command in commands:
            marker='E26_PHASE_BEGIN '+label+'\n'
            if marker not in text:break
            part=text.split(marker,1)[1].split('E26_PHASE_BEGIN ',1)[0]
            passed='E26_PHASE_END '+label in part
            row=dict(label=label,command=command,exit=0 if passed else done.returncode,test_results=re.findall(r'test result: .*',part))
            result['commands'].append(row);print(json.dumps(row),flush=True)
        if done.returncode:
            print('\n'.join(text.splitlines()[-100:]),flush=True)
            raise RuntimeError('lite release pipeline failed')
        for label in ['lite-tests']+(['warm-tests'] if args.warm_tests else []):
            row=next(row for row in result['commands'] if row['label']==label)
            if not any('3 passed;' in value for value in row['test_results']):raise RuntimeError('unit gate did not execute: '+label)
        verify(proof_path)
        source=ROOT/'.local/bin/meridian-e18/reactor-1'
        shutil.copytree(source,frozen)
        shutil.copy2(SOURCE/'target/release/horizon-client',frozen/'horizon-client')
        shutil.copy2(SOURCE/'target/release/examples/e26_clock_probe',frozen/'e26_clock_probe')
        engine=sha(frozen/'horizon-client')
        for name in ['candidate.json','canonical.json']:
            meta=json.loads((frozen/name).read_text());meta['binaries']['horizon-client']=engine
            meta['kind']='E26-lite-running-cpu-diagnostic';meta['lite_source_proof_sha256']=sha(proof_path)
            support.save(frozen/name,meta)
        meta=json.loads((frozen/'manifest.json').read_text());meta['horizon-client']=engine;support.save(frozen/'manifest.json',meta)
        meta=json.loads((frozen/'FINAL.json').read_text());meta['binaries']['horizon-client']['sha256']=engine
        meta['binaries']['horizon-client']['path']=str((frozen/'horizon-client').relative_to(ROOT));support.save(frozen/'FINAL.json',meta)
        shutil.copy2(proof_path,frozen/'source-proof.json')
        validate_snapshot(frozen)
        result.update(status='complete',directory=str(frozen.relative_to(ROOT)),
            binaries={name:sha(frozen/name) for name in ['horizon-client','meridian','goliath-store','meridian-sidecar','horizon-bots','e4-client','e26_clock_probe']})
        support.save(frozen/'build.json',result)
    except BaseException as error:
        result.update(status='failed',error=str(error));raise
    finally:
        result['seconds_including_queue']=time.monotonic()-began;support.save(target,result)


if __name__=='__main__':
    if '--unlocked-queue' in sys.argv:
        main()
    else:
        with (LOCAL/'operation.lock').open('a') as operation:
            fcntl.flock(operation,fcntl.LOCK_EX)
            main()
