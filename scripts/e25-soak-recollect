#!/usr/bin/env python3
"""Judge a collected soak again from its retained evidence after a reader fault. Runs nothing.

The first collection record is kept beside the new one. Use only when the
run itself finished and the fault was in reading what it left behind.
"""
import argparse
import json
from pathlib import Path

import e25_soak_harness as harness


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--name',required=True)
    parser.add_argument('--data-dir',type=Path,required=True)
    parser.add_argument('--reason',required=True,help='what went wrong in the first collection')
    args = parser.parse_args()
    harness.configure(args.data_dir)
    owner = harness.ROOT / '.local/host/quiet/owner'
    if owner.exists():
        raise RuntimeError('release the measurement window before reading a soak back')
    target = harness.EVIDENCE / (args.name+'-collection.json')
    kept = harness.EVIDENCE / (args.name+'-collection-first.json')
    first = harness.read(target)
    if kept.exists() or first.get('recollected'):
        raise RuntimeError('this soak was already recollected')
    if first['status'] != 'failed' or first['error'] or first['native_summary']:
        raise RuntimeError('only a collection that failed to read its native summary is recollected')
    kept.write_bytes(target.read_bytes())
    record,failed = harness.collection(args.name,None,first['executed'],
        dict(reason=args.reason,first_record=harness.digest(kept),ran_nothing=True))
    target.write_text(json.dumps(record,indent=2)+'\n')
    print(json.dumps({key:record[key] for key in ['status','error','native_error','binaries_unchanged','authority_trace_complete','recollected']},indent=2),flush=True)
    if failed:
        raise SystemExit(1)


if __name__ == '__main__':
    main()
