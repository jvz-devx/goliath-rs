#!/usr/bin/env python3
"""Own one reversible FINAL-09 plus H13 measurement-source selection."""
import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import tarfile

ROOT = Path(__file__).resolve().parent.parent
SOURCE = ROOT / '.local/src/horizon'
EVIDENCE = ROOT / '.local/evidence/E25/horizon-source-backup'
BASE = ROOT / '.local/evidence/E25/horizon-h13-base'
PATCH = ROOT / 'patches/horizon-13-lease-raw-clock.patch'
PATCH_SHA = 'a37d2cf285243c8ef624c09502169f9b673c5e61187f1aaac61d3e39b4c9daae'
FIXTURE = ROOT / '.local/bin/goliath-e24/lease-fixed-r1'
ADDITIONS = {
    'crates/horizon-client/src/game/dedicated/cluster/lease/clock.rs',
    'crates/horizon-client/src/game/dedicated/cluster/lease/trace.rs',
    'crates/horizon-client/src/lan/latency_trace.rs',
    'crates/horizon-bots/src/latency_trace.rs',
}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def git(*args, **kwargs):
    environment = dict(os.environ, **kwargs.pop('env', {}))
    environment['GIT_OPTIONAL_LOCKS'] = '0'
    return subprocess.check_output(['git', *map(str, args)], cwd=SOURCE, env=environment, **kwargs)


def select():
    loader = importlib.machinery.SourceFileLoader('e25_horizon_backup', str(ROOT / 'scripts/e24-source'))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    helper = importlib.util.module_from_spec(spec)
    loader.exec_module(helper)
    helper.EVIDENCE, helper.git = EVIDENCE, git
    helper.select()
    if sha(PATCH) != PATCH_SHA:
        raise RuntimeError('H13 differs from the gated patch')
    git('apply', '--check', PATCH)
    git('apply', PATCH)
    source_record = json.loads((FIXTURE / 'FINAL.json').read_text())['e24_source']
    for name, digest in source_record['files'].items():
        if sha(SOURCE / name) != digest:
            raise RuntimeError('selected H13 input differs from gates: ' + name)
    BASE.mkdir(exist_ok=False)
    index = BASE / 'index'
    environment = dict(GIT_INDEX_FILE=str(index))
    original = EVIDENCE / 'final09-index'
    shutil.copy2(original, index)
    git('apply', '--cached', '--check', PATCH, env=environment)
    git('apply', '--cached', PATCH, env=environment)
    names = git('ls-files', '-c', '-o', '--exclude-standard', '-z').decode().split('\0')
    files = {name: sha(SOURCE / name) for name in names if name and (SOURCE / name).is_file()}
    (BASE / 'identity.json').write_text(json.dumps(dict(patch_sha256=PATCH_SHA, files=files), indent=2) + '\n')
    print(json.dumps(dict(selected='FINAL-09 plus H13 only', source_files=len(files), index_unchanged=sha(SOURCE / '.git/index') == json.loads((EVIDENCE / 'identity.json').read_text())['index_sha256'])), flush=True)


def restore():
    record = json.loads((EVIDENCE / 'identity.json').read_text())
    if sha(EVIDENCE / 'source.tar.gz') != record['source_archive_sha256']:
        raise RuntimeError('source backup archive changed')
    names = set(git('ls-files', '-c', '-o', '--exclude-standard', '-z').decode().split('\0')) - {''}
    added = names - record['all_files'].keys()
    if added - ADDITIONS:
        raise RuntimeError('unknown additions prevent restoration: ' + str(sorted(added - ADDITIONS)))
    index = SOURCE / '.git/index'
    before = index.read_bytes()
    if before != (EVIDENCE / 'original-index').read_bytes():
        for args in [('ls-files','--stage','-z'),('ls-files','-v','-z'),('ls-files','--resolve-undo','-z')]:
            if git(*args) != git(*args,env={'GIT_INDEX_FILE':str(EVIDENCE/'original-index')}):
                raise RuntimeError('logical index entries or flags changed; refuse restoration')
        cached = EVIDENCE / ('index-cache-' + hashlib.sha256(before).hexdigest())
        if not cached.exists():
            cached.write_bytes(before)
    # Added files remain recoverable from the retained measurement patch or selection.
    for name in added:
        (SOURCE / name).unlink()
    with tarfile.open(EVIDENCE / 'source.tar.gz') as archive:
        archive.extractall(SOURCE, filter='data')
    for name, expected in record['all_files'].items():
        if sha(SOURCE / name) != expected:
            raise RuntimeError('restored source bytes differ: ' + name)
    if git('status', '--porcelain=v1', '-z') != (EVIDENCE / 'status.bin').read_bytes():
        raise RuntimeError('restored dirty status differs')
    shutil.copy2(EVIDENCE / 'original-index', index)
    if sha(index) != record['index_sha256']:
        raise RuntimeError('original index bytes were not restored')
    print('Original Horizon files, dirty status and exact Git index restored.', flush=True)


def resume():
    record = json.loads((EVIDENCE / 'identity.json').read_text())
    for name, expected in record['all_files'].items():
        if sha(SOURCE / name) != expected:
            raise RuntimeError('source differs before resume: ' + name)
    if git('status','--porcelain=v1','-z') != (EVIDENCE/'status.bin').read_bytes():
        raise RuntimeError('dirty status differs before resume')
    for name in ['horizon-11-shared-observer.patch','horizon-10-warm-tick.patch']:
        git('apply','--reverse','--check',ROOT/'patches'/name)
        git('apply','--reverse',ROOT/'patches'/name)
    git('apply','--check',PATCH)
    git('apply',PATCH)
    identity = json.loads((BASE/'identity.json').read_text())
    for name, expected in identity['files'].items():
        if sha(SOURCE/name) != expected:
            raise RuntimeError('resumed H13 base differs: ' + name)
    print('Resumed the byte-verified FINAL-09 plus H13 source.',flush=True)


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['select', 'restore', 'resume'])
    parser.add_argument('--round')
    parser.add_argument('--fixture',type=Path)
    options = parser.parse_args()
    if options.round:
        if not options.round or not all(c.isalnum() or c=='-' for c in options.round):raise ValueError('simple round required')
        EVIDENCE=ROOT/'.local/evidence/E25'/('horizon-'+options.round+'-source-backup')
        BASE=ROOT/'.local/evidence/E25'/('horizon-'+options.round+'-base')
    if options.fixture:
        FIXTURE=options.fixture.resolve()
        record=json.loads((FIXTURE/'FINAL.json').read_text())['e24_source']
        PATCH=ROOT/record['patch'];PATCH_SHA=record['patch_sha256']
    {'select':select,'restore':restore,'resume':resume}[options.action]()
