diff --git a/crates/horizon-client/src/game/dedicated/cluster/lease/trace.rs b/crates/horizon-client/src/game/dedicated/cluster/lease/trace.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/dedicated/cluster/lease/trace.rs
@@ -0,0 +1,70 @@
+//! Optional E24 diagnostic records. Clocks here never grant authority.
+use serde_json::{Value, json};
+use std::{
+    fs::File,
+    io::Write,
+    sync::{Mutex, OnceLock},
+    time::{Instant, SystemTime, UNIX_EPOCH},
+};
+
+struct Trace {
+    origin: Instant,
+    file: Mutex<File>,
+}
+static TRACE: OnceLock<Trace> = OnceLock::new();
+
+pub(super) fn initialize(tile: usize) -> std::io::Result<Option<File>> {
+    let Some(directory) = std::env::var_os("GOLIATH_LEASE_TRACE_DIR") else {
+        return Ok(None);
+    };
+    let directory = std::path::PathBuf::from(directory);
+    std::fs::create_dir_all(&directory)?;
+    let prefix = format!("tile-{tile}-{}", std::process::id());
+    let file = File::create_new(directory.join(format!("{prefix}-lease.jsonl")))?;
+    let client = File::create_new(directory.join(format!("{prefix}-client.csv")))?;
+    TRACE
+        .set(Trace {
+            origin: Instant::now(),
+            file: Mutex::new(file),
+        })
+        .map_err(|_| std::io::Error::other("lease trace already initialized"))?;
+    record(
+        "trace-start",
+        json!({"tile":tile,"pid":std::process::id(),"client_handle":"claim-and-renew-only","payloads_recorded":false}),
+    );
+    Ok(Some(client))
+}
+
+pub(super) fn at(now: Instant) -> Option<i128> {
+    TRACE.get().map(|trace| {
+        now.checked_duration_since(trace.origin).map_or_else(
+            || -(trace.origin.duration_since(now).as_nanos() as i128),
+            |duration| duration.as_nanos() as i128,
+        )
+    })
+}
+
+pub(super) fn record(event: &str, data: Value) {
+    let Some(trace) = TRACE.get() else { return };
+    let now = Instant::now();
+    let wall_ns = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |d| d.as_nanos());
+    let row = json!({"event":event,"wall_ns":wall_ns,"at_ns":at(now),"data":data});
+    if let Ok(mut file) = trace.file.lock() {
+        if let Err(error) = writeln!(file, "{row}") {
+            eprintln!("lease diagnostic trace failed: {error}");
+        }
+    }
+}
+
+pub(super) fn clock(reason: &str, previous: &super::Clock, next: &super::Clock) {
+    record(
+        "clock-anomaly",
+        json!({"reason":reason,
+        "previous_before_ns":at(previous.before),"previous_after_ns":at(previous.after),
+        "previous_continuous_ns":previous.continuous.as_nanos(),
+        "next_before_ns":at(next.before),"next_after_ns":at(next.after),
+        "next_continuous_ns":next.continuous.as_nanos()}),
+    );
+}
