--- /dev/null
+++ b/crates/horizon-core/src/tick_timers.rs
@@ -0,0 +1,282 @@
+//! Diagnostic-only exclusive main-thread costs, with explicit pacing sleep exclusion.
+use std::{cell::RefCell, collections::VecDeque, time::Instant};
+
+pub const LABELS: [&str; 16] = [
+    "ownership",
+    "lease",
+    "cut_state",
+    "warm_generation",
+    "control_transfer",
+    "observer_control",
+    "status",
+    "digest_samples",
+    "upstream_pacing",
+    "upstream_work",
+    "diagnostic",
+    "reader_tracking",
+    "reader_chunks",
+    "mixed_upper_bound",
+    "cut_enqueue",
+    "planted_cost",
+];
+pub const UPSTREAM: usize = 9;
+const LIMIT: usize = 8192;
+
+#[derive(Debug)]
+pub struct Row {
+    pub sequence: u64,
+    pub tick: i64,
+    pub busy_ns: u64,
+    pub ns: [u64; 16],
+    pub calls: [u64; 16],
+}
+
+struct State {
+    epoch: Instant,
+    enabled: bool,
+    running: bool,
+    current: usize,
+    last: u64,
+    ns: [u64; 16],
+    calls: [u64; 16],
+    rows: VecDeque<Row>,
+    sequence: u64,
+    dropped: u64,
+    readers: Vec<i32>,
+}
+
+impl Default for State {
+    fn default() -> Self {
+        Self {
+            epoch: Instant::now(),
+            enabled: false,
+            running: false,
+            current: UPSTREAM,
+            last: 0,
+            ns: [0; 16],
+            calls: [0; 16],
+            rows: VecDeque::new(),
+            sequence: 0,
+            dropped: 0,
+            readers: Vec::new(),
+        }
+    }
+}
+
+impl State {
+    fn now(&self) -> u64 {
+        self.epoch.elapsed().as_nanos() as u64
+    }
+    fn charge(&mut self, now: u64) {
+        if self.running {
+            self.ns[self.current] += now.saturating_sub(self.last);
+        }
+        self.last = now;
+    }
+    fn enter(&mut self, site: usize, now: u64) -> usize {
+        self.charge(now);
+        let previous = self.current;
+        self.current = site;
+        self.calls[site] += 1;
+        previous
+    }
+    fn finish(&mut self, tick: i64, now: u64) {
+        self.charge(now);
+        self.sequence += 1;
+        let row = Row {
+            sequence: self.sequence,
+            tick,
+            busy_ns: self.ns.iter().sum(),
+            ns: std::mem::take(&mut self.ns),
+            calls: std::mem::take(&mut self.calls),
+        };
+        if self.rows.len() == LIMIT {
+            self.rows.pop_front();
+            self.dropped += 1;
+        }
+        self.rows.push_back(row);
+    }
+}
+
+thread_local! { static STATE: RefCell<State> = RefCell::new(State::default()); }
+
+pub struct Scope(Option<usize>);
+impl Drop for Scope {
+    fn drop(&mut self) {
+        if let Some(previous) = self.0 {
+            STATE.with_borrow_mut(|s| {
+                if s.enabled {
+                    s.charge(s.now());
+                    s.current = previous;
+                }
+            });
+        }
+    }
+}
+
+#[inline]
+pub fn scope(site: usize) -> Scope {
+    STATE.with_borrow_mut(|s| {
+        if !s.enabled {
+            return Scope(None);
+        }
+        let now = s.now();
+        Scope(Some(s.enter(site, now)))
+    })
+}
+
+#[inline]
+pub fn scope_if(site: usize, condition: bool) -> Scope {
+    if condition { scope(site) } else { Scope(None) }
+}
+
+pub fn configure(enabled: bool) {
+    STATE.with_borrow_mut(|s| {
+        s.enabled = enabled;
+        s.running = enabled;
+        s.current = UPSTREAM;
+        s.last = s.now();
+        s.ns = [0; 16];
+        s.calls = [0; 16];
+        s.sequence = 0;
+        s.dropped = 0;
+        s.rows.clear();
+    });
+}
+
+pub fn pause() {
+    STATE.with_borrow_mut(|s| {
+        if s.enabled {
+            s.charge(s.now());
+            s.running = false;
+        }
+    });
+}
+
+pub fn resume() {
+    STATE.with_borrow_mut(|s| {
+        if s.enabled {
+            s.last = s.now();
+            s.running = true;
+        }
+    });
+}
+
+pub fn finish_tick(tick: i64) {
+    STATE.with_borrow_mut(|s| {
+        if s.enabled {
+            s.finish(tick, s.now());
+        }
+    });
+}
+
+pub fn drain() -> (Vec<Row>, u64) {
+    STATE.with_borrow_mut(|s| (s.rows.drain(..).collect(), std::mem::take(&mut s.dropped)))
+}
+
+pub fn readers(ids: impl Iterator<Item = i32>) {
+    STATE.with_borrow_mut(|s| {
+        if !s.enabled {
+            return;
+        }
+        s.readers.clear();
+        s.readers.extend(ids);
+        s.readers.sort_unstable();
+    });
+}
+
+#[inline]
+pub fn reader(id: i32) -> bool {
+    STATE.with_borrow(|s| s.enabled && s.readers.binary_search(&id).is_ok())
+}
+
+/// Compiled only into the separately named positive-control executable.
+pub fn planted_cost() {
+    if option_env!("HORIZON_E26_PLANTED_COST") == Some("1") {
+        let _cost = scope(15);
+        let began = Instant::now();
+        while began.elapsed().as_micros() < 200 {
+            std::hint::spin_loop();
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn nested_costs_are_exclusive_and_sum_to_busy_time() {
+        let mut s = State {
+            enabled: true,
+            running: true,
+            ..State::default()
+        };
+        let outer = s.enter(0, 10);
+        let inner = s.enter(1, 30);
+        s.charge(80);
+        s.current = inner;
+        s.charge(100);
+        s.current = outer;
+        s.finish(42, 120);
+        let row = s.rows.pop_front().unwrap();
+        assert_eq!(row.ns[0], 40);
+        assert_eq!(row.ns[1], 50);
+        assert_eq!(row.ns[UPSTREAM], 30);
+        assert_eq!(row.busy_ns, 120);
+        assert_eq!(row.calls[0], 1);
+        assert_eq!(row.calls[1], 1);
+    }
+
+    #[test]
+    fn pacing_sleep_is_not_busy_or_charged_to_the_outer_scope() {
+        let mut s = State {
+            enabled: true,
+            running: true,
+            ..State::default()
+        };
+        s.enter(8, 10);
+        s.charge(20);
+        s.running = false;
+        s.charge(10_020);
+        s.running = true;
+        s.finish(1, 10_050);
+        let row = s.rows.pop_front().unwrap();
+        assert_eq!(row.busy_ns, 50);
+        assert_eq!(row.ns[8], 40);
+    }
+
+    #[test]
+    fn rows_are_bounded_and_all_lost_rows_are_reported() {
+        let mut s = State {
+            enabled: true,
+            running: true,
+            ..State::default()
+        };
+        for tick in 0..LIMIT + 2 {
+            s.finish(tick as i64, tick as u64 + 1);
+        }
+        assert_eq!(s.rows.len(), LIMIT);
+        assert_eq!(s.dropped, 2);
+        assert_eq!(s.rows.front().unwrap().sequence, 3);
+    }
+
+    #[test]
+    fn other_threads_remain_disabled_and_reconfiguration_clears_history() {
+        configure(true);
+        finish_tick(1);
+        assert!(
+            std::thread::spawn(|| {
+                finish_tick(1);
+                drain().0.is_empty()
+            })
+            .join()
+            .unwrap()
+        );
+        configure(true);
+        assert!(drain().0.is_empty());
+        configure(false);
+        finish_tick(2);
+        assert!(drain().0.is_empty());
+    }
+}
