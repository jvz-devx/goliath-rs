+#[test]
+fn write_batches_keep_fifo_order_across_the_descriptor_cap() {
+    let chunks: VecDeque<_> = (0..80)
+        .map(|index| Chunk {
+            bytes: vec![index as u8; 5],
+            offset: index % 2,
+            completed: None,
+        })
+        .collect();
+    let mut slices: [IoSlice<'_>; WRITE_SLICES] = std::array::from_fn(|_| IoSlice::new(&[]));
+    let used = write_slices(&chunks, TURN_BYTES, &mut slices);
+    assert_eq!(used, WRITE_SLICES.min(80));
+    let actual: Vec<_> = slices[..used]
+        .iter()
+        .flat_map(|slice| slice.iter().copied())
+        .collect();
+    let expected: Vec<_> = chunks
+        .iter()
+        .take(used)
+        .flat_map(|chunk| chunk.bytes[chunk.offset..].iter().copied())
+        .collect();
+    assert_eq!(actual, expected);
+}
+
+#[test]
+fn write_batches_bound_bytes_and_keep_partial_chunk_offsets() {
+    let chunks = VecDeque::from([
+        Chunk {
+            bytes: vec![1, 2, 3, 4],
+            offset: 2,
+            completed: None,
+        },
+        Chunk {
+            bytes: vec![5, 6, 7],
+            offset: 1,
+            completed: None,
+        },
+    ]);
+    let mut slices: [IoSlice<'_>; WRITE_SLICES] = std::array::from_fn(|_| IoSlice::new(&[]));
+    let used = write_slices(&chunks, 3, &mut slices);
+    assert_eq!(used, 2);
+    let actual: Vec<_> = slices[..used]
+        .iter()
+        .flat_map(|slice| slice.iter().copied())
+        .collect();
+    assert_eq!(actual, [3, 4, 6]);
+}
