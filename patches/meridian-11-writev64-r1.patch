+/// Describe a FIFO byte-limited prefix without allocating a descriptor vector.
+fn write_slices<'a>(
+    chunks: &'a VecDeque<Chunk>,
+    mut remaining: usize,
+    slices: &mut [IoSlice<'a>],
+) -> usize {
+    let mut used = 0;
+    for chunk in chunks.iter().take(slices.len()) {
+        if remaining == 0 {
+            break;
+        }
+        let length = remaining.min(chunk.bytes.len() - chunk.offset);
+        slices[used] = IoSlice::new(&chunk.bytes[chunk.offset..chunk.offset + length]);
+        remaining -= length;
+        used += 1;
+    }
+    used
+}
