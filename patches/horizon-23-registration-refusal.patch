+/// Placed logins this tile has not registered: no generation, and not on their way out.
+fn unregistered(guests: &[Guest]) -> Vec<u128> {
+    guests
+        .iter()
+        .filter(|g| g.placed && !g.released && local_generation(g.saved.as_ref()).is_none())
+        .map(|g| g.uuid)
+        .collect()
+}
+
+/// Applies one `CreateUuid` reply to the new login `uuid`. The store checks this tile's
+/// fence before its player table, so `AlreadyExists` refuses this player alone: a record
+/// for it exists already, owned by this or another tile. The login leaves released, so
+/// it gains no ownership and no player file or record is written for it here. Any other
+/// refusal, a stale fence or an expired lease among them, stays an error that stops the tile.
+fn settle_registration(guests: &mut [Guest], uuid: u128, reply: Response) -> Result<()> {
+    let guest = guests.iter_mut().find(|g| g.uuid == uuid);
+    match reply {
+        Response::Committed(Generation(0)) => {
+            if let Some(g) = guest {
                 mark(&mut g.saved, 0)?;
             }
         }
-        Ok(())
+        Response::Fault(StoreFault::AlreadyExists) => {
+            let id = horizon_protocol::crypto::uuid_string(uuid);
+            eprintln!(
+                "E28_REGISTRATION_REFUSED {}",
+                json!({"uuid":id,"fault":"AlreadyExists","placed":guest.is_some()})
+            );
+            if let Some(g) = guest {
+                g.released = true;
+                g.left_reason =
+                    "cluster registration refused: the store already holds this player".into();
+                g.sender.disconnect(horizon_protocol::text::translatable(
+                    "multiplayer.disconnect.duplicate_login",
+                    &[],
+                ));
+            }
+        }
+        other => return Err(format!("new player registration failed: {other:?}").into()),
+    }
+    Ok(())
+}
