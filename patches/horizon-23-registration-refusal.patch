+#[cfg(test)]
+mod tests {
+    use super::*;
+    use horizon_client::lan::{Joined, Out, PlayerSender};
+    use horizon_protocol::packets::configuration::ClientInformation;
+    use std::sync::{
+        Arc,
+        atomic::AtomicI32,
+        mpsc::{Receiver, channel},
+    };
+
+    /// A placed new login with no generation, and the end of its connection.
+    fn login(uuid: u128) -> (Guest, Receiver<Out>) {
+        let (tx, rx) = channel();
+        let mut guest = Guest::new(
+            Joined {
+                conn: uuid as u32,
+                uuid,
+                name: format!("Login{uuid}"),
+                properties: Vec::new(),
+                info: ClientInformation::new(4),
+                brand: "vanilla".into(),
+                sender: PlayerSender::new(tx, Arc::default()),
+                latency: Arc::new(AtomicI32::new(0)),
+                address: "127.0.0.1:25565".parse().unwrap(),
+                expected: false,
+                configured: Default::default(),
+            },
+            uuid as i32,
+            [0.5, 64.0, 0.5],
+            4,
+        );
+        guest.placed = true;
+        (guest, rx)
+    }
+
+    fn disconnected(out: &Receiver<Out>) -> bool {
+        out.try_iter().any(|m| matches!(m, Out::Disconnect(_)))
+    }
+
+    #[test]
+    fn a_refused_registration_disconnects_only_that_login() {
+        let (held, held_out) = login(1);
+        let (fresh, fresh_out) = login(2);
+        let mut guests = vec![held, fresh];
+        assert_eq!(unregistered(&guests), [1, 2]);
+        let refused = Response::Fault(StoreFault::AlreadyExists);
+        settle_registration(&mut guests, 1, refused).unwrap();
+        settle_registration(&mut guests, 2, Response::Committed(Generation(0))).unwrap();
+        // Released: the leave path saves no player file, stats or advancements for it.
+        assert!(guests[0].released);
+        assert_eq!(local_generation(guests[0].saved.as_ref()), None);
+        assert!(disconnected(&held_out));
+        assert!(!guests[1].released);
+        assert_eq!(local_generation(guests[1].saved.as_ref()), Some(0));
+        assert!(!disconnected(&fresh_out));
+        // Neither is sent to the store again on the next tick.
+        assert!(unregistered(&guests).is_empty());
+    }
+
+    #[test]
+    fn refusals_that_are_not_about_the_player_stay_fatal() {
+        let faults = [
+            StoreFault::StaleFence,
+            StoreFault::LeaseExpired,
+            StoreFault::LeaseRequired,
+            StoreFault::LeaseDraining,
+            StoreFault::LeaseBusy,
+            StoreFault::RequestConflict,
+            StoreFault::Limit,
+            StoreFault::GenerationConflict,
+            StoreFault::MissingPlayer,
+            StoreFault::RenewalReplay,
+        ];
+        let others = [Response::Committed(Generation(1)), Response::Ok];
+        for reply in faults.map(Response::Fault).into_iter().chain(others) {
+            let (guest, out) = login(1);
+            let mut guests = vec![guest];
+            assert!(settle_registration(&mut guests, 1, reply).is_err());
+            assert!(!guests[0].released);
+            assert_eq!(local_generation(guests[0].saved.as_ref()), None);
+            assert!(!disconnected(&out));
+            assert_eq!(unregistered(&guests), [1]);
+        }
     }
 }
