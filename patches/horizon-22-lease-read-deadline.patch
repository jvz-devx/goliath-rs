+    const LEASE_MS: u64 = 1000;
+    const MARGIN: Duration = Duration::from_millis(100);
+    type Answer = fn(&Command, Fence) -> Option<(Duration, Response)>;
+
+    /// A loopback store answering each request after a delay, or holding it unanswered.
+    /// It logs every renewal counter with the instant it read the request.
+    fn stub(
+        fence: Fence,
+        answer: Answer,
+    ) -> (std::net::SocketAddr, Arc<Mutex<Vec<(u64, Instant)>>>) {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let address = listener.local_addr().unwrap();
+        let received = Arc::new(Mutex::new(Vec::new()));
+        let log = Arc::clone(&received);
+        std::thread::spawn(move || {
+            for stream in listener.incoming() {
+                let Ok(mut stream) = stream else {
+                    return;
+                };
+                let log = Arc::clone(&log);
+                std::thread::spawn(move || {
+                    while let Ok(command) =
+                        goliath_store::read_request(&mut stream, Duration::from_secs(5))
+                    {
+                        if let Operation::RenewLease { counter, .. } = command.operation {
+                            log.lock().unwrap().push((counter, Instant::now()));
+                        }
+                        let Some((delay, response)) = answer(&command, fence) else {
+                            std::thread::sleep(Duration::from_secs(3));
+                            return;
+                        };
+                        std::thread::sleep(delay);
+                        let reply = goliath_store::write_response(
+                            &mut stream,
+                            &response,
+                            Duration::from_secs(1),
+                        );
+                        if reply.is_err() {
+                            return;
+                        }
+                    }
+                });
+            }
+        });
+        (address, received)
+    }
+
+    fn lease(counter: u64, fence: Fence) -> Response {
+        Response::Leased(LeaseGrant {
+            fence,
+            lease_ms: LEASE_MS,
+            counter,
+        })
+    }
+
+    struct Outcome {
+        original: Instant,
+        deadline: Instant,
+        accepted: u64,
+        reason: Option<&'static str>,
+        received: Vec<(u64, Instant)>,
+        last_open: Instant,
+        first_closed: Instant,
+        slowest_check: Duration,
+    }
+
+    /// Runs the real renewal loop against the stub and samples the action gate every
+    /// millisecond until the keeper has stopped and the gate has closed.
+    fn renew_against(answer: Answer) -> Outcome {
+        let sent = Instant::now();
+        let authority = Arc::new(granted(sent));
+        let original = authority.state.lock().unwrap().keeper.deadline().unwrap();
+        let (address, received) = stub(authority.fence, answer);
+        let client = Client::new(address, read_cap(LEASE_MS, MARGIN), 1).unwrap();
+        let schedule = RenewalSchedule::new(sent, RENEWAL_PERIOD, RENEWAL_RPC_SLACK).unwrap();
+        let keeper = {
+            let authority = Arc::clone(&authority);
+            std::thread::spawn(move || keep(&authority, &client, schedule, LEASE_MS, MARGIN))
+        };
+        let (mut last_open, mut first_closed) = (sent, None);
+        let mut slowest_check = Duration::ZERO;
+        let limit = sent + Duration::from_secs(10);
+        while !keeper.is_finished() || first_closed.is_none() {
+            assert!(Instant::now() < limit, "the keeper never stopped");
+            let before = Instant::now();
+            let open = authority.check(Duration::ZERO);
+            let after = Instant::now();
+            slowest_check = slowest_check.max(after - before);
+            if open {
+                assert!(first_closed.is_none(), "the gate reopened");
+                last_open = before;
+            } else if first_closed.is_none() {
+                first_closed = Some(after);
+            }
+            std::thread::sleep(Duration::from_millis(1));
+        }
+        keeper.join().unwrap();
+        let state = authority.state.lock().unwrap();
+        let received = received.lock().unwrap().clone();
+        Outcome {
+            original,
+            deadline: state.keeper.deadline().unwrap(),
+            accepted: state.accepted_counter,
+            reason: state.stopped_reason,
+            received,
+            last_open,
+            first_closed: first_closed.unwrap(),
+            slowest_check,
+        }
+    }
+
+    /// The gate never opens at or after the deadline, and closes soon after it.
+    fn closed_at(outcome: &Outcome, deadline: Instant) {
+        assert!(outcome.last_open < deadline);
+        assert!(outcome.first_closed >= deadline);
+        assert!(outcome.first_closed < deadline + Duration::from_millis(250));
+        assert!(matches!(
+            outcome.reason,
+            Some("renew-keeper-deadline" | "action-may-act-false" | "renew-io-deadline")
+        ));
+    }
+
+    #[test]
+    fn a_stalled_grant_before_the_call_deadline_counts_from_its_original_send() {
+        // The store answers renewal 1 after 400 ms, longer than the old 200 ms read cap,
+        // and never answers renewal 2.
+        let outcome = renew_against(|command, fence| match command.operation {
+            Operation::RenewLease { counter: 1, .. } => {
+                Some((Duration::from_millis(400), lease(1, fence)))
+            }
+            _ => None,
+        });
+        assert_eq!(outcome.accepted, 1);
+        let (counter, read) = outcome.received[0];
+        assert_eq!(counter, 1);
+        assert!(outcome.deadline > outcome.original);
+        // Anchored to the send: a reply-anchored grant would end 400 ms later than this.
+        assert!(outcome.deadline <= read + Duration::from_millis(LEASE_MS) - MARGIN);
+        assert!(outcome.received.len() >= 2);
+        closed_at(&outcome, outcome.deadline);
+    }
+
+    #[test]
+    fn a_grant_arriving_after_the_deadline_is_never_installed() {
+        let outcome = renew_against(|command, fence| match command.operation {
+            Operation::RenewLease { counter, .. } => {
+                Some((Duration::from_millis(1200), lease(counter, fence)))
+            }
+            _ => None,
+        });
+        assert_eq!(outcome.accepted, 0);
+        assert_eq!(outcome.deadline, outcome.original);
+        closed_at(&outcome, outcome.original);
+    }
+
+    #[test]
+    fn an_unanswered_renewal_cannot_hold_the_gate_open() {
+        let outcome = renew_against(|_, _| None);
+        assert_eq!(outcome.accepted, 0);
+        assert_eq!(outcome.deadline, outcome.original);
+        // One read stayed outstanding from about 250 ms to the call deadline.
+        assert!(outcome.received[0].1 + Duration::from_millis(500) < outcome.original);
+        // The gate never waits on the keeper thread's read.
+        assert!(outcome.slowest_check < Duration::from_millis(50));
+        closed_at(&outcome, outcome.original);
+    }
