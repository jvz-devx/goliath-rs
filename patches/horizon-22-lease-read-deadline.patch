+    #[test]
+    #[cfg(not(target_os = "macos"))]
+    fn margin_guard_charges_twice_the_lease_per_thousand() {
+        assert!(!margin_sufficient(500, Duration::from_nanos(999_000)));
+        assert!(margin_sufficient(500, Duration::from_nanos(999_001)));
+        assert!(margin_sufficient(1000, Duration::from_millis(100)));
