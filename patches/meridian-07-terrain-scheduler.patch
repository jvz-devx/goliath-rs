diff --git a/crates/meridian-net/src/io_pool/timers.rs b/crates/meridian-net/src/io_pool/timers.rs
new file mode 100644
--- /dev/null
+++ b/crates/meridian-net/src/io_pool/timers.rs
@@ -0,0 +1,123 @@
+//! Bounded periodic callbacks owned and driven by one reactor, without timer threads.
+use std::{
+    io,
+    sync::{
+        Arc,
+        atomic::{AtomicUsize, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+pub(super) struct Periodic {
+    next: Instant,
+    period: Duration,
+    callback: Box<dyn FnMut() -> bool + Send>,
+    slots: Arc<AtomicUsize>,
+}
+
+impl Periodic {
+    pub(super) fn new(
+        slots: &Arc<AtomicUsize>,
+        period: Duration,
+        callback: impl FnMut() -> bool + Send + 'static,
+    ) -> io::Result<Self> {
+        if period.is_zero() {
+            return Err(io::Error::other(
+                "periodic IO work needs a nonzero interval",
+            ));
+        }
+        slots
+            .fetch_update(Ordering::AcqRel, Ordering::Relaxed, |n| {
+                (n < super::CONNECTIONS).then_some(n + 1)
+            })
+            .map_err(|_| io::Error::other("bounded periodic IO work exceeded"))?;
+        Ok(Self {
+            next: Instant::now(),
+            period,
+            callback: Box::new(callback),
+            slots: Arc::clone(slots),
+        })
+    }
+
+    fn tick(&mut self, now: Instant) -> bool {
+        if now < self.next {
+            return true;
+        }
+        self.next = now + self.period;
+        (self.callback)()
+    }
+}
+
+impl Drop for Periodic {
+    fn drop(&mut self) {
+        self.slots.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+
+#[derive(Default)]
+pub(super) struct Timers {
+    entries: Vec<Periodic>,
+    next: Option<Instant>,
+}
+impl Timers {
+    pub(super) fn push(&mut self, periodic: Periodic) {
+        // A new session joins the existing driver's timer turn. Do not create
+        // one selector wake deadline per player.
+        if self.next.is_none() {
+            self.next = Some(Instant::now());
+        }
+        self.entries.push(periodic);
+    }
+    pub(super) fn tick(&mut self) {
+        let now = Instant::now();
+        if self.next.is_none_or(|next| now < next) {
+            return;
+        }
+        self.entries.retain_mut(|periodic| periodic.tick(now));
+        self.next = self.entries.iter().map(|periodic| periodic.next).min();
+    }
+    pub(super) fn timeout(&self) -> Option<Duration> {
+        self.next
+            .map(|next| next.saturating_duration_since(Instant::now()))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cancelled_timer_releases_admission_and_due_ticks_do_not_catch_up() {
+        let slots = Arc::new(AtomicUsize::new(0));
+        let calls = Arc::new(AtomicUsize::new(0));
+        let count = Arc::clone(&calls);
+        let mut timer = Periodic::new(&slots, Duration::from_millis(20), move || {
+            count.fetch_add(1, Ordering::Relaxed) == 0
+        })
+        .unwrap();
+        let first = timer.next;
+        assert!(timer.tick(first));
+        assert!(timer.tick(first + Duration::from_millis(19)));
+        assert_eq!(calls.load(Ordering::Relaxed), 1);
+        assert!(!timer.tick(first + Duration::from_secs(1)));
+        assert_eq!(timer.next, first + Duration::from_millis(1020));
+        drop(timer);
+        assert_eq!(slots.load(Ordering::Relaxed), 0);
+    }
+
+    #[test]
+    fn admission_and_shutdown_are_bounded() {
+        let slots = Arc::new(AtomicUsize::new(super::super::CONNECTIONS));
+        assert!(Periodic::new(&slots, Duration::from_millis(20), || true).is_err());
+        slots.store(0, Ordering::Relaxed);
+        assert!(Periodic::new(&slots, Duration::ZERO, || true).is_err());
+        let mut timers = Timers::default();
+        timers.push(Periodic::new(&slots, Duration::from_millis(20), || false).unwrap());
+        timers.tick();
+        assert!(timers.timeout().is_none());
+        assert_eq!(slots.load(Ordering::Relaxed), 0);
+        timers.push(Periodic::new(&slots, Duration::from_millis(20), || true).unwrap());
+        drop(timers);
+        assert_eq!(slots.load(Ordering::Relaxed), 0);
+    }
+}
