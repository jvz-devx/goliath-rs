+            .map_err(|e| e.to_string())
+    }
+}
+
+// One timer per session, one in-flight reconciliation, and bounded shared workers.
+// Refused worker admission retries on the next tick without losing reader state.
+fn schedule(
+    io: Affinity,
+    over: impl Fn() -> bool + Send + 'static,
+    run: impl FnMut() -> bool + Send + 'static,
+) -> Result<(), String> {
+    let work = Arc::new(Reconcile {
+        busy: AtomicBool::new(false),
+        done: AtomicBool::new(false),
+        run: Mutex::new(Box::new(run)),
+    });
+    let worker = io.clone();
+    io.schedule(Duration::from_millis(20), move || {
+        if over() || work.done.load(Ordering::Acquire) {
+            return false;
+        }
+        if !work.busy.swap(true, Ordering::AcqRel) {
+            let next = Arc::clone(&work);
+            if !worker.submit(move || {
+                let keep = (next.run.lock().expect("terrain reconciliation poisoned"))();
+                next.done.store(!keep, Ordering::Release);
+                next.busy.store(false, Ordering::Release);
+            }) {
+                work.busy.store(false, Ordering::Release);
+            }
+        }
+        true
+    })
+    .map_err(|e| e.to_string())
+}
+
+struct Reconcile {
+    busy: AtomicBool,
+    done: AtomicBool,
+    run: Mutex<Box<dyn FnMut() -> bool + Send>>,
 }
 
