@@ -0,0 +1,271 @@
+//! Sparse observer wire sequences through the real hub's chunk and update paths.
+use super::*;
+use crate::lan::observer::{Area, RefreshRequest, SparseView};
+
+fn view(revision: u64, centers: &[[i32; 2]]) -> SparseView {
+    SparseView::new(
+        revision,
+        centers
+            .iter()
+            .map(|center| Area {
+                center: *center,
+                radius: 2,
+            })
+            .collect(),
+    )
+    .unwrap()
+}
+
+fn observer() -> (Hub, std::sync::mpsc::Receiver<crate::lan::Out>) {
+    let (mut hub, rx) = hub_with_a_guest();
+    let g = &mut hub.guests[0];
+    g.placed = false;
+    g.held = true;
+    g.chunks_per_tick = 64.0;
+    hub.terrain_observers.insert(g.uuid);
+    hub.ticks = 3;
+    (hub, rx)
+}
+
+fn packets(rx: &std::sync::mpsc::Receiver<crate::lan::Out>) -> Vec<(i32, Vec<u8>)> {
+    let mut result = Vec::new();
+    for out in rx.try_iter() {
+        let bodies = match out {
+            crate::lan::Out::Packet(body) => vec![body],
+            crate::lan::Out::Packets(bodies) => bodies,
+            crate::lan::Out::Disconnect(_) => panic!("observer unexpectedly disconnected"),
+        };
+        for body in bodies {
+            let mut r = horizon_protocol::buf::Reader::new(&body);
+            result.push((r.varint().unwrap(), r.rest().to_vec()));
+        }
+    }
+    result
+}
+
+fn send_chunks(hub: &mut Hub, world: &mut World) {
+    let border = crate::worldborder::WorldBorder::default();
+    let mut next = 10;
+    hub.update_chunks(&TickCtx {
+        world,
+        entities: &[],
+        next_entity: &mut next,
+        spawn: [0., 64., 0.],
+        difficulty: 2,
+        difficulty_locked: false,
+        clock_rate: 1.,
+        tick_rate: 20.,
+        tick_frozen: false,
+        tick_steps: Default::default(),
+        collision: None,
+        border: &border,
+        streaming: None,
+    });
+}
+
+fn add_column(world: &mut World, key: (i32, i32)) {
+    let mut chunk = crate::chunk::Chunk::empty(key.0, key.1);
+    chunk.lit = true;
+    world.chunks.insert(key, Arc::new(chunk));
+}
+
+#[test]
+fn sparse_observer_sends_disconnected_columns_and_forgets_only_removed_interest() {
+    let (mut hub, rx) = observer();
+    hub.terrain_observer_views
+        .insert(1, view(1, &[[-100, 0], [100, 0]]));
+    let mut world = World::new(horizon_world::registry::BlockStateId(0), 0);
+    for key in [(-100, 0), (0, 0), (100, 0)] {
+        add_column(&mut world, key);
+    }
+    send_chunks(&mut hub, &mut world);
+    let sent = packets(&rx);
+    let columns: Vec<_> = sent
+        .iter()
+        .filter(|(id, _)| *id == ids::LEVEL_CHUNK_WITH_LIGHT)
+        .map(|(_, body)| {
+            let mut r = horizon_protocol::buf::Reader::new(body);
+            (r.i32().unwrap(), r.i32().unwrap())
+        })
+        .collect();
+    assert_eq!(columns, vec![(-100, 0), (100, 0)]);
+    assert_eq!(hub.guests[0].sent_chunks.len(), 2);
+    assert!(!hub.guests[0].sent_chunks.contains(&(0, 0)));
+    hub.terrain_observer_views.insert(1, view(2, &[[100, 0]]));
+    send_chunks(&mut hub, &mut world);
+    let sent = packets(&rx);
+    assert_eq!(sent.len(), 1);
+    assert!(matches!(
+        C::decode(sent[0].0, &sent[0].1).unwrap(),
+        C::ForgetLevelChunk(play::ForgetLevelChunk { pos: [-100, 0] })
+    ));
+    assert!(hub.guests[0].sent_chunks.contains(&(100, 0)));
+    hub.terrain_observer_views.insert(1, view(3, &[]));
+    send_chunks(&mut hub, &mut world);
+    assert!(hub.guests[0].sent_chunks.is_empty());
+    assert!(hub.guests[0].chunk_queue.is_empty());
+    assert_eq!(packets(&rx).len(), 1);
+}
+
+#[test]
+fn sparse_refresh_retains_update_membership_and_sends_snapshot_without_forget() {
+    let (mut hub, rx) = observer();
+    hub.terrain_observer_views.insert(1, view(7, &[[0, 0]]));
+    let mut world = World::new(horizon_world::registry::BlockStateId(0), 0);
+    add_column(&mut world, (0, 0));
+    send_chunks(&mut hub, &mut world);
+    packets(&rx);
+    let request = RefreshRequest {
+        revision: 7,
+        columns: vec![[0, 0], [0, 0]],
+    };
+    assert_eq!(hub.refresh_terrain_observer(1, &request), Ok(1));
+    assert_eq!(hub.refresh_terrain_observer(1, &request), Ok(0));
+    assert!(hub.guests[0].sent_chunks.contains(&(0, 0)));
+    // The reader must acknowledge its first batch before another snapshot can leave.
+    send_chunks(&mut hub, &mut world);
+    assert!(packets(&rx).is_empty());
+    assert!(hub.guests[0].chunk_queue.contains(&(0, 0)));
+    hub.guests[0].unacknowledged = 0;
+    world.block_log = Some(vec![(1, 0, 1)]);
+    hub.broadcast_block_changes(&mut world);
+    send_chunks(&mut hub, &mut world);
+    world.block_log = Some(vec![(2, 0, 1)]);
+    hub.broadcast_block_changes(&mut world);
+    let sent = packets(&rx);
+    let ids: Vec<_> = sent.iter().map(|(id, _)| *id).collect();
+    assert_eq!(
+        ids,
+        vec![
+            ids::BLOCK_UPDATE,
+            ids::CHUNK_BATCH_START,
+            ids::LEVEL_CHUNK_WITH_LIGHT,
+            ids::CHUNK_BATCH_FINISHED,
+            ids::BLOCK_UPDATE
+        ]
+    );
+    assert!(hub.guests[0].sent_chunks.contains(&(0, 0)));
+    assert!(!hub.guests[0].chunk_queue.contains(&(0, 0)));
+}
+
+#[test]
+fn sparse_refresh_refuses_stale_untracked_unsent_or_mutable_readers_without_partial_queueing() {
+    let (mut hub, _rx) = observer();
+    hub.terrain_observer_views.insert(1, view(3, &[[0, 0]]));
+    hub.guests[0].sent_chunks.insert((0, 0));
+    for request in [
+        RefreshRequest {
+            revision: 2,
+            columns: vec![[0, 0]],
+        },
+        RefreshRequest {
+            revision: 3,
+            columns: vec![[0, 0], [100, 100]],
+        },
+        RefreshRequest {
+            revision: 3,
+            columns: vec![[0, 0], [1, 0]],
+        },
+        RefreshRequest {
+            revision: 3,
+            columns: vec![[0, 0]; 257],
+        },
+    ] {
+        assert!(hub.refresh_terrain_observer(1, &request).is_err());
+        assert!(hub.guests[0].chunk_queue.is_empty());
+        assert!(hub.guests[0].sent_chunks.contains(&(0, 0)));
+    }
+    let request = RefreshRequest {
+        revision: 3,
+        columns: vec![[0, 0]],
+    };
+    hub.guests[0].placed = true;
+    assert!(hub.refresh_terrain_observer(1, &request).is_err());
+    hub.guests[0].placed = false;
+    hub.guests[0].imported = true;
+    assert!(hub.refresh_terrain_observer(1, &request).is_err());
+    hub.guests[0].imported = false;
+    hub.guests[0].held = false;
+    assert!(hub.refresh_terrain_observer(1, &request).is_err());
+    hub.guests[0].held = true;
+    hub.terrain_observers.remove(&1);
+    assert!(hub.refresh_terrain_observer(1, &request).is_err());
+    assert!(hub.guests[0].chunk_queue.is_empty());
+}
+
+#[test]
+fn sparse_observer_receives_interior_light_updates_for_per_client_edges() {
+    let (mut hub, rx) = observer();
+    hub.terrain_observer_views.insert(1, view(1, &[[0, 0]]));
+    let mut world = World::new(horizon_world::registry::BlockStateId(0), 0);
+    add_column(&mut world, (0, 0));
+    for z in -1..=1 {
+        for x in -1..=1 {
+            hub.guests[0].sent_chunks.insert((x, z));
+        }
+    }
+    world.light_log = Some(Default::default());
+    world
+        .light_log
+        .as_mut()
+        .unwrap()
+        .insert((0, 0), crate::section_mask::SectionMask::default());
+    hub.broadcast_light_changes(&mut world);
+    let sent = packets(&rx);
+    assert_eq!(sent.len(), 1);
+    assert_eq!(sent[0].0, ids::LIGHT_UPDATE);
+    hub.terrain_observer_views.clear();
+    world
+        .light_log
+        .as_mut()
+        .unwrap()
+        .insert((0, 0), crate::section_mask::SectionMask::default());
+    hub.broadcast_light_changes(&mut world);
+    assert!(
+        packets(&rx).is_empty(),
+        "legacy interior lighting behavior is unchanged"
+    );
+}
+
+#[test]
+fn sparse_loading_uses_only_areas_and_cleanup_drops_union_state() {
+    let (mut hub, _rx) = observer();
+    assert_eq!(hub.loading_chunks(|_| true), vec![(0, 0)]);
+    hub.terrain_observer_views
+        .insert(1, view(1, &[[-100, 0], [100, 0]]));
+    assert!(
+        hub.loading_chunks(|_| true).is_empty(),
+        "the anchor must not add a gap loading ticket"
+    );
+    assert_eq!(
+        hub.terrain_observer_views[&1]
+            .loading_areas()
+            .collect::<Vec<_>>(),
+        vec![((-100, 0), 3), ((100, 0), 3)]
+    );
+    hub.remove_guest(0, "test exit");
+    assert!(hub.terrain_observer_views.is_empty());
+    assert!(hub.terrain_observers.is_empty());
+}
+
+#[test]
+fn legacy_observer_recenter_and_sparse_reset_keep_their_distinct_paths() {
+    let (mut hub, rx) = observer();
+    hub.guests[0].view_distance = 2;
+    hub.update_view(0);
+    assert_eq!(hub.guests[0].chunk_queue.len(), 49);
+    assert!(hub.guests[0].chunk_queue.contains(&(-3, -3)));
+    assert_eq!(packets(&rx)[0].0, ids::SET_CHUNK_CACHE_CENTER);
+    hub.guests[0].position[0] = 1600.;
+    hub.update_view(0);
+    assert!(hub.guests[0].chunk_queue.contains(&(100, 0)));
+    assert!(!hub.guests[0].chunk_queue.contains(&(0, 0)));
+    hub.terrain_observer_views.insert(1, view(1, &[[0, 0]]));
+    hub.update_view(0);
+    assert!(hub.guests[0].chunk_queue.contains(&(0, 0)));
+    hub.guests[0].chunk_queue.clear();
+    hub.guests[0].sent_chunks.clear();
+    hub.guests[0].center = None;
+    hub.update_view(0);
+    assert_eq!(hub.guests[0].chunk_queue.len(), 49);
+}
