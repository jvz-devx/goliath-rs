+//! Bounded sparse coverage for held terrain observers, with ordered snapshot refresh.
+use super::guest::Guest;
+use crate::fast_hash::FxHashSet;
+use horizon_protocol::packets::play::{self, Clientbound as C};
+
+const MAX_AREAS: usize = 256;
+const MAX_COLUMNS: usize = 4096;
+const MAX_REQUEST_BYTES: usize = 64 * 1024;
+const MAX_REFRESH: usize = 256;
+const CHUNK_LIMIT: i32 = 30_000_000 / 16;
+
+#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct Area {
+    pub center: [i32; 2],
+    pub radius: u8,
+}
+
+/// The old array and radius forms remain distinct from sparse interest requests.
+#[derive(serde::Deserialize)]
+#[serde(untagged, deny_unknown_fields)]
+pub enum ViewRequest {
+    Position([f64; 3]),
+    Sized {
+        position: [f64; 3],
+        radius: Option<u8>,
+    },
+    Sparse {
+        position: [f64; 3],
+        revision: u64,
+        areas: Vec<Area>,
+    },
+}
+
+impl ViewRequest {
+    pub fn parse(text: &str) -> Result<Self, &'static str> {
+        if text.len() > MAX_REQUEST_BYTES {
+            return Err("observer request exceeds 64 KiB");
+        }
+        serde_json::from_str(text).map_err(|_| "invalid observer view")
+    }
+}
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct RefreshRequest {
+    pub revision: u64,
+    pub columns: Vec<[i32; 2]>,
+}
+
+impl RefreshRequest {
+    pub fn parse(text: &str) -> Result<Self, &'static str> {
+        if text.len() > MAX_REQUEST_BYTES {
+            return Err("observer request exceeds 64 KiB");
+        }
+        let request: Self = serde_json::from_str(text).map_err(|_| "invalid observer refresh")?;
+        if request.columns.len() > MAX_REFRESH {
+            return Err("observer refresh exceeds 256 columns");
+        }
+        Ok(request)
+    }
+}
+
+pub struct SparseView {
+    revision: u64,
+    areas: Vec<Area>,
+    columns: FxHashSet<(i32, i32)>,
+    dirty: bool,
+}
+
+impl SparseView {
+    /// Validate both wire coverage and its lighting/loading margin before installation.
+    pub fn new(revision: u64, mut areas: Vec<Area>) -> Result<Self, &'static str> {
+        if areas.len() > MAX_AREAS {
+            return Err("observer view exceeds 256 areas");
+        }
+        areas.sort_unstable();
+        areas.dedup();
+        let mut columns = FxHashSet::default();
+        let mut loading = FxHashSet::default();
+        for area in &areas {
+            let [cx, cz] = area.center;
+            let r = i32::from(area.radius);
+            if !(2..=32).contains(&r)
+                || area
+                    .center
+                    .iter()
+                    .any(|c| c.abs_diff(0) > CHUNK_LIMIT as u32)
+            {
+                return Err("invalid observer area");
+            }
+            // An extra loading area with r+1 finishes to r+2, including light neighbours.
+            for dz in -r - 2..=r + 2 {
+                for dx in -r - 2..=r + 2 {
+                    let key = (cx + dx, cz + dz);
+                    if key.0.abs() > CHUNK_LIMIT || key.1.abs() > CHUNK_LIMIT {
+                        return Err("observer area exceeds world bounds");
+                    }
+                    loading.insert(key);
+                    if super::hub::tracked(cx, cz, r, key.0, key.1) {
+                        columns.insert(key);
+                    }
+                    if loading.len() > MAX_COLUMNS || columns.len() > MAX_COLUMNS {
+                        return Err("observer view exceeds 4096 columns including loading margin");
+                    }
+                }
+            }
+        }
+        Ok(Self {
+            revision,
+            areas,
+            columns,
+            dirty: true,
+        })
+    }
+
+    pub fn revision(&self) -> u64 {
+        self.revision
+    }
+    pub fn area_count(&self) -> usize {
+        self.areas.len()
+    }
+    pub fn column_count(&self) -> usize {
+        self.columns.len()
+    }
+
+    /// Equal revisions are heartbeat retries only. A different union needs a newer revision.
+    pub fn accepts(&self, next: &Self) -> Result<(), &'static str> {
+        if next.revision < self.revision
+            || next.revision == self.revision && next.areas != self.areas
+        {
+            return Err("stale or conflicting observer revision");
+        }
+        Ok(())
+    }
+
+    pub fn loading_areas(&self) -> impl Iterator<Item = ((i32, i32), i32)> + '_ {
+        self.areas
+            .iter()
+            .map(|a| ((a.center[0], a.center[1]), i32::from(a.radius) + 1))
+    }
+
+    pub(crate) fn reconcile(&mut self, g: &mut Guest) {
+        if !self.dirty && g.center == Some(g.chunk()) {
+            return;
+        }
+        self.dirty = false;
+        g.center = Some(g.chunk());
+        let forget: Vec<_> = g
+            .sent_chunks
+            .iter()
+            .copied()
+            .filter(|key| !self.columns.contains(key))
+            .collect();
+        for (x, z) in forget {
+            g.sent_chunks.remove(&(x, z));
+            g.send(&C::ForgetLevelChunk(play::ForgetLevelChunk { pos: [x, z] }));
+        }
+        g.far_queue.clear();
+        g.far_sent_chunks.clear();
+        g.chunk_queue.retain(|key| self.columns.contains(key));
+        let mut queued: FxHashSet<_> = g.chunk_queue.iter().copied().collect();
+        let mut added: Vec<_> = self
+            .columns
+            .iter()
+            .copied()
+            .filter(|key| !g.sent_chunks.contains(key) && queued.insert(*key))
+            .collect();
+        added.sort_unstable();
+        g.chunk_queue.extend(added);
+    }
+
+    /// Keep sent membership while the replacement is pending, so intervening updates still flow.
+    pub(crate) fn refresh(
+        &self,
+        g: &mut Guest,
+        request: &RefreshRequest,
+    ) -> Result<usize, &'static str> {
+        if request.revision != self.revision {
+            return Err("refresh revision is not current");
+        }
+        if request.columns.len() > MAX_REFRESH
+            || request.columns.iter().any(|at| {
+                let key = (at[0], at[1]);
+                !self.columns.contains(&key) || !g.sent_chunks.contains(&key)
+            })
+        {
+            return Err("refresh needs at most 256 requested, already sent columns");
+        }
+        let mut queued: FxHashSet<_> = g.chunk_queue.iter().copied().collect();
+        let mut added = 0;
+        for at in &request.columns {
+            let key = (at[0], at[1]);
+            if queued.insert(key) {
+                g.chunk_queue.push(key);
+                added += 1;
+            }
+        }
+        Ok(added)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn area(x: i32, z: i32) -> Area {
+        Area {
+            center: [x, z],
+            radius: 2,
+        }
+    }
+
+    #[test]
+    fn sparse_union_keeps_disconnected_areas_without_the_gap() {
+        let view = SparseView::new(1, vec![area(-100, 0), area(100, 0), area(-100, 0)]).unwrap();
+        assert_eq!(view.area_count(), 2);
+        assert!(view.columns.contains(&(-100, 0)));
+        assert!(view.columns.contains(&(100, 0)));
+        assert!(!view.columns.contains(&(0, 0)));
+        assert_eq!(view.column_count(), 98);
+        assert_eq!(
+            view.loading_areas().collect::<Vec<_>>(),
+            vec![((-100, 0), 3), ((100, 0), 3)]
+        );
+    }
+
+    #[test]
+    fn overlapping_union_deduplicates_and_revisions_cannot_roll_back() {
+        let view = SparseView::new(5, vec![area(0, 0), area(1, 0)]).unwrap();
+        assert_eq!(view.column_count(), 56);
+        assert!(
+            view.accepts(&SparseView::new(5, vec![area(1, 0), area(0, 0)]).unwrap())
+                .is_ok()
+        );
+        assert!(
+            view.accepts(&SparseView::new(4, vec![area(0, 0)]).unwrap())
+                .is_err()
+        );
+        assert!(
+            view.accepts(&SparseView::new(5, vec![area(0, 0)]).unwrap())
+                .is_err()
+        );
+        assert!(
+            view.accepts(&SparseView::new(6, Vec::new()).unwrap())
+                .is_ok()
+        );
+    }
+
+    #[test]
+    fn admission_bounds_areas_coordinates_radius_and_expanded_loading() {
+        assert!(SparseView::new(0, vec![area(0, 0); 257]).is_err());
+        assert!(SparseView::new(0, vec![area(i32::MIN, 0)]).is_err());
+        assert!(SparseView::new(0, vec![area(CHUNK_LIMIT, 0)]).is_err());
+        assert!(
+            SparseView::new(
+                0,
+                vec![Area {
+                    center: [0, 0],
+                    radius: 33
+                }]
+            )
+            .is_err()
+        );
+        assert!(
+            SparseView::new(
+                0,
+                vec![Area {
+                    center: [0, 0],
+                    radius: 1
+                }]
+            )
+            .is_err()
+        );
+        assert!(
+            SparseView::new(
+                0,
+                vec![Area {
+                    center: [0, 0],
+                    radius: 32
+                }]
+            )
+            .is_err()
+        );
+        assert!(
+            SparseView::new(
+                0,
+                vec![Area {
+                    center: [0, 0],
+                    radius: 29
+                }]
+            )
+            .is_ok()
+        );
+        assert_eq!(SparseView::new(0, Vec::new()).unwrap().column_count(), 0);
+    }
+
+    #[test]
+    fn request_parser_preserves_legacy_forms_and_never_downgrades_bad_sparse_input() {
+        assert!(matches!(
+            ViewRequest::parse("[1,2,3]").unwrap(),
+            ViewRequest::Position([1., 2., 3.])
+        ));
+        assert!(matches!(
+            ViewRequest::parse(r#"{"position":[1,2,3],"radius":8}"#).unwrap(),
+            ViewRequest::Sized {
+                radius: Some(8),
+                ..
+            }
+        ));
+        assert!(matches!(
+            ViewRequest::parse(r#"{"position":[1,2,3]}"#).unwrap(),
+            ViewRequest::Sized { radius: None, .. }
+        ));
+        assert!(matches!(
+            ViewRequest::parse(r#"{"position":[1,2,3],"revision":1,"areas":[]}"#).unwrap(),
+            ViewRequest::Sparse { revision: 1, .. }
+        ));
+        assert!(ViewRequest::parse(r#"{"position":[1,2,3],"areas":[]}"#).is_err());
+        assert!(ViewRequest::parse(r#"{"position":[1,2,3],"revision":1,"areas":[{"center":[0,0],"radius":2,"unknown":0}]}"#).is_err());
+        assert!(ViewRequest::parse(&" ".repeat(MAX_REQUEST_BYTES + 1)).is_err());
+        assert!(RefreshRequest::parse(r#"{"revision":1,"columns":[[0,0]],"unknown":0}"#).is_err());
+        assert!(
+            RefreshRequest::parse(
+                &serde_json::json!({"revision":1,"columns":vec![[0,0];257]}).to_string()
+            )
+            .is_err()
+        );
+    }
+}
