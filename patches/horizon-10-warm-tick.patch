+/// The idle control prelude can run many times between ticks. Only speculative
+/// preparation is coalesced: real cuts still validate the live pointer and block
+/// entity revision, and encode a fresh image whenever this cache is stale.
+fn reserve_warm_tick(last: &mut Option<i64>, tick: i64, warming: &AtomicBool) -> bool {
+    if *last == Some(tick) || warming.swap(true, Ordering::AcqRel) {
+        return false;
+    }
+    *last = Some(tick);
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::reserve_warm_tick;
+    use std::sync::atomic::{AtomicBool, Ordering};
+
+    #[test]
+    fn completed_warm_pass_is_not_repeated_by_idle_control_polls() {
+        let mut last = None;
+        let warming = AtomicBool::new(false);
+        assert!(reserve_warm_tick(&mut last, 100, &warming));
+        warming.store(false, Ordering::Release);
+        for _ in 0..1_000 {
+            assert!(!reserve_warm_tick(&mut last, 100, &warming));
+        }
+        assert!(reserve_warm_tick(&mut last, 101, &warming));
+    }
+
+    #[test]
+    fn busy_worker_does_not_consume_the_next_ticks_opportunity() {
+        let mut last = None;
+        let warming = AtomicBool::new(false);
+        assert!(reserve_warm_tick(&mut last, 100, &warming));
+        assert!(!reserve_warm_tick(&mut last, 101, &warming));
+        warming.store(false, Ordering::Release);
+        assert!(reserve_warm_tick(&mut last, 101, &warming));
+    }
+
+    #[test]
+    fn reset_tick_still_prepares_a_new_image() {
+        let mut last = None;
+        let warming = AtomicBool::new(false);
+        assert!(reserve_warm_tick(&mut last, 100, &warming));
+        warming.store(false, Ordering::Release);
+        assert!(reserve_warm_tick(&mut last, 0, &warming));
+    }
+}
