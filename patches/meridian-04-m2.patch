+        return Err("invalid live cooldown state".into());
+    }
+    Ok(Some((
+        attributes.values,
+        cooldowns
+            .into_iter()
+            .map(|(group, elapsed, total)| (group, total - elapsed))
+            .collect(),
+    )))
