+//! Owner-filtered read-only terrain readers, independent of the active player lane.
+use crate::{
+    TargetBackend,
+    configure::configure,
+    prepare::Target,
+    session::{SessionHandle, add, encode},
+};
+use horizon_protocol::{
+    buf::Reader, connection::Closer, ids::play::clientbound as c, packets::play,
+};
+use meridian_ghost::Packet;
+use meridian_net::{Profile, backend};
+use std::{
+    collections::{HashMap, hash_map::DefaultHasher},
+    hash::{Hash, Hasher},
+    sync::Mutex,
+    time::Duration,
+};
+
+/// Static column ownership. All entries use the same coordinate space.
+#[derive(Clone)]
+pub struct TerrainOwners {
+    pub origin: [i32; 2],
+    pub edge: i32,
+    pub entries: Vec<[i32; 2]>,
+    pub backends: Vec<String>,
+}
+pub(crate) struct Terrain {
+    owners: TerrainOwners,
+    loaded: HashMap<(i32, i32), usize>,
+    signatures: HashMap<(i32, i32), u64>,
+    reset: bool,
+    initial: Option<[f64; 3]>,
+    radius: i32,
+    center: Option<(i32, i32)>,
+}
+impl TerrainOwners {
+    fn owner(&self, x: i32, z: i32) -> Option<usize> {
+        let x = (i64::from(x) * 16 - i64::from(self.origin[0])).div_euclid(i64::from(self.edge));
+        let z = (i64::from(z) * 16 - i64::from(self.origin[1])).div_euclid(i64::from(self.edge));
+        self.entries
+            .iter()
+            .position(|p| i64::from(p[0]) == x && i64::from(p[1]) == z)
+    }
+}
+/// The manager owns the connection, closing it on session exit or setup failure.
+pub struct TerrainReader(Closer);
+impl Drop for TerrainReader {
+    fn drop(&mut self) {
+        self.0.close();
+    }
+}
+
+pub(crate) fn packet(id: i32) -> bool {
+    matches!(
+        id,
+        c::LEVEL_CHUNK_WITH_LIGHT
+            | c::FORGET_LEVEL_CHUNK
+            | c::LIGHT_UPDATE
+            | c::BLOCK_UPDATE
+            | c::SECTION_BLOCKS_UPDATE
+            | c::BLOCK_ENTITY_DATA
+            | c::BLOCK_EVENT
+            | c::LEVEL_EVENT
+            | c::SOUND
+            | c::CHUNKS_BIOMES
+            | c::SET_CHUNK_CACHE_CENTER
+            | c::SET_CHUNK_CACHE_RADIUS
+            | c::CHUNK_BATCH_START
+            | c::CHUNK_BATCH_FINISHED
+    )
+}
+fn column(id: i32, payload: &[u8]) -> Option<(i32, i32)> {
+    if id == c::LEVEL_CHUNK_WITH_LIGHT {
+        let mut r = Reader::new(payload);
+        return Some((r.i32().ok()?, r.i32().ok()?));
+    }
+    match play::Clientbound::decode(id, payload).ok()? {
+        play::Clientbound::ForgetLevelChunk(p) => Some((p.pos[0], p.pos[1])),
+        play::Clientbound::LightUpdate(p) => Some((p.x, p.z)),
+        play::Clientbound::BlockUpdate(p) => Some((p.pos[0] >> 4, p.pos[2] >> 4)),
+        play::Clientbound::SectionBlocksUpdate(p) => Some((p.section[0], p.section[2])),
+        play::Clientbound::BlockEntityData(p) => Some((p.pos[0] >> 4, p.pos[2] >> 4)),
+        play::Clientbound::BlockEvent(p) => Some((p.pos[0] >> 4, p.pos[2] >> 4)),
+        play::Clientbound::LevelEvent(p) if !p.global => Some((p.pos[0] >> 4, p.pos[2] >> 4)),
+        play::Clientbound::Sound(p) => Some((p.x.div_euclid(128), p.z.div_euclid(128))),
+        _ => None,
+    }
+}
+impl SessionHandle {
+    pub(crate) fn composed_arrival_ready(
+        &self,
+        view: &meridian_ghost::View,
+        backend: &str,
+        at: [f64; 3],
+    ) -> bool {
+        let down = self.0.down();
+        let Some(terrain) = &down.terrain else {
+            return false;
+        };
+        let Some(owner) = terrain.owners.backends.iter().position(|b| b == backend) else {
+            return false;
+        };
+        let (x, z) = ((at[0].floor() as i32) >> 4, (at[2].floor() as i32) >> 4);
+        (-1..=1).all(|dx| {
+            (-1..=1).all(|dz| {
+                let key = (x + dx, z + dz);
+                match terrain.owners.owner(key.0, key.1) {
+                    Some(index) if index == owner => view.has_column(key.0, key.1),
+                    Some(index) => terrain.loaded.get(&key) == Some(&index),
+                    None => false,
+                }
+            })
+        })
+    }
+    /// Opt in before relay starts. Ordinary Meridian sessions keep their original path.
+    pub fn compose_terrain(&self, owners: TerrainOwners) {
+        assert!(owners.edge > 0 && owners.edge % 16 == 0);
+        self.0.down().terrain = Some(Terrain {
+            owners,
+            loaded: HashMap::new(),
+            signatures: HashMap::new(),
+            reset: false,
+            initial: None,
+            radius: 3,
+            center: None,
+        });
+    }
+    /// The actual client pose, falling back to the first server placement during login.
+    pub fn terrain_position(&self) -> Option<[f64; 3]> {
+        let down = self.0.down();
+        let up = self.0.up();
+        up.authoritative_pose
+            .map(|(_, pose)| pose)
+            .or(up.client_pose)
+            .map(|p| p.at)
+            .or_else(|| down.terrain.as_ref()?.initial)
+    }
+    pub fn terrain_center(&self, position: [f64; 3]) -> Result<(), String> {
+        let center = (
+            (position[0].floor() as i32) >> 4,
+            (position[2].floor() as i32) >> 4,
+        );
+        let mut down = self.0.down();
+        let Some(terrain) = &mut down.terrain else {
+            return Ok(());
+        };
+        if terrain.center == Some(center) {
+            return Ok(());
+        }
+        terrain.center = Some(center);
+        let packet = Packet::of(&play::Clientbound::SetChunkCacheCenter(
+            play::SetChunkCacheCenter {
+                x: center.0,
+                z: center.1,
+            },
+        ));
+        let mut body = Vec::new();
+        encode(&mut body, packet.id, &packet.payload);
+        down.writer.send(&body).map_err(|e| e.to_string())?;
+        let _ = down.ghost.apply(&packet);
+        Ok(())
+    }
+    pub fn terrain_reset_requested(&self) -> bool {
+        self.0
+            .down()
+            .terrain
+            .as_mut()
+            .is_some_and(|t| std::mem::take(&mut t.reset))
+    }
+    /// Synthetic profile for one private reader. Never use the actual player's identity.
+    pub fn terrain_profile(&self, index: usize) -> Profile {
+        let mut uuid = self.0.profile.uuid;
+        uuid[0] ^= 0xa7;
+        uuid[1] ^= index as u8;
+        Profile {
+            name: format!(
+                "E12View{index}{:08x}",
+                u32::from_be_bytes(uuid[12..].try_into().expect("four bytes"))
+            ),
+            uuid,
+            properties: Vec::new(),
+        }
+    }
+    pub fn open_terrain_reader(
+        &self,
+        target: TargetBackend<'_>,
+        owner: usize,
+        profile: &Profile,
+    ) -> Result<TerrainReader, String> {
+        let (mut client, digest, player_id) = {
+            let down = self.0.down();
+            (
+                self.0.up().client.clone(),
+                down.config_digest.ok_or("client is still configuring")?,
+                down.ghost.player_id().ok_or("client has no player")?,
+            )
+        };
+        if let Some(info) = &mut client.information {
+            // One extra ring keeps next-frame visible columns in the client cache.
+            let mut r = Reader::new(info);
+            let _ = r.string(32767).map_err(|e| e.to_string())?;
+            let at = r.position();
+            if let Some(distance) = info.get_mut(at) {
+                *distance = distance.saturating_add(1).min(32);
+            }
+        }
+        let mut link =
+            backend::connect(target.address, profile, target.options).map_err(|e| e.to_string())?;
+        link.connection
+            .reader
+            .set_read_timeout(Some(Duration::from_secs(8)))
+            .map_err(|e| e.to_string())?;
+        let (observed, _) = configure(&mut link.connection, &client)?;
+        if digest.differs(&observed).is_some() {
+            return Err("observer registry digest differs".into());
+        }
+        link.connection
+            .reader
+            .set_read_timeout(None)
+            .map_err(|e| e.to_string())?;
+        let (mut reader, writer) = link.connection.split();
+        let closer = reader.closer().map_err(|e| e.to_string())?;
+        let handle = TerrainReader(closer);
+        let session = self.clone();
+        std::thread::Builder::new()
+            .name(format!("terrain-{owner}"))
+            .spawn(move || {
+                let writer = Mutex::new(writer);
+                let target = Target::terrain_reader(player_id);
+                let mut body = Vec::new();
+                while !session.is_over() {
+                    let Ok((id, payload)) = reader.recv() else {
+                        break;
+                    };
+                    // This answers lane-local flow control. It never relays an observer entity.
+                    target.take(&writer, id, &payload);
+                    let mut packets = Vec::new();
+                    if id == c::CHUNKS_BIOMES {
+                        if let Ok(play::Clientbound::ChunksBiomes(p)) =
+                            play::Clientbound::decode(id, &payload)
+                        {
+                            packets.extend(p.chunks.into_iter().map(|chunk| {
+                                (
+                                    (chunk.pos[0], chunk.pos[1]),
+                                    Packet::of(&play::Clientbound::ChunksBiomes(
+                                        play::ChunksBiomes {
+                                            chunks: vec![chunk],
+                                        },
+                                    )),
+                                )
+                            }));
+                        }
+                    } else if let Some(at) = column(id, &payload) {
+                        packets.push((at, Packet { id, payload }));
+                    }
+                    if packets.is_empty() {
+                        continue;
+                    }
+                    let mut down = session.0.down();
+                    let position = {
+                        let up = session.0.up();
+                        up.authoritative_pose
+                            .map(|(_, pose)| pose)
+                            .or(up.client_pose)
+                            .map(|p| p.at)
+                            .or_else(|| down.terrain.as_ref()?.initial)
+                    };
+                    let Some(position) = position else {
+                        continue;
+                    };
+                    for (at, packet) in packets {
+                        let Some(terrain) = &mut down.terrain else {
+                            return;
+                        };
+                        if terrain.owners.owner(at.0, at.1) != Some(owner) {
+                            continue;
+                        }
+                        let center = (
+                            (position[0].floor() as i32) >> 4,
+                            (position[2].floor() as i32) >> 4,
+                        );
+                        let visible =
+                            (at.0 - center.0).abs().max((at.1 - center.1).abs()) <= terrain.radius;
+                        if packet.id == c::FORGET_LEVEL_CHUNK {
+                            if visible || terrain.loaded.remove(&at).is_none() {
+                                continue;
+                            }
+                            terrain.signatures.remove(&at);
+                        } else if packet.id == c::LEVEL_CHUNK_WITH_LIGHT {
+                            let mut hash = DefaultHasher::new();
+                            packet.payload.hash(&mut hash);
+                            let hash = hash.finish();
+                            if terrain.signatures.insert(at, hash) == Some(hash) {
+                                continue;
+                            }
+                            terrain.loaded.insert(at, owner);
+                        } else if !terrain.loaded.contains_key(&at) {
+                            continue;
+                        }
+                        encode(&mut body, packet.id, &packet.payload);
+                        if down.writer.send(&body).is_err() {
+                            drop(down);
+                            session.close();
+                            return;
+                        }
+                        add(&mut down.flow, &body);
+                        let _ = down.ghost.apply(&packet);
+                    }
+                }
+                // A lost terrain source cannot silently leave stale foreign columns visible.
+                if !session.is_over() {
+                    session.close();
+                }
+            })
+            .map_err(|e| e.to_string())?;
+        Ok(handle)
+    }
+}
+pub(crate) fn initial(terrain: &mut Terrain, id: i32, payload: &[u8]) {
+    if id == c::RESPAWN {
+        terrain.loaded.clear();
+        terrain.signatures.clear();
+        terrain.initial = None;
+        terrain.center = None;
+        terrain.reset = true;
+    }
+    if id == c::LOGIN {
+        if let Ok(play::Clientbound::Login(p)) = play::Clientbound::decode(id, payload) {
+            terrain.radius = p.chunk_radius;
+        }
+    } else if id == c::PLAYER_POSITION
+        && terrain.initial.is_none()
+        && let Ok(play::Clientbound::PlayerPosition(p)) = play::Clientbound::decode(id, payload)
+    {
+        terrain.initial = Some(p.position);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn negative_columns_use_the_same_half_open_owner() {
+        let owners = TerrainOwners {
+            origin: [0, 0],
+            edge: 64,
+            entries: vec![[0, 0], [-1, 0], [-1, -1], [0, -1]],
+            backends: vec!["a".into(), "b".into(), "c".into(), "d".into()],
+        };
+        assert_eq!(owners.owner(0, 0), Some(0));
+        assert_eq!(owners.owner(-1, 0), Some(1));
+        assert_eq!(owners.owner(-4, -4), Some(2));
+        assert_eq!(owners.owner(0, -1), Some(3));
+        assert_eq!(owners.owner(-5, 0), None);
+    }
+    #[test]
+    fn entity_and_player_state_are_never_terrain() {
+        for id in [
+            c::ADD_ENTITY,
+            c::SET_ENTITY_DATA,
+            c::SET_ENTITY_MOTION,
+            c::SET_PASSENGERS,
+            c::PLAYER_POSITION,
+            c::CONTAINER_SET_CONTENT,
+            c::SOUND_ENTITY,
+        ] {
+            assert!(!packet(id));
+        }
+    }
+}
