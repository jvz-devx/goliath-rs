diff --git a/crates/meridian-proxy/src/terrain.rs b/crates/meridian-proxy/src/terrain.rs
new file mode 100644
--- /dev/null
+++ b/crates/meridian-proxy/src/terrain.rs
@@ -0,0 +1,132 @@
+//! Lifetimes and recenter requests for private, read-only per-tile terrain readers.
+use meridian_config::Config;
+use meridian_handoff::{SessionHandle, TargetBackend, TerrainOwners};
+use meridian_net::backend::BackendOptions;
+use std::{
+    net::IpAddr,
+    time::{Duration, Instant},
+};
+
+pub(crate) fn start(
+    config: &Config,
+    handle: &SessionHandle,
+    address: IpAddr,
+) -> Result<(), String> {
+    if std::env::var_os("GOLIATH_CLUSTER").is_none()
+        || std::env::var_os("E12_TERRAIN_OFF").is_some()
+    {
+        return Ok(());
+    }
+    let Some(map) = config.tiles.clone() else {
+        return Ok(());
+    };
+    let endpoints = map
+        .entries
+        .iter()
+        .map(|t| crate::cluster::terrain_endpoint(&t.backend))
+        .collect::<Result<Vec<_>, _>>()?;
+    handle.compose_terrain(TerrainOwners {
+        origin: map.origin,
+        edge: map.edge,
+        entries: map.entries.iter().map(|t| t.index).collect(),
+        backends: map.entries.iter().map(|t| t.backend.clone()).collect(),
+    });
+    let config = config.clone();
+    let handle = handle.clone();
+    std::thread::Builder::new()
+        .name("terrain-manager".into())
+        .spawn(move || {
+            let run = || -> Result<(), String> {
+                let options = BackendOptions {
+                    forwarding_secret: config.forwarding_secret.as_bytes().to_vec(),
+                    connect_timeout: Duration::from_millis(config.connect_timeout_ms),
+                    player_address: address,
+                };
+                let timeout = Duration::from_secs(8);
+                let mut readers = Vec::new();
+                let mut profiles = Vec::new();
+                let mut last_center = None;
+                let mut refreshed = Instant::now();
+                while !handle.is_over() {
+                    let Some(position) = handle.terrain_position() else {
+                        std::thread::sleep(Duration::from_millis(20));
+                        continue;
+                    };
+                    let center = (
+                        (position[0].floor() as i32) >> 4,
+                        (position[2].floor() as i32) >> 4,
+                    );
+                    if !readers.is_empty() && handle.terrain_reset_requested() {
+                        for (endpoint, id) in endpoints.iter().zip(&profiles) {
+                            let reply = endpoint
+                                .ask(&format!("player-observe-reset {id}"), timeout)
+                                .map_err(|e| e.to_string())?;
+                            if reply["ok"] != true {
+                                return Err(format!("observer reset refused: {reply}"));
+                            }
+                        }
+                        last_center = None;
+                    }
+                    if readers.is_empty() {
+                        for (index, tile) in map.entries.iter().enumerate() {
+                            let profile = handle.terrain_profile(index);
+                            let id = horizon_protocol::crypto::uuid_string(u128::from_be_bytes(
+                                profile.uuid,
+                            ));
+                            let reply = endpoints[index]
+                                .ask(
+                                    &format!("player-observe {id} {}", serde_json::json!(position)),
+                                    timeout,
+                                )
+                                .map_err(|e| e.to_string())?;
+                            if reply["ok"] != true {
+                                return Err(format!("observer prepare refused: {reply}"));
+                            }
+                            let backend = config
+                                .backend(&tile.backend)
+                                .ok_or("missing terrain backend")?;
+                            readers.push(handle.open_terrain_reader(
+                                TargetBackend {
+                                    name: &tile.backend,
+                                    address: &backend.address,
+                                    options: &options,
+                                },
+                                index,
+                                &profile,
+                            )?);
+                            profiles.push(id);
+                        }
+                    }
+                    if last_center != Some(center) || refreshed.elapsed() >= Duration::from_secs(5)
+                    {
+                        handle.terrain_center(position)?;
+                        for (index,(endpoint, id)) in endpoints.iter().zip(&profiles).enumerate() {
+                            let reply = endpoint
+                                .ask(
+                                    &format!("player-observe {id} {}", serde_json::json!(position)),
+                                    timeout,
+                                )
+                                .map_err(|e| e.to_string())?;
+                            if reply["ok"] != true {
+                                return Err(format!("observer recenter refused: {reply}"));
+                            }
+                            if std::env::var_os("E12_TERRAIN_TRACE").is_some() {
+                                eprintln!("E12_TERRAIN {}",serde_json::json!({"owner":index,"position":position,"ns":std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).expect("clock").as_nanos()}));
+                            }
+                        }
+                        last_center = Some(center);
+                        refreshed = Instant::now();
+                    }
+                    std::thread::sleep(Duration::from_millis(20));
+                }
+                drop(readers);
+                Ok(())
+            };
+            if let Err(error) = run() {
+                crate::log::warning!("terrain composition stopped: {error}");
+                handle.close();
+            }
+        })
+        .map_err(|e| e.to_string())?;
+    Ok(())
+}
