+fn keep_own_metadata(extras: &mut Vec<Packet>, mut packet: Packet) {
+    if let Ok(C::SetEntityData(mut next)) = packet.decode() {
+        for old in extras.iter().filter(|p| p.id == c::SET_ENTITY_DATA) {
+            if let Ok(C::SetEntityData(old)) = old.decode() {
