+        let low = i64::from(origin[axis]) + i64::from(edge) * i64::from(tile[axis]);
+        let coordinate = position[if axis == 0 { 0 } else { 2 }];
+        coordinate >= low as f64 - margin && coordinate < (low + i64::from(edge)) as f64 + margin
+    })
+}
 
