--- /dev/null
+++ b/crates/meridian-handoff/src/path_timing.rs
@@ -0,0 +1,111 @@
+//! Optional complete write-latency histograms, including buffered and frozen inputs.
+use std::{
+    cell::Cell,
+    sync::{
+        OnceLock,
+        atomic::{AtomicU64, Ordering},
+    },
+    time::Instant,
+};
+
+const BUCKETS: usize = 10_001;
+const STEP_US: u64 = 10;
+
+#[derive(Clone, Copy)]
+pub(crate) enum Path {
+    Client = 0,
+    Backend = 1,
+    Reader = 2,
+    Activation = 3,
+}
+
+struct Histogram {
+    bins: [AtomicU64; BUCKETS],
+    maximum: AtomicU64,
+    unstamped: AtomicU64,
+}
+impl Histogram {
+    const fn new() -> Self {
+        Self {
+            bins: [const { AtomicU64::new(0) }; BUCKETS],
+            maximum: AtomicU64::new(0),
+            unstamped: AtomicU64::new(0),
+        }
+    }
+}
+static HISTOGRAMS: [Histogram; 4] = [const { Histogram::new() }; 4];
+thread_local! { static READ: Cell<Option<Instant>> = const { Cell::new(None) }; }
+
+pub(crate) fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| std::env::var_os("E18_PATH_TIMING").is_some())
+}
+
+pub(crate) fn stamp(at: Option<Instant>) {
+    READ.set(at);
+}
+pub(crate) fn current() -> Option<Instant> {
+    READ.get()
+}
+
+pub(crate) fn record(path: Path, began: Option<Instant>, completed: Instant) {
+    if !enabled() {
+        return;
+    }
+    let histogram = &HISTOGRAMS[path as usize];
+    let Some(began) = began else {
+        histogram.unstamped.fetch_add(1, Ordering::Relaxed);
+        return;
+    };
+    let micros = completed
+        .saturating_duration_since(began)
+        .as_micros()
+        .min(u128::from(u64::MAX)) as u64;
+    let bucket = (micros / STEP_US).min((BUCKETS - 1) as u64) as usize;
+    histogram.bins[bucket].fetch_add(1, Ordering::Relaxed);
+    histogram.maximum.fetch_max(micros, Ordering::Relaxed);
+}
+
+/// Console-owned snapshot/reset. No histograms or queues grow with packet count.
+pub fn path_timing(reset: bool) -> serde_json::Value {
+    let mut output = serde_json::Map::new();
+    for (name, histogram) in [
+        "clientbound",
+        "serverbound",
+        "reader-replies",
+        "activation-ack",
+    ]
+    .into_iter()
+    .zip(&HISTOGRAMS)
+    {
+        let read = |counter: &AtomicU64| {
+            if reset {
+                counter.swap(0, Ordering::Relaxed)
+            } else {
+                counter.load(Ordering::Relaxed)
+            }
+        };
+        let bins: Vec<_> = histogram.bins.iter().map(read).collect();
+        let count: u64 = bins.iter().sum();
+        let percentile = |numerator: u64| {
+            let rank = (count * numerator).div_ceil(100);
+            let mut seen = 0;
+            for (index, value) in bins.iter().enumerate() {
+                seen += value;
+                if count > 0 && seen >= rank {
+                    return (index < BUCKETS - 1).then_some((index as u64 + 1) * STEP_US);
+                }
+            }
+            None
+        };
+        let nonzero: std::collections::BTreeMap<_, _> = bins
+            .iter()
+            .enumerate()
+            .filter_map(|(index, count)| (*count > 0).then_some((index as u64 * STEP_US, *count)))
+            .collect();
+        output.insert(name.into(), serde_json::json!({"count":count,"p50_us_upper":percentile(50),"p95_us_upper":percentile(95),"p99_us_upper":percentile(99),
+            "maximum_us":read(&histogram.maximum),"overflow_at_100ms":bins[BUCKETS-1],"unstamped_writes":read(&histogram.unstamped),"bins_us":nonzero}));
+    }
+    serde_json::json!({"enabled":enabled(),"reset":reset,"scope":"first decoded frame read in each socket read burst to completed socket write; activation inputs use activation acknowledgement",
+        "bin_width_us":STEP_US,"paths":output})
+}
