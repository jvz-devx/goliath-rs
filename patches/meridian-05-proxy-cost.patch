--- /dev/null
+++ b/crates/meridian-handoff/src/drain.rs
@@ -0,0 +1,268 @@
+//! Bounded packet writes flushed at the end of an already-buffered read burst.
+use crate::path_timing::{self, Path};
+use crate::session::{Lane, Shared, lock};
+use horizon_protocol::{
+    Result,
+    connection::{ConnReader, ConnWriter},
+    frame,
+};
+use std::{sync::Arc, time::Instant};
+
+const WRITE_CAP: usize = 64 * 1024;
+
+pub(crate) struct Writer {
+    inner: ConnWriter,
+    pending: Vec<u8>,
+    drains: usize,
+    broken: bool,
+    batching: bool,
+    path: Path,
+    stamps: Vec<Option<Instant>>,
+}
+
+impl Writer {
+    pub(crate) fn new(inner: ConnWriter) -> Self {
+        Self {
+            inner,
+            pending: Vec::new(),
+            drains: 0,
+            broken: false,
+            batching: std::env::var_os("E18_WRITES_DIRECT").is_none(),
+            path: Path::Backend,
+            stamps: Vec::new(),
+        }
+    }
+
+    pub(crate) fn client(inner: ConnWriter) -> Self {
+        Self {
+            path: Path::Client,
+            ..Self::new(inner)
+        }
+    }
+    pub(crate) fn observer(inner: ConnWriter) -> Self {
+        Self {
+            path: Path::Reader,
+            ..Self::new(inner)
+        }
+    }
+
+    pub(crate) fn begin(&mut self) {
+        self.drains += 1;
+    }
+
+    pub(crate) fn end(&mut self) -> Result<()> {
+        self.drains = self.drains.checked_sub(1).expect("balanced read drains");
+        // Flush each completed drain even if another producer is draining too.
+        // Otherwise an overlapping busy lane could indefinitely hold a reply.
+        self.flush()
+    }
+
+    pub(crate) fn flush(&mut self) -> Result<()> {
+        if self.broken {
+            return Err(horizon_protocol::Error::new(
+                "a coalesced write already failed",
+            ));
+        }
+        if !self.pending.is_empty() {
+            if let Err(error) = self.inner.write_raw(&self.pending) {
+                // A partial encrypted write is uncertain. Never replay that buffer.
+                self.pending.clear();
+                self.stamps.clear();
+                self.broken = true;
+                self.inner.shutdown();
+                return Err(error);
+            }
+            self.pending.clear();
+            let completed = Instant::now();
+            for stamp in self.stamps.drain(..) {
+                path_timing::record(self.path, stamp, completed);
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn send(&mut self, body: &[u8]) -> Result<()> {
+        if self.drains == 0 || !self.batching {
+            self.flush()?;
+            self.inner.send(body)?;
+            if path_timing::enabled() {
+                path_timing::record(self.path, path_timing::current(), Instant::now());
+            }
+            return Ok(());
+        }
+        // Meridian accepts only the pinned protocol. There is no backend adapter.
+        // Keep the writer's client conversion and cipher state, never concatenate
+        // plaintext frames after encryption or reorder a direct control write.
+        let Some(body) = self.inner.for_client(body)? else {
+            return Ok(());
+        };
+        let contents = frame::contents(&body, self.inner.threshold)?;
+        if self.pending.len() + contents.len() + 5 > WRITE_CAP || self.stamps.len() >= 2048 {
+            self.flush()?;
+        }
+        if contents.len() + 5 > WRITE_CAP {
+            // One legal large packet uses the ordinary bounded protocol path.
+            self.inner.send_contents(&contents)?;
+            if path_timing::enabled() {
+                path_timing::record(self.path, path_timing::current(), Instant::now());
+            }
+            return Ok(());
+        }
+        self.inner.frame_into(&contents, &mut self.pending);
+        if path_timing::enabled() {
+            self.stamps.push(path_timing::current());
+        }
+        Ok(())
+    }
+}
+
+/// A drain owns no thread or timer. It never waits for another packet before
+/// flushing. Ordinary blocking reads still provide the existing backpressure.
+pub(crate) struct ReadDrain<'a> {
+    shared: &'a Shared,
+    client: bool,
+    lane: Option<Arc<Lane>>,
+    arrived: Option<Instant>,
+}
+
+impl<'a> ReadDrain<'a> {
+    pub(crate) fn new(shared: &'a Shared, client: bool) -> Self {
+        Self {
+            shared,
+            client,
+            lane: None,
+            arrived: None,
+        }
+    }
+
+    pub(crate) fn next(
+        &mut self,
+        reader: &mut ConnReader,
+        lane: impl FnOnce() -> Arc<Lane>,
+    ) -> Result<(i32, Vec<u8>)> {
+        if self.lane.is_some() {
+            if let Some(packet) = reader.buffered()? {
+                path_timing::stamp(self.arrived);
+                return Ok(packet);
+            }
+            self.finish()?;
+        }
+        // There is no outstanding write when this read blocks.
+        let packet = reader.recv()?;
+        self.arrived = path_timing::enabled().then(Instant::now);
+        path_timing::stamp(self.arrived);
+        let lane = lane();
+        if self.client {
+            self.shared.down().writer.begin();
+        }
+        lock(&lane.writer).begin();
+        self.lane = Some(lane);
+        Ok(packet)
+    }
+
+    fn finish(&mut self) -> Result<()> {
+        if let Some(lane) = self.lane.take() {
+            let client = if self.client {
+                self.shared.down().writer.end()
+            } else {
+                Ok(())
+            };
+            let backend = lock(&lane.writer).end();
+            client?;
+            backend?;
+        }
+        path_timing::stamp(None);
+        Ok(())
+    }
+}
+
+impl Drop for ReadDrain<'_> {
+    fn drop(&mut self) {
+        // The caller observes normal end-of-drain errors. On an early exit the
+        // session is already closing, so a final flush failure cannot revive it.
+        let _ = self.finish();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use horizon_protocol::connection::{Connection, Pipe};
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    fn pair() -> (Connection, Connection, Arc<AtomicUsize>) {
+        let (left, right) = Pipe::pair();
+        let writes = Arc::new(AtomicUsize::new(0));
+        let observed = Arc::clone(&writes);
+        right.on_ready(move || {
+            observed.fetch_add(1, Ordering::Relaxed);
+        });
+        (Connection::local(left), Connection::local(right), writes)
+    }
+
+    #[test]
+    fn a_drain_is_one_write_with_compression_encryption_and_fifo() {
+        let (mut source, mut peer, writes) = pair();
+        for connection in [&mut source, &mut peer] {
+            connection.set_compression(32);
+            connection.enable_encryption(&[7; 16]);
+        }
+        let mut writer = Writer::new(source.writer);
+        writer.begin();
+        for index in 0..128u8 {
+            let mut body = vec![index; 512];
+            body[0] = 2;
+            writer.send(&body).unwrap();
+        }
+        assert_eq!(writes.load(Ordering::Relaxed), 0);
+        writer.end().unwrap();
+        assert_eq!(writes.load(Ordering::Relaxed), 1);
+        for index in 0..128u8 {
+            assert_eq!(peer.recv().unwrap(), (2, vec![index; 511]));
+        }
+    }
+
+    #[test]
+    fn the_size_cap_flushes_without_a_timer_or_an_unbounded_queue() {
+        let (source, mut peer, writes) = pair();
+        let mut writer = Writer::new(source.writer);
+        writer.begin();
+        for _ in 0..100 {
+            writer.send(&vec![1; 1000]).unwrap();
+            assert!(writer.pending.len() <= WRITE_CAP);
+        }
+        assert!(writes.load(Ordering::Relaxed) > 0);
+        writer.end().unwrap();
+        for _ in 0..100 {
+            assert_eq!(peer.recv().unwrap(), (1, vec![1; 999]));
+        }
+    }
+
+    #[test]
+    fn an_overlapping_producer_cannot_hold_the_completed_drain() {
+        let (source, mut peer, writes) = pair();
+        let mut writer = Writer::new(source.writer);
+        writer.begin();
+        writer.begin();
+        writer.send(&[1, 2]).unwrap();
+        writer.end().unwrap();
+        assert_eq!(writes.load(Ordering::Relaxed), 1);
+        assert_eq!(peer.recv().unwrap(), (1, vec![2]));
+        writer.send(&[3, 4]).unwrap();
+        writer.end().unwrap();
+        assert_eq!(peer.recv().unwrap(), (3, vec![4]));
+    }
+
+    #[test]
+    fn a_write_failure_discards_the_buffer_and_latches_closed() {
+        let (source, peer, _) = pair();
+        let mut writer = Writer::new(source.writer);
+        writer.begin();
+        writer.send(&[1, 2]).unwrap();
+        peer.writer.shutdown();
+        assert!(writer.end().is_err());
+        assert!(writer.pending.is_empty());
+        assert!(writer.broken);
+        assert!(writer.send(&[3, 4]).is_err());
+    }
+}
