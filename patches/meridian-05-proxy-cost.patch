+pub(crate) fn active(
+    shared: &Shared,
+    down: &mut Down,
+    packet: Packet,
+    body: &mut Vec<u8>,
+) -> horizon_protocol::Result<()> {
+    let Some(terrain) = &down.terrain else {
+        return Ok(());
+    };
+    if !terrain.lazy {
+        return Ok(());
+    }
+    let Some(owner) = terrain
+        .owners
+        .backends
+        .iter()
+        .position(|name| name == &down.backend)
+    else {
+        return Ok(());
+    };
+    relay(shared, down, owner, false, packet, body)
+}
+
+fn relay(
+    shared: &Shared,
+    down: &mut Down,
+    owner: usize,
+    reader: bool,
+    packet: Packet,
+    body: &mut Vec<u8>,
+) -> horizon_protocol::Result<()> {
+    let mut packets = Vec::new();
+    if packet.id == c::CHUNKS_BIOMES {
+        if let Ok(play::Clientbound::ChunksBiomes(p)) = packet.decode() {
+            packets.extend(p.chunks.into_iter().map(|chunk| {
+                (
+                    (chunk.pos[0], chunk.pos[1]),
+                    Packet::of(&play::Clientbound::ChunksBiomes(play::ChunksBiomes {
+                        chunks: vec![chunk],
+                    })),
+                )
+            }));
+        }
+    } else if let Some(at) = column(packet.id, &packet.payload) {
+        packets.push((at, packet));
+    }
+    if packets.is_empty() {
+        return Ok(());
+    }
+    let position = {
+        let up = shared.up();
+        up.authoritative_pose
+            .map(|(_, pose)| pose)
+            .or(up.client_pose)
+            .map(|p| p.at)
+            .or_else(|| down.terrain.as_ref()?.initial)
+    };
+    let Some(position) = position else {
+        return Ok(());
+    };
+    let active = down.backend.clone();
+    for (at, packet) in packets {
+        let Some(terrain) = &mut down.terrain else {
+            return Ok(());
+        };
+        if terrain.owners.owner(at.0, at.1) != Some(owner) {
+            continue;
+        }
+        if reader {
+            let columns = terrain.reader_columns.entry(owner).or_default();
+            if packet.id == c::LEVEL_CHUNK_WITH_LIGHT {
+                columns.insert(at);
+            }
+            if packet.id == c::FORGET_LEVEL_CHUNK {
+                columns.remove(&at);
+            }
+            // While active, this reader is only a prewarmed replacement for the
+            // source's terrain stream. Its entities and terrain remain hidden.
+            if terrain.lazy && terrain.owners.backends.get(owner) == Some(&active) {
+                continue;
+            }
+        }
+        let center = (
+            (position[0].floor() as i32) >> 4,
+            (position[2].floor() as i32) >> 4,
+        );
+        let visible = (at.0 - center.0).abs().max((at.1 - center.1).abs()) <= terrain.radius;
+        if packet.id == c::FORGET_LEVEL_CHUNK {
+            if visible || terrain.loaded.remove(&at).is_none() {
+                continue;
+            }
+            terrain.signatures.remove(&at);
+        } else if packet.id == c::LEVEL_CHUNK_WITH_LIGHT {
+            let mut hash = DefaultHasher::new();
+            packet.payload.hash(&mut hash);
+            let hash = hash.finish();
+            if terrain.signatures.insert(at, hash) == Some(hash) {
+                continue;
+            }
+            terrain.loaded.insert(at, owner);
+        } else if !terrain.loaded.contains_key(&at) {
+            continue;
+        }
+        encode(body, packet.id, &packet.payload);
+        down.writer.send(body)?;
+        add(&mut down.flow, body);
+        let _ = down.ghost.apply(&packet);
+    }
+    Ok(())
+}
