diff --git a/crates/horizon-core/src/authority.rs b/crates/horizon-core/src/authority.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-core/src/authority.rs
@@ -0,0 +1,22 @@
+//! Caller-owned local authority checks at server side-effect boundaries, without IO here.
+use std::{
+    sync::{Arc, OnceLock},
+    time::Duration,
+};
+
+type Gate = dyn Fn(Duration) -> bool + Send + Sync;
+static GATE: OnceLock<Arc<Gate>> = OnceLock::new();
+
+/// Install before opening a clustered server to players. Standalone worlds need no gate.
+pub fn install(gate: Arc<Gate>) -> Result<(), &'static str> {
+    GATE.set(gate)
+        .map_err(|_| "server authority gate already installed")
+}
+/// No lease lock may be held across IO by the owner of this callback.
+pub fn may_act() -> bool {
+    can_finish(Duration::ZERO)
+}
+/// Reserve a bounded critical section inside the current local authorization window.
+pub fn can_finish(budget: Duration) -> bool {
+    GATE.get().is_none_or(|gate| gate(budget))
+}
