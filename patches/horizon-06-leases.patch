diff --git a/crates/horizon-client/src/game/dedicated/cluster/lease.rs b/crates/horizon-client/src/game/dedicated/cluster/lease.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/dedicated/cluster/lease.rs
@@ -0,0 +1,341 @@
+//! Horizon-owned lease claims, renewal scheduling and suspend-safe local action gates.
+use goliath_store::{
+    Client, Command, Fence, LeaseKeeper, Operation, Response, StoreFault, TileId, request_id,
+};
+use horizon_client::Result;
+use serde_json::{Value, json};
+use std::{
+    sync::{Arc, Mutex, OnceLock},
+    time::{Duration, Instant},
+};
+
+struct Clock {
+    before: Instant,
+    after: Instant,
+    continuous: Duration,
+}
+impl Clock {
+    fn new() -> Option<Self> {
+        let before = Instant::now();
+        let continuous = continuous()?;
+        let after = Instant::now();
+        Some(Self {
+            before,
+            after,
+            continuous,
+        })
+    }
+    fn advance_with(&mut self, next: Self) -> Option<Instant> {
+        // Bracket the continuous-clock read. A scheduling pause between reads widens
+        // the interval, rather than being mistaken for a suspended uptime clock.
+        let maximum = next.after.checked_duration_since(self.before)?;
+        let minimum = next
+            .before
+            .checked_duration_since(self.after)
+            .unwrap_or_default();
+        let elapsed = next.continuous.checked_sub(self.continuous)?;
+        let slack = maximum / 500 + Duration::from_micros(1);
+        if elapsed > maximum.checked_add(slack)? || elapsed.checked_add(slack)? < minimum {
+            return None;
+        }
+        let after = next.after;
+        *self = next;
+        Some(after)
+    }
+    fn advancing(&mut self) -> Option<Instant> {
+        self.advance_with(Self::new()?)
+    }
+}
+#[cfg(target_os = "macos")]
+fn continuous() -> Option<Duration> {
+    // macOS clock_gettime(3): CLOCK_MONOTONIC advances during sleep, unlike uptime.
+    let time = rustix::time::clock_gettime(rustix::time::ClockId::Monotonic);
+    Some(Duration::new(
+        u64::try_from(time.tv_sec).ok()?,
+        u32::try_from(time.tv_nsec).ok()?,
+    ))
+}
+#[cfg(target_os = "linux")]
+fn continuous() -> Option<Duration> {
+    let time = rustix::time::clock_gettime(rustix::time::ClockId::Boottime);
+    Some(Duration::new(
+        u64::try_from(time.tv_sec).ok()?,
+        u32::try_from(time.tv_nsec).ok()?,
+    ))
+}
+#[cfg(not(any(target_os = "macos", target_os = "linux")))]
+fn continuous() -> Option<Duration> {
+    None
+}
+struct State {
+    keeper: LeaseKeeper,
+    clock: Clock,
+}
+struct Authority {
+    state: Mutex<State>,
+    fence: Fence,
+}
+static AUTHORITY: OnceLock<Arc<Authority>> = OnceLock::new();
+
+impl Authority {
+    fn check(&self, budget: Duration) -> bool {
+        let Ok(mut state) = self.state.lock() else {
+            return false;
+        };
+        let Some(now) = state.clock.advancing() else {
+            state.keeper.stop();
+            return false;
+        };
+        state.keeper.may_act(now)
+            && state
+                .keeper
+                .deadline()
+                .and_then(|deadline| deadline.checked_duration_since(now))
+                .is_some_and(|left| left > budget)
+    }
+}
+pub(super) fn fence() -> Result<Fence> {
+    Ok(AUTHORITY
+        .get()
+        .ok_or("cluster lease not initialized")?
+        .fence)
+}
+pub(in crate::game::dedicated) fn require() -> Result<()> {
+    if std::env::var_os("GOLIATH_STORE").is_some() && !horizon_core::authority::may_act() {
+        return Err("cluster lease expired or local clock stopped; queued effects refused".into());
+    }
+    Ok(())
+}
+pub(in crate::game::dedicated) fn authority_status() -> Value {
+    match AUTHORITY.get() {
+        Some(authority) => {
+            json!({"ok":true,"leased":true,"authorized":authority.check(Duration::ZERO),"tile":authority.fence.tile.0,"process":authority.fence.process.0,"epoch":authority.fence.epoch.0,
+            "token":format!("{}:{}",authority.fence.process.0,authority.fence.epoch.0)})
+        }
+        None => json!({"ok":true,"leased":false}),
+    }
+}
+pub(in crate::game::dedicated) fn initialize() -> Result<()> {
+    let Ok(address) = std::env::var("GOLIATH_STORE") else {
+        return Ok(());
+    };
+    let tile = TileId(std::env::var("GOLIATH_TILE_ID")?.parse()?);
+    let lease_ms = std::env::var("GOLIATH_LEASE_MS")
+        .unwrap_or_else(|_| "1000".into())
+        .parse::<u64>()?;
+    let margin = Duration::from_millis(
+        std::env::var("GOLIATH_LEASE_MARGIN_MS")
+            .unwrap_or_else(|_| "100".into())
+            .parse()?,
+    );
+    let address = address.parse()?;
+    if LeaseKeeper::new(tile, lease_ms, margin).is_none()
+        || Duration::from_millis(lease_ms)
+            .checked_sub(margin)
+            .is_none_or(|window| window <= Duration::from_millis(200))
+        || margin.as_millis() * 1001 < u128::from(lease_ms) * 2
+        || Clock::new().is_none()
+    {
+        return Err(
+            "lease configuration cannot provide the clock margin and bounded IO window".into(),
+        );
+    }
+    let client = Client::new(address, Duration::from_millis(200), 1)?;
+    if let Response::Directory(entries) = client.execute(Operation::Directory)?
+        && let Some(old) = entries
+            .iter()
+            .find(|entry| entry.fence.tile == tile && entry.active)
+    {
+        if std::env::var("GOLIATH_LEASE_TAKEOVER").as_deref() != Ok("1") {
+            return Err("active tile holder exists; explicit leased takeover required".into());
+        }
+        match client.execute(Operation::CheckLease(old.fence))? {
+            Response::Fault(StoreFault::LeaseRequired) => {
+                return Err("stop and release every legacy holder before enabling leases".into());
+            }
+            Response::Ok => {
+                let _ = client.execute(Operation::BeginTakeover(old.fence))?;
+            }
+            // Expiry or a newer fence between Directory and CheckLease is not a legacy
+            // upgrade. The fresh claim still has to pass the store's retained wait.
+            _ => {}
+        }
+    }
+    let until = Instant::now() + Duration::from_secs(10);
+    let (keeper, clock) = loop {
+        let mut clock =
+            Clock::new().ok_or("cluster lease needs a suspend-aware monotonic clock")?;
+        match client.claim_lease(tile, lease_ms, margin) {
+            Ok(mut keeper) => {
+                if clock.advancing().is_none() {
+                    keeper.stop();
+                    return Err("clock anomaly during lease claim".into());
+                }
+                break (keeper, clock);
+            }
+            Err(error) => {
+                if Instant::now() >= until {
+                    return Err(error.into());
+                }
+                std::thread::sleep(Duration::from_millis(20));
+            }
+        }
+    };
+    let fence = keeper.fence().ok_or("lease claim returned no fence")?;
+    let authority = Arc::new(Authority {
+        state: Mutex::new(State { keeper, clock }),
+        fence,
+    });
+    AUTHORITY
+        .set(Arc::clone(&authority))
+        .map_err(|_| "cluster lease already initialized")?;
+    let gate = Arc::clone(&authority);
+    horizon_core::authority::install(Arc::new(move |budget| gate.check(budget)))?;
+    // Horizon owns this thread, not the store/model libraries. No keeper lock spans IO.
+    std::thread::Builder::new()
+        .name("goliath-lease".into())
+        .spawn(move || {
+            let period = Duration::from_millis((lease_ms / 4).max(1));
+            loop {
+                std::thread::sleep(period);
+                let ticket = {
+                    let Ok(mut state) = authority.state.lock() else {
+                        break;
+                    };
+                    let Some(now) = state.clock.advancing() else {
+                        state.keeper.stop();
+                        break;
+                    };
+                    let Some(ticket) = state.keeper.request(now) else {
+                        break;
+                    };
+                    ticket
+                };
+                let command = Command {
+                    id: request_id(),
+                    operation: Operation::RenewLease {
+                        fence,
+                        counter: ticket.counter(),
+                    },
+                };
+                let result = client.call(&command);
+                let Ok(mut state) = authority.state.lock() else {
+                    break;
+                };
+                let Some(now) = state.clock.advancing() else {
+                    state.keeper.stop();
+                    break;
+                };
+                match result {
+                    Ok(Response::Leased(grant)) => {
+                        let previous_deadline = state.keeper.deadline();
+                        if !state.keeper.observe(ticket, grant, now) {
+                            state.keeper.stop();
+                            break;
+                        }
+                        // No action reader can see the new grant before this post-check.
+                        let after = state.clock.advancing();
+                        if after.is_none()
+                            || previous_deadline
+                                .is_some_and(|deadline| after.is_some_and(|now| now >= deadline))
+                        {
+                            state.keeper.stop();
+                            break;
+                        }
+                    }
+                    Ok(_) => {
+                        state.keeper.stop();
+                        break;
+                    }
+                    Err(_) => {
+                        if !state.keeper.may_act(now) {
+                            state.keeper.stop();
+                            break;
+                        }
+                    }
+                }
+            }
+        })?;
+    super::super::tile_cut::claim_cluster_fence(&format!("{}:{}", fence.process.0, fence.epoch.0))?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use goliath_store::{Epoch, LeaseGrant, ProcessId};
+    fn granted(sent: Instant) -> Authority {
+        let fence = Fence {
+            tile: TileId(0),
+            process: ProcessId(1),
+            epoch: Epoch(1),
+        };
+        let mut keeper = LeaseKeeper::new(fence.tile, 1000, Duration::from_millis(100)).unwrap();
+        let ticket = keeper.request(sent).unwrap();
+        assert!(keeper.observe(
+            ticket,
+            LeaseGrant {
+                fence,
+                lease_ms: 1000,
+                counter: 0
+            },
+            sent
+        ));
+        Authority {
+            fence,
+            state: Mutex::new(State {
+                keeper,
+                clock: Clock::new().unwrap(),
+            }),
+        }
+    }
+    #[test]
+    fn expired_action_gate_stays_closed() {
+        let authority = granted(Instant::now() - Duration::from_secs(1));
+        assert!(!authority.check(Duration::ZERO));
+        assert!(
+            !authority
+                .state
+                .lock()
+                .unwrap()
+                .keeper
+                .may_act(Instant::now())
+        );
+    }
+    #[test]
+    fn clock_discontinuity_latches_authority_closed() {
+        let authority = granted(Instant::now());
+        {
+            let mut state = authority.state.lock().unwrap();
+            state.clock.continuous += Duration::from_secs(30);
+        }
+        assert!(!authority.check(Duration::ZERO));
+        {
+            let mut state = authority.state.lock().unwrap();
+            state.clock = Clock::new().unwrap();
+        }
+        assert!(!authority.check(Duration::ZERO));
+    }
+    #[test]
+    fn suspend_is_detected_without_wall_clock_or_real_sleep() {
+        let now = Instant::now();
+        let mut before = Clock {
+            before: now,
+            after: now,
+            continuous: Duration::from_secs(10),
+        };
+        let after = Clock {
+            before: now + Duration::from_millis(1),
+            after: now + Duration::from_millis(1),
+            continuous: Duration::from_secs(40),
+        };
+        assert!(before.advance_with(after).is_none());
+    }
+    #[test]
+    fn critical_budget_cannot_cross_the_deadline() {
+        let authority = granted(Instant::now());
+        assert!(authority.check(Duration::from_millis(100)));
+        assert!(!authority.check(Duration::from_secs(1)));
+        assert!(authority.check(Duration::ZERO));
+    }
+}
