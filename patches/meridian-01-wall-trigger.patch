+/// The ordinary handoff, with the wall's trigger position carried unchanged.
+pub fn wall(
+    config: &Config,
+    switcher: &Switcher,
+    handle: &SessionHandle,
+    name: &str,
+    address: IpAddr,
+    target: &str,
+    position: [f64; 3],
+) -> Result<Moved, String> {
+    let step = Cell::new(metrics::step_label(meridian_handoff::Step::Check));
+    let result = attempt(
+        config,
+        switcher,
+        handle,
+        name,
+        address,
+        (target, Some(position)),
+        &step,
+    );
+    match &result {
+        Ok(moved) => switcher.metrics.transfer_done(&moved.done, moved.took),
+        Err(_) => switcher.metrics.transfer_failed(step.get()),
+    }
+    result
+}
