+//! Transport framing, lifetime and bounded output proofs on loopback TCP.
+use super::*;
+use horizon_protocol::{
+    buf::write_varint,
+    connection::{Connection, Socket},
+};
+use std::{io::Read, net::TcpListener, thread};
+
+struct Echo {
+    output: Arc<Mutex<Option<Output>>>,
+    packets: mpsc::Sender<Vec<u8>>,
+    closed: mpsc::Sender<()>,
+    completed: mpsc::Sender<()>,
+}
+impl Handler for Echo {
+    fn packet(&mut self, id: i32, payload: Vec<u8>, _: Instant) -> io::Result<()> {
+        let mut body = Vec::new();
+        write_varint(&mut body, id);
+        body.extend(payload);
+        self.packets.send(body.clone()).unwrap();
+        let mut frame = Vec::new();
+        write_varint(&mut frame, body.len() as i32);
+        frame.extend(body);
+        let completed = self.completed.clone();
+        self.output.lock().unwrap().as_ref().unwrap().push(
+            frame,
+            Some(Box::new(move |_| {
+                let _ = completed.send(());
+            })),
+        )
+    }
+    fn drained(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+    fn closed(&mut self, _: io::Error) {
+        let _ = self.closed.send(());
+    }
+}
+
+fn pair() -> (StdStream, StdStream) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let client = StdStream::connect(listener.local_addr().unwrap()).unwrap();
+    (client, listener.accept().unwrap().0)
+}
+
+#[test]
+fn fragmented_frames_preserve_fifo_and_complete_only_after_write() {
+    let (pool, mut drivers) = Pool::new(1).unwrap();
+    let (mut peer, stream) = pair();
+    peer.set_read_timeout(Some(Duration::from_secs(2))).unwrap();
+    let (socket, reader, _) = Connection::from_stream(stream).unwrap().detach();
+    let Socket::Tcp(stream) = socket else {
+        panic!("TCP fixture");
+    };
+    let output = Arc::new(Mutex::new(None));
+    let (packets, received) = mpsc::channel();
+    let (closed, ended) = mpsc::channel();
+    let (completed, written) = mpsc::channel();
+    let sink = pool
+        .register(
+            stream,
+            reader,
+            Box::new(Echo {
+                output: Arc::clone(&output),
+                packets,
+                closed,
+                completed,
+            }),
+        )
+        .unwrap();
+    *output.lock().unwrap() = Some(sink.clone());
+    let runner = thread::spawn(move || drivers.pop().unwrap().run().unwrap());
+    peer.write_all(&[3, 1]).unwrap();
+    assert!(received.recv_timeout(Duration::from_millis(20)).is_err());
+    assert!(written.try_recv().is_err());
+    peer.write_all(&[8, 9, 2, 2, 7]).unwrap();
+    assert_eq!(
+        received.recv_timeout(Duration::from_secs(2)).unwrap(),
+        [1, 8, 9]
+    );
+    assert_eq!(
+        received.recv_timeout(Duration::from_secs(2)).unwrap(),
+        [2, 7]
+    );
+    let mut bytes = [0; 7];
+    peer.read_exact(&mut bytes).unwrap();
+    assert_eq!(bytes, [3, 1, 8, 9, 2, 2, 7]);
+    written.recv_timeout(Duration::from_secs(2)).unwrap();
+    written.recv_timeout(Duration::from_secs(2)).unwrap();
+    sink.wait_empty(Duration::from_secs(2)).unwrap();
+    pool.stop();
+    runner.join().unwrap();
+    ended.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert!(sink.push(vec![1], None).is_err());
+}
+
+#[test]
+fn an_over_cap_client_is_closed_without_accepting_more_bytes() {
+    let (pool, mut drivers) = Pool::new(1).unwrap();
+    let (mut peer, stream) = pair();
+    peer.set_read_timeout(Some(Duration::from_secs(2))).unwrap();
+    let (socket, reader, _) = Connection::from_stream(stream).unwrap().detach();
+    let Socket::Tcp(stream) = socket else {
+        panic!("TCP fixture");
+    };
+    let (packets, _) = mpsc::channel();
+    let (closed, ended) = mpsc::channel();
+    let (completed, _) = mpsc::channel();
+    let sink = pool
+        .register(
+            stream,
+            reader,
+            Box::new(Echo {
+                output: Arc::new(Mutex::new(None)),
+                packets,
+                closed,
+                completed,
+            }),
+        )
+        .unwrap();
+    assert!(sink.push(vec![0; OUTPUT_CAP + 1], None).is_err());
+    assert!(sink.push(vec![0], None).is_err());
+    let runner = thread::spawn(move || drivers.pop().unwrap().run().unwrap());
+    assert_eq!(peer.read(&mut [0]).unwrap(), 0);
+    ended.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert!(sink.wait_empty(Duration::from_secs(2)).is_err());
+    pool.stop();
+    runner.join().unwrap();
+}
+
+#[test]
+fn stop_closes_queued_admissions_and_refuses_new_ones() {
+    let (pool, mut drivers) = Pool::new(1).unwrap();
+    let (_peer, stream) = pair();
+    let (socket, reader, _) = Connection::from_stream(stream).unwrap().detach();
+    let Socket::Tcp(stream) = socket else {
+        panic!("TCP fixture");
+    };
+    let (packets, _) = mpsc::channel();
+    let (closed, ended) = mpsc::channel();
+    let (completed, _) = mpsc::channel();
+    let sink = pool
+        .register(
+            stream,
+            reader,
+            Box::new(Echo {
+                output: Arc::new(Mutex::new(None)),
+                packets,
+                closed,
+                completed,
+            }),
+        )
+        .unwrap();
+    pool.stop();
+    pool.stop();
+    drivers.pop().unwrap().run().unwrap();
+    ended.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert!(sink.push(vec![0], None).is_err());
+    assert_eq!(pool.shards[0].slots.load(Ordering::Acquire), 0);
+}
+
+#[test]
+fn dropping_an_unstarted_driver_closes_queued_connections() {
+    let (pool, drivers) = Pool::new(1).unwrap();
+    let (_peer, stream) = pair();
+    let (socket, reader, _) = Connection::from_stream(stream).unwrap().detach();
+    let Socket::Tcp(stream) = socket else {
+        panic!("TCP fixture");
+    };
+    let (packets, _) = mpsc::channel();
+    let (closed, ended) = mpsc::channel();
+    let (completed, _) = mpsc::channel();
+    let sink = pool
+        .register(
+            stream,
+            reader,
+            Box::new(Echo {
+                output: Arc::new(Mutex::new(None)),
+                packets,
+                closed,
+                completed,
+            }),
+        )
+        .unwrap();
+    drop(drivers);
+    ended.recv_timeout(Duration::from_secs(2)).unwrap();
+    assert!(sink.push(vec![0], None).is_err());
+    assert_eq!(pool.shards[0].slots.load(Ordering::Acquire), 0);
+}
+
+#[test]
+fn bytes_queued_before_registration_are_not_lost_with_an_early_dirty_event() {
+    let (pool, mut drivers) = Pool::new(1).unwrap();
+    let (mut peer, stream) = pair();
+    peer.set_read_timeout(Some(Duration::from_secs(2))).unwrap();
+    let (socket, reader, _) = Connection::from_stream(stream).unwrap().detach();
+    let Socket::Tcp(stream) = socket else {
+        panic!("TCP fixture");
+    };
+    let runner = thread::spawn(move || drivers.pop().unwrap().run().unwrap());
+    let (packets, _) = mpsc::channel();
+    let (closed, _) = mpsc::channel();
+    let (completed, _) = mpsc::channel();
+    let sink = pool
+        .register_with(stream, reader, |output| {
+            output.push(vec![3, 1, 2, 3], None).unwrap();
+            let (send, receive) = mpsc::channel();
+            output
+                .shard
+                .commands
+                .try_send(Command::AfterDrain(send))
+                .unwrap();
+            output.shard.notify().unwrap();
+            receive.recv_timeout(Duration::from_secs(2)).unwrap();
+            Box::new(Echo {
+                output: Arc::new(Mutex::new(Some(output.clone()))),
+                packets,
+                closed,
+                completed,
+            })
+        })
+        .unwrap();
+    let mut bytes = [0; 4];
+    peer.read_exact(&mut bytes).unwrap();
+    assert_eq!(bytes, [3, 1, 2, 3]);
+    sink.finish().unwrap();
+    assert_eq!(peer.read(&mut [0]).unwrap(), 0);
+    pool.stop();
+    runner.join().unwrap();
+}
