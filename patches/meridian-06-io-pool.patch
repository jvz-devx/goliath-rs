+//! The proxy owns the fixed IO drivers and their shutdown, not library sessions.
+use crate::{
+    log::{info, warning},
+    state::Proxy,
+};
+use meridian_net::io_pool::{Pool, Tasks};
+use std::{
+    io,
+    sync::Arc,
+    thread::{self, JoinHandle},
+};
+
+pub(crate) struct Runtime {
+    pool: Arc<Pool>,
+    tasks: Arc<Tasks>,
+    threads: Vec<JoinHandle<()>>,
+}
+
+pub(crate) fn start(proxy: &Arc<Proxy>) -> io::Result<Option<Runtime>> {
+    if std::env::var_os("GOLIATH_CLUSTER").is_none()
+        || std::env::var_os("E18_BLOCKING_IO").is_some()
+    {
+        return Ok(None);
+    }
+    let count = std::env::var("E18_IO_THREADS")
+        .ok()
+        .map(|s| s.parse::<usize>())
+        .transpose()
+        .map_err(io::Error::other)?
+        .unwrap_or(4);
+    if !(1..=8).contains(&count) {
+        return Err(io::Error::other("E18_IO_THREADS must be1..8"));
+    }
+    let (pool, drivers) = Pool::new(count)?;
+    let pool = Arc::new(pool);
+    let (tasks, workers) = Tasks::new(4, 512);
+    pool.install_tasks(&tasks);
+    let mut runtime = Runtime {
+        pool: Arc::clone(&pool),
+        tasks,
+        threads: Vec::new(),
+    };
+    for (index, worker) in workers.into_iter().enumerate() {
+        let proxy = Arc::clone(proxy);
+        runtime.threads.push(
+            thread::Builder::new()
+                .name(format!("proxy-control-{index}"))
+                .spawn(move || {
+                    let _stop = StopOnExit(proxy);
+                    worker.run();
+                })?,
+        );
+    }
+    for (index, driver) in drivers.into_iter().enumerate() {
+        let proxy = Arc::clone(proxy);
+        let thread = thread::Builder::new()
+            .name(format!("proxy-io-{index}"))
+            .spawn(move || {
+                let _stop = StopOnExit(Arc::clone(&proxy));
+                if let Err(error) = driver.run() {
+                    warning!("IO driver stopped: {error}");
+                }
+            })?;
+        runtime.threads.push(thread);
+    }
+    proxy
+        .sessions
+        .io
+        .set(pool)
+        .map_err(|_| io::Error::other("IO pool was already installed"))?;
+    info!("E18 fixed IO pool: {count} drivers");
+    Ok(Some(runtime))
+}
+
+struct StopOnExit(Arc<Proxy>);
+impl Drop for StopOnExit {
+    fn drop(&mut self) {
+        self.0.stop();
+    }
+}
+impl Drop for Runtime {
+    fn drop(&mut self) {
+        self.pool.stop();
+        self.tasks.stop();
+        for thread in self.threads.drain(..) {
+            if thread.join().is_err() {
+                warning!("IO driver panicked; its connections were closed");
+            }
+        }
+    }
