+//! Loopback proofs for the same handoff state machine on caller-owned IO drivers.
+use super::*;
+use meridian_net::io_pool::{Pool, Tasks};
+use std::{
+    net::{TcpListener, TcpStream},
+    sync::mpsc,
+    thread,
+};
+
+struct Io {
+    pool: Arc<Pool>,
+    tasks: Arc<Tasks>,
+    threads: Vec<JoinHandle<()>>,
+}
+impl Io {
+    fn new() -> Self {
+        let (pool, drivers) = Pool::new(1).unwrap();
+        let pool = Arc::new(pool);
+        let (tasks, workers) = Tasks::new(1, 8);
+        pool.install_tasks(&tasks);
+        let mut threads = drivers
+            .into_iter()
+            .map(|driver| thread::spawn(move || driver.run().unwrap()))
+            .collect::<Vec<_>>();
+        threads.extend(
+            workers
+                .into_iter()
+                .map(|worker| thread::spawn(move || worker.run())),
+        );
+        Self {
+            pool,
+            tasks,
+            threads,
+        }
+    }
+}
+impl Drop for Io {
+    fn drop(&mut self) {
+        self.pool.stop();
+        self.tasks.stop();
+        for thread in self.threads.drain(..) {
+            thread.join().unwrap();
+        }
+    }
+}
+
+fn pair() -> (Connection, Connection) {
+    let listener = TcpListener::bind("127.0.0.1:0").unwrap();
+    let peer = TcpStream::connect(listener.local_addr().unwrap()).unwrap();
+    let source = listener.accept().unwrap().0;
+    let mut a = Connection::from_stream(source).unwrap();
+    let mut b = Connection::from_stream(peer).unwrap();
+    for connection in [&mut a, &mut b] {
+        connection.set_compression(64);
+        connection.enable_encryption(&[7; 16]);
+        connection.reader.set_read_timeout(Some(WAIT)).unwrap();
+    }
+    (a, b)
+}
+
+fn session(io: &Io) -> (Session, SessionHandle, Connection, Connection) {
+    let (client, player) = pair();
+    let (backend, source) = pair();
+    let (session, handle) = Session::new_with_io(
+        ClientSession {
+            profile: profile(),
+            auth: AuthKind::Offline,
+            virtual_host: None,
+            connection: client,
+        },
+        BackendLink {
+            connection: backend,
+        },
+        "source",
+        Some(io.pool.affinity()),
+    )
+    .unwrap();
+    (session, handle, player, source)
+}
+
+#[test]
+fn ready_relay_preserves_compressed_encrypted_packets_and_disconnect_order() {
+    let io = Io::new();
+    let (session, handle, mut player, mut source) = session(&io);
+    let run = thread::spawn(move || session.run());
+    join_source_as(&mut player, &mut source, &INFORMATION);
+    handle.disconnect(horizon_protocol::packets::configuration::Disconnect {
+        reason: horizon_protocol::text::literal("done"),
+    });
+    let (id, payload) = player.recv().unwrap();
+    assert!(matches!(decode(id, &payload), C::Disconnect(_)));
+    assert!(player.recv().unwrap_err().is_end_of_stream());
+    run.join().unwrap().unwrap();
+    assert!(handle.is_over());
+}
+
+#[test]
+fn a_blocked_command_does_not_block_another_player_on_the_same_io_driver() {
+    let io = Io::new();
+    let (first, _handle, mut player, mut source) = session(&io);
+    let (started, seen) = mpsc::channel();
+    let (release, wait) = mpsc::channel();
+    let wait = Arc::new(Mutex::new(wait));
+    let first = first.with_commands(Arc::new(move |_| {
+        started.send(()).unwrap();
+        let _ = wait.lock().unwrap().recv_timeout(WAIT);
+        Some("done".into())
+    }));
+    let first = thread::spawn(move || first.run());
+    join_source_as(&mut player, &mut source, &INFORMATION);
+    player
+        .send(
+            &play::Serverbound::ChatCommand(play::ChatCommand {
+                command: "server".into(),
+            })
+            .encode(),
+        )
+        .unwrap();
+    seen.recv_timeout(WAIT).unwrap();
+    let (second, _handle, mut other, mut backend) = session(&io);
+    let second = thread::spawn(move || second.run());
+    other
+        .reader
+        .set_read_timeout(Some(Duration::from_millis(400)))
+        .unwrap();
+    send(&mut backend, cfg::clientbound::FINISH_CONFIGURATION, &[]);
+    expect(&mut other, cfg::clientbound::FINISH_CONFIGURATION).unwrap();
+    release.send(()).unwrap();
+    let (id, payload) = player.recv().unwrap();
+    assert!(matches!(decode(id, &payload), C::SystemChat(_)));
+    drop(player);
+    drop(other);
+    first.join().unwrap().unwrap();
+    second.join().unwrap().unwrap();
+}
+
+#[test]
+fn a_shut_route_replays_its_buffered_move_when_the_gate_opens() {
+    let io = Io::new();
+    let (session, handle, mut player, mut source) = session(&io);
+    let run = thread::spawn(move || session.run());
+    join_source_as(&mut player, &mut source, &INFORMATION);
+    let gate = handle.0.routing.shut();
+    let mut payload = Vec::new();
+    for value in [1.0f64, 64.0, 2.0] {
+        payload.extend(value.to_be_bytes());
+    }
+    payload.push(0);
+    send(&mut player, ps::MOVE_PLAYER_POS, &payload);
+    source
+        .reader
+        .set_read_timeout(Some(Duration::from_millis(30)))
+        .unwrap();
+    assert!(source.recv().is_err());
+    source.reader.set_read_timeout(Some(WAIT)).unwrap();
+    drop(gate);
+    let (id, actual) = source.recv().unwrap();
+    assert_eq!(id, ps::MOVE_PLAYER_POS);
+    assert_eq!(actual, payload);
+    drop(player);
+    run.join().unwrap().unwrap();
+}
