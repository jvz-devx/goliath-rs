--- /dev/null
+++ b/crates/meridian-handoff/src/session/reactive.rs
@@ -0,0 +1,364 @@
+//! Ready-read callbacks reuse the session's packet transitions and drain boundaries.
+use super::{
+    ClientPackets, End, Event, Lane, SessionHandle, Shared, backend_packet, lane_ended, lock,
+};
+use crate::path_timing;
+use horizon_protocol::connection::ConnReader;
+use meridian_net::{Result, io_pool::Handler, relay::CommandHook};
+use std::{
+    collections::VecDeque,
+    io,
+    net::TcpStream,
+    sync::{
+        Arc,
+        atomic::{AtomicBool, Ordering},
+        mpsc,
+    },
+    time::Instant,
+};
+
+pub(super) fn client(
+    shared: &Arc<Shared>,
+    stream: TcpStream,
+    reader: ConnReader,
+    events: mpsc::Sender<Event>,
+    commands: Option<Arc<CommandHook>>,
+    positions: Option<Arc<dyn Fn([f64; 3]) + Send + Sync>>,
+) -> Result<()> {
+    shared
+        .io
+        .as_ref()
+        .expect("ready reader has an IO affinity")
+        .register_with(stream, reader, |output| {
+            shared.down().writer.attach(output.clone());
+            shared.routing.follow(output.clone());
+            Box::new(Client {
+                shared: Arc::clone(shared),
+                events,
+                commands,
+                positions,
+                packets: Arc::new(std::sync::Mutex::new(ClientPackets::new())),
+                control_end: Arc::new(std::sync::Mutex::new(None)),
+                busy: Arc::new(AtomicBool::new(false)),
+                output: output.clone(),
+                pending: VecDeque::new(),
+                pending_bytes: 0,
+                burst: Burst::new(false),
+                end: None,
+            })
+        })?;
+    Ok(())
+}
+
+pub(super) fn backend(
+    shared: &Arc<Shared>,
+    lane: Arc<Lane>,
+    stream: TcpStream,
+    reader: ConnReader,
+) -> Result<()> {
+    let events = lock(&shared.events).clone();
+    shared
+        .io
+        .as_ref()
+        .expect("ready reader has an IO affinity")
+        .register_with(stream, reader, |output| {
+            lock(&lane.writer).attach(output.clone());
+            Box::new(Backend {
+                shared: Arc::clone(shared),
+                lane,
+                events,
+                body: Vec::new(),
+                burst: Burst::new(true),
+                end: None,
+            })
+        })?;
+    Ok(())
+}
+
+struct Burst {
+    lane: Option<Arc<Lane>>,
+    client: bool,
+}
+impl Burst {
+    fn new(client: bool) -> Self {
+        Self { lane: None, client }
+    }
+    fn begin(&mut self, shared: &Shared, lane: Arc<Lane>, arrived: Instant) {
+        path_timing::stamp(Some(arrived));
+        if self.lane.is_none() {
+            if self.client {
+                shared.down().writer.begin();
+            }
+            lock(&lane.writer).begin();
+            self.lane = Some(lane);
+        }
+    }
+    fn finish(&mut self, shared: &Shared) -> io::Result<()> {
+        let mut result = Ok(());
+        if let Some(lane) = self.lane.take() {
+            let client = if self.client {
+                shared.down().writer.end()
+            } else {
+                Ok(())
+            };
+            let backend = lock(&lane.writer).end();
+            result = client.and(backend).map_err(io::Error::other);
+        }
+        path_timing::stamp(None);
+        result
+    }
+}
+
+pub(super) fn terrain(
+    session: SessionHandle,
+    lane: Arc<Lane>,
+    source: (TcpStream, ConnReader),
+    owner: usize,
+    player_id: i32,
+    intentional: Arc<AtomicBool>,
+) -> Result<()> {
+    let shared = Arc::clone(&session.0);
+    shared
+        .io
+        .as_ref()
+        .expect("ready reader has an IO affinity")
+        .register_with(source.0, source.1, |output| {
+            lock(&lane.writer).attach(output.clone());
+            Box::new(Terrain {
+                session,
+                lane,
+                owner,
+                intentional,
+                target: crate::prepare::Target::terrain_reader(player_id),
+                body: Vec::new(),
+                burst: Burst::new(true),
+            })
+        })?;
+    Ok(())
+}
+
+struct Terrain {
+    session: SessionHandle,
+    lane: Arc<Lane>,
+    owner: usize,
+    intentional: Arc<AtomicBool>,
+    target: crate::prepare::Target,
+    body: Vec<u8>,
+    burst: Burst,
+}
+impl Handler for Terrain {
+    fn packet(&mut self, id: i32, payload: Vec<u8>, arrived: Instant) -> io::Result<()> {
+        if self.session.is_over()
+            || self.session.0.closing.load(Ordering::Acquire)
+            || self.intentional.load(Ordering::Acquire)
+        {
+            return Err(io::ErrorKind::ConnectionAborted.into());
+        }
+        self.burst
+            .begin(&self.session.0, Arc::clone(&self.lane), arrived);
+        self.target.take(&self.lane.writer, id, &payload);
+        let mut down = self.session.0.down();
+        if self.intentional.load(Ordering::Acquire) {
+            return Err(io::ErrorKind::ConnectionAborted.into());
+        }
+        crate::terrain::relay(
+            &self.session.0,
+            &mut down,
+            self.owner,
+            true,
+            meridian_ghost::Packet { id, payload },
+            &mut self.body,
+        )
+        .map_err(io::Error::other)
+    }
+    fn drained(&mut self) -> io::Result<()> {
+        self.burst.finish(&self.session.0)
+    }
+    fn closed(&mut self, _: io::Error) {
+        let _ = self.burst.finish(&self.session.0);
+        if !self.session.is_over()
+            && !self.session.0.closing.load(Ordering::Acquire)
+            && !self.intentional.load(Ordering::Acquire)
+        {
+            self.session.close();
+        }
+    }
+}
+
+fn ended(error: io::Error) -> End {
+    match error.kind() {
+        io::ErrorKind::UnexpectedEof
+        | io::ErrorKind::BrokenPipe
+        | io::ErrorKind::ConnectionAborted
+        | io::ErrorKind::ConnectionReset => End::Closed,
+        _ => End::Broken(horizon_protocol::Error::new(error.to_string())),
+    }
+}
+
+struct Backend {
+    shared: Arc<Shared>,
+    lane: Arc<Lane>,
+    events: Option<mpsc::Sender<Event>>,
+    body: Vec<u8>,
+    burst: Burst,
+    end: Option<End>,
+}
+impl Handler for Backend {
+    fn packet(&mut self, id: i32, payload: Vec<u8>, arrived: Instant) -> io::Result<()> {
+        if self.shared.closing.load(Ordering::Acquire) {
+            self.end = Some(End::Closed);
+            return Err(io::ErrorKind::ConnectionAborted.into());
+        }
+        self.burst
+            .begin(&self.shared, Arc::clone(&self.lane), arrived);
+        self.end = backend_packet(id, payload, &self.lane, &self.shared, &mut self.body);
+        if self.end.is_some() {
+            Err(io::ErrorKind::ConnectionAborted.into())
+        } else {
+            Ok(())
+        }
+    }
+    fn drained(&mut self) -> io::Result<()> {
+        self.burst.finish(&self.shared)
+    }
+    fn closed(&mut self, error: io::Error) {
+        let _ = self.burst.finish(&self.shared);
+        let end = self.end.take().unwrap_or_else(|| ended(error));
+        lane_ended(&self.shared, &self.lane, self.events.take(), end);
+    }
+}
+
+struct Client {
+    shared: Arc<Shared>,
+    events: mpsc::Sender<Event>,
+    commands: Option<Arc<CommandHook>>,
+    positions: Option<Arc<dyn Fn([f64; 3]) + Send + Sync>>,
+    packets: Arc<std::sync::Mutex<ClientPackets>>,
+    control_end: Arc<std::sync::Mutex<Option<End>>>,
+    busy: Arc<AtomicBool>,
+    output: meridian_net::io_pool::Output,
+    pending: VecDeque<(i32, Vec<u8>, Instant)>,
+    pending_bytes: usize,
+    burst: Burst,
+    end: Option<End>,
+}
+impl Handler for Client {
+    fn ready(&mut self) -> io::Result<()> {
+        let end = lock(&self.control_end).take();
+        if let Some(end) = end {
+            self.end = Some(end);
+            return Err(io::ErrorKind::ConnectionAborted.into());
+        }
+        self.drain_pending()
+    }
+    fn packet(&mut self, id: i32, payload: Vec<u8>, arrived: Instant) -> io::Result<()> {
+        if self.shared.closing.load(Ordering::Acquire) {
+            self.end = Some(End::Closed);
+            return Err(io::ErrorKind::ConnectionAborted.into());
+        }
+        if self.busy.load(Ordering::Acquire)
+            || self.shared.routing.is_shut()
+            || !self.pending.is_empty()
+        {
+            if self.pending.len() >= 2048
+                || payload.len() + 5 > 4 * 1024 * 1024 - self.pending_bytes
+            {
+                self.end = Some(End::Broken(horizon_protocol::Error::new(
+                    "bounded command input queue exceeded",
+                )));
+                return Err(io::ErrorKind::ConnectionAborted.into());
+            }
+            self.pending_bytes += payload.len() + 5;
+            self.pending.push_back((id, payload, arrived));
+            return self.drain_pending();
+        }
+        self.consume(id, payload, arrived)
+    }
+    fn drained(&mut self) -> io::Result<()> {
+        self.burst.finish(&self.shared)
+    }
+    fn closed(&mut self, error: io::Error) {
+        let _ = self.burst.finish(&self.shared);
+        let _ = self.events.send(Event::Client(
+            self.end.take().unwrap_or_else(|| ended(error)),
+        ));
+    }
+}
+
+impl Client {
+    fn drain_pending(&mut self) -> io::Result<()> {
+        while !self.busy.load(Ordering::Acquire) && !self.shared.routing.is_shut() {
+            let Some((id, payload, arrived)) = self.pending.pop_front() else {
+                break;
+            };
+            self.pending_bytes -= payload.len() + 5;
+            self.consume(id, payload, arrived)?;
+        }
+        Ok(())
+    }
+
+    fn consume(&mut self, id: i32, payload: Vec<u8>, arrived: Instant) -> io::Result<()> {
+        use horizon_protocol::ids::play::serverbound as s;
+        self.burst
+            .begin(&self.shared, Arc::clone(&self.shared.up().lane), arrived);
+        let command = self.commands.is_some()
+            && matches!(id, s::CHAT_COMMAND | s::CHAT_COMMAND_SIGNED)
+            && lock(&self.packets).sending == meridian_net::relay::Phase::Play;
+        if command {
+            let (packets, end, busy, output, shared, commands, positions) = (
+                Arc::clone(&self.packets),
+                Arc::clone(&self.control_end),
+                Arc::clone(&self.busy),
+                self.output.clone(),
+                Arc::clone(&self.shared),
+                self.commands.clone(),
+                self.positions.clone(),
+            );
+            self.busy.store(true, Ordering::Release);
+            let submitted = self
+                .shared
+                .io
+                .as_ref()
+                .expect("ready reader has an IO affinity")
+                .submit(move || {
+                    if !shared.client_gone.load(Ordering::Acquire)
+                        && !shared.ended.load(Ordering::Acquire)
+                    {
+                        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+                            path_timing::stamp(Some(arrived));
+                            let ended = lock(&packets).packet(
+                                id,
+                                payload,
+                                &shared,
+                                commands.as_deref(),
+                                positions.as_deref(),
+                            );
+                            path_timing::stamp(None);
+                            ended
+                        }));
+                        *lock(&end) = match result {
+                            Ok(ended) => ended,
+                            Err(_) => Some(End::Broken(horizon_protocol::Error::new(
+                                "command callback panicked; session closed",
+                            ))),
+                        };
+                    }
+                    busy.store(false, Ordering::Release);
+                    let _ = output.resume();
+                });
+            if !submitted {
+                self.busy.store(false, Ordering::Release);
+                SessionHandle(Arc::clone(&self.shared))
+                    .tell("Proxy busy; command not run, please retry.");
+            }
+            return Ok(());
+        }
+        self.end =
+            lock(&self.packets).packet(id, payload, &self.shared, None, self.positions.as_deref());
+        if self.end.is_some() {
+            Err(io::ErrorKind::ConnectionAborted.into())
+        } else {
+            Ok(())
+        }
+    }
+}
