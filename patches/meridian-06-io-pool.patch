@@ -0,0 +1,668 @@
+//! Bounded readiness-driven TCP transport; the proxy owns and runs its drivers.
+use horizon_protocol::connection::ConnReader;
+use mio::{Events, Interest, Poll, Token, Waker, net::TcpStream};
+use std::{
+    cell::Cell,
+    collections::{HashMap, HashSet, VecDeque},
+    io::{self, IoSlice, Write},
+    net::{Shutdown, TcpStream as StdStream},
+    sync::{
+        Arc, Condvar, Mutex, OnceLock,
+        atomic::{AtomicBool, AtomicUsize, Ordering},
+        mpsc,
+    },
+    time::{Duration, Instant},
+};
+
+const CONNECTIONS: usize = 4096;
+const OUTPUT_CAP: usize = 8 * 1024 * 1024;
+const OUTPUT_CHUNKS: usize = 8192;
+const TURN_BYTES: usize = 256 * 1024;
+const WAKE: Token = Token(0);
+mod tasks;
+pub use tasks::{Tasks, Worker};
+static NEXT_DRIVER: AtomicUsize = AtomicUsize::new(1);
+thread_local! {
+    static DRIVER: Cell<usize> = const { Cell::new(0) };
+    static LOCAL_WORK: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Per-connection packet state. A callback must never perform blocking IO.
+pub trait Handler: Send {
+    fn ready(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+    fn packet(&mut self, id: i32, payload: Vec<u8>, arrived: Instant) -> io::Result<()>;
+    /// End the current ready read burst, even when another producer has work.
+    fn drained(&mut self) -> io::Result<()>;
+    fn closed(&mut self, error: io::Error);
+}
+
+type Completed = Box<dyn FnOnce(Instant) + Send>;
+
+struct WriteChunk {
+    bytes: Vec<u8>,
+    offset: usize,
+    completed: Option<Completed>,
+}
+
+#[derive(Default)]
+struct Queue {
+    chunks: VecDeque<WriteChunk>,
+    bytes: usize,
+    notified: bool,
+    closed: bool,
+    finishing: bool,
+    resume_notified: bool,
+}
+
+struct SharedOutput {
+    queue: Mutex<Queue>,
+    emptied: Condvar,
+    closer: StdStream,
+}
+
+struct Shard {
+    identity: usize,
+    commands: mpsc::SyncSender<Command>,
+    wake: Waker,
+    slots: AtomicUsize,
+    next: AtomicUsize,
+    stopping: AtomicBool,
+    tasks: OnceLock<Arc<Tasks>>,
+}
+
+impl Shard {
+    fn notify(&self) -> io::Result<()> {
+        if DRIVER.get() == self.identity {
+            LOCAL_WORK.set(true);
+            Ok(())
+        } else {
+            self.wake.wake()
+        }
+    }
+}
+
+/// FIFO encrypted bytes awaiting the physical socket write, with a hard cap.
+#[derive(Clone)]
+pub struct Output {
+    token: Token,
+    shared: Arc<SharedOutput>,
+    shard: Arc<Shard>,
+}
+
+impl Output {
+    pub fn resume(&self) -> io::Result<()> {
+        let mut queue = self.shared.queue.lock().expect("IO output queue poisoned");
+        if queue.closed || queue.resume_notified {
+            return Ok(());
+        }
+        queue.resume_notified = true;
+        self.shard
+            .commands
+            .try_send(Command::Resume(self.token))
+            .map_err(|_| io::Error::other("IO driver stopped"))?;
+        drop(queue);
+        self.shard.notify()
+    }
+    pub fn push(&self, bytes: Vec<u8>, completed: Option<Completed>) -> io::Result<()> {
+        if bytes.is_empty() {
+            if let Some(done) = completed {
+                done(Instant::now());
+            }
+            return Ok(());
+        }
+        let mut queue = self.shared.queue.lock().expect("IO output queue poisoned");
+        if queue.closed || queue.finishing {
+            return Err(io::ErrorKind::BrokenPipe.into());
+        }
+        if bytes.len() > OUTPUT_CAP.saturating_sub(queue.bytes)
+            || queue.chunks.len() >= OUTPUT_CHUNKS
+        {
+            queue.closed = true;
+            drop(queue);
+            self.shared.emptied.notify_all();
+            let _ = self.shared.closer.shutdown(Shutdown::Both);
+            return Err(io::Error::other("bounded IO output queue exceeded"));
+        }
+        queue.bytes += bytes.len();
+        queue.chunks.push_back(WriteChunk {
+            bytes,
+            offset: 0,
+            completed,
+        });
+        if !queue.notified {
+            queue.notified = true;
+            // At most one dirty command per live connection, plus one admission.
+            // The channel holds twice the shard's admission limit plus its stop.
+            if self
+                .shard
+                .commands
+                .try_send(Command::Dirty(self.token))
+                .is_err()
+            {
+                queue.closed = true;
+                drop(queue);
+                self.shared.emptied.notify_all();
+                let _ = self.shared.closer.shutdown(Shutdown::Both);
+                return Err(io::Error::other("IO driver no longer accepts writes"));
+            }
+            drop(queue);
+            self.shard.notify()?;
+        }
+        Ok(())
+    }
+
+    pub fn is_current_driver(&self) -> bool {
+        DRIVER.get() == self.shard.identity
+    }
+
+    /// Close only after all already-queued bytes have been physically written.
+    pub fn finish(&self) -> io::Result<()> {
+        let mut queue = self.shared.queue.lock().expect("IO output queue poisoned");
+        if queue.closed {
+            return Ok(());
+        }
+        queue.finishing = true;
+        if !queue.notified {
+            queue.notified = true;
+            self.shard
+                .commands
+                .try_send(Command::Dirty(self.token))
+                .map_err(|_| io::Error::other("IO driver stopped"))?;
+            drop(queue);
+            self.shard.notify()?;
+        }
+        Ok(())
+    }
+
+    /// Only a non-reactor control worker may wait for a handover write barrier.
+    pub fn wait_empty(&self, timeout: Duration) -> io::Result<()> {
+        let queue = self.shared.queue.lock().expect("IO output queue poisoned");
+        let (queue, result) = self
+            .shared
+            .emptied
+            .wait_timeout_while(queue, timeout, |queue| queue.bytes != 0 && !queue.closed)
+            .expect("IO output queue poisoned");
+        if queue.closed {
+            return Err(io::ErrorKind::BrokenPipe.into());
+        }
+        if result.timed_out() && queue.bytes != 0 {
+            return Err(io::ErrorKind::TimedOut.into());
+        }
+        Ok(())
+    }
+}
+
+struct Entry {
+    stream: TcpStream,
+    reader: ConnReader,
+    handler: Box<dyn Handler>,
+    output: Output,
+    writable: bool,
+    closed: bool,
+}
+
+enum Command {
+    Install(Box<Entry>),
+    Dirty(Token),
+    Resume(Token),
+    Stop,
+    #[cfg(test)]
+    AfterDrain(mpsc::Sender<()>),
+}
+
+/// A registration handle, not a process-global runtime or a thread owner.
+pub struct Pool {
+    shards: Vec<Arc<Shard>>,
+    next: AtomicUsize,
+}
+
+/// Keep a session's client, backend lanes and readers on the same IO driver.
+#[derive(Clone)]
+pub struct Affinity(Arc<Shard>);
+
+impl Pool {
+    /// Returns drivers for the application's fixed threads to own and run.
+    pub fn new(count: usize) -> io::Result<(Self, Vec<Driver>)> {
+        if count == 0 {
+            return Err(io::Error::other("IO pool needs a driver"));
+        }
+        let mut shards = Vec::new();
+        let mut drivers = Vec::new();
+        for _ in 0..count {
+            let poll = Poll::new()?;
+            let wake = Waker::new(poll.registry(), WAKE)?;
+            let (commands, receive) = mpsc::sync_channel(CONNECTIONS * 3 + 1);
+            let shard = Arc::new(Shard {
+                identity: NEXT_DRIVER.fetch_add(1, Ordering::Relaxed),
+                commands,
+                wake,
+                slots: AtomicUsize::new(0),
+                next: AtomicUsize::new(1),
+                stopping: AtomicBool::new(false),
+                tasks: OnceLock::new(),
+            });
+            drivers.push(Driver {
+                identity: shard.identity,
+                poll,
+                receive,
+                entries: HashMap::new(),
+                reading: HashSet::new(),
+                writing: HashSet::new(),
+            });
+            shards.push(shard);
+        }
+        Ok((
+            Self {
+                shards,
+                next: AtomicUsize::new(0),
+            },
+            drivers,
+        ))
+    }
+
+    pub fn register(
+        &self,
+        stream: StdStream,
+        reader: ConnReader,
+        handler: Box<dyn Handler>,
+    ) -> io::Result<Output> {
+        self.register_with(stream, reader, |_| handler)
+    }
+
+    /// Installs the writer handle before the selector can call the reader.
+    pub fn register_with(
+        &self,
+        stream: StdStream,
+        reader: ConnReader,
+        handler: impl FnOnce(&Output) -> Box<dyn Handler>,
+    ) -> io::Result<Output> {
+        self.affinity().register_with(stream, reader, handler)
+    }
+
+    pub fn affinity(&self) -> Affinity {
+        Affinity(Arc::clone(
+            &self.shards[self.next.fetch_add(1, Ordering::Relaxed) % self.shards.len()],
+        ))
+    }
+
+    pub fn install_tasks(&self, tasks: &Arc<Tasks>) {
+        for shard in &self.shards {
+            assert!(shard.tasks.set(Arc::clone(tasks)).is_ok());
+        }
+    }
+
+    pub fn stop(&self) {
+        for shard in &self.shards {
+            if shard.stopping.swap(true, Ordering::AcqRel) {
+                continue;
+            }
+            let _ = shard.commands.try_send(Command::Stop);
+            let _ = shard.notify();
+        }
+    }
+}
+
+impl Affinity {
+    pub fn submit(&self, job: impl FnOnce() + Send + 'static) -> bool {
+        self.0.tasks.get().is_some_and(|tasks| tasks.submit(job))
+    }
+    pub fn register_with(
+        &self,
+        stream: StdStream,
+        reader: ConnReader,
+        handler: impl FnOnce(&Output) -> Box<dyn Handler>,
+    ) -> io::Result<Output> {
+        let shard = Arc::clone(&self.0);
+        if shard.stopping.load(Ordering::Acquire) {
+            return Err(io::Error::other("IO pool is stopping"));
+        }
+        shard
+            .slots
+            .fetch_update(Ordering::AcqRel, Ordering::Acquire, |slots| {
+                (slots < CONNECTIONS).then_some(slots + 1)
+            })
+            .map_err(|_| io::Error::other("IO admission deferred: driver is full"))?;
+        // All fallible socket setup precedes transfer of the admission slot.
+        let setup = || -> io::Result<_> {
+            stream.set_nodelay(true)?;
+            let shared = Arc::new(SharedOutput {
+                queue: Mutex::new(Queue::default()),
+                emptied: Condvar::new(),
+                closer: stream.try_clone()?,
+            });
+            let token = Token(shard.next.fetch_add(1, Ordering::Relaxed));
+            if token == WAKE {
+                return Err(io::Error::other("IO token space exhausted"));
+            }
+            Ok(Output {
+                token,
+                shared,
+                shard: Arc::clone(&shard),
+            })
+        };
+        let output = match setup() {
+            Ok(output) => output,
+            Err(error) => {
+                shard.slots.fetch_sub(1, Ordering::Release);
+                return Err(error);
+            }
+        };
+        let handler = handler(&output);
+        // A producer may already hold the writer. Attach its queue before the
+        // shared socket becomes nonblocking; only the driver writes afterwards.
+        let nonblocking = stream.set_nonblocking(true);
+        let mut entry = Entry {
+            stream: TcpStream::from_std(stream),
+            reader,
+            handler,
+            output: output.clone(),
+            writable: false,
+            closed: false,
+        };
+        if let Err(error) = nonblocking {
+            entry.close(io::Error::other(error.to_string()));
+            return Err(error);
+        }
+        if shard
+            .commands
+            .try_send(Command::Install(Box::new(entry)))
+            .is_err()
+        {
+            return Err(io::Error::other("IO driver stopped before admission"));
+        }
+        shard.notify()?;
+        Ok(output)
+    }
+}
+
+/// Application-owned selector loop. No task creates a thread per connection.
+pub struct Driver {
+    identity: usize,
+    poll: Poll,
+    receive: mpsc::Receiver<Command>,
+    entries: HashMap<Token, Entry>,
+    reading: HashSet<Token>,
+    writing: HashSet<Token>,
+}
+
+impl Driver {
+    pub fn run(mut self) -> io::Result<()> {
+        DRIVER.set(self.identity);
+        LOCAL_WORK.set(false);
+        let result = self.run_inner();
+        let tokens: Vec<_> = self.entries.keys().copied().collect();
+        for token in tokens {
+            self.remove(token, io::Error::other("IO driver stopped"));
+        }
+        // Also close admissions that raced the stop but never reached the map.
+        while let Ok(command) = self.receive.try_recv() {
+            if let Command::Install(mut entry) = command {
+                entry.close(io::Error::other("IO driver stopped before registration"));
+            }
+        }
+        DRIVER.set(0);
+        LOCAL_WORK.set(false);
+        result
+    }
+
+    fn run_inner(&mut self) -> io::Result<()> {
+        let mut events = Events::with_capacity(1024);
+        #[cfg(test)]
+        let mut after_drain = Vec::new();
+        loop {
+            while let Ok(command) = self.receive.try_recv() {
+                match command {
+                    Command::Stop => return Ok(()),
+                    #[cfg(test)]
+                    Command::AfterDrain(reply) => after_drain.push(reply),
+                    Command::Dirty(token) => {
+                        self.writing.insert(token);
+                    }
+                    Command::Resume(token) => {
+                        if let Some(entry) = self.entries.get(&token) {
+                            entry
+                                .output
+                                .shared
+                                .queue
+                                .lock()
+                                .expect("IO output queue poisoned")
+                                .resume_notified = false;
+                            self.reading.insert(token);
+                        }
+                    }
+                    Command::Install(mut entry) => {
+                        let token = entry.output.token;
+                        if let Err(error) = self.poll.registry().register(
+                            &mut entry.stream,
+                            token,
+                            Interest::READABLE,
+                        ) {
+                            entry.close(error);
+                        } else {
+                            {
+                                let mut queue = entry
+                                    .output
+                                    .shared
+                                    .queue
+                                    .lock()
+                                    .expect("IO output queue poisoned");
+                                if queue.bytes > 0 || queue.finishing {
+                                    self.writing.insert(token);
+                                }
+                                queue.resume_notified = false;
+                            }
+                            self.entries.insert(token, *entry);
+                            self.reading.insert(token); // Includes frames buffered during login.
+                        }
+                    }
+                }
+            }
+            let reading: Vec<_> = self.reading.drain().collect();
+            for token in reading {
+                let Some(entry) = self.entries.get_mut(&token) else {
+                    continue;
+                };
+                match entry.read() {
+                    Ok(true) => {
+                        self.reading.insert(token);
+                    }
+                    Ok(false) => {}
+                    Err(error) => self.remove(token, error),
+                }
+            }
+            let writing: Vec<_> = self.writing.drain().collect();
+            for token in writing {
+                let Some(entry) = self.entries.get_mut(&token) else {
+                    continue;
+                };
+                match entry.write() {
+                    Ok(pending) => {
+                        if pending || pending != entry.writable {
+                            entry.writable = pending;
+                            let interest = if pending {
+                                Interest::READABLE | Interest::WRITABLE
+                            } else {
+                                Interest::READABLE
+                            };
+                            if let Err(error) =
+                                self.poll
+                                    .registry()
+                                    .reregister(&mut entry.stream, token, interest)
+                            {
+                                self.remove(token, error);
+                            }
+                        }
+                    }
+                    Err(error) => self.remove(token, error),
+                }
+            }
+            #[cfg(test)]
+            for reply in after_drain.drain(..) {
+                let _ = reply.send(());
+            }
+            // Local producers only queue work. They never issue a cross-thread
+            // wake syscall, and their queued writes must run before sleeping.
+            if LOCAL_WORK.replace(false) {
+                continue;
+            }
+            let timeout = (!self.reading.is_empty()).then_some(Duration::ZERO);
+            match self.poll.poll(&mut events, timeout) {
+                Ok(()) => {}
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+                Err(error) => return Err(error),
+            }
+            for event in &events {
+                let token = event.token();
+                if token == WAKE {
+                    continue;
+                }
+                if event.is_readable() || event.is_read_closed() || event.is_error() {
+                    self.reading.insert(token);
+                }
+                if event.is_writable() || event.is_write_closed() {
+                    self.writing.insert(token);
+                }
+            }
+        }
+    }
+
+    fn remove(&mut self, token: Token, error: io::Error) {
+        if let Some(mut entry) = self.entries.remove(&token) {
+            let _ = self.poll.registry().deregister(&mut entry.stream);
+            entry.close(error);
+        }
+        self.reading.remove(&token);
+        self.writing.remove(&token);
+    }
+}
+
+#[cfg(test)]
+mod tests;
+
+impl Entry {
+    fn read(&mut self) -> io::Result<bool> {
+        let result = self.handler.ready().and_then(|()| self.read_inner());
+        let drained = self.handler.drained();
+        result.and_then(|again| drained.map(|()| again))
+    }
+
+    fn read_inner(&mut self) -> io::Result<bool> {
+        let mut bytes = 0;
+        let arrived = Instant::now();
+        loop {
+            while let Some((id, payload)) = self.reader.buffered().map_err(io::Error::other)? {
+                self.handler.packet(id, payload, arrived)?;
+            }
+            if bytes >= TURN_BYTES {
+                return Ok(true);
+            }
+            match self.reader.read_from(&mut self.stream) {
+                Ok(0) => return Err(io::ErrorKind::UnexpectedEof.into()),
+                Ok(count) => bytes += count,
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => return Ok(false),
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => {}
+                Err(error) => return Err(error),
+            }
+        }
+    }
+
+    fn write(&mut self) -> io::Result<bool> {
+        let mut bytes = 0;
+        loop {
+            let mut queue = self
+                .output
+                .shared
+                .queue
+                .lock()
+                .expect("IO output queue poisoned");
+            if queue.closed {
+                return Err(io::ErrorKind::BrokenPipe.into());
+            }
+            if queue.chunks.is_empty() {
+                if queue.finishing {
+                    return Err(io::ErrorKind::ConnectionAborted.into());
+                }
+                queue.notified = false;
+                self.output.shared.emptied.notify_all();
+                return Ok(false);
+            }
+            if bytes >= TURN_BYTES {
+                return Ok(true);
+            }
+            let mut remaining = TURN_BYTES - bytes;
+            let slices: Vec<_> = queue
+                .chunks
+                .iter()
+                .take(16)
+                .map_while(|chunk| {
+                    if remaining == 0 {
+                        return None;
+                    }
+                    let length = remaining.min(chunk.bytes.len() - chunk.offset);
+                    remaining -= length;
+                    Some(IoSlice::new(
+                        &chunk.bytes[chunk.offset..chunk.offset + length],
+                    ))
+                })
+                .collect();
+            let count = match self.stream.write_vectored(&slices) {
+                Ok(0) => return Err(io::ErrorKind::WriteZero.into()),
+                Ok(count) => count,
+                Err(error) if error.kind() == io::ErrorKind::WouldBlock => return Ok(true),
+                Err(error) if error.kind() == io::ErrorKind::Interrupted => continue,
+                Err(error) => return Err(error),
+            };
+            drop(slices);
+            bytes += count;
+            queue.bytes -= count;
+            let mut left = count;
+            let mut completed = Vec::new();
+            while left > 0 {
+                let chunk = queue.chunks.front_mut().expect("written bytes are queued");
+                let take = left.min(chunk.bytes.len() - chunk.offset);
+                chunk.offset += take;
+                left -= take;
+                if chunk.offset == chunk.bytes.len() {
+                    if let Some(done) = queue.chunks.pop_front().expect("front exists").completed {
+                        completed.push(done);
+                    }
+                }
+            }
+            let at = Instant::now();
+            drop(queue);
+            for done in completed {
+                done(at);
+            }
+        }
+    }
+
+    fn close(&mut self, error: io::Error) {
+        if std::mem::replace(&mut self.closed, true) {
+            return;
+        }
+        let mut queue = self
+            .output
+            .shared
+            .queue
+            .lock()
+            .expect("IO output queue poisoned");
+        queue.closed = true;
+        queue.chunks.clear();
+        queue.bytes = 0;
+        drop(queue);
+        self.output.shared.emptied.notify_all();
+        let _ = self.output.shared.closer.shutdown(Shutdown::Both);
+        self.handler.closed(error);
+    }
+}
+
+impl Drop for Entry {
+    fn drop(&mut self) {
+        // Covers admissions racing a stopped receiver and a driver unwinding.
+        // No queued entry can leave its cloned socket open without an owner.
+        self.close(io::Error::other("IO connection owner dropped"));
+        self.output.shard.slots.fetch_sub(1, Ordering::Release);
+    }
+}
