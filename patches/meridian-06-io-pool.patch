@@ -0,0 +1,50 @@
+//! Caller-owned workers for bounded blocking command hooks, outside IO drivers.
+use std::sync::{Arc, Mutex, mpsc};
+
+type Job = Box<dyn FnOnce() + Send>;
+pub struct Tasks {
+    send: mpsc::SyncSender<Option<Job>>,
+    workers: usize,
+}
+pub struct Worker {
+    receive: Arc<Mutex<mpsc::Receiver<Option<Job>>>>,
+}
+impl Tasks {
+    pub fn new(workers: usize, capacity: usize) -> (Arc<Self>, Vec<Worker>) {
+        assert!(workers > 0 && capacity > 0);
+        let (send, receive) = mpsc::sync_channel(capacity);
+        let receive = Arc::new(Mutex::new(receive));
+        (
+            Arc::new(Self { send, workers }),
+            (0..workers)
+                .map(|_| Worker {
+                    receive: Arc::clone(&receive),
+                })
+                .collect(),
+        )
+    }
+    /// A full queue rejects a command before it runs. The session stays live.
+    pub fn submit(&self, job: impl FnOnce() + Send + 'static) -> bool {
+        self.send.try_send(Some(Box::new(job))).is_ok()
+    }
+    pub fn stop(&self) {
+        for _ in 0..self.workers {
+            let _ = self.send.send(None);
+        }
+    }
+}
+impl Worker {
+    pub fn run(self) {
+        loop {
+            let next = self
+                .receive
+                .lock()
+                .expect("blocking task receiver poisoned")
+                .recv();
+            match next {
+                Ok(Some(job)) => job(),
+                _ => break,
+            }
+        }
+    }
+}
