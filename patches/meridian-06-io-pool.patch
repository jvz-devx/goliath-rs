+//! Transfers socket ownership to a caller-owned IO driver without losing codec state.
+use crate::{drain::Writer, path_timing::Path};
+use horizon_protocol::connection::{Closer, ConnReader, Connection, Socket};
+use std::net::TcpStream;
+
+pub(crate) enum Source {
+    Blocking(ConnReader),
+    Ready(TcpStream, ConnReader),
+}
+
+pub(crate) fn split(
+    connection: Connection,
+    ready: bool,
+    path: Path,
+) -> meridian_net::Result<(Source, Writer, Closer)> {
+    let closer = connection.reader.closer()?;
+    if ready {
+        let (socket, reader, writer) = connection.detach();
+        let Socket::Tcp(stream) = socket else {
+            return Err(std::io::Error::other("readiness IO requires a TCP connection").into());
+        };
+        let raw = stream.try_clone()?;
+        Ok((
+            Source::Ready(stream, reader),
+            Writer::detached(writer, raw, path),
+            closer,
+        ))
+    } else {
+        let (reader, writer) = connection.split();
+        let writer = match path {
+            Path::Client => Writer::client(writer),
+            Path::Reader => Writer::observer(writer),
+            _ => Writer::new(writer),
+        };
+        Ok((Source::Blocking(reader), writer, closer))
+    }
+}
