+/// The queue keeps client numbering. Rewrite only once its destination is final.
+fn send_input(up: &mut Up, id: i32, payload: Vec<u8>) -> std::result::Result<(), String> {
+    let payload = if up.swap.is_identity() || !meridian_rewrite::serverbound_has_ids(id) {
+        payload
+    } else {
+        rewrite(up.swap.serverbound(id, payload.clone()), payload)
+    };
+    let payload = match &mut up.identities {
+        Some(ids) => ids.sequence(up.lane.id, id, payload)?,
+        None => payload,
+    };
+    let mut body = Vec::new();
+    encode(&mut body, id, &payload);
+    lock(&up.lane.writer)
+        .send(&body)
+        .map_err(|e| e.to_string())?;
+    add(&mut up.flow, &body);
+    Ok(())
+}
