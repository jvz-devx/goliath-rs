--- /dev/null
+++ b/crates/meridian-handoff/src/lane_input.rs
@@ -0,0 +1,431 @@
+//! Bounded frozen inputs and lane-local acknowledgement identities.
+use crate::session::Lane;
+use horizon_protocol::{
+    buf::{Reader, Writer},
+    ids::play::{clientbound as c, serverbound as s},
+    packets::play::{Clientbound as C, Serverbound as S},
+};
+use meridian_ghost::Packet;
+use std::{
+    collections::{BTreeMap, VecDeque},
+    sync::{Arc, Weak},
+};
+
+const PACKETS: usize = 256;
+const BYTES: usize = 1024 * 1024;
+const REPLIES: usize = 64;
+
+#[derive(Default)]
+pub(crate) struct Inputs {
+    packets: VecDeque<Packet>,
+    bytes: usize,
+}
+
+impl Inputs {
+    pub fn push(&mut self, packet: Packet) -> Result<(), String> {
+        if self.packets.len() == PACKETS || self.bytes + packet.payload.len() > BYTES {
+            return Err("E8 input queue overflow; session closed without dropping input".into());
+        }
+        self.bytes += packet.payload.len();
+        self.packets.push_back(packet);
+        Ok(())
+    }
+    pub fn into_packets(self) -> VecDeque<Packet> {
+        self.packets
+    }
+}
+
+struct Reply<T> {
+    lane: Weak<Lane>,
+    original: T,
+}
+struct Block {
+    lane: u64,
+    local: i32,
+    client: i32,
+    answered: bool,
+}
+
+#[derive(Default)]
+pub(crate) struct Identities {
+    next: i32,
+    keepalives: BTreeMap<i64, Reply<i64>>,
+    pings: BTreeMap<i32, Reply<i32>>,
+    teleports: BTreeMap<i32, Reply<i32>>,
+    batches: VecDeque<Weak<Lane>>,
+    block_lane: u64,
+    block_next: i32,
+    blocks: VecDeque<Block>,
+}
+
+pub(crate) enum Answer {
+    Input,
+    Ignore,
+    Lane(Arc<Lane>, Vec<u8>),
+}
+
+impl Identities {
+    fn number(&mut self) -> Result<i32, String> {
+        self.next = self
+            .next
+            .checked_add(1)
+            .ok_or("E8 reply id space exhausted")?;
+        Ok(self.next)
+    }
+
+    /// Translate challenges before sending them to the client. Called for retired
+    /// lane block acks too, so acknowledgements cannot strand old predictions.
+    pub fn clientbound(
+        &mut self,
+        lane: &Arc<Lane>,
+        id: i32,
+        payload: &[u8],
+    ) -> Result<Option<Vec<u8>>, String> {
+        let mut packet = match id {
+            c::KEEP_ALIVE | c::PING | c::PLAYER_POSITION | c::BLOCK_CHANGED_ACK => {
+                Some(C::decode(id, payload).map_err(|e| e.to_string())?)
+            }
+            c::CHUNK_BATCH_FINISHED => {
+                if self.batches.len() >= REPLIES {
+                    return Err("E8 outstanding chunk batches limit".into());
+                }
+                self.batches.push_back(Arc::downgrade(lane));
+                None
+            }
+            _ => None,
+        };
+        match packet.as_mut() {
+            Some(C::KeepAlive(p)) => {
+                if self.keepalives.len() >= REPLIES {
+                    return Err("E8 outstanding keepalives limit".into());
+                }
+                let number = i64::from(self.number()?);
+                self.keepalives.insert(
+                    number,
+                    Reply {
+                        lane: Arc::downgrade(lane),
+                        original: p.id,
+                    },
+                );
+                p.id = number;
+            }
+            Some(C::Ping(p)) => {
+                if self.pings.len() >= REPLIES {
+                    return Err("E8 outstanding pings limit".into());
+                }
+                let number = self.number()?;
+                self.pings.insert(
+                    number,
+                    Reply {
+                        lane: Arc::downgrade(lane),
+                        original: p.id,
+                    },
+                );
+                p.id = number;
+            }
+            Some(C::PlayerPosition(p)) => {
+                if self.teleports.len() >= REPLIES {
+                    return Err("E8 outstanding teleports limit".into());
+                }
+                let number = self.number()?;
+                self.teleports.insert(
+                    number,
+                    Reply {
+                        lane: Arc::downgrade(lane),
+                        original: p.teleport,
+                    },
+                );
+                p.teleport = number;
+            }
+            Some(C::BlockChangedAck(p)) => {
+                for block in &mut self.blocks {
+                    if block.lane == lane.id && block.local <= p.sequence {
+                        block.answered = true;
+                    }
+                }
+                let mut sequence = None;
+                while self.blocks.front().is_some_and(|block| block.answered) {
+                    sequence = self.blocks.pop_front().map(|block| block.client);
+                }
+                let Some(sequence) = sequence else {
+                    return Ok(None);
+                };
+                p.sequence = sequence;
+            }
+            _ => {}
+        }
+        Ok(Some(match packet {
+            Some(packet) => {
+                let bytes = packet.encode();
+                let mut r = Reader::new(&bytes);
+                r.varint().map_err(|e| e.to_string())?;
+                r.rest().to_vec()
+            }
+            None => payload.to_vec(),
+        }))
+    }
+
+    /// Challenges remain bound to their issuing lane, even during a freeze.
+    /// Unknown, expired and already answered ids never fall through to a new lane.
+    pub fn answer(&mut self, id: i32, payload: &[u8]) -> Result<Answer, String> {
+        let mut w = Writer::new();
+        let reply = match id {
+            s::KEEP_ALIVE => {
+                let key = Reader::new(payload).i64().map_err(|e| e.to_string())?;
+                self.keepalives.remove(&key).map(|r| {
+                    w.i64(r.original);
+                    r.lane
+                })
+            }
+            s::PONG => {
+                let key = Reader::new(payload).i32().map_err(|e| e.to_string())?;
+                self.pings.remove(&key).map(|r| {
+                    w.i32(r.original);
+                    r.lane
+                })
+            }
+            s::ACCEPT_TELEPORTATION => {
+                let S::AcceptTeleportation(mut p) =
+                    S::decode(id, payload).map_err(|e| e.to_string())?
+                else {
+                    return Err("bad teleport answer".into());
+                };
+                self.teleports.remove(&p.id).map(|r| {
+                    p.id = r.original;
+                    let encoded = S::AcceptTeleportation(p).encode();
+                    let mut reader = Reader::new(&encoded);
+                    let _ = reader.varint();
+                    w.data.extend_from_slice(reader.rest());
+                    r.lane
+                })
+            }
+            s::CHUNK_BATCH_RECEIVED => self
+                .batches
+                .pop_front()
+                .inspect(|_| w.data.extend_from_slice(payload)),
+            _ => return Ok(Answer::Input),
+        };
+        Ok(match reply.and_then(|lane| lane.upgrade()) {
+            Some(lane) => Answer::Lane(lane, w.data),
+            None => Answer::Ignore,
+        })
+    }
+
+    /// Give each active lane its own sequence, then map cumulative acks back to
+    /// one client-wide watermark only when every earlier action was answered.
+    pub fn sequence(&mut self, lane: u64, id: i32, payload: Vec<u8>) -> Result<Vec<u8>, String> {
+        if !matches!(id, s::PLAYER_ACTION | s::USE_ITEM | s::USE_ITEM_ON) {
+            return Ok(payload);
+        }
+        let mut packet = S::decode(id, &payload).map_err(|e| e.to_string())?;
+        let seq = match &mut packet {
+            S::PlayerAction(p) => &mut p.sequence,
+            S::UseItem(p) => &mut p.sequence,
+            S::UseItemOn(p) => &mut p.sequence,
+            _ => return Ok(payload),
+        };
+        if *seq < 0 {
+            return Ok(payload);
+        }
+        if self.blocks.len() >= PACKETS {
+            return Err("E8 outstanding block actions limit".into());
+        }
+        if self.block_lane != lane {
+            self.block_lane = lane;
+            self.block_next = 0;
+        }
+        self.block_next = self
+            .block_next
+            .checked_add(1)
+            .ok_or("E8 block sequence exhausted")?;
+        self.blocks.push_back(Block {
+            lane,
+            local: self.block_next,
+            client: *seq,
+            answered: false,
+        });
+        *seq = self.block_next;
+        let encoded = packet.encode();
+        let mut r = Reader::new(&encoded);
+        r.varint().map_err(|e| e.to_string())?;
+        Ok(r.rest().to_vec())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use horizon_protocol::packets::play;
+    use std::sync::Mutex;
+
+    fn lane(id: u64) -> Arc<Lane> {
+        let (connection, _peer) = meridian_testkit::pipe();
+        let closer = connection.reader.closer().unwrap();
+        let (_reader, writer) = connection.split();
+        Arc::new(Lane {
+            id,
+            writer: Mutex::new(writer),
+            closer,
+            target: None,
+        })
+    }
+
+    fn payload(bytes: &[u8]) -> Vec<u8> {
+        let mut r = Reader::new(bytes);
+        r.varint().unwrap();
+        r.rest().to_vec()
+    }
+    #[test]
+    fn queue_is_ordered_and_bounded() {
+        let mut queue = Inputs::default();
+        for id in 0..256 {
+            queue
+                .push(Packet {
+                    id,
+                    payload: vec![id as u8],
+                })
+                .unwrap();
+        }
+        assert!(
+            queue
+                .push(Packet {
+                    id: 256,
+                    payload: vec![]
+                })
+                .is_err()
+        );
+        assert_eq!(
+            queue
+                .into_packets()
+                .iter()
+                .map(|p| p.id)
+                .collect::<Vec<_>>(),
+            (0..256).collect::<Vec<_>>()
+        );
+        let mut queue = Inputs::default();
+        assert!(
+            queue
+                .push(Packet {
+                    id: 0,
+                    payload: vec![0; BYTES + 1]
+                })
+                .is_err()
+        );
+    }
+    #[test]
+    fn unknown_lane_replies_do_not_reach_current_lane() {
+        let mut ids = Identities::default();
+        assert!(matches!(
+            ids.answer(s::KEEP_ALIVE, &7i64.to_be_bytes()).unwrap(),
+            Answer::Ignore
+        ));
+        assert!(matches!(
+            ids.answer(s::PONG, &7i32.to_be_bytes()).unwrap(),
+            Answer::Ignore
+        ));
+    }
+
+    #[test]
+    fn identical_backend_challenges_are_bound_to_their_issuing_lanes() {
+        let a = lane(1);
+        let b = lane(2);
+        let mut ids = Identities::default();
+        let keep_a = ids
+            .clientbound(&a, c::KEEP_ALIVE, &7i64.to_be_bytes())
+            .unwrap()
+            .unwrap();
+        let keep_b = ids
+            .clientbound(&b, c::KEEP_ALIVE, &7i64.to_be_bytes())
+            .unwrap()
+            .unwrap();
+        assert_ne!(keep_a, keep_b);
+        for (lane, body) in [(&b, keep_b), (&a, keep_a)] {
+            let Answer::Lane(origin, original) = ids.answer(s::KEEP_ALIVE, &body).unwrap() else {
+                panic!("not routed");
+            };
+            assert!(Arc::ptr_eq(&origin, lane));
+            assert_eq!(original, 7i64.to_be_bytes());
+            assert!(matches!(
+                ids.answer(s::KEEP_ALIVE, &body).unwrap(),
+                Answer::Ignore
+            ));
+        }
+        let teleport = C::PlayerPosition(play::PlayerPosition {
+            teleport: 0,
+            position: [1., 2., 3.],
+            delta: [0.; 3],
+            yaw: 0.,
+            pitch: 0.,
+            relatives: 0,
+        });
+        let first = ids
+            .clientbound(&a, c::PLAYER_POSITION, &payload(&teleport.encode()))
+            .unwrap()
+            .unwrap();
+        let second = ids
+            .clientbound(&b, c::PLAYER_POSITION, &payload(&teleport.encode()))
+            .unwrap()
+            .unwrap();
+        assert_ne!(first, second);
+        let C::PlayerPosition(position) = C::decode(c::PLAYER_POSITION, &first).unwrap() else {
+            panic!()
+        };
+        let answer = payload(
+            &S::AcceptTeleportation(play::AcceptTeleportation {
+                id: position.teleport,
+                x: 1.,
+                y: 2.,
+                z: 3.,
+                yaw: 0.,
+                pitch: 0.,
+            })
+            .encode(),
+        );
+        let Answer::Lane(origin, body) = ids.answer(s::ACCEPT_TELEPORTATION, &answer).unwrap()
+        else {
+            panic!()
+        };
+        assert!(Arc::ptr_eq(&origin, &a));
+        let S::AcceptTeleportation(p) = S::decode(s::ACCEPT_TELEPORTATION, &body).unwrap() else {
+            panic!()
+        };
+        assert_eq!(p.id, 0);
+    }
+
+    #[test]
+    fn retired_lane_block_ack_does_not_advance_past_an_unanswered_action() {
+        let a = lane(1);
+        let b = lane(2);
+        let mut ids = Identities::default();
+        for (lane, seq) in [(&a, 37), (&b, 38)] {
+            let body = payload(
+                &S::UseItem(play::UseItem {
+                    hand: 0,
+                    sequence: seq,
+                    yaw: 0.,
+                    pitch: 0.,
+                })
+                .encode(),
+            );
+            let body = ids.sequence(lane.id, s::USE_ITEM, body).unwrap();
+            let S::UseItem(p) = S::decode(s::USE_ITEM, &body).unwrap() else {
+                panic!()
+            };
+            assert_eq!(p.sequence, 1);
+        }
+        let ack = payload(&C::BlockChangedAck(play::BlockChangedAck { sequence: 1 }).encode());
+        assert!(
+            ids.clientbound(&b, c::BLOCK_CHANGED_ACK, &ack)
+                .unwrap()
+                .is_none()
+        );
+        let body = ids
+            .clientbound(&a, c::BLOCK_CHANGED_ACK, &ack)
+            .unwrap()
+            .unwrap();
+        let C::BlockChangedAck(p) = C::decode(c::BLOCK_CHANGED_ACK, &body).unwrap() else {
+            panic!()
+        };
+        assert_eq!(p.sequence, 38);
+    }
+}
