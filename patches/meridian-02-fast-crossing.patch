+impl Shared {
+    pub fn queue_inputs(&self) {
+        self.up().inputs = Some(Inputs::default());
+    }
+
+    pub fn replay_inputs(&self) -> std::result::Result<usize, String> {
+        let mut up = self.up();
+        let packets = up.inputs.take().unwrap_or_default().into_packets();
+        let count = packets.len();
+        for packet in packets {
+            send_input(&mut up, packet.id, packet.payload)?;
+        }
+        Ok(count)
     }
 }
 
