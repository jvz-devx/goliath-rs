+//! One expiring approach preparation and serialized wall activation per player.
+use crate::{
+    log::{info, warning},
+    switching::{self, Switcher},
+};
+use meridian_config::Config;
+use meridian_handoff::{Activation, SessionHandle};
+use std::{
+    net::IpAddr,
+    sync::{Arc, Condvar, Mutex},
+    time::{Duration, Instant},
+};
+
+#[derive(Default)]
+struct Pending {
+    latest: Option<[f64; 3]>,
+    direction: [f64; 3],
+    running: bool,
+    refused: bool,
+    outside: bool,
+    retry_after: Option<Instant>,
+    preparing: Option<String>,
+    crossing: Option<[f64; 3]>,
+}
+
+/// Experimental cumulative changes, fixed for the life of the proxy process.
+pub fn stage() -> u8 {
+    std::env::var("E8_STAGE")
+        .ok()
+        .and_then(|s| s.parse().ok())
+        .unwrap_or(4)
+}
+
+fn candidate(config: &Config, state: &Pending, current: &str) -> Option<(String, [f64; 3])> {
+    let map = config.tiles.as_ref()?;
+    let position = state.latest?;
+    if let Some(tile) = map
+        .destination(position)
+        .filter(|tile| tile.backend != current)
+    {
+        return Some((tile.backend.clone(), position));
+    }
+    let length = state.direction[0].hypot(state.direction[2]);
+    if length < 0.0001 {
+        return None;
+    }
+    let mut predicted = position;
+    for axis in [0, 2] {
+        predicted[axis] += 4.0 * state.direction[axis] / length;
+    }
+    map.destination(predicted)
+        .filter(|tile| tile.backend != current)
+        .map(|tile| (tile.backend.clone(), predicted))
+}
+
+pub fn hook(
+    config: Arc<Config>,
+    switcher: Arc<Switcher>,
+    handle: SessionHandle,
+    name: String,
+    address: IpAddr,
+) -> Arc<dyn Fn([f64; 3]) + Send + Sync> {
+    let pending = Arc::new((Mutex::new(Pending::default()), Condvar::new()));
+    Arc::new(move |position| {
+        let Some(map) = &config.tiles else {
+            return;
+        };
+        let mut state = pending.0.lock().expect("wall state poisoned");
+        if let Some(previous) = state.latest {
+            let delta: [f64; 3] = std::array::from_fn(|axis| position[axis] - previous[axis]);
+            if delta[0] != 0.0 || delta[2] != 0.0 {
+                state.direction = delta;
+            }
+        }
+        state.latest = Some(position);
+        let outside = map
+            .tile_at(position)
+            .is_none_or(|index| !map.entries.iter().any(|t| t.index == index));
+        if outside && !state.outside {
+            handle.tell("E4 wall deferred unmapped or invalid position; current backend retained");
+        }
+        state.outside = outside;
+        if state.running
+            && state.crossing.is_none()
+            && let Some(target) = &state.preparing
+            && map
+                .destination(position)
+                .is_some_and(|tile| &tile.backend == target)
+        {
+            handle.tell(&format!("E4 wall start {target}"));
+            state.crossing = Some(position);
+        }
+        pending.1.notify_all();
+        if state.running || state.refused || state.retry_after.is_some_and(|at| Instant::now() < at)
+        {
+            return;
+        }
+        if candidate(&config, &state, &handle.backend()).is_none() {
+            return;
+        }
+        state.running = true;
+        let (config, switcher, handle, name, pending) = (
+            Arc::clone(&config),
+            Arc::clone(&switcher),
+            handle.clone(),
+            name.clone(),
+            Arc::clone(&pending),
+        );
+        let refusal_handle = handle.clone();
+        let spawned = std::thread::Builder::new()
+            .name(format!("wall-{name}"))
+            .spawn(move || {
+                loop {
+                    let (target, predicted) = {
+                        let mut state = pending.0.lock().expect("wall state poisoned");
+                        let Some(next) = candidate(&config, &state, &handle.backend()) else {
+                            state.running = false;
+                            state.preparing = None;
+                            return;
+                        };
+                        state.preparing = Some(next.0.clone());
+                        state.crossing = state.latest.filter(|p| {
+                            config
+                                .tiles
+                                .as_ref()
+                                .expect("tiles")
+                                .destination(*p)
+                                .is_some_and(|tile| tile.backend == next.0)
+                        });
+                        if state.crossing.is_some() {
+                            handle.tell(&format!("E4 wall start {}", next.0));
+                        }
+                        next
+                    };
+                    let activation: Activation = {
+                        let (pending, handle, config, target) = (
+                            Arc::clone(&pending),
+                            handle.clone(),
+                            Arc::clone(&config),
+                            target.clone(),
+                        );
+                        Arc::new(move || {
+                            let deadline = Instant::now() + Duration::from_secs(3);
+                            let mut state = pending.0.lock().expect("wall state poisoned");
+                            loop {
+                                if handle.is_over() {
+                                    return Err("E8 preparation abandoned: session ended".into());
+                                }
+                                if let Some(at) = state.crossing {
+                                    return Ok(at);
+                                }
+                                if Instant::now() >= deadline
+                                    || candidate(&config, &state, &handle.backend())
+                                        .is_none_or(|next| next.0 != target)
+                                {
+                                    return Err(
+                                        "E8 preparation abandoned: turned away or expired".into()
+                                    );
+                                }
+                                state = pending
+                                    .1
+                                    .wait_timeout(state, Duration::from_millis(25))
+                                    .expect("wall state poisoned")
+                                    .0;
+                            }
+                        })
+                    };
+                    match switching::approach(
+                        &config,
+                        &switcher,
+                        &handle,
+                        &name,
+                        address,
+                        (&target, predicted, activation),
+                    ) {
+                        Ok(moved) if moved.alert.is_none() => {
+                            info!("{}", moved.describe(&name));
+                            handle.tell(&format!("E4 wall arrived {target}"));
+                        }
+                        result => {
+                            let why = match result {
+                                Ok(m) => m.alert.unwrap_or_default(),
+                                Err(e) => e,
+                            };
+                            let abandoned = why.contains("E8 preparation abandoned:");
+                            let retry = abandoned
+                                || (why.contains("that player is dead") && !handle.is_over());
+                            warning!("wall refusal (retry {retry}): {why}");
+                            if !abandoned {
+                                handle.tell(&format!("E4 wall refused {why}"));
+                            }
+                            let mut state = pending.0.lock().expect("wall state poisoned");
+                            state.refused = !retry;
+                            state.retry_after =
+                                retry.then(|| Instant::now() + Duration::from_secs(1));
+                            state.running = false;
+                            state.preparing = None;
+                            state.crossing = None;
+                            return;
+                        }
+                    }
+                    let mut state = pending.0.lock().expect("wall state poisoned");
+                    state.preparing = None;
+                    state.crossing = None;
+                }
+            });
+        if let Err(error) = spawned {
+            state.running = false;
+            state.refused = true;
+            refusal_handle.tell(&format!("E4 wall refused cannot start worker: {error}"));
+        }
+    })
+}
