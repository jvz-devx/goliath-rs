+    first.empty();
+    publish(&view, block(5));
+    assert_eq!(first.next(), block(5));
+    assert_eq!(second.next(), block(5));
+    drop(a);
+    publish(&view, block(6));
+    assert_eq!(second.next(), block(6));
+    first.empty();
+    assert_eq!(lock(&view.0).members.len(), 1);
+    drop(b);
+    assert!(lock(&view.0).cache.columns.is_empty());
