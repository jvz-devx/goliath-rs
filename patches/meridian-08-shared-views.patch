+//! Shared cache bounds and per-client packet ordering on real protocol connections.
+use super::*;
+use crate::{DigestBuilder, Session};
+use horizon_protocol::connection::Connection;
+use meridian_net::{
+    backend::BackendLink,
+    client::{AuthKind, ClientSession},
+    relay::Phase,
+};
+use meridian_testkit::{held, pipe};
+
+struct Client {
+    _session: Session,
+    handle: SessionHandle,
+    player: Connection,
+    _source: Connection,
+}
+impl Client {
+    fn new() -> Self {
+        let (client, player) = pipe();
+        let (backend, source) = pipe();
+        player
+            .reader
+            .set_read_timeout(Some(Duration::from_millis(50)))
+            .unwrap();
+        let (session, handle) = Session::new(
+            ClientSession {
+                profile: Profile {
+                    name: "SharedProbe".into(),
+                    uuid: [1; 16],
+                    properties: Vec::new(),
+                },
+                auth: AuthKind::Offline,
+                virtual_host: None,
+                connection: client,
+            },
+            BackendLink {
+                connection: backend,
+            },
+            "source",
+        )
+        .unwrap();
+        handle.compose_terrain(TerrainOwners {
+            origin: [0, 0],
+            edge: 2048,
+            entries: vec![[0, 0], [-1, 0]],
+            backends: vec!["a".into(), "source".into()],
+        });
+        {
+            let mut down = handle.0.down();
+            down.config_digest = Some(DigestBuilder::default().finish());
+            down.phase = Phase::Play;
+            down.ghost
+                .apply(&Packet::of(&held::login(held::CLIENT_ID, held::OVERWORLD)))
+                .unwrap();
+        }
+        handle.0.up().client_pose = Some(crate::prepare::Pose {
+            at: [8., 70., 8.],
+            ..Default::default()
+        });
+        Self {
+            _session: session,
+            handle,
+            player,
+            _source: source,
+        }
+    }
+    fn next(&mut self) -> Packet {
+        let (id, payload) = self.player.recv().unwrap();
+        Packet { id, payload }
+    }
+    fn empty(&mut self) {
+        assert!(
+            self.player.recv().is_err(),
+            "an unrelated client received terrain"
+        );
+    }
+}
+fn chunk(x: i32, z: i32) -> Packet {
+    let (id, payload) = held::chunk(x, z, 1);
+    Packet { id, payload }
+}
+fn block(state: u32) -> Packet {
+    Packet::of(&play::Clientbound::BlockUpdate(play::BlockUpdate {
+        pos: [1, 70, 1],
+        state: state as i32,
+    }))
+}
+fn publish(view: &SharedTerrain, packet: Packet) {
+    let mut touched = HashMap::new();
+    view.receive(packet, &mut touched).unwrap();
+    for (_, shared) in touched {
+        shared.down().writer.end().unwrap();
+    }
+}
