+//! Shared read-only terrain cache, ordered subscriptions and one caller-driven reader.
+use crate::{
+    ClientConfiguration, Digest, SessionHandle, TargetBackend, TerrainOwners, TerrainReader,
+};
+use crate::{
+    configure::configure,
+    drain::Writer,
+    prepare::Target,
+    session::{Shared, lock},
+};
+use horizon_protocol::{ids::play::clientbound as c, packets::play};
+use meridian_ghost::Packet;
+use meridian_net::{Profile, backend, io_pool::Handler};
+use std::{
+    collections::{HashMap, HashSet},
+    io,
+    sync::{
+        Arc, Mutex, Weak,
+        atomic::{AtomicBool, AtomicU64, Ordering},
+    },
+    time::{Duration, Instant},
+};
+
+type Column = (i32, i32);
+const MAX_COLUMNS: usize = 4096;
+const MAX_MEMBERS: usize = 4096;
+const MAX_INTERESTS: usize = 262144;
+const BASE_BYTES: usize = 64 * 1024 * 1024;
+const UPDATE_BYTES: usize = 16 * 1024 * 1024;
+const COLUMN_UPDATES: usize = 256 * 1024;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord)]
+pub struct InterestArea {
+    pub center: [i32; 2],
+    pub radius: i32,
+}
+
+fn area(position: [f64; 3], radius: i32) -> Result<InterestArea, String> {
+    if !position
+        .iter()
+        .all(|p| p.is_finite() && p.abs() < 30_000_000.)
+        || !(2..=31).contains(&radius)
+    {
+        return Err("shared terrain interest exceeds coordinate or radius bounds".into());
+    }
+    Ok(InterestArea {
+        center: [
+            (position[0].floor() as i32) >> 4,
+            (position[2].floor() as i32) >> 4,
+        ],
+        radius: radius + 1,
+    })
+}
+fn columns(area: InterestArea, owners: &TerrainOwners, owner: usize) -> HashSet<Column> {
+    (-area.radius..=area.radius)
+        .flat_map(|dz| {
+            (-area.radius..=area.radius).map(move |dx| (area.center[0] + dx, area.center[1] + dz))
+        })
+        .filter(|key| owners.owner(key.0, key.1) == Some(owner))
+        .collect()
+}
+fn coverage(areas: impl Iterator<Item = InterestArea>) -> Result<(), String> {
+    let mut loading = HashSet::new();
+    let mut distinct = HashSet::new();
+    for a in areas {
+        if !distinct.insert((a.center, a.radius)) {
+            continue;
+        }
+        if distinct.len() > 256 {
+            return Err("shared terrain exceeds 256 areas".into());
+        }
+        for z in -a.radius - 2..=a.radius + 2 {
+            for x in -a.radius - 2..=a.radius + 2 {
+                loading.insert((a.center[0] + x, a.center[1] + z));
+                if loading.len() > MAX_COLUMNS {
+                    return Err("shared terrain exceeds 4096 loading columns".into());
+                }
+            }
+        }
+    }
+    Ok(())
+}
+fn charge(packet: &Packet) -> usize {
+    packet.payload.len() + 64
+}
+fn persistent(id: i32) -> bool {
+    matches!(
+        id,
+        c::BLOCK_UPDATE
+            | c::SECTION_BLOCKS_UPDATE
+            | c::LIGHT_UPDATE
+            | c::BLOCK_ENTITY_DATA
+            | c::CHUNKS_BIOMES
+    )
+}
+
+struct Cached {
+    base: Arc<Packet>,
+    updates: Vec<Arc<Packet>>,
+    bytes: usize,
+    valid: bool,
+}
+#[derive(Default)]
+struct Cache {
+    columns: HashMap<Column, Cached>,
+    bases: usize,
+    updates: usize,
+    refresh: HashSet<Column>,
+    sent_refresh: HashSet<Column>,
+}
+impl Cache {
+    fn remove(&mut self, key: Column) {
+        if let Some(old) = self.columns.remove(&key) {
+            self.bases -= charge(&old.base);
+            self.updates -= old.bytes;
+        }
+        self.refresh.remove(&key);
+        self.sent_refresh.remove(&key);
+    }
+    fn apply(&mut self, key: Column, packet: Arc<Packet>) -> Result<(), String> {
+        if packet.id == c::FORGET_LEVEL_CHUNK {
+            self.remove(key);
+            return Ok(());
+        }
+        if packet.id == c::LEVEL_CHUNK_WITH_LIGHT {
+            self.remove(key);
+            let bytes = charge(&packet);
+            if bytes > BASE_BYTES.saturating_sub(self.bases) {
+                return Err("shared terrain base cache exceeded 64 MiB".into());
+            }
+            self.bases += bytes;
+            self.columns.insert(
+                key,
+                Cached {
+                    base: packet,
+                    updates: Vec::new(),
+                    bytes: 0,
+                    valid: true,
+                },
+            );
+        } else if persistent(packet.id)
+            && let Some(column) = self.columns.get_mut(&key)
+            && column.valid
+        {
+            let bytes = charge(&packet);
+            if bytes > COLUMN_UPDATES.saturating_sub(column.bytes)
+                || bytes > UPDATE_BYTES.saturating_sub(self.updates)
+            {
+                self.updates -= column.bytes;
+                column.bytes = 0;
+                column.updates = Vec::new();
+                column.valid = false;
+                self.refresh.insert(key);
+                self.sent_refresh.remove(&key);
+            } else {
+                column.bytes += bytes;
+                self.updates += bytes;
+                column.updates.push(packet);
+            }
+        }
+        Ok(())
+    }
+    fn snapshot(&self, key: Column) -> Option<Vec<Arc<Packet>>> {
+        let column = self.columns.get(&key)?;
+        column.valid.then(|| {
+            std::iter::once(Arc::clone(&column.base))
+                .chain(column.updates.iter().cloned())
+                .collect()
+        })
+    }
+    fn retain(&mut self, wanted: &HashSet<Column>) {
+        let old: Vec<_> = self
+            .columns
+            .keys()
+            .copied()
+            .filter(|key| !wanted.contains(key))
+            .collect();
+        for key in old {
+            self.remove(key);
+        }
+    }
+}
+struct Member {
+    session: Weak<Shared>,
+    area: InterestArea,
+    wanted: HashSet<Column>,
+    delivered: HashSet<Column>,
+}
+struct State {
+    owner: usize,
+    owners: TerrainOwners,
+    digest: Digest,
+    members: HashMap<u64, Member>,
+    wanted: HashSet<Column>,
+    cache: Cache,
+    failed: bool,
+    version: u64,
+}
+impl State {
+    fn interests(&mut self) {
+        self.version = self.version.wrapping_add(1);
+        self.wanted = self
+            .members
+            .values()
+            .flat_map(|m| m.wanted.iter().copied())
+            .collect();
+        self.cache.retain(&self.wanted);
+    }
+    fn admit(&self, id: Option<u64>, next: InterestArea, wanted: usize) -> Result<(), String> {
+        if self.failed {
+            return Err("shared terrain reader ended".into());
+        }
+        if id.is_none() && self.members.len() >= MAX_MEMBERS {
+            return Err("shared terrain subscriber bound exceeded".into());
+        }
+        if self
+            .members
+            .iter()
+            .filter(|(key, _)| Some(**key) != id)
+            .map(|(_, m)| m.wanted.len())
+            .sum::<usize>()
+            + wanted
+            > MAX_INTERESTS
+        {
+            return Err("shared terrain total interests exceeded".into());
+        }
+        coverage(
+            self.members
+                .iter()
+                .filter(|(key, _)| Some(**key) != id)
+                .map(|(_, m)| m.area)
+                .chain(std::iter::once(next)),
+        )
+    }
+}
+
+#[derive(Clone)]
+pub struct SharedTerrain(Arc<Mutex<State>>);
+pub struct SharedSubscription {
+    view: SharedTerrain,
+    id: u64,
+}
+impl Drop for SharedSubscription {
+    fn drop(&mut self) {
+        let mut state = lock(&self.view.0);
+        state.members.remove(&self.id);
+        state.interests();
+    }
+}
+impl SharedTerrain {
+    pub fn areas(&self) -> Vec<InterestArea> {
+        let state = lock(&self.0);
+        let mut areas: Vec<_> = state.members.values().map(|m| m.area).collect();
+        areas.sort_unstable();
+        areas.dedup();
+        areas
+    }
+    pub fn version(&self) -> u64 {
+        lock(&self.0).version
+    }
+    pub fn refreshes(&self) -> Vec<[i32; 2]> {
+        let state = lock(&self.0);
+        state
+            .cache
+            .refresh
+            .iter()
+            .filter(|key| !state.cache.sent_refresh.contains(key))
+            .take(256)
+            .map(|&(x, z)| [x, z])
+            .collect()
+    }
+    pub fn refreshed(&self, columns: &[[i32; 2]]) {
+        let mut state = lock(&self.0);
+        for at in columns {
+            let key = (at[0], at[1]);
+            if state.cache.refresh.contains(&key) {
+                state.cache.sent_refresh.insert(key);
+            }
+        }
+    }
+    pub fn subscribe(
+        &self,
+        session: &SessionHandle,
+        position: [f64; 3],
+        radius: i32,
+    ) -> Result<SharedSubscription, String> {
+        let digest = session
+            .0
+            .down()
+            .config_digest
+            .ok_or("client is still configuring")?;
+        let mut state = lock(&self.0);
+        if state.digest != digest {
+            return Err("shared observer registry digest differs".into());
+        }
+        let area = area(position, radius)?;
+        let wanted = columns(area, &state.owners, state.owner);
+        state.admit(None, area, wanted.len())?;
+        static NEXT: AtomicU64 = AtomicU64::new(1);
+        let id = NEXT.fetch_add(1, Ordering::Relaxed);
+        state.members.insert(
+            id,
+            Member {
+                session: Arc::downgrade(&session.0),
+                area,
+                wanted,
+                delivered: HashSet::new(),
+            },
+        );
+        state.interests();
+        if let Err(error) = replay(&mut state, id) {
+            state.members.remove(&id);
+            state.interests();
+            return Err(error);
+        }
+        Ok(SharedSubscription {
+            view: self.clone(),
+            id,
+        })
+    }
+    fn receive(
+        &self,
+        packet: Packet,
+        touched: &mut HashMap<u64, Arc<Shared>>,
+    ) -> Result<(), String> {
+        let packets = if packet.id == c::CHUNKS_BIOMES {
+            match packet.decode() {
+                Ok(play::Clientbound::ChunksBiomes(p)) => p
+                    .chunks
+                    .into_iter()
+                    .map(|chunk| {
+                        (
+                            (chunk.pos[0], chunk.pos[1]),
+                            Arc::new(Packet::of(&play::Clientbound::ChunksBiomes(
+                                play::ChunksBiomes {
+                                    chunks: vec![chunk],
+                                },
+                            ))),
+                        )
+                    })
+                    .collect(),
+                _ => return Err("invalid shared biome packet".into()),
+            }
+        } else if let Some(key) = crate::terrain::column(packet.id, &packet.payload) {
+            vec![(key, Arc::new(packet))]
+        } else {
+            return Ok(());
+        };
+        let mut state = lock(&self.0);
+        let owner = state.owner;
+        for (key, packet) in packets {
+            if state.owners.owner(key.0, key.1) != Some(owner) || !state.wanted.contains(&key) {
+                continue;
+            }
+            state.cache.apply(key, Arc::clone(&packet))?;
+            let ids: Vec<_> = state
+                .members
+                .iter()
+                .filter_map(|(&id, m)| m.wanted.contains(&key).then_some(id))
+                .collect();
+            for id in ids {
+                let member = state.members.get_mut(&id).expect("live member");
+                let Some(shared) = member.session.upgrade() else {
+                    continue;
+                };
+                if SessionHandle(Arc::clone(&shared)).is_over() {
+                    continue;
+                }
+                if packet.id != c::LEVEL_CHUNK_WITH_LIGHT && !member.delivered.contains(&key) {
+                    continue;
+                }
+                let mut down = shared.down();
+                if let std::collections::hash_map::Entry::Vacant(entry) = touched.entry(id) {
+                    down.writer.begin();
+                    entry.insert(Arc::clone(&shared));
+                }
+                let mut body = Vec::new();
+                if crate::terrain::relay(
+                    &shared,
+                    &mut down,
+                    owner,
+                    true,
+                    (*packet).clone(),
+                    &mut body,
+                )
+                .is_err()
+                {
+                    drop(down);
+                    SessionHandle(shared).close();
+                    continue;
+                }
+                if packet.id == c::LEVEL_CHUNK_WITH_LIGHT {
+                    member.delivered.insert(key);
+                }
+                if packet.id == c::FORGET_LEVEL_CHUNK {
+                    member.delivered.remove(&key);
+                }
+            }
+        }
+        Ok(())
+    }
+    fn fail(&self) {
+        let sessions = {
+            let mut state = lock(&self.0);
+            state.failed = true;
+            state
+                .members
+                .values()
+                .filter_map(|m| m.session.upgrade())
+                .collect::<Vec<_>>()
+        };
+        for shared in sessions {
+            SessionHandle(shared).close();
+        }
+    }
+}
+impl SharedSubscription {
+    pub fn recenter(&self, position: [f64; 3], radius: i32, reset: bool) -> Result<(), String> {
+        let mut state = lock(&self.view.0);
+        let next = area(position, radius)?;
+        let wanted = columns(next, &state.owners, state.owner);
+        state.admit(Some(self.id), next, wanted.len())?;
+        let owner = state.owner;
+        let member = state
+            .members
+            .get_mut(&self.id)
+            .ok_or("shared terrain membership ended")?;
+        if member.area == next && !reset {
+            return Ok(());
+        }
+        if reset {
+            member.delivered = HashSet::new();
+        }
+        let removed: Vec<_> = member
+            .delivered
+            .iter()
+            .copied()
+            .filter(|key| !wanted.contains(key))
+            .collect();
+        if let Some(shared) = member.session.upgrade() {
+            let mut down = shared.down();
+            let mut body = Vec::new();
+            down.writer.begin();
+            let result = (|| {
+                for (x, z) in removed {
+                    member.delivered.remove(&(x, z));
+                    crate::terrain::relay(
+                        &shared,
+                        &mut down,
+                        owner,
+                        true,
+                        Packet::of(&play::Clientbound::ForgetLevelChunk(
+                            play::ForgetLevelChunk { pos: [x, z] },
+                        )),
+                        &mut body,
+                    )
+                    .map_err(|e| e.to_string())?;
+                }
+                Ok::<(), String>(())
+            })();
+            let flushed = down.writer.end().map_err(|e| e.to_string());
+            result.and(flushed)?;
+        }
+        if member.delivered.capacity() > member.delivered.len() * 4 + 64 {
+            member.delivered.shrink_to_fit();
+        }
+        member.area = next;
+        member.wanted = wanted;
+        state.interests();
+        replay(&mut state, self.id)
+    }
+    pub fn retire(&self) -> Result<bool, String> {
+        let mut state = lock(&self.view.0);
+        let Some(member) = state.members.get(&self.id) else {
+            return Ok(true);
+        };
+        if let Some(shared) = member.session.upgrade()
+            && !SessionHandle(shared).retire_shared_terrain(state.owner)?
+        {
+            return Ok(false);
+        }
+        state.members.remove(&self.id);
+        state.interests();
+        Ok(true)
+    }
+}
+fn replay(state: &mut State, id: u64) -> Result<(), String> {
+    let member = state
+        .members
+        .get_mut(&id)
+        .ok_or("shared terrain membership ended")?;
+    let Some(shared) = member.session.upgrade() else {
+        return Ok(());
+    };
+    let mut down = shared.down();
+    let mut body = Vec::new();
+    down.writer.begin();
+    let mut wanted: Vec<_> = member
+        .wanted
+        .iter()
+        .copied()
+        .filter(|key| !member.delivered.contains(key))
+        .collect();
+    wanted.sort_by_key(|key| {
+        (
+            (key.0 - member.area.center[0])
+                .abs()
+                .max((key.1 - member.area.center[1]).abs()),
+            *key,
+        )
+    });
+    let result = (|| {
+        for key in wanted {
+            if let Some(packets) = state.cache.snapshot(key) {
+                for packet in packets {
+                    crate::terrain::relay(
+                        &shared,
+                        &mut down,
+                        state.owner,
+                        true,
+                        (*packet).clone(),
+                        &mut body,
+                    )
+                    .map_err(|e| e.to_string())?;
+                }
+                member.delivered.insert(key);
+            }
+        }
+        Ok(())
+    })();
+    let flushed = down.writer.end().map_err(|e| e.to_string());
+    result.and(flushed)
+}
+
+impl SessionHandle {
+    /// The configured client's registry identity, used to select a compatible shared group.
+    pub fn terrain_digest(&self) -> Option<Digest> {
+        self.0.down().config_digest
+    }
+    pub fn shared_terrain(&self, owner: usize) -> Result<SharedTerrain, String> {
+        let down = self.0.down();
+        Ok(SharedTerrain(Arc::new(Mutex::new(State {
+            owner,
+            owners: down
+                .terrain
+                .as_ref()
+                .ok_or("terrain is not composed")?
+                .owners
+                .clone(),
+            digest: down.config_digest.ok_or("client is still configuring")?,
+            members: HashMap::new(),
+            wanted: HashSet::new(),
+            cache: Cache::default(),
+            failed: false,
+            version: 0,
+        }))))
+    }
+    pub fn open_shared_terrain_reader(
+        &self,
+        target: TargetBackend<'_>,
+        profile: &Profile,
+        view: &SharedTerrain,
+    ) -> Result<TerrainReader, String> {
+        let io = self
+            .0
+            .io
+            .clone()
+            .ok_or("shared terrain needs caller-owned readiness IO")?;
+        let client: ClientConfiguration = self.0.up().client.clone();
+        let mut link =
+            backend::connect(target.address, profile, target.options).map_err(|e| e.to_string())?;
+        link.connection
+            .reader
+            .set_read_timeout(Some(Duration::from_secs(8)))
+            .map_err(|e| e.to_string())?;
+        let (digest, _) = configure(&mut link.connection, &client)?;
+        if lock(&view.0).digest != digest {
+            return Err("shared observer registry digest differs".into());
+        }
+        link.connection
+            .reader
+            .set_read_timeout(None)
+            .map_err(|e| e.to_string())?;
+        let (source, writer, closer) =
+            crate::transport::split(link.connection, true, crate::path_timing::Path::Reader)
+                .map_err(|e| e.to_string())?;
+        let crate::transport::Source::Ready(stream, reader) = source else {
+            return Err("shared reader was not readiness driven".into());
+        };
+        let intentional = Arc::new(AtomicBool::new(false));
+        let handle = TerrainReader(closer, Arc::clone(&intentional));
+        let writer = Mutex::new(writer);
+        let view = view.clone();
+        io.register_with(stream, reader, |output| {
+            lock(&writer).attach(output.clone());
+            Box::new(Reader {
+                view,
+                writer,
+                intentional,
+                target: Target::terrain_reader(0),
+                touched: HashMap::new(),
+                burst: false,
+            })
+        })
+        .map_err(|e| e.to_string())?;
+        Ok(handle)
+    }
+}
+struct Reader {
+    view: SharedTerrain,
+    writer: Mutex<Writer>,
+    intentional: Arc<AtomicBool>,
+    target: Target,
+    touched: HashMap<u64, Arc<Shared>>,
+    burst: bool,
+}
+impl Handler for Reader {
+    fn packet(&mut self, id: i32, payload: Vec<u8>, arrived: Instant) -> io::Result<()> {
+        if self.intentional.load(Ordering::Acquire) {
+            return Err(io::ErrorKind::ConnectionAborted.into());
+        }
+        crate::path_timing::stamp(Some(arrived));
+        if !self.burst {
+            lock(&self.writer).begin();
+            self.burst = true;
+        }
+        // Only lane-local flow control enters Target. Entity, recipe and advancement
+        // histories are not part of this bounded terrain cache.
+        if matches!(
+            id,
+            c::LOGIN
+                | c::PLAYER_POSITION
+                | c::CHUNK_BATCH_FINISHED
+                | c::COOKIE_REQUEST
+                | c::KEEP_ALIVE
+                | c::PING
+        ) {
+            self.target.take(&self.writer, id, &payload);
+            let mut target = self.target.lock();
+            target.answered.clear();
+            if target.ended.is_some() {
+                return Err(io::Error::other("shared reader flow-control state failed"));
+            }
+        }
+        if matches!(id, c::DISCONNECT | c::START_CONFIGURATION | c::TRANSFER) {
+            return Err(io::Error::other("shared reader left its play stream"));
+        }
+        self.view
+            .receive(Packet { id, payload }, &mut self.touched)
+            .map_err(io::Error::other)
+    }
+    fn drained(&mut self) -> io::Result<()> {
+        for (_, shared) in self.touched.drain() {
+            let result = shared.down().writer.end();
+            if result.is_err() {
+                SessionHandle(shared).close();
+            }
+        }
+        if self.burst {
+            self.burst = false;
+            lock(&self.writer).end().map_err(io::Error::other)?;
+        }
+        crate::path_timing::stamp(None);
+        Ok(())
+    }
+    fn closed(&mut self, _: io::Error) {
+        let _ = self.drained();
+        if !self.intentional.load(Ordering::Acquire) {
+            self.view.fail();
+        }
+    }
+}
