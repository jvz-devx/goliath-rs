--- /dev/null
+++ b/crates/meridian-proxy/src/terrain/shared.rs
@@ -0,0 +1,365 @@
+//! Proxy-owned shared reader lifetimes and sparse-interest control requests.
+use super::{near, schedule};
+use meridian_config::{Config, TileMap};
+use meridian_handoff::{
+    Digest, InterestArea, SessionHandle, SharedSubscription, SharedTerrain, TargetBackend,
+    TerrainOwners, TerrainReader,
+};
+use meridian_net::{backend::BackendOptions, io_pool::Affinity};
+use meridian_sidecar::endpoint::Endpoint;
+use serde_json::{Value, json};
+use std::{
+    collections::HashMap,
+    net::IpAddr,
+    sync::{Arc, Mutex, Weak},
+    time::{Duration, Instant},
+};
+
+type Slot = Arc<Mutex<Option<Live>>>;
+type ViewSlots = HashMap<(String, Digest), Weak<Mutex<Option<Live>>>>;
+#[derive(Default)]
+pub(crate) struct SharedViews {
+    slots: Mutex<ViewSlots>,
+}
+impl SharedViews {
+    fn slot(&self, key: String, digest: Digest) -> Result<Slot, String> {
+        let mut slots = self.slots.lock().expect("shared terrain registry poisoned");
+        slots.retain(|_, slot| slot.strong_count() != 0);
+        if let Some(slot) = slots.get(&(key.clone(), digest)).and_then(Weak::upgrade) {
+            return Ok(slot);
+        }
+        if slots.keys().filter(|(tile, _)| tile == &key).count() >= 4 {
+            return Err("shared terrain exceeds four configuration groups per tile".into());
+        }
+        let slot = Arc::new(Mutex::new(None));
+        slots.insert((key, digest), Arc::downgrade(&slot));
+        Ok(slot)
+    }
+}
+struct Owned {
+    member: SharedSubscription,
+    live: Slot,
+    center: (i32, i32),
+}
+struct Live {
+    _reader: TerrainReader,
+    view: SharedTerrain,
+    uuid: String,
+    anchor: [f64; 3],
+    revision: u64,
+    version: u64,
+    areas: Vec<InterestArea>,
+    refreshed: Instant,
+}
+struct Context {
+    config: Config,
+    map: TileMap,
+    endpoints: Vec<Endpoint>,
+    options: BackendOptions,
+}
+const TIMEOUT: Duration = Duration::from_secs(8);
+
+fn encoded(areas: &[InterestArea]) -> Vec<Value> {
+    areas
+        .iter()
+        .map(|a| json!({"center":a.center,"radius":a.radius}))
+        .collect()
+}
+fn ask(endpoint: &Endpoint, command: String) -> Result<Value, String> {
+    let reply = endpoint.ask(&command, TIMEOUT).map_err(|e| e.to_string())?;
+    if reply["ok"] != true {
+        return Err(format!("shared observer refused: {reply}"));
+    }
+    Ok(reply)
+}
+impl Context {
+    fn open(
+        &self,
+        handle: &SessionHandle,
+        index: usize,
+        position: [f64; 3],
+        radius: i32,
+    ) -> Result<(Live, SharedSubscription), String> {
+        let view = handle.shared_terrain(index)?;
+        // Install demand before the stream can deliver its first full snapshot.
+        let member = view.subscribe(handle, position, radius)?;
+        let profile = handle.terrain_profile(index);
+        let uuid = horizon_protocol::crypto::uuid_string(u128::from_be_bytes(profile.uuid));
+        let areas = view.areas();
+        let request = json!({"position":position,"revision":1,"areas":encoded(&areas)});
+        let reply = ask(
+            &self.endpoints[index],
+            format!("player-observe {uuid} {request}"),
+        )?;
+        if reply["revision"] != 1 {
+            return Err("shared observer interest revision was not acknowledged".into());
+        }
+        let tile = &self.map.entries[index];
+        let backend = self
+            .config
+            .backend(&tile.backend)
+            .ok_or("missing terrain backend")?;
+        let reader = handle.open_shared_terrain_reader(
+            TargetBackend {
+                name: &tile.backend,
+                address: &backend.address,
+                options: &self.options,
+            },
+            &profile,
+            &view,
+        )?;
+        let version = view.version();
+        Ok((
+            Live {
+                _reader: reader,
+                view,
+                uuid,
+                anchor: position,
+                revision: 1,
+                version,
+                areas,
+                refreshed: Instant::now(),
+            },
+            member,
+        ))
+    }
+}
+impl Live {
+    fn sync(&mut self, endpoint: &Endpoint) -> Result<(), String> {
+        let version = self.view.version();
+        let areas = if version != self.version {
+            self.view.areas()
+        } else {
+            self.areas.clone()
+        };
+        if areas != self.areas || self.refreshed.elapsed() >= Duration::from_secs(5) {
+            let revision = if areas != self.areas {
+                self.revision
+                    .checked_add(1)
+                    .ok_or("shared observer revision exhausted")?
+            } else {
+                self.revision
+            };
+            let request =
+                json!({"position":self.anchor,"revision":revision,"areas":encoded(&areas)});
+            let reply = ask(endpoint, format!("player-observe {} {request}", self.uuid))?;
+            if reply["revision"] != revision {
+                return Err("shared observer interest revision differs".into());
+            }
+            self.revision = revision;
+            self.areas = areas;
+            self.refreshed = Instant::now();
+        }
+        self.version = version;
+        let columns = self.view.refreshes();
+        if !columns.is_empty() {
+            let request = json!({"revision":self.revision,"columns":columns});
+            ask(
+                endpoint,
+                format!("player-observe-refresh {} {request}", self.uuid),
+            )?;
+            self.view.refreshed(&columns);
+        }
+        Ok(())
+    }
+}
+pub(super) fn start(
+    config: &Config,
+    handle: &SessionHandle,
+    address: IpAddr,
+    io: Affinity,
+    views: Arc<SharedViews>,
+) -> Result<(), String> {
+    let map = config.tiles.clone().ok_or("missing tile map")?;
+    let endpoints = map
+        .entries
+        .iter()
+        .map(|t| crate::cluster::terrain_endpoint(&t.backend))
+        .collect::<Result<Vec<_>, _>>()?;
+    handle.compose_terrain(TerrainOwners {
+        origin: map.origin,
+        edge: map.edge,
+        entries: map.entries.iter().map(|t| t.index).collect(),
+        backends: map.entries.iter().map(|t| t.backend.clone()).collect(),
+    });
+    let options = BackendOptions {
+        forwarding_secret: config.forwarding_secret.as_bytes().to_vec(),
+        connect_timeout: Duration::from_millis(config.connect_timeout_ms),
+        player_address: address,
+    };
+    let context = Context {
+        config: config.clone(),
+        map,
+        endpoints,
+        options,
+    };
+    let handle = handle.clone();
+    let over = handle.clone();
+    let failed = handle.clone();
+    let mut members: Vec<Option<Owned>> = (0..context.map.entries.len()).map(|_| None).collect();
+    let mut retry_after = vec![None; context.map.entries.len()];
+    let eager = std::env::var_os("E18_TERRAIN_EAGER").is_some();
+    let mut step = move || -> Result<bool, String> {
+        if handle.is_over() {
+            return Ok(false);
+        }
+        let Some(position) = handle.terrain_position() else {
+            return Ok(true);
+        };
+        let center = (
+            (position[0].floor() as i32) >> 4,
+            (position[2].floor() as i32) >> 4,
+        );
+        let active = handle.backend();
+        let radius = handle.terrain_radius();
+        let reset = handle.terrain_reset_requested();
+        let near_foreign = context.map.entries.iter().any(|t| {
+            t.backend != active
+                && near(
+                    position,
+                    context.map.origin,
+                    context.map.edge,
+                    t.index,
+                    radius + 2,
+                )
+        });
+        handle.terrain_center(position)?;
+        for (index, tile) in context.map.entries.iter().enumerate() {
+            let margin = radius + if members[index].is_some() { 4 } else { 2 };
+            let wanted = eager
+                || if tile.backend == active {
+                    near_foreign
+                        || members[index].is_some()
+                            && context.map.entries.iter().any(|other| {
+                                other.backend != active
+                                    && near(
+                                        position,
+                                        context.map.origin,
+                                        context.map.edge,
+                                        other.index,
+                                        radius + 4,
+                                    )
+                            })
+                } else {
+                    near(
+                        position,
+                        context.map.origin,
+                        context.map.edge,
+                        tile.index,
+                        margin,
+                    )
+                };
+            if !wanted {
+                if let Some(owned) = members[index].as_ref()
+                    && owned.member.retire()?
+                {
+                    drop(members[index].take());
+                }
+                continue;
+            }
+            if members[index].is_none() {
+                if retry_after[index].is_some_and(|at| Instant::now() < at) {
+                    continue;
+                }
+                let key = format!(
+                    "{:?}:{index}:{}",
+                    context.map,
+                    context
+                        .config
+                        .backend(&tile.backend)
+                        .ok_or("missing terrain backend")?
+                        .address
+                );
+                let slot = views.slot(
+                    key,
+                    handle
+                        .terrain_digest()
+                        .ok_or("client is still configuring")?,
+                )?;
+                let mut live = slot.lock().expect("shared observer owner poisoned");
+                let member = if let Some(live) = live.as_mut() {
+                    live.view.subscribe(&handle, position, radius)?
+                } else {
+                    match context.open(&handle, index, position, radius) {
+                        Ok((opened, member)) => {
+                            *live = Some(opened);
+                            member
+                        }
+                        Err(error) if error.contains("too many players are expected at once") => {
+                            retry_after[index] = Some(Instant::now() + Duration::from_secs(1));
+                            continue;
+                        }
+                        Err(error) => return Err(error),
+                    }
+                };
+                live.as_mut()
+                    .expect("open shared reader")
+                    .sync(&context.endpoints[index])?;
+                drop(live);
+                members[index] = Some(Owned {
+                    member,
+                    live: slot,
+                    center,
+                });
+                retry_after[index] = None;
+            }
+            let owned = members[index].as_mut().expect("wanted shared subscription");
+            if reset || owned.center != center {
+                owned.member.recenter(position, radius, reset)?;
+                owned.center = center;
+            }
+            owned
+                .live
+                .lock()
+                .expect("shared observer owner poisoned")
+                .as_mut()
+                .expect("live shared reader")
+                .sync(&context.endpoints[index])?;
+        }
+        Ok(true)
+    };
+    schedule(
+        io,
+        move || over.is_over(),
+        move || match step() {
+            Ok(keep) => keep,
+            Err(error) => {
+                crate::log::warning!("shared terrain composition stopped: {error}");
+                failed.close();
+                false
+            }
+        },
+    )
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use meridian_handoff::DigestBuilder;
+    fn digest(value: u8) -> Digest {
+        let mut d = DigestBuilder::default();
+        d.add(
+            horizon_protocol::ids::configuration::clientbound::REGISTRY_DATA,
+            &[value],
+        );
+        d.finish()
+    }
+    #[test]
+    fn compatible_clients_share_one_slot_and_configuration_groups_have_a_fixed_bound() {
+        let views = SharedViews::default();
+        let mut held = Vec::new();
+        let first = views.slot("tile-a".into(), digest(0)).unwrap();
+        assert!(Arc::ptr_eq(
+            &first,
+            &views.slot("tile-a".into(), digest(0)).unwrap()
+        ));
+        held.push(first);
+        for i in 1..4 {
+            held.push(views.slot("tile-a".into(), digest(i)).unwrap());
+        }
+        assert!(views.slot("tile-a".into(), digest(4)).is_err());
+        assert!(views.slot("tile-b".into(), digest(4)).is_ok());
+        held.pop();
+        assert!(views.slot("tile-a".into(), digest(4)).is_ok());
+    }
+}
