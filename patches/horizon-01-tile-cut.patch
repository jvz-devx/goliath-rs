+                        Err(e) => return Err(e.into()),
+                    };
+                    entry.insert(old);
+                }
+                let mut poi = save::encode_poi(chunk, tables);
+                if let (Some(next), Some(Some(previous))) = (&mut poi, pois.get(&key)) {
+                    save::keep_claims(next, previous);
+                }
+                pois.insert(key, poi.clone());
+                let bytes = poi
+                    .map(|tag| nbt::write_named(&tag, Limits::saved()))
