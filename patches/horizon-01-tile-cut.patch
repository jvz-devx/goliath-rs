@@ -0,0 +1,735 @@
+//! E6's tick-boundary snapshots. The sole worker owns encoding, append and compaction.
+use crate::game::Game;
+use horizon_client::{
+    Result,
+    biome::Biomes,
+    chunk::{Chunk, LevelShape},
+    save::{self, Level, SaveTables},
+};
+use horizon_core::position::ChunkPos;
+use horizon_world::{
+    compression::Compression,
+    nbt::{self, Limits, NamedTag, Tag},
+    registry::BlockRegistry,
+};
+use serde_json::{Value, json};
+use std::{
+    collections::{HashMap, HashSet},
+    path::{Path, PathBuf},
+    sync::{
+        Arc, Weak,
+        mpsc::{self, Receiver, Sender},
+    },
+    time::Instant,
+};
+mod store;
+
+fn configured() -> Result<(PathBuf, String)> {
+    let root = std::env::var_os("HORIZON_E3_CUT_DIR").ok_or("tile cuts are off")?;
+    let fence = std::env::var("HORIZON_E3_FENCE")?;
+    if fence.is_empty() || fence == "-" || fence.chars().any(char::is_whitespace) {
+        return Err("the process needs a nonempty opaque fence".into());
+    }
+    Ok((PathBuf::from(root), fence))
+}
+pub(super) fn fence_request(args: &str) -> Value {
+    let result = (|| -> Result<()> {
+        let (root, _) = configured()?;
+        let parts: Vec<_> = args.split_whitespace().collect();
+        if parts.len() != 2 || parts[1] == "-" {
+            return Err("tile-fence needs expected-token new-token".into());
+        }
+        store::claim(&root, parts[0], parts[1])
+    })();
+    match result {
+        Ok(()) => json!({"ok":true}),
+        Err(e) => json!({"error":e.to_string()}),
+    }
+}
+pub(super) fn restore_configured(world: &Path) -> Result<()> {
+    if std::env::var_os("HORIZON_E3_CUT_DIR").is_none() {
+        return Ok(());
+    }
+    let (root, token) = configured()?;
+    if !root.is_absolute() || root.starts_with(world) || world.starts_with(&root) {
+        return Err("cut directory must be absolute and outside the working world".into());
+    }
+    let _session = save::SessionLock::acquire(world)?;
+    if let Some(head) = store::restore(&root, &token, world)? {
+        eprintln!("E3_RESTORED {}", serde_json::to_string(&head)?);
+    }
+    Ok(())
+}
+type Key = (String, i32, i32);
+struct Seen {
+    chunk: Weak<Chunk>,
+    revision: u64,
+    pistons: bool,
+}
+pub(super) struct Runtime {
+    send: Sender<Work>,
+    done: Receiver<std::result::Result<(), String>>,
+    seen: HashMap<Key, Seen>,
+    names: HashMap<String, Vec<((i32, i32, i32), String)>>,
+    unloads: HashMap<String, u64>,
+    players: Option<HashSet<u128>>,
+    pending: usize,
+    poisoned: bool,
+    initialized: bool,
+}
+struct Terrain {
+    prefix: String,
+    chunks: Vec<Arc<Chunk>>,
+    metadata: Vec<ChunkMetadata>,
+    entities: Vec<((i32, i32), Vec<Tag>)>,
+    registry: &'static BlockRegistry,
+    biomes: Arc<Biomes>,
+    tables: Option<Arc<SaveTables>>,
+    shape: LevelShape,
+    forced: HashSet<(i32, i32)>,
+}
+struct ChunkMetadata {
+    key: [i32; 2],
+    time: i64,
+    inhabited: i64,
+    blocks: Vec<horizon_core::ticks::SavedTick>,
+    fluids: Vec<horizon_core::ticks::SavedTick>,
+}
+struct Work {
+    tick: i64,
+    terrain: Vec<Terrain>,
+    tags: Vec<(String, Tag)>,
+    json: Vec<(String, Value)>,
+    level: Level,
+    clock: (f32, f32, bool),
+    bootstrap: Option<store::Files>,
+    start: Instant,
+    tick_ms: f64,
+    capture_ms: f64,
+    export: Option<Value>,
+    reply: Sender<String>,
+}
+impl Runtime {
+    fn new(root: PathBuf, token: String) -> Result<Self> {
+        let (send, receive) = mpsc::channel();
+        let (done_tx, done) = mpsc::channel();
+        std::thread::Builder::new()
+            .name("e6-cut-writer".into())
+            .spawn(move || worker(root, token, receive, done_tx))?;
+        Ok(Self {
+            send,
+            done,
+            seen: HashMap::new(),
+            names: HashMap::new(),
+            unloads: HashMap::new(),
+            players: None,
+            pending: 0,
+            poisoned: false,
+            initialized: false,
+        })
+    }
+    fn ready(&mut self) -> Result<()> {
+        while let Ok(result) = self.done.try_recv() {
+            self.pending -= 1;
+            if result.is_err() {
+                self.poisoned = true;
+            }
+        }
+        if self.poisoned {
+            return Err(
+                "cut writer failed; restart from the durable log before another cut".into(),
+            );
+        }
+        if self.pending >= 8 {
+            return Err("cut queue is full".into());
+        }
+        Ok(())
+    }
+}
+fn gzip(tag: Tag) -> Result<Vec<u8>> {
+    Ok(Compression::Gzip.encode(
+        &nbt::write_named(
+            &NamedTag {
+                name: "".into(),
+                tag,
+            },
+            Limits::saved(),
+        )
+        .map_err(|e| e.to_string())?,
+    )?)
+}
+fn region(prefix: &str, folder: &str, x: i32, z: i32) -> String {
+    format!("{prefix}/{folder}/r.{}.{}.mca", x >> 5, z >> 5)
+}
+fn encode(
+    work: &mut Work,
+    staging: &Path,
+    pois: &mut HashMap<Key, Option<NamedTag>>,
