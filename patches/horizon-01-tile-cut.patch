+}
+
+thread_local! {
+    /// E6 borrows the existing metadata builders, but never their file writers.
+    static CUT_TAGS: std::cell::RefCell<Option<Vec<(PathBuf, Tag)>>> = const { std::cell::RefCell::new(None) };
+}
+
+/// Collect metadata tags on this thread without encoding or writing them. A panic clears the
+/// scope too. Background region/player writers on other threads are deliberately unaffected.
+pub fn cut_tags<T>(build: impl FnOnce() -> Result<T>) -> Result<(T, Vec<(PathBuf, Tag)>)> {
+    struct Clear;
+    impl Drop for Clear {
+        fn drop(&mut self) {
+            CUT_TAGS.with(|tags| {
+                tags.borrow_mut().take();
+            });
+        }
+    }
+    CUT_TAGS.with(|tags| -> Result<()> {
+        if tags.borrow().is_some() {
+            return Err("nested cut metadata capture".into());
+        }
+        *tags.borrow_mut() = Some(Vec::new());
+        Ok(())
+    })?;
+    let _clear = Clear;
+    let value = build()?;
+    let tags = CUT_TAGS.with(|tags| tags.borrow_mut().take().unwrap_or_default());
+    Ok((value, tags))
+}
