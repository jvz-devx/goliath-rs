+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn scratch() -> std::path::PathBuf {
+        static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+        let base = std::env::var_os("E3_TEST_ROOT").expect("isolated E3_TEST_ROOT required");
+        let dir = Path::new(&base).join(format!(
+            "e6-store-{}-{}-{}",
+            std::process::id(),
+            NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed),
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .unwrap()
+                .as_nanos()
+        ));
+        fs::create_dir_all(&dir).unwrap();
+        dir
+    }
+    fn image(n: u8) -> Vec<Change> {
+        ["chest", "drop", "player-a", "player-b", "level"]
+            .into_iter()
+            .map(|p| Change::file(p.into(), vec![n; 32]))
+            .collect()
+    }
+    #[test]
+    fn every_byte_torn_tail_restores_one_complete_cut() {
+        let dir = scratch();
+        claim(&dir, "-", "a").unwrap();
+        let mut writer = Writer::open(&dir, "a").unwrap();
+        writer.append(&dir, "a", vec![(1, image(1))]).unwrap();
+        let before = fs::read(dir.join("LOG")).unwrap();
+        writer.append(&dir, "a", vec![(2, image(2))]).unwrap();
+        let complete = fs::read(dir.join("LOG")).unwrap();
+        drop(writer);
+        for end in before.len()..=complete.len() {
+            fs::write(dir.join("LOG"), &complete[..end]).unwrap();
+            let world = dir.join("world");
+            fs::create_dir_all(&world).unwrap();
+            fs::write(world.join("future"), b"discard").unwrap();
+            let head = restore(&dir, "a", &world).unwrap().unwrap();
+            let wanted = if end == complete.len() { 2 } else { 1 };
+            assert_eq!(head.sequence, wanted);
+            for c in image(wanted as u8) {
+                assert_eq!(fs::read(world.join(c.path)).unwrap(), c.bytes);
+            }
+            assert!(!world.join("future").exists());
+        }
+        fs::remove_dir_all(dir).unwrap();
+    }
+    #[test]
+    fn stale_writer_cannot_append_after_fence_change() {
+        let dir = scratch();
+        claim(&dir, "-", "a").unwrap();
+        let mut old = Writer::open(&dir, "a").unwrap();
+        old.append(&dir, "a", vec![(1, image(1))]).unwrap();
+        claim(&dir, "a", "b").unwrap();
+        let before = fs::read(dir.join("LOG")).unwrap();
+        assert!(old.append(&dir, "a", vec![(2, image(2))]).is_err());
+        assert_eq!(fs::read(dir.join("LOG")).unwrap(), before);
+        let mut next = Writer::open(&dir, "b").unwrap();
+        next.append(&dir, "b", vec![(3, image(3))]).unwrap();
+        assert_eq!(
+            restore(&dir, "b", &dir.join("world"))
+                .unwrap()
+                .unwrap()
+                .sequence,
+            2
+        );
+        fs::remove_dir_all(dir).unwrap();
+    }
+    #[test]
+    fn grouped_records_and_interrupted_compaction_replay() {
+        let dir = scratch();
+        claim(&dir, "-", "a").unwrap();
+        let mut writer = Writer::open(&dir, "a").unwrap();
+        let out = writer
+            .append(&dir, "a", vec![(1, image(1)), (2, image(2))])
+            .unwrap();
+        assert_eq!(out[0].2, out[1].2);
+        fs::write(
+            dir.join("BASE"),
+            encode(out[1].0.clone(), &image(2)).unwrap(),
+        )
+        .unwrap();
+        assert_eq!(
+            restore(&dir, "a", &dir.join("world"))
+                .unwrap()
+                .unwrap()
+                .sequence,
+            2
+        );
+        fs::remove_dir_all(dir).unwrap();
+    }
+    #[test]
+    fn compaction_rotates_log_identity_and_rejects_an_old_writer() {
+        let dir = scratch();
+        claim(&dir, "-", "a").unwrap();
+        let mut old = Writer::open(&dir, "a").unwrap();
+        let mut writer = Writer::open(&dir, "a").unwrap();
+        let out = writer
+            .append(&dir, "a", vec![(1, image(1)), (2, image(2))])
+            .unwrap();
+        writer.compact_at(&dir, "a", out[1].0.clone(), 0).unwrap();
+        assert_eq!(fs::metadata(dir.join("LOG")).unwrap().len(), 0);
+        assert!(old.append(&dir, "a", vec![(3, image(3))]).is_err());
+        writer.append(&dir, "a", vec![(3, image(3))]).unwrap();
