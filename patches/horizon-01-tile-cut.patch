+        }
+        for ((x, z), entities) in &terrain.entities {
+            let tag = Tag::compound([
+                ("DataVersion", Tag::Int(horizon_world::DATA_VERSION)),
+                ("Position", Tag::IntArray(vec![*x, *z])),
+                ("Entities", Tag::List(entities.clone())),
+            ]);
+            let bytes = if entities.is_empty() {
+                Vec::new()
+            } else {
+                Compression::Zlib.encode(
+                    &nbt::write_named(
+                        &NamedTag {
+                            name: "".into(),
+                            tag,
+                        },
+                        Limits::saved(),
+                    )
+                    .map_err(|e| e.to_string())?,
+                )?
+            };
+            changes.push(store::Change::chunk(
+                region(&terrain.prefix, "entities", *x, *z),
+                [*x, *z],
+                bytes,
+            ));
+        }
+    }
+    let (_, tags) = save::cut_tags(|| {
+        work.level.write_without_player(staging)?;
+        for terrain in &work.terrain {
+            let save = save::SaveDir::new(staging.join(&terrain.prefix), terrain.shape);
+            save.save_forced_chunks(&terrain.forced)?;
+        }
+        Ok(())
+    })?;
+    for (path, mut tag) in tags {
+        let name = path
+            .strip_prefix(staging)?
+            .to_str()
+            .ok_or("non-UTF8 save path")?
+            .to_owned();
+        if name == "data/minecraft/world_clocks.dat"
+            && let Some(Tag::Compound(clock)) = tag
+                .get_mut("data")
+                .and_then(|d| d.get_mut("minecraft:overworld"))
+        {
+            clock.insert("partial_tick".into(), Tag::Float(work.clock.0.to_bits()));
+            clock.insert("rate".into(), Tag::Float(work.clock.1.to_bits()));
+            clock.insert("paused".into(), Tag::Byte(i8::from(work.clock.2)));
+        }
+        let bytes = gzip(tag)?;
+        // Keep metadata reads on the worker consistent with earlier queued cuts.
+        std::fs::create_dir_all(path.parent().ok_or("missing metadata parent")?)?;
+        std::fs::write(path, &bytes)?;
+        changes.push(store::Change::file(name, bytes));
+    }
+    for (name, tag) in std::mem::take(&mut work.tags) {
+        changes.push(store::Change::file(name, gzip(tag)?));
+    }
+    for (name, value) in std::mem::take(&mut work.json) {
+        changes.push(store::Change::file(name, serde_json::to_vec(&value)?));
+    }
+    Ok(changes)
+}
+fn worker(
+    root: PathBuf,
+    token: String,
+    receive: Receiver<Work>,
+    done: Sender<std::result::Result<(), String>>,
+) {
+    let staging = root.join("metadata-work");
+    let mut writer = None;
+    let mut pois = HashMap::new();
+    let mut failure = None;
+    while let Ok(first) = receive.recv() {
+        let mut batch = vec![first];
+        batch.extend(receive.try_iter().take(7));
+        let off = Instant::now();
+        let mut encode_ms = 0.;
+        let result = (|| -> Result<_> {
+            if let Some(error) = &failure {
+                return Err(format!("cut writer poisoned: {error}").into());
+            }
+            if writer.is_none() {
+                writer = Some(store::Writer::open(&root, &token)?);
+            }
+            let mut cuts = Vec::new();
+            for work in &mut batch {
+                cuts.push((work.tick, encode(work, &staging, &mut pois)?));
+            }
+            // A capture that arrives during encoding joins this same durable barrier.
+            while batch.len() < 8 {
+                let Ok(mut work) = receive.try_recv() else {
+                    break;
+                };
+                cuts.push((work.tick, encode(&mut work, &staging, &mut pois)?));
+                batch.push(work);
+            }
+            encode_ms = off.elapsed().as_secs_f64() * 1000.;
+            let writer = writer.as_mut().ok_or("cut writer missing")?;
+            writer.append(&root, &token, cuts)
+        })();
+        match result {
+            Ok(receipts) => {
+                let group = receipts.len();
+                let mut last = None;
+                for (work, (head, bytes, io_ms)) in batch.into_iter().zip(receipts) {
+                    let value = json!({"ok":true,"sequence":head.sequence,"tick":head.tick,"tick_ms":work.tick_ms,"capture_ms":work.capture_ms,
+                        "off_ms":off.elapsed().as_secs_f64()*1000.,"server_ms":work.start.elapsed().as_secs_f64()*1000.,
+                        "bytes_written":bytes,"install_io_ms":io_ms,"encode_ms":encode_ms,"group_size":group,"export":work.export});
+                    let _ = work.reply.send(value.to_string());
+                    let _ = done.send(Ok(()));
+                    last = Some(head);
+                }
+                if let (Some(writer), Some(head)) = (&mut writer, last)
+                    && let Err(e) = writer.compact(&root, &token, head)
+                {
+                    failure = Some(e.to_string());
+                }
+            }
+            Err(e) => {
+                let error = e.to_string();
+                failure = Some(error.clone());
+                for work in batch {
+                    let _ = work.reply.send(json!({"error":error}).to_string());
+                    let _ = done.send(Err(error.clone()));
+                }
+            }
+        }
+    }
+}
+
+impl Game<'_> {
+    /// The cold bootstrap remains E3's full barrier. It must finish before budgeted crossings.
+    fn tile_bootstrap(&mut self) -> Result<store::Files> {
+        let back = self.dim;
+        let dims = self.levels.parked_dims();
+        for dim in dims.iter().copied().chain(std::iter::once(back)) {
+            self.enter_level(None, dim)?;
+            let start = Instant::now();
+            while !self.streaming.poll_save(&mut self.world) {
+                if start.elapsed().as_secs() >= 30 {
+                    return Err("terrain save barrier timed out".into());
+                }
+                std::thread::yield_now();
+            }
+            self.world
+                .modified
+                .extend(self.world.chunks.keys().copied());
+        }
+        self.enter_level(None, back)?;
+        self.save_game_with(true)?;
+        self.finish_player_autosaves(true)?;
+        store::capture(&self.world_root)
+    }
+    fn tile_close_menus(&mut self) -> Result<()> {
+        let back = self.dim;
+        if let Some(mut host) = self.lan.take() {
+            let players: Vec<_> = host
+                .hub
+                .guests
+                .iter()
+                .filter(|g| g.placed)
+                .map(|g| (g.conn, crate::game::Dim::from_id(&g.dimension)))
+                .collect();
+            for (conn, dim) in players {
+                if let Err(e) = self.enter_level(Some(&mut host), dim) {
+                    self.lan = Some(host);
+                    return Err(e);
+                }
+                self.guest_close_all(&mut host, conn);
+                self.lan_crafting_closed(&mut host, conn, Some(0));
+            }
+            self.lan = Some(host);
+        }
+        self.enter_level(None, back)
+    }
+    pub(super) fn tile_cut_request(
+        &mut self,
+        args: &str,
+        reply: Sender<String>,
+        runtime: &mut Option<Runtime>,
+    ) {
+        let start = Instant::now();
+        let mut capture_started = false;
+        let result = (|| -> Result<_> {
+            let (root, token) = configured()?;
+            if !horizon_client::mod_api::mods().is_empty() {
+                return Err("E6 has no snapshot contract for native mod callbacks".into());
+            }
+            let mut parts = args.split_whitespace();
+            if parts.next() != Some(token.as_str()) {
+                return Err("request fence does not match this process".into());
+            }
+            let player = parts.next().map(str::to_owned);
+            if parts.next().is_some() {
+                return Err("tile-cut takes token and optional departing UUID".into());
+            }
+            if !root.is_absolute()
+                || root.starts_with(&self.world_root)
+                || self.world_root.starts_with(&root)
+            {
+                return Err("cut directory must be absolute and outside the working world".into());
+            }
+            if runtime.is_none() {
+                *runtime = Some(Runtime::new(root.clone(), token)?);
+            }
+            let state = runtime.as_mut().ok_or("cut runtime missing")?;
+            state.ready()?;
+            if state.initialized {
+                let back = self.dim;
+                for dim in self
+                    .levels
+                    .parked_dims()
+                    .into_iter()
+                    .chain(std::iter::once(back))
+                {
+                    self.enter_level(None, dim)?;
+                    let loading = self.streaming.terrain_loading();
+                    let pending = self.world.loaded_entities.len();
+                    if loading || pending != 0 {
+                        self.enter_level(None, back)?;
+                        return Err(format!("terrain work still in flight: loading={loading}, pending entity chunks={pending}; retry after a tick").into());
+                    }
+                }
+                self.enter_level(None, back)?;
+            }
+            capture_started = true;
+            store::phase(&root, "capture-begin")?;
+            let export = if let Some(player) = player {
+                let value = self.player_request("player-export", &format!("{player} freeze"));
+                if !value.get("ok").and_then(Value::as_bool).unwrap_or(false) {
+                    return Err(value.to_string().into());
+                }
+                Some(value)
+            } else {
+                None
+            };
+            self.tile_close_menus()?;
+            let players: HashSet<_> = self
+                .lan
+                .as_ref()
+                .map(|h| {
+                    h.hub
+                        .guests
+                        .iter()
+                        .filter(|g| g.placed && !g.released)
+                        .map(|g| g.uuid)
+                        .collect()
+                })
+                .unwrap_or_default();
+            if state
+                .players
+                .as_ref()
+                .is_some_and(|previous| previous != &players)
+            {
+                return Err("tile cut requires a fixed resident player set; restart after joins or departures".into());
+            }
+            state.players = Some(players);
+            let bootstrap = if state.initialized {
+                None
+            } else {
+                Some(self.tile_bootstrap()?)
+            };
+            let capture = Instant::now();
+            let back = self.dim;
+            let dims = self.levels.parked_dims();
+            let mut terrain = Vec::new();
+            let (_, tags) = save::cut_tags(|| {
+                for dim in dims.into_iter().chain(std::iter::once(back)) {
+                    self.enter_level(None, dim)?;
+                    self.world.block_entities.track_cuts();
+                    let prefix = save::dimension_dir(&self.world_root, dim.id())
+                        .strip_prefix(&self.world_root)?
+                        .to_str()
+                        .ok_or("non-UTF8 dimension")?
+                        .to_owned();
+                    let unloads = self.world.block_entities.cut_unloads();
+                    if state
+                        .unloads
+                        .get(&prefix)
+                        .is_some_and(|old| *old != unloads || unloads == u64::MAX)
+                    {
+                        return Err("tile cut observed an unload since its base; restart to include unloaded state".into());
+                    }
+                    state.unloads.insert(prefix.clone(), unloads);
+                    let mut keys: HashSet<_> = self.world.chunks.keys().copied().collect();
+                    self.tile_entity_keys(&mut keys);
+                    if keys.iter().any(|key| !self.world.chunks.contains_key(key)) {
+                        return Err("tile cut requires every live entity chunk to be resident; load the missing chunks before retrying".into());
+                    }
+                    // No unobserved unload can silently discard changed containers or entities.
+                    if state
+                        .seen
+                        .keys()
+                        .any(|(p, x, z)| p == &prefix && !keys.contains(&(*x, *z)))
+                    {
+                        return Err("tile cut requires the previous footprint resident; restart before changing the footprint".into());
+                    }
+                    let mut names: Vec<_> = self
+                        .world
+                        .block_names
+                        .iter()
+                        .map(|(p, n)| (*p, n.clone()))
+                        .collect();
+                    names.sort();
+                    let names_changed = state.names.get(&prefix) != Some(&names);
+                    state.names.insert(prefix.clone(), names);
+                    let mut dirty = Vec::new();
+                    let mut metadata = Vec::new();
+                    for (&(x, z), chunk) in self.world.chunks.iter() {
+                        let revision = self.world.block_entities.cut_revision((x, z));
+                        let inhabited = self.world.inhabited.get(&(x, z)).copied().unwrap_or(0);
+                        let old = state.seen.get(&(prefix.clone(), x, z));
+                        // Scheduler state always gets a small overlay, including empty lists.
+                        let pos = ChunkPos::new(x, z);
+                        let blocks = self
+                            .block_ticks
+                            .blocks
+                            .chunk(pos)
+                            .map(|t| t.pack(self.world.game_time))
+                            .unwrap_or_else(|| {
+                                chunk
+                                    .saved
+                                    .as_ref()
+                                    .map(|s| s.block_ticks.clone())
+                                    .unwrap_or_default()
+                            });
+                        let fluids = self
+                            .block_ticks
+                            .fluids
+                            .chunk(pos)
+                            .map(|t| t.pack(self.world.game_time))
+                            .unwrap_or_else(|| {
+                                chunk
+                                    .saved
+                                    .as_ref()
+                                    .map(|s| s.fluid_ticks.clone())
+                                    .unwrap_or_default()
+                            });
+                        metadata.push(ChunkMetadata {
+                            key: [x, z],
+                            time: self.world.game_time,
+                            inhabited,
+                            blocks,
+                            fluids,
+                        });
+                        let pistons = !self.block_ticks.moving_pistons.is_empty();
+                        if names_changed
+                            || revision == u64::MAX
+                            || old.is_none_or(|old| {
+                                old.chunk.as_ptr() != Arc::as_ptr(chunk)
+                                    || old.revision != revision
+                                    || old.pistons
+                            })
+                            || pistons
+                            || self
+                                .be_anims
+                                .gateway_servers
+                                .keys()
+                                .any(|p| p[0] >> 4 == x && p[2] >> 4 == z)
+                        {
+                            dirty.push(chunk.clone());
+                        }
+                        state.seen.insert(
+                            (prefix.clone(), x, z),
+                            Seen {
+                                chunk: Arc::downgrade(chunk),
+                                revision,
+                                pistons,
+                            },
+                        );
+                    }
+                    let chunks = self.with_entities(&dirty);
+                    let entities = self.entity_chunks(&keys, false);
+                    self.save_border();
+                    self.save_raids();
+                    self.save.save_attachments(&self.world.attachments)?;
+                    terrain.push(Terrain {
+                        prefix,
+                        chunks,
+                        metadata,
+                        entities,
+                        registry: self.pack.assets.registry,
+                        biomes: world_biomes!(self).clone(),
+                        tables: self.save.tables.get().cloned(),
+                        shape: self.save.shape,
+                        forced: self.streaming.forced.clone(),
+                    });
+                }
+                self.enter_level(None, back)?;
+                self.save_maps();
+                self.save_random_sequences();
+                self.save_fight();
+                self.save_wandering_trader();
+                self.save_portal_arrivals();
+                self.save_scoreboard();
+                self.save_bossbars();
+                self.save_schedule();
+                self.save_warden_tracker();
+                self.sync_level();
+                Ok(())
+            })?;
+            let mut tags: Vec<_> = tags
+                .into_iter()
+                .map(|(path, tag)| {
+                    Ok((
+                        path.strip_prefix(&self.world_root)?
+                            .to_str()
+                            .ok_or("non-UTF8 metadata")?
+                            .to_owned(),
+                        tag,
+                    ))
+                })
+                .collect::<Result<_>>()?;
+            let mut json = Vec::new();
+            if let Some(mut host) = self.lan.take() {
+                for guest in host
+                    .hub
+                    .guests
+                    .iter_mut()
+                    .filter(|g| g.placed && !g.released)
+                {
+                    self.guest_attachments_into(guest);
+                    let uuid = horizon_protocol::crypto::uuid_string(guest.uuid);
+                    tags.push((
+                        format!("players/data/{uuid}.dat"),
+                        horizon_client::lan::playerdata::player_tag(guest),
+                    ));
+                    json.push((
+                        format!("players/advancements/{uuid}.json"),
+                        guest
+                            .advancements
+                            .to_json(&self.adv.tree, horizon_world::DATA_VERSION),
+                    ));
+                    if let Some(play) = host.play.get(&guest.conn) {
+                        json.push((format!("players/stats/{uuid}.json"), play.stats.to_json()));
+                    }
+                }
+                self.lan = Some(host);
+            }
+            store::phase(&root, "captured")?;
+            let capture_ms = capture.elapsed().as_secs_f64() * 1000.;
+            Ok(Work {
+                tick: self.world.game_time,
+                terrain,
+                tags,
+                json,
+                level: self.level.clone(),
+                clock: (
+                    self.ui.clock.partial,
+                    self.ui.clock.rate,
+                    self.ui.clock.paused,
+                ),
+                bootstrap,
+                start,
+                tick_ms: start.elapsed().as_secs_f64() * 1000.,
+                capture_ms,
+                export,
+                reply: reply.clone(),
+            })
+        })();
+        match result {
+            Ok(work) => {
+                if let Some(state) = runtime {
+                    state.initialized = true;
+                    state.pending += 1;
+                    if state.send.send(work).is_err() {
+                        state.poisoned = true;
+                        let _ = reply.send(json!({"error":"cut writer stopped"}).to_string());
+                    }
+                }
+            }
+            Err(e) => {
+                if let Some(state) = runtime
+                    && capture_started
+                {
+                    state.poisoned = true;
+                }
+                let _ = reply.send(json!({"error":e.to_string()}).to_string());
+            }
+        }
+    }
+}
