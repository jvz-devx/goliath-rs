+    }
+    #[test]
+    fn chunk_metadata_overlay_survives_compaction_and_new_terrain_replaces_it() {
+        use horizon_world::nbt::{Limits, NamedTag, Tag};
+        let dir = scratch();
+        claim(&dir, "-", "a").unwrap();
+        let mut writer = Writer::open(&dir, "a").unwrap();
+        let path = "dimensions/minecraft/overworld/region/r.0.0.mca";
+        let compressed = |time, count| {
+            ChunkRecord::from_nbt(
+                &NamedTag {
+                    name: "".into(),
+                    tag: Tag::compound([
+                        ("LastUpdate", Tag::Long(time)),
+                        ("chest", Tag::Int(count)),
+                    ]),
+                },
+                Compression::Zlib,
+                0,
+                Limits::saved(),
+            )
+            .unwrap()
+            .compressed
+        };
+        writer
+            .append(
+                &dir,
+                "a",
+                vec![(
+                    1,
+                    vec![Change::chunk(path.into(), [0, 0], compressed(1, 7))],
+                )],
+            )
+            .unwrap();
+        let overlay = ChunkRecord::from_nbt(
+            &NamedTag {
+                name: "".into(),
+                tag: Tag::compound([("LastUpdate", Tag::Long(2))]),
+            },
+            Compression::Zlib,
+            0,
+            Limits::saved(),
+        )
+        .unwrap()
+        .compressed;
+        let receipt = writer
+            .append(
+                &dir,
+                "a",
+                vec![(2, vec![Change::overlay(path.into(), [0, 0], overlay)])],
+            )
+            .unwrap();
+        writer
+            .compact_at(&dir, "a", receipt[0].0.clone(), 0)
+            .unwrap();
+        let world = dir.join("world");
+        restore(&dir, "a", &world).unwrap();
+        let read = |world: &Path| {
+            RegionFile::open(world.join(path))
+                .unwrap()
+                .read(ChunkPos::new(0, 0))
+                .unwrap()
+                .unwrap()
+                .nbt(Limits::saved())
+                .unwrap()
+                .tag
+        };
+        let tag = read(&world);
+        assert_eq!(tag.get("LastUpdate"), Some(&Tag::Long(2)));
+        assert_eq!(tag.get("chest"), Some(&Tag::Int(7)));
+        writer
+            .append(
+                &dir,
+                "a",
+                vec![(
+                    3,
+                    vec![Change::chunk(path.into(), [0, 0], compressed(3, 31))],
+                )],
+            )
+            .unwrap();
+        restore(&dir, "a", &world).unwrap();
+        let tag = read(&world);
+        assert_eq!(tag.get("LastUpdate"), Some(&Tag::Long(3)));
+        assert_eq!(tag.get("chest"), Some(&Tag::Int(31)));
+        fs::remove_dir_all(dir).unwrap();
+    }
+}
