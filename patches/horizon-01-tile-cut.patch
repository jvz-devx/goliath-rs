+            3
+        );
+        fs::remove_dir_all(dir).unwrap();
+    }
+    #[test]
+    fn corrupt_base_or_interior_record_fails_before_touching_world() {
+        let dir = scratch();
+        claim(&dir, "-", "a").unwrap();
+        let mut writer = Writer::open(&dir, "a").unwrap();
+        writer
+            .append(&dir, "a", vec![(1, image(1)), (2, image(2))])
+            .unwrap();
+        let mut bytes = fs::read(dir.join("LOG")).unwrap();
