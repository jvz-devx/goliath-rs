+                chunk,
+                terrain.registry,
+                &terrain.biomes,
+                terrain.tables.as_deref(),
+                terrain.shape,
+            );
+            let bytes = nbt::write_named(&tag, Limits::saved()).map_err(|e| e.to_string())?;
+            changes.push(store::Change::chunk(
+                region(&terrain.prefix, "region", chunk.x, chunk.z),
+                [chunk.x, chunk.z],
+                Compression::Zlib.encode(&bytes)?,
