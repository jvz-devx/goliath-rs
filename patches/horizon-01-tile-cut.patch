+            if !name.ends_with(".mca") || name.contains("/poi/") {
+                let path = staging.join(&name);
+                std::fs::create_dir_all(path.parent().ok_or("missing parent")?)?;
+                std::fs::write(path, &bytes)?;
+            }
+            changes.push(store::Change::file(name, bytes));
+        }
+    }
