+//! Fenced cut records. Only a checksummed log prefix selects a recovered image.
+use horizon_client::Result;
+use horizon_core::position::ChunkPos;
+use horizon_world::{
+    compression::Compression,
+    region::{ChunkRecord, RegionFile},
+};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+use std::{
+    collections::BTreeMap,
+    fs::{self, File, OpenOptions},
+    io::Write,
+    path::{Component, Path},
+    time::Instant,
+};
+
+const MAGIC: &[u8; 8] = b"E6CUT001";
+const MAX_RECORD: usize = 512 * 1024 * 1024;
+pub(super) type Files = Vec<(String, Vec<u8>)>;
+
+pub(super) fn phase(root: &Path, name: &str) -> Result<()> {
+    if std::env::var_os("HORIZON_E3_TEST_PHASES").is_none() {
+        return Ok(());
+    }
+    fs::write(root.join("PHASE"), name)?;
+    let start = Instant::now();
+    while root.join(format!("gate-{name}")).exists() {
+        if start.elapsed().as_secs() > 30 {
+            return Err("E6 test gate timed out".into());
+        }
+        std::thread::sleep(std::time::Duration::from_millis(1));
+    }
+    Ok(())
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+pub(super) struct Head {
+    pub sequence: u64,
+    pub tick: i64,
+    fence: String,
+}
+#[derive(Serialize, Deserialize)]
+struct Entry {
+    path: String,
+    chunk: Option<[i32; 2]>,
+    len: usize,
+    #[serde(default)]
+    overlay: bool,
+}
+#[derive(Serialize, Deserialize)]
+struct Header {
+    head: Head,
+    entries: Vec<Entry>,
+}
+pub(super) struct Change {
+    path: String,
+    chunk: Option<[i32; 2]>,
+    bytes: Vec<u8>,
+    overlay: bool,
+}
+impl Change {
+    pub fn file(path: String, bytes: Vec<u8>) -> Self {
+        Self {
+            path,
+            chunk: None,
+            bytes,
+            overlay: false,
+        }
+    }
+    /// A zlib-compressed Anvil chunk. Empty bytes delete the chunk.
+    pub fn chunk(path: String, key: [i32; 2], bytes: Vec<u8>) -> Self {
+        Self {
+            path,
+            chunk: Some(key),
+            bytes,
+            overlay: false,
+        }
+    }
+    pub fn overlay(path: String, key: [i32; 2], bytes: Vec<u8>) -> Self {
+        Self {
+            path,
+            chunk: Some(key),
+            bytes,
+            overlay: true,
+        }
+    }
+}
+fn lock(root: &Path) -> Result<File> {
+    fs::create_dir_all(root)?;
+    let file = OpenOptions::new()
+        .create(true)
+        .truncate(false)
+        .read(true)
+        .write(true)
+        .open(root.join("LOCK"))?;
+    file.lock()?;
+    Ok(file)
+}
+fn sync(file: &File) -> Result<()> {
+    file.sync_all()?;
+    #[cfg(target_os = "macos")]
+    rustix::fs::fcntl_fullfsync(file)?;
+    Ok(())
+}
+fn fence(root: &Path, token: &str) -> Result<()> {
+    if fs::read_to_string(root.join("FENCE"))? != token {
+        return Err("stale tile fence".into());
+    }
+    Ok(())
+}
+pub(super) fn claim(root: &Path, expected: &str, token: &str) -> Result<()> {
+    let _lock = lock(root)?;
+    let current = match fs::read_to_string(root.join("FENCE")) {
+        Ok(s) => s,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => "-".into(),
+        Err(e) => return Err(e.into()),
+    };
+    if current != expected {
+        return Err("fence CAS conflict".into());
+    }
+    let mut file = File::create(root.join("FENCE.new"))?;
+    file.write_all(token.as_bytes())?;
+    file.sync_all()?;
+    fs::rename(root.join("FENCE.new"), root.join("FENCE"))?;
+    File::open(root)?.sync_all()?;
+    sync(&file)
+}
+fn relative(path: &str) -> Result<&Path> {
+    let path = Path::new(path);
+    if path.as_os_str().is_empty()
+        || path
+            .components()
+            .any(|c| !matches!(c, Component::Normal(_)))
+    {
+        return Err("invalid cut path".into());
+    }
+    Ok(path)
+}
+pub(super) fn capture(world: &Path) -> Result<Files> {
+    fn walk(base: &Path, path: &Path, out: &mut Files) -> Result<()> {
+        for entry in fs::read_dir(path)? {
+            let entry = entry?;
+            let kind = entry.file_type()?;
+            if kind.is_symlink() {
+                return Err("symlinks are not allowed in cut worlds".into());
+            }
+            if kind.is_dir() {
+                walk(base, &entry.path(), out)?;
+            } else if kind.is_file() {
+                let name = entry.file_name().to_string_lossy().into_owned();
+                if name != "session.lock"
+                    && !["_old", "_new", ".corrupt"]
+                        .iter()
+                        .any(|s| name.ends_with(s))
+                {
+                    out.push((
+                        entry
+                            .path()
+                            .strip_prefix(base)?
+                            .to_str()
+                            .ok_or("non-UTF8 save path")?
+                            .to_owned(),
+                        fs::read(entry.path())?,
+                    ));
+                }
+            }
+        }
+        Ok(())
+    }
+    let mut out = Vec::new();
+    walk(world, world, &mut out)?;
+    out.sort_by(|a, b| a.0.cmp(&b.0));
+    Ok(out)
+}
+fn encode(head: Head, changes: &[Change]) -> Result<Vec<u8>> {
+    let header = serde_json::to_vec(&Header {
+        head,
+        entries: changes
+            .iter()
+            .map(|c| Entry {
+                path: c.path.clone(),
+                chunk: c.chunk,
+                len: c.bytes.len(),
+                overlay: c.overlay,
+            })
+            .collect(),
+    })?;
+    let mut payload = Vec::new();
+    payload.extend_from_slice(&(header.len() as u64).to_le_bytes());
+    payload.extend_from_slice(&header);
+    for c in changes {
+        relative(&c.path)?;
+        payload.extend_from_slice(&c.bytes);
+    }
+    if payload.len() > MAX_RECORD {
+        return Err("cut record exceeds size limit".into());
+    }
+    let mut frame = Vec::with_capacity(payload.len() + 48);
+    frame.extend_from_slice(MAGIC);
+    frame.extend_from_slice(&(payload.len() as u64).to_le_bytes());
+    let mut hash = Sha256::new();
+    hash.update((payload.len() as u64).to_le_bytes());
+    hash.update(&payload);
+    frame.extend_from_slice(&hash.finalize());
+    frame.extend_from_slice(&payload);
+    Ok(frame)
+}
+fn decode(payload: &[u8]) -> Result<(Head, Vec<Change>)> {
+    let len = u64::from_le_bytes(payload.get(..8).ok_or("short cut header")?.try_into()?) as usize;
+    let end = 8usize.checked_add(len).ok_or("cut header overflow")?;
+    let header: Header = serde_json::from_slice(payload.get(8..end).ok_or("short cut header")?)?;
+    let mut at = end;
+    let mut changes = Vec::new();
+    for entry in header.entries {
+        relative(&entry.path)?;
+        if let Some([x, z]) = entry.chunk
+            && !entry
+                .path
+                .ends_with(&format!("/r.{}.{}.mca", x >> 5, z >> 5))
+        {
+            return Err("cut chunk path mismatch".into());
+        }
+        let end = at.checked_add(entry.len).ok_or("cut entry overflow")?;
+        changes.push(Change {
+            path: entry.path,
+            chunk: entry.chunk,
+            bytes: payload.get(at..end).ok_or("short cut entry")?.to_vec(),
+            overlay: entry.overlay,
+        });
+        at = end;
+    }
+    if at != payload.len() {
+        return Err("trailing cut payload".into());
+    }
+    Ok((header.head, changes))
+}
+type Image = BTreeMap<(String, Option<[i32; 2]>, bool), Vec<u8>>;
+fn baseline(root: &Path, image: &mut Image) -> Result<Option<Head>> {
+    let path = root.join("BASE");
+    let (head, len) = scan(&path, None, image)?;
+    if path.exists() && (head.is_none() || fs::metadata(path)?.len() != len) {
+        return Err("corrupt installed cut base".into());
+    }
+    Ok(head)
+}
+fn merge(image: &mut Image, changes: Vec<Change>) {
+    for c in changes {
+        if c.chunk.is_none() {
+            image.retain(|(name, _, _), _| name != &c.path);
+        }
+        if c.chunk.is_some() && !c.overlay {
+            image.remove(&(c.path.clone(), c.chunk, true));
+        }
+        image.insert((c.path, c.chunk, c.overlay), c.bytes);
+    }
+}
+/// Drop a torn final record, but never a bad record in the middle of the log.
+fn scan(path: &Path, mut head: Option<Head>, image: &mut Image) -> Result<(Option<Head>, u64)> {
+    let bytes = match fs::read(path) {
+        Ok(b) => b,
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => return Ok((head, 0)),
+        Err(e) => return Err(e.into()),
+    };
+    let mut at = 0;
+    while bytes.len() - at >= 48 {
+        if &bytes[at..at + 8] != MAGIC {
+            return Err("invalid cut frame magic".into());
+        }
+        let len = u64::from_le_bytes(bytes[at + 8..at + 16].try_into()?) as usize;
+        if len > MAX_RECORD {
+            return Err("invalid cut frame length".into());
+        }
+        let end = at.checked_add(48 + len).ok_or("cut frame overflow")?;
+        if end > bytes.len() {
+            break;
+        }
+        let mut hash = Sha256::new();
+        hash.update(&bytes[at + 8..at + 16]);
+        hash.update(&bytes[at + 48..end]);
+        if hash.finalize()[..] != bytes[at + 16..at + 48] {
+            if end == bytes.len() {
+                break;
+            }
+            return Err("cut checksum mismatch before tail".into());
+        }
+        let (next, changes) = decode(&bytes[at + 48..end])?;
+        if head.as_ref().is_none_or(|h| next.sequence > h.sequence) {
+            if head
+                .as_ref()
+                .is_some_and(|h| next.sequence != h.sequence + 1)
+            {
+                return Err("cut sequence gap".into());
+            }
+            merge(image, changes);
+            head = Some(next);
+        }
+        at = end;
+    }
+    Ok((head, at as u64))
+}
+pub(super) struct Writer {
+    file: File,
+    len: u64,
+    pub sequence: u64,
+    image: Image,
+}
+impl Writer {
+    fn current_log(&self, root: &Path) -> Result<bool> {
+        let opened = self.file.metadata()?;
+        let named = fs::metadata(root.join("LOG"))?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::MetadataExt;
+            if opened.dev() != named.dev() || opened.ino() != named.ino() {
+                return Ok(false);
+            }
+        }
+        Ok(opened.len() == self.len && named.len() == self.len)
+    }
+    pub fn open(root: &Path, token: &str) -> Result<Self> {
+        let _lock = lock(root)?;
+        fence(root, token)?;
+        let mut image = Image::new();
+        let base = baseline(root, &mut image)?;
+        let (head, len) = scan(&root.join("LOG"), base, &mut image)?;
+        let file = OpenOptions::new()
+            .create(true)
+            .truncate(false)
+            .read(true)
+            .append(true)
+            .open(root.join("LOG"))?;
+        if file.metadata()?.len() != len {
+            file.set_len(len)?;
+        }
+        File::open(root)?.sync_all()?;
+        sync(&file)?;
+        Ok(Self {
+            file,
+            len,
+            sequence: head.map_or(0, |h| h.sequence),
+            image,
+        })
+    }
+    pub fn append(
+        &mut self,
+        root: &Path,
+        token: &str,
+        cuts: Vec<(i64, Vec<Change>)>,
+    ) -> Result<Vec<(Head, u64, f64)>> {
+        let mut encoded = Vec::new();
+        for (i, (tick, changes)) in cuts.into_iter().enumerate() {
+            let sequence = self
+                .sequence
+                .checked_add(i as u64 + 1)
+                .ok_or("cut sequence exhausted")?;
+            let head = Head {
+                sequence,
+                tick,
+                fence: token.into(),
+            };
+            encoded.push((encode(head.clone(), &changes)?, head, changes));
+        }
+        phase(root, "pack-sync")?;
+        let _lock = lock(root)?;
+        fence(root, token)?;
+        if !self.current_log(root)? {
+            return Err("cut head CAS conflict".into());
+        }
+        let start = Instant::now();
+        phase(root, "pack-write")?;
+        for (bytes, _, _) in &encoded {
+            let mid = bytes.len() / 2;
+            self.file.write_all(&bytes[..mid])?;
+            phase(root, "mid-append")?;
+            self.file.write_all(&bytes[mid..])?;
+        }
+        phase(root, "head-write")?;
+        phase(root, "head-rename")?;
+        sync(&self.file)?;
+        phase(root, "head-renamed")?;
+        let elapsed = start.elapsed().as_secs_f64() * 1000.;
+        let mut out = Vec::new();
+        for (bytes, head, changes) in encoded {
+            self.len += bytes.len() as u64;
+            self.sequence = head.sequence;
+            merge(&mut self.image, changes);
+            out.push((head, bytes.len() as u64, elapsed));
+        }
+        phase(root, "installed")?;
+        Ok(out)
+    }
+    /// Called after replies. A crash before log truncation replays the new BASE and skips
+    /// its already compacted LOG prefix. The lock also prevents a new owner from interleaving.
+    pub fn compact(&mut self, root: &Path, token: &str, head: Head) -> Result<()> {
+        let limit = if std::env::var_os("HORIZON_E3_TEST_PHASES").is_some() {
+            std::env::var("HORIZON_E6_TEST_COMPACT_BYTES")
+                .ok()
+                .and_then(|s| s.parse().ok())
+                .unwrap_or(64 * 1024 * 1024)
+        } else {
+            64 * 1024 * 1024
+        };
+        self.compact_at(root, token, head, limit)
+    }
+    fn compact_at(&mut self, root: &Path, token: &str, head: Head, limit: u64) -> Result<()> {
+        if self.len < limit {
+            return Ok(());
+        }
+        let changes: Vec<_> = self
+            .image
+            .iter()
+            .map(|((path, chunk, overlay), bytes)| Change {
+                path: path.clone(),
+                chunk: *chunk,
+                bytes: bytes.clone(),
+                overlay: *overlay,
+            })
+            .collect();
+        let bytes = encode(head, &changes)?;
+        let _lock = lock(root)?;
+        fence(root, token)?;
+        if !self.current_log(root)? {
+            return Err("cut head CAS conflict".into());
+        }
+        let mut file = File::create(root.join("BASE.new"))?;
+        phase(root, "base-write")?;
+        file.write_all(&bytes)?;
+        phase(root, "base-sync")?;
+        file.sync_all()?;
+        phase(root, "base-rename")?;
+        fs::rename(root.join("BASE.new"), root.join("BASE"))?;
+        File::open(root)?.sync_all()?;
+        sync(&file)?;
+        phase(root, "log-rotate")?;
+        let next = OpenOptions::new()
+            .create(true)
+            .truncate(true)
+            .read(true)
+            .write(true)
+            .open(root.join("LOG.new"))?;
+        next.sync_all()?;
+        fs::rename(root.join("LOG.new"), root.join("LOG"))?;
+        File::open(root)?.sync_all()?;
+        sync(&next)?;
+        self.file = OpenOptions::new()
+            .read(true)
+            .append(true)
+            .open(root.join("LOG"))?;
+        self.len = 0;
+        Ok(())
+    }
+}
+pub(super) fn restore(root: &Path, token: &str, world: &Path) -> Result<Option<Head>> {
+    let _lock = lock(root)?;
+    if root.join("HEAD").exists() {
+        return Err("E3 archives require the E3 binary; E6 needs a fresh cut directory".into());
+    }
+    if !root.join("LOG").exists() && !root.join("BASE").exists() {
+        return Ok(None);
+    }
+    fence(root, token)?;
+    let mut image = Image::new();
+    let base = baseline(root, &mut image)?;
+    let (head, _) = scan(&root.join("LOG"), base, &mut image)?;
+    let Some(head) = head else {
+        return Ok(None);
+    };
+    for ((_, chunk, _), bytes) in &image {
+        if chunk.is_some() && !bytes.is_empty() {
+            ChunkRecord {
+                compression: Compression::Zlib,
+                compressed: bytes.clone(),
+                timestamp: 0,
+            }
+            .nbt(horizon_world::nbt::Limits::saved())?;
+        }
+    }
+    fs::create_dir_all(world)?;
+    for (name, _) in capture(world)? {
+        if !image.keys().any(|(p, _, _)| p == &name) {
+            fs::remove_file(world.join(name))?;
+        }
+    }
+    for ((name, chunk, overlay), mut bytes) in image {
+        let path = world.join(relative(&name)?);
+        fs::create_dir_all(path.parent().ok_or("cut file lacks parent")?)?;
+        if let Some([x, z]) = chunk {
+            let mut region = RegionFile::open_writable(path, true)?;
+            if overlay {
+                let pos = ChunkPos::new(x, z);
+                let mut previous = region
+                    .read(pos)?
+                    .ok_or("cut overlay lacks a base chunk")?
+                    .nbt(horizon_world::nbt::Limits::saved())?;
+                let overlay = ChunkRecord {
+                    compression: Compression::Zlib,
+                    compressed: bytes,
+                    timestamp: 0,
+                }
+                .nbt(horizon_world::nbt::Limits::saved())?;
+                let (
+                    horizon_world::nbt::Tag::Compound(previous),
+                    horizon_world::nbt::Tag::Compound(fields),
+                ) = (&mut previous.tag, overlay.tag)
+                else {
+                    return Err("invalid cut chunk overlay".into());
+                };
+                previous.extend(fields);
+                let tag = horizon_world::nbt::NamedTag {
+                    name: "".into(),
+                    tag: horizon_world::nbt::Tag::Compound(previous.clone()),
+                };
+                bytes = ChunkRecord::from_nbt(
+                    &tag,
+                    Compression::Zlib,
+                    0,
+                    horizon_world::nbt::Limits::saved(),
+                )?
+                .compressed;
+            }
+            if bytes.is_empty() {
+                region.clear(ChunkPos::new(x, z), 0)?;
+            } else {
+                region.write(
+                    ChunkPos::new(x, z),
+                    &ChunkRecord {
+                        compression: Compression::Zlib,
+                        compressed: bytes,
+                        timestamp: 0,
+                    },
+                )?;
+            }
+        } else {
+            fs::write(path, bytes)?;
+        }
+    }
+    Ok(Some(head))
+}
