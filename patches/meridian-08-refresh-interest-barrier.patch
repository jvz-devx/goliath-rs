+#[test]
+fn restored_interest_without_a_fresh_column_still_has_a_deadline() {
+    let mut client = Client::new();
+    let view = client.handle.shared_terrain(0).unwrap();
+    let _member = view.subscribe(&client.handle, [8., 70., 8.], 3).unwrap();
+    publish(&view, chunk(0, 0));
+    client.next();
+    invalidate(&view);
+    let began = Instant::now();
+    assert!(matches!(
+        view.refresh_action(began),
+        TerrainRefresh::Request(_)
+    ));
+    view.refresh_deferred();
+    assert!(matches!(
+        view.refresh_action(began + recovery::RESET_AFTER),
+        TerrainRefresh::Reset
+    ));
+    publish(
+        &view,
+        Packet::of(&play::Clientbound::ForgetLevelChunk(
+            play::ForgetLevelChunk { pos: [0, 0] },
+        )),
+    );
+    assert!(matches!(
+        view.refresh_action(began + recovery::RESET_AFTER + recovery::RETRY),
+        TerrainRefresh::Restore
+    ));
+    assert!(matches!(
+        view.refresh_action(began + recovery::RESET_AFTER + recovery::RESET_WAIT),
+        TerrainRefresh::Failed
+    ));
+    assert!(client.player.recv().unwrap_err().is_end_of_stream());
+    assert_eq!(view.telemetry()["recovery_restores"], 1);
     assert_eq!(view.telemetry()["recovery_failures"], 1);
 }
 
