new file mode 100644
--- /dev/null
+++ b/crates/meridian-handoff/src/shared_terrain/recovery.rs
@@ -0,0 +1,61 @@
+//! Monotonic retry pacing and one bounded snapshot-reset recovery per pending episode.
+use std::time::{Duration, Instant};
+
+pub(super) const RETRY: Duration = Duration::from_millis(100);
+pub(super) const RESET_AFTER: Duration = Duration::from_secs(1);
+pub(super) const RESET_WAIT: Duration = Duration::from_secs(5);
+pub(super) enum Step {
+    Wait,
+    Request,
+    Reset,
+    Failed,
+}
+#[derive(Default)]
+pub(super) struct Recovery {
+    began: Option<Instant>,
+    next: Option<Instant>,
+    reset: Option<Instant>,
+    failed: bool,
+    pub(super) requests: u64,
+    pub(super) deferrals: u64,
+    pub(super) resets: u64,
+    pub(super) failures: u64,
+}
+impl Recovery {
+    pub(super) fn abort(&mut self) {
+        if !self.failed {
+            self.failed = true;
+            self.failures += 1;
+        }
+    }
+    pub(super) fn poll(&mut self, now: Instant, pending: bool, requestable: bool) -> Step {
+        if self.failed {
+            return Step::Failed;
+        }
+        if !pending {
+            self.began = None;
+            self.next = None;
+            self.reset = None;
+            return Step::Wait;
+        }
+        let began = *self.began.get_or_insert(now);
+        if let Some(reset) = self.reset {
+            if now.saturating_duration_since(reset) >= RESET_WAIT {
+                self.abort();
+                return Step::Failed;
+            }
+            return Step::Wait;
+        }
+        if now.saturating_duration_since(began) >= RESET_AFTER {
+            self.reset = Some(now);
+            self.resets += 1;
+            return Step::Reset;
+        }
+        if requestable && self.next.is_none_or(|next| now >= next) {
+            self.next = Some(now + RETRY);
+            self.requests += 1;
+            return Step::Request;
+        }
+        Step::Wait
+    }
+}
