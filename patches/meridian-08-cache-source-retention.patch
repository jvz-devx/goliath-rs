+}
+
+fn invalidate(view: &SharedTerrain) {
+    lock(&view.0)
+        .cache
+        .apply(
+            (0, 0),
+            Arc::new(Packet {
+                id: c::BLOCK_ENTITY_DATA,
+                payload: vec![0; COLUMN_UPDATES],
+            }),
+        )
+        .unwrap();
+}
+
+#[test]
+fn permanently_unsent_refresh_recovers_by_reset_and_delivers_within_the_deadline() {
+    let mut first = Client::new();
+    let mut waiting = Client::new();
+    let view = first.handle.shared_terrain(0).unwrap();
+    let _first = view.subscribe(&first.handle, [8., 70., 8.], 3).unwrap();
+    publish(&view, chunk(0, 0));
+    first.next();
+    invalidate(&view);
+    let _waiting = view.subscribe(&waiting.handle, [8., 70., 8.], 3).unwrap();
+    waiting.empty();
+    let began = Instant::now();
+    let mut delivered_at = None;
+    for ms in (0..=1000).step_by(100) {
+        let now = began + Duration::from_millis(ms);
+        match view.refresh_action(now) {
+            TerrainRefresh::Request(columns) => {
+                assert_eq!(columns, vec![[0, 0]]);
+                // The control precondition never becomes true, including after retries.
+                let precondition = false;
+                assert!(!precondition);
+                view.refresh_deferred();
+                assert!(
+                    matches!(
+                        view.refresh_action(now + Duration::from_millis(1)),
+                        TerrainRefresh::Idle
+                    ),
+                    "retry pacing is per view, not per client"
+                );
+            }
+            TerrainRefresh::Reset => {
+                // A reset forces the source to stream its full column without that precondition.
+                publish(&view, chunk(0, 0));
+                assert_eq!(waiting.next(), chunk(0, 0));
+                first.empty();
+                delivered_at = Some(now.saturating_duration_since(began));
+            }
+            TerrainRefresh::Idle => {}
+            TerrainRefresh::Failed => panic!("the reset source did deliver"),
+        }
+    }
+    assert_eq!(delivered_at, Some(recovery::RESET_AFTER));
+    assert!(matches!(
+        view.refresh_action(began + Duration::from_secs(2)),
+        TerrainRefresh::Idle
+    ));
+    let stats = view.telemetry();
+    assert_eq!(stats["refresh_deferrals"], 10);
+    assert_eq!(stats["refresh_requests"], 10);
+    assert_eq!(stats["recovery_resets"], 1);
+    assert_eq!(stats["recovery_failures"], 0);
+}
+
+#[test]
+fn an_unresponsive_reset_fails_closed_instead_of_waiting_forever() {
+    let mut client = Client::new();
+    let view = client.handle.shared_terrain(0).unwrap();
+    let _member = view.subscribe(&client.handle, [8., 70., 8.], 3).unwrap();
+    publish(&view, chunk(0, 0));
+    client.next();
+    invalidate(&view);
+    let began = Instant::now();
+    assert!(matches!(
+        view.refresh_action(began),
+        TerrainRefresh::Request(_)
+    ));
+    view.refresh_deferred();
+    assert!(matches!(
+        view.refresh_action(began + recovery::RESET_AFTER),
+        TerrainRefresh::Reset
+    ));
+    assert!(matches!(
+        view.refresh_action(began + recovery::RESET_AFTER + recovery::RESET_WAIT),
+        TerrainRefresh::Failed
+    ));
+    assert!(client.player.recv().unwrap_err().is_end_of_stream());
+    assert!(matches!(
+        view.refresh_action(began + Duration::from_secs(20)),
+        TerrainRefresh::Failed
+    ));
+    assert_eq!(view.telemetry()["recovery_failures"], 1);
+}
+
+#[test]
+fn source_cache_high_water_marks_include_retained_unused_columns() {
+    let client = Client::new();
+    let view = client.handle.shared_terrain(0).unwrap();
+    let member = view.subscribe(&client.handle, [8., 70., 8.], 3).unwrap();
+    publish(&view, chunk(0, 0));
+    publish(&view, chunk(1, 0));
+    client.handle.0.up().client_pose = Some(crate::prepare::Pose {
+        at: [1608., 70., 8.],
+        ..Default::default()
+    });
+    member.recenter([1608., 70., 8.], 3, false).unwrap();
+    let held = view.telemetry();
+    assert_eq!(held["source_columns"], 2);
+    assert_eq!(held["peak_source_columns"], 2);
+    assert_eq!(held["peak_source_bytes"], 2 * charge(&chunk(0, 0)));
+    publish(
+        &view,
+        Packet::of(&play::Clientbound::ForgetLevelChunk(
+            play::ForgetLevelChunk { pos: [0, 0] },
+        )),
+    );
+    let after = view.telemetry();
+    assert_eq!(after["source_columns"], 1);
+    assert_eq!(after["peak_source_columns"], 2);
+    assert_eq!(after["peak_source_bytes"], held["peak_source_bytes"]);
+}
