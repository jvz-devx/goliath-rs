@@ -0,0 +1,44 @@
+//! Safe allocator pressure relief at the Darwin OS boundary, with no owned runtime.
+#![deny(unsafe_code)]
+
+/// Best-effort released bytes on macOS; zero without side effects elsewhere.
+pub fn pressure_relief(goal: usize) -> usize {
+    platform(goal)
+}
+
+#[cfg(target_os = "macos")]
+fn platform(goal: usize) -> usize {
+    // SAFETY: <malloc/malloc.h>, malloc_zone_pressure_relief, explicitly permits
+    // NULL to examine all zones and any size_t goal. Zero requests maximal relief;
+    // every other value is a best-effort target, not a pointer or a size to access.
+    // Header: https://github.com/apple-oss-distributions/libmalloc/blob/main/include/malloc/malloc.h
+    #[allow(unsafe_code)]
+    unsafe {
+        unsafe extern "C" {
+            fn malloc_zone_pressure_relief(zone: *mut std::ffi::c_void, goal: usize) -> usize;
+        }
+        malloc_zone_pressure_relief(std::ptr::null_mut(), goal)
+    }
+}
+
+#[cfg(not(target_os = "macos"))]
+fn platform(_goal: usize) -> usize {
+    0
+}
+
+#[cfg(test)]
+mod tests {
+    #[cfg(target_os = "macos")]
+    #[test]
+    fn native_call_returns() {
+        let _ = std::hint::black_box(super::pressure_relief(1));
+    }
+
+    #[cfg(not(target_os = "macos"))]
+    #[test]
+    fn other_targets_are_noop_for_every_goal() {
+        for goal in [0, 1, 16 * 1024 * 1024, usize::MAX] {
+            assert_eq!(super::pressure_relief(goal), 0);
+        }
+    }
+}
