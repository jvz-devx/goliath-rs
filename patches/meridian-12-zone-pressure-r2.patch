--- /dev/null
+++ b/crates/meridian-proxy/src/pressure.rs
@@ -0,0 +1,89 @@
+//! Low-frequency allocator relief driven only by the existing accept-waker thread.
+use std::time::{Duration, Instant};
+
+const PERIOD: Duration = Duration::from_secs(60);
+const GOAL: usize = 16 * 1024 * 1024;
+
+pub(crate) struct PressureRelief {
+    next: Instant,
+    calls: u64,
+    released: usize,
+    maximum: Duration,
+}
+
+impl PressureRelief {
+    pub(crate) fn new(now: Instant) -> Self {
+        Self {
+            next: now + PERIOD,
+            calls: 0,
+            released: 0,
+            maximum: Duration::ZERO,
+        }
+    }
+
+    fn due(&self, now: Instant) -> bool {
+        now >= self.next
+    }
+
+    fn completed(&mut self, finished: Instant, released: usize, elapsed: Duration) {
+        // Schedule after completion, never replay missed periods in a burst.
+        self.next = finished + PERIOD;
+        self.calls = self.calls.saturating_add(1);
+        self.released = self.released.saturating_add(released);
+        self.maximum = self.maximum.max(elapsed);
+    }
+
+    pub(crate) fn tick(&mut self) {
+        let started = Instant::now();
+        if !self.due(started) {
+            return;
+        }
+        let released = meridian_zone::pressure_relief(GOAL);
+        let finished = Instant::now();
+        let elapsed = finished.saturating_duration_since(started);
+        self.completed(finished, released, elapsed);
+        crate::log::info!(
+            "allocator-relief calls={} goal_bytes={} released_bytes={} total_released_bytes={} elapsed_us={} maximum_us={}",
+            self.calls,
+            GOAL,
+            released,
+            self.released,
+            elapsed.as_micros(),
+            self.maximum.as_micros()
+        );
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn first_call_waits_a_full_period() {
+        let start = Instant::now();
+        let relief = PressureRelief::new(start);
+        assert!(!relief.due(start));
+        assert!(!relief.due(start + PERIOD - Duration::from_nanos(1)));
+        assert!(relief.due(start + PERIOD));
+        assert_eq!(GOAL, 16 * 1024 * 1024);
+    }
+
+    #[test]
+    fn completion_sets_the_next_deadline_without_catch_up() {
+        let start = Instant::now();
+        let mut relief = PressureRelief::new(start);
+        let finished = start + Duration::from_secs(181);
+        relief.completed(finished, 4096, Duration::from_millis(2));
+        assert_eq!(relief.next, finished + PERIOD);
+        assert!(!relief.due(finished));
+        assert!(!relief.due(finished + PERIOD - Duration::from_nanos(1)));
+        assert!(relief.due(finished + PERIOD));
+        assert_eq!(relief.calls, 1);
+        assert_eq!(relief.released, 4096);
+        assert_eq!(relief.maximum, Duration::from_millis(2));
+        relief.completed(finished + PERIOD, 8192, Duration::from_millis(1));
+        assert_eq!(relief.calls, 2);
+        assert_eq!(relief.released, 12288);
+        assert_eq!(relief.maximum, Duration::from_millis(2));
+    }
+}
