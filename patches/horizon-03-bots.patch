+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn coordinates_reject_nonfinite_and_wrong_arity() {
+        assert!(numbers::<2>("nan,1").is_err());
+        assert!(numbers::<2>("1,2,3").is_err());
+        assert_eq!(numbers::<2>("-12.5,32").unwrap(), [-12.5, 32.]);
+    }
+
+    fn settings() -> Settings {
+        Settings {
+            servers: vec![],
+            bots: 400,
+            seconds: 1.,
+            join_every: 0.,
+            seed: 12345,
+            view: 3,
+            speed: 4.,
+            height: 0.,
+            ground: false,
+            stand: false,
+            spread: [-128., -128., 128., 128.],
+            path: vec![],
+            name: "Test".into(),
+            report: None,
+        }
+    }
+    fn feed(bot: &mut Bot, settings: &Settings, packet: Vec<u8>) {
+        let mut reader = Reader::new(&packet);
+        let id = reader.varint().unwrap();
+        bot.packet(settings, id, &packet[reader.position()..])
+            .unwrap();
+    }
+    #[test]
+    fn routes_are_seeded_spread_and_inside_the_requested_range() {
+        let s = settings();
+        let routes: Vec<_> = (0..s.bots).map(|i| s.route(i)).collect();
+        let centers: HashSet<_> = routes
+            .iter()
+            .map(|p| ((p[0][0] * 1000.) as i64, (p[0][1] * 1000.) as i64))
+            .collect();
+        assert_eq!(centers.len(), 400);
+        assert!(
+            routes
+                .iter()
+                .flatten()
+                .all(|p| p.iter().all(|v| (-128. ..128.).contains(v)))
+        );
+        assert_eq!(s.route(77), s.route(77));
+        let mut other = settings();
+        other.seed += 1;
+        assert_ne!(s.route(77), other.route(77));
+    }
+    #[test]
+    fn configuration_and_respawn_clear_chunks_but_keep_the_route_and_progress() {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let s = settings();
+        let poll = Poll::new().unwrap();
+        let mut b = Bot::new(&s, 0, &poll, listener.local_addr().unwrap(), false).unwrap();
+        let _peer = listener.accept().unwrap();
+        // A periodic movement round may run before the nonblocking connect event.
+        // It must leave the queued handshake intact until write readiness arrives.
+        b.flush().unwrap();
+        assert_eq!(b.sent, 0);
+        assert!(!b.output.is_empty());
+        b.phase = Phase::Play;
+        b.position = Some([0., 64., 0.]);
+        b.held.insert((0, 0));
+        b.waypoint = 2;
+        let route = b.route.clone();
+        b.output.clear();
+        feed(
+            &mut b,
+            &s,
+            super::super::raw(ids::play::clientbound::START_CONFIGURATION, |_| {}),
+        );
+        assert!(b.held.is_empty());
+        assert!(b.position.is_none());
+        assert_eq!(b.switches, 1);
+        assert_eq!(b.route, route);
+        assert_eq!(b.waypoint, 2);
+        let (prefix, n) = frame::header(&b.output).unwrap().unwrap();
+        let mut reply = Reader::new(&b.output[prefix..prefix + n]);
+        assert_eq!(
+            reply.varint().unwrap(),
+            ids::play::serverbound::CONFIGURATION_ACKNOWLEDGED
+        );
+        feed(
+            &mut b,
+            &s,
+            configuration::Clientbound::FinishConfiguration(Empty).encode(),
+        );
+        feed(
+            &mut b,
+            &s,
+            play::Clientbound::PlayerPosition(play::PlayerPosition {
+                teleport: 17,
+                position: [0., 64., 0.],
+                delta: [0.; 3],
+                yaw: 0.,
+                pitch: 0.,
+                relatives: 0,
+            })
+            .encode(),
+        );
+        b.held.insert((0, 0));
+        let before = b.position;
+        b.tick(&s).unwrap();
+        assert_ne!(b.position, before);
+        assert_eq!(b.route, route);
+        feed(
+            &mut b,
+            &s,
+            super::super::raw(ids::play::clientbound::RESPAWN, |_| {}),
+        );
+        assert!(b.held.is_empty());
+        assert!(b.position.is_some());
+        assert_eq!(b.waypoint, 2);
+        feed(
+            &mut b,
+            &s,
+            play::Clientbound::Transfer(configuration::Transfer {
+                host: "127.0.0.1".into(),
+                port: 25566,
+            })
+            .encode(),
+        );
+        assert_eq!(b.reconnect, Some(("127.0.0.1".into(), 25566)));
+    }
+}
