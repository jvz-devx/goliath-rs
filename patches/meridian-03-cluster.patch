new file mode 100644
--- /dev/null
+++ b/crates/meridian-handoff/src/cluster_sky.rs
@@ -0,0 +1,80 @@
+//! Replaces backend sky packets with the durable cluster clock and weather anchor.
+use horizon_protocol::{
+    buf::Reader,
+    ids::play::clientbound as c,
+    packets::play::{Clientbound as C, ClockState, SetTime},
+};
+use std::{
+    sync::OnceLock,
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+pub(crate) fn rewrite(id: i32, payload: Vec<u8>) -> Vec<u8> {
+    static CLOCK: OnceLock<Option<serde_json::Value>> = OnceLock::new();
+    let Some(clock) = CLOCK.get_or_init(|| {
+        std::env::var("GOLIATH_CLOCK")
+            .ok()
+            .and_then(|v| serde_json::from_str(&v).ok())
+    }) else {
+        return payload;
+    };
+    if id == c::SET_TIME {
+        let now = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map_or(0, |d| d.as_millis() as u64);
+        let elapsed = now.saturating_sub(clock["unix_ms"].as_u64().unwrap_or(now)) / 50;
+        let packet = C::SetTime(SetTime {
+            game_time: clock["game_tick"]
+                .as_u64()
+                .unwrap_or(0)
+                .saturating_add(elapsed) as i64,
+            clocks: vec![ClockState {
+                clock: 0,
+                total_ticks: clock["day_tick"]
+                    .as_u64()
+                    .unwrap_or(0)
+                    .saturating_add(elapsed) as i64,
+                partial_tick: 0.,
+                rate: 1.,
+            }],
+        })
+        .encode();
+        let mut reader = Reader::new(&packet);
+        if reader.varint().is_ok() {
+            return reader.rest().to_vec();
+        }
+    }
+    if id == c::GAME_EVENT
+        && let Ok(C::GameEvent(mut event)) = C::decode(id, &payload)
+    {
+        // Suppress per-tile weather. The startup config fixes cluster weather.
+        if [1, 2, 7, 8].contains(&event.event) {
+            event.param = match event.event {
+                7 => {
+                    if clock["raining"] == true {
+                        1.
+                    } else {
+                        0.
+                    }
+                }
+                8 => {
+                    if clock["thundering"] == true {
+                        1.
+                    } else {
+                        0.
+                    }
+                }
+                _ => event.param,
+            };
+            if [1, 2].contains(&event.event) {
+                event.event = if clock["raining"] == true { 1 } else { 2 };
+            }
+            let packet = C::GameEvent(event).encode();
+            let mut reader = Reader::new(&packet);
+            if reader.varint().is_ok() {
+                return reader.rest().to_vec();
+            }
+        }
+    }
+    payload
+}
