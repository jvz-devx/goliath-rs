diff --git a/crates/meridian-proxy/src/cluster.rs b/crates/meridian-proxy/src/cluster.rs
new file mode 100644
--- /dev/null
+++ b/crates/meridian-proxy/src/cluster.rs
@@ -0,0 +1,278 @@
+//! D6's real source cut, fenced store CAS and target activation adapter.
+use goliath_store::{
+    Blob, Client, Command, Epoch, Fence, Generation, Operation, OwnershipCas, PlayerKey, ProcessId,
+    RequestId, Response, TileId,
+};
+use meridian_handoff::{Arrival, Exported, Imported, Outcome, PlayerControl};
+use meridian_sidecar::endpoint::Endpoint;
+use serde_json::{Value, json};
+use std::{
+    path::Path,
+    time::{Duration, Instant},
+};
+
+fn manifest() -> Result<Option<Value>, String> {
+    let Some(path) = std::env::var_os("GOLIATH_CLUSTER") else {
+        return Ok(None);
+    };
+    serde_json::from_slice(&std::fs::read(path).map_err(|e| e.to_string())?)
+        .map(Some)
+        .map_err(|e| e.to_string())
+}
+
+fn client(manifest: &Value) -> Result<Client, String> {
+    let address = manifest["store"].as_str().ok_or("missing store address")?;
+    Client::new(
+        address.parse().map_err(|e| format!("{e}"))?,
+        Duration::from_secs(3),
+        3,
+    )
+    .map_err(|e| e.to_string())
+}
+
+fn fence(tile: &Value) -> Result<Fence, String> {
+    Ok(Fence {
+        tile: TileId(tile["tile"].as_u64().ok_or("missing tile id")? as usize),
+        process: ProcessId(tile["process"].as_u64().ok_or("missing process")?),
+        epoch: Epoch(tile["epoch"].as_u64().ok_or("missing epoch")?),
+    })
+}
+
+pub(crate) fn owner(uuid: [u8; 16]) -> Result<Option<String>, String> {
+    let Some(manifest) = manifest()? else {
+        return Ok(None);
+    };
+    match client(&manifest)?
+        .execute(Operation::ReadUuid(PlayerKey(u128::from_be_bytes(uuid))))
+        .map_err(|e| e.to_string())?
+    {
+        Response::Player(None) => Ok(None),
+        Response::Player(Some(record)) => manifest["tiles"]
+            .as_object()
+            .ok_or("missing tiles")?
+            .iter()
+            .find(|(_, tile)| tile["tile"].as_u64() == Some(record.owner.0 as u64))
+            .map(|(name, _)| Some(name.clone()))
+            .ok_or_else(|| "store owner is not configured".into()),
+        other => Err(format!("store routing failed: {other:?}")),
+    }
+}
+
+pub(crate) fn wrap(
+    backend: &str,
+    inner: Box<dyn PlayerControl>,
+    timeout: Duration,
+) -> Result<Box<dyn PlayerControl>, String> {
+    let Some(manifest) = manifest()? else {
+        return Ok(inner);
+    };
+    let tile = &manifest["tiles"][backend];
+    let path = tile["endpoint"].as_str().ok_or("missing endpoint")?;
+    let endpoint = Endpoint::read(Path::new(path)).map_err(|e| e.to_string())?;
+    Ok(Box::new(Control {
+        inner,
+        endpoint,
+        client: client(&manifest)?,
+        fence: fence(tile)?,
+        timeout,
+        authority_uncertain: false,
+    }))
+}
+
+struct Control {
+    inner: Box<dyn PlayerControl>,
+    endpoint: Endpoint,
+    client: Client,
+    fence: Fence,
+    timeout: Duration,
+    authority_uncertain: bool,
+}
+
+impl Control {
+    fn ask(&self, line: &str) -> Result<Value, String> {
+        let reply = self
+            .endpoint
+            .ask(line, self.timeout)
+            .map_err(|e| e.to_string())?;
+        if reply["ok"] != true {
+            return Err(reply.to_string());
+        }
+        Ok(reply)
+    }
+    fn player(uuid: &str) -> Result<PlayerKey, String> {
+        u128::from_str_radix(&uuid.replace('-', ""), 16)
+            .map(PlayerKey)
+            .map_err(|e| e.to_string())
+    }
+}
+
+impl PlayerControl for Control {
+    fn authority_uncertain(&self) -> bool {
+        self.authority_uncertain
+    }
+    fn expect(&mut self, uuid: &str, seconds: Option<u64>) -> Result<(), String> {
+        self.inner.expect(uuid, seconds)
+    }
+    fn expect_at(
+        &mut self,
+        uuid: &str,
+        seconds: Option<u64>,
+        position: Option<[f64; 3]>,
+    ) -> Result<(), String> {
+        if let Some(position) = position {
+            self.ask(&format!(
+                "player-expect-at {uuid} {} {}",
+                seconds.unwrap_or(10),
+                json!(position)
+            ))
+            .map(drop)
+        } else {
+            self.expect(uuid, seconds)
+        }
+    }
+    fn export(&mut self, uuid: &str, freeze: bool) -> Result<Exported, String> {
+        if !freeze {
+            return self.inner.export(uuid, false);
+        }
+        let started = Instant::now();
+        let reply = self.ask(&format!(
+            "tile-cut {}:{} {uuid}",
+            self.fence.process.0, self.fence.epoch.0
+        ))?;
+        let export = &reply["export"];
+        let mut record = export["record"].clone();
+        if !record.is_object() {
+            return Err("durable cut has no frozen record".into());
+        }
+        record["goliath_source"] =
+            json!([self.fence.tile.0, self.fence.process.0, self.fence.epoch.0]);
+        record["goliath_cut"] = json!({"sequence":reply["sequence"],"tick":reply["tick"]});
+        eprintln!(
+            "E10_PHASE {}",
+            json!({"phase":"cut","uuid":uuid,"ms":started.elapsed().as_secs_f64()*1000.,"tick_ms":reply["tick_ms"],"capture_ms":reply["capture_ms"],"encode_ms":reply["encode_ms"],"install_io_ms":reply["install_io_ms"],"sequence":reply["sequence"]})
+        );
+        Ok(Exported {
+            record,
+            freeze_ticks_left: export["freeze_ticks_left"].as_u64(),
+        })
+    }
+    fn import(
+        &mut self,
+        uuid: &str,
+        record: Value,
+        parts: Option<Vec<String>>,
+        announce: Option<bool>,
+        place: bool,
+        arrival: Option<Arrival>,
+    ) -> Result<Imported, String> {
+        if !place || parts.is_some() {
+            return Err("cluster activation requires a whole placed record".into());
+        }
+        let source = record["goliath_source"]
+            .as_array()
+            .ok_or("activation has no source fence")?;
+        if source.len() != 3 {
+            return Err("invalid source fence".into());
+        }
+        let source = Fence {
+            tile: TileId(source[0].as_u64().ok_or("source tile")? as usize),
+            process: ProcessId(source[1].as_u64().ok_or("source process")?),
+            epoch: Epoch(source[2].as_u64().ok_or("source epoch")?),
+        };
+        let generation = Generation(
+            record["goliath_generation"]
+                .as_u64()
+                .ok_or("record has no generation")?,
+        );
+        let handover = record["handover"]
+            .as_str()
+            .ok_or("record has no handover")?;
+        let id = RequestId(u128::from_str_radix(handover, 16).map_err(|e| e.to_string())?);
+        let mut body = json!({"record":record,"announce":announce.unwrap_or(false),"place":true});
+        if let Some(arrival) = arrival {
+            body["position"] = json!(arrival.position);
+            body["rotation"] = json!(arrival.rotation);
+            if let Some(velocity) = arrival.velocity {
+                body["velocity"] = json!(velocity);
+            }
+            if let Some(on_ground) = arrival.on_ground {
+                body["on_ground"] = json!(on_ground);
+            }
+        }
+        let command = Command {
+            id,
+            operation: Operation::CommitUuid {
+                player: Self::player(uuid)?,
+                cas: OwnershipCas {
+                    generation,
+                    source,
+                    target: self.fence,
+                },
+                blob: Blob {
+                    version: 1,
+                    bytes: serde_json::to_vec(&body).map_err(|e| e.to_string())?,
+                },
+            },
+        };
+        let started = Instant::now();
+        self.authority_uncertain = true;
+        match self
+            .client
+            .call(&command)
+            .map_err(|e| format!("store CAS result unknown, never resume source: {e}"))?
+        {
+            Response::Committed(next) if next.0 == generation.0 + 1 => {}
+            other => {
+                self.authority_uncertain = false;
+                return Err(format!("store CAS rejected: {other:?}"));
+            }
+        }
+        eprintln!(
+            "E10_PHASE {}",
+            json!({"phase":"cas","uuid":uuid,"generation":generation.0+1,"target":self.fence.tile.0,"ms":started.elapsed().as_secs_f64()*1000.})
+        );
+        let started = Instant::now();
+        let reply = self.ask(&format!("player-import {uuid} {body}"))?;
+        eprintln!(
+            "E10_PHASE {}",
+            json!({"phase":"activation","uuid":uuid,"ms":started.elapsed().as_secs_f64()*1000.,"timing":reply["timing"]})
+        );
+        Ok(Imported {
+            recentered: reply["recentered"].as_bool(),
+        })
+    }
+    fn confirm(&mut self, uuid: &str, handover: &str) -> Result<(), String> {
+        self.inner.confirm(uuid, handover)
+    }
+    fn release(
+        &mut self,
+        uuid: &str,
+        handover: &str,
+        outcome: Outcome,
+        announce: bool,
+    ) -> Result<(), String> {
+        // Resolve uncertain CAS outcomes before any abort. A store outage closes
+        // this path; Horizon's cluster freeze timeout disconnects instead of resuming.
+        let outcome = match self
+            .client
+            .execute(Operation::ReadUuid(Self::player(uuid)?))
+            .map_err(|e| e.to_string())?
+        {
+            Response::Player(Some(record)) if record.owner != self.fence.tile => Outcome::Moved,
+            Response::Player(Some(_)) if outcome == Outcome::Abort || self.authority_uncertain => {
+                Outcome::Abort
+            }
+            _ => return Err("cannot establish authority for source release".into()),
+        };
+        self.inner.release(uuid, handover, outcome, announce)
+    }
+    fn drop_player(&mut self, uuid: &str, handover: Option<&str>) -> Result<(), String> {
+        self.inner.drop_player(uuid, handover)
+    }
+    fn recover(&mut self) -> Result<bool, String> {
+        Ok(true)
+    }
+    fn lost(&self) -> bool {
+        true
+    }
+}
