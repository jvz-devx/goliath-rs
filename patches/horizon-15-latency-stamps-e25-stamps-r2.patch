+//! Opt-in, bounded movement decode evidence on the connection reader, never the tick.
+use serde_json::{Value, json};
+use std::{
+    collections::HashSet,
+    fs::{File, OpenOptions},
+    io::Write,
+    sync::{
+        Mutex, OnceLock,
+        atomic::{AtomicU64, Ordering},
+    },
+};
+
+const MAX_EVENTS: u64 = 100_000;
+static TRACE: OnceLock<Option<Trace>> = OnceLock::new();
+static ERRORS: AtomicU64 = AtomicU64::new(0);
+
+struct Trace {
+    names: HashSet<String>,
+    tile: String,
+    output: Mutex<File>,
+    events: AtomicU64,
+    dropped: AtomicU64,
+}
+
+fn failed() {
+    if ERRORS.fetch_add(1, Ordering::Relaxed) == 0 {
+        eprintln!("E25_TRACE_ERROR tile latency evidence is incomplete");
+    }
+}
+
+fn trace() -> Option<&'static Trace> {
+    TRACE.get_or_init(|| {
+        let directory = std::env::var_os("E25_LATENCY_DIR")?;
+        let names = std::env::var("E25_LATENCY_NAMES").ok()?;
+        let tile = std::env::var("E25_LATENCY_TILE").ok()?;
+        let path = std::path::Path::new(&directory).join(format!("e25-tile-{}.jsonl", std::process::id()));
+        let file = OpenOptions::new().write(true).create_new(true).open(path);
+        let mut output = match file {
+            Ok(output) => output,
+            Err(_) => { failed(); return None; }
+        };
+        if writeln!(output, "{}", json!({"event":"trace-start","schema":"E25-latency-v1","clock":"CLOCK_MONOTONIC_RAW","tile":tile})).is_err() {
+            failed(); return None;
+        }
+        Some(Trace { names:names.split(',').map(str::to_owned).collect(), tile,
+            output:Mutex::new(output), events:AtomicU64::new(0), dropped:AtomicU64::new(0) })
+    }).as_ref()
+}
+
+pub(super) fn selected(name: &str) -> bool {
+    trace().is_some_and(|trace| trace.names.contains(name))
+}
+
+#[cfg(target_os = "macos")]
+pub(super) fn now_ns() -> Option<u64> {
+    let value =
+        nix::time::clock_gettime(nix::time::ClockId::from_raw(nix::libc::CLOCK_MONOTONIC_RAW))
+            .ok()?;
+    u64::try_from(value.tv_sec())
+        .ok()?
+        .checked_mul(1_000_000_000)?
+        .checked_add(u64::try_from(value.tv_nsec()).ok()?)
+}
+
+#[cfg(not(target_os = "macos"))]
+pub(super) fn now_ns() -> Option<u64> {
+    None
+}
+
+pub(super) fn clock_failed() {
+    failed();
+}
+
+pub(super) fn decoded(uuid: u128, name: &str, id: i32, payload: &[u8], at_ns: u64) {
+    let Some(trace) = trace() else {
+        return;
+    };
+    if trace.events.fetch_add(1, Ordering::Relaxed) >= MAX_EVENTS {
+        trace.dropped.fetch_add(1, Ordering::Relaxed);
+        return;
+    }
+    let mut packet = format!("{id:02x}");
+    for byte in payload {
+        use std::fmt::Write;
+        let _ = write!(packet, "{byte:02x}");
+    }
+    let row = json!({"event":"tile-decode","uuid":format!("{uuid:032x}"),"name":name,
+        "tile":trace.tile,"packet":packet,"at_ns":at_ns});
+    match trace.output.lock() {
+        Ok(mut output) => {
+            if writeln!(output, "{row}").is_err() {
+                failed();
+            }
+        }
+        Err(_) => failed(),
+    }
+}
+
+pub fn status() -> Value {
+    let trace = trace();
+    json!({"schema":"E25-latency-v1","enabled":trace.is_some(),"errors":ERRORS.load(Ordering::Relaxed),
+        "events":trace.map_or(0,|trace|trace.events.load(Ordering::Relaxed)),
+        "dropped":trace.map_or(0,|trace|trace.dropped.load(Ordering::Relaxed))})
+}
