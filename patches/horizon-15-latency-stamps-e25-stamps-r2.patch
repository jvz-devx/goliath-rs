new file mode 100644
--- /dev/null
+++ b/crates/horizon-bots/src/latency_trace.rs
@@ -0,0 +1,188 @@
+//! Owns opt-in witness frame ranges and actual first-byte syscall timestamps.
+use serde_json::json;
+use std::{
+    collections::VecDeque,
+    fs::{File, OpenOptions},
+    io::Write,
+    sync::{Arc, Mutex, OnceLock},
+};
+
+type Result<T> = std::result::Result<T, String>;
+static OUTPUT: OnceLock<std::result::Result<Arc<Mutex<File>>, String>> = OnceLock::new();
+const MAX_PENDING: usize = 4096;
+
+struct Pending {
+    start: usize,
+    end: usize,
+    packet: String,
+    sequence: u64,
+    stamped: bool,
+    compression: Option<usize>,
+}
+
+pub(super) struct Trace {
+    name: String,
+    uuid: u128,
+    tile: String,
+    output: Arc<Mutex<File>>,
+    pending: VecDeque<Pending>,
+    sequence: u64,
+}
+
+impl Trace {
+    pub(super) fn bind(name: &str, uuid: u128) -> Result<Option<Self>> {
+        let Some(directory) = std::env::var_os("E25_LATENCY_DIR") else {
+            return Ok(None);
+        };
+        let names = std::env::var("E25_LATENCY_NAMES").map_err(|error| error.to_string())?;
+        if !names.split(',').any(|candidate| candidate == name) {
+            return Ok(None);
+        }
+        let tile = std::env::var("E25_LATENCY_TILE").map_err(|error| error.to_string())?;
+        let output = OUTPUT.get_or_init(|| {
+            let path = std::path::Path::new(&directory).join(format!("e25-bots-{}.jsonl",std::process::id()));
+            let mut file = OpenOptions::new().write(true).create_new(true).open(path).map_err(|error|error.to_string())?;
+            writeln!(file,"{}",json!({"event":"trace-start","schema":"E25-latency-v1","clock":"CLOCK_MONOTONIC_RAW","encryption":false})).map_err(|error|error.to_string())?;
+            Ok(Arc::new(Mutex::new(file)))
+        }).as_ref().map_err(Clone::clone)?;
+        Ok(Some(Self {
+            name: name.to_owned(),
+            uuid,
+            tile,
+            output: Arc::clone(output),
+            pending: VecDeque::new(),
+            sequence: 0,
+        }))
+    }
+
+    pub(super) fn queued(
+        &mut self,
+        packet: &[u8],
+        start: usize,
+        end: usize,
+        compression: Option<usize>,
+    ) -> Result<()> {
+        if packet.first().copied()
+            != Some(horizon_protocol::ids::play::serverbound::MOVE_PLAYER_POS as u8)
+        {
+            return Ok(());
+        }
+        if self.pending.len() >= MAX_PENDING {
+            return Err("E25 witness frame queue exceeded its cap".into());
+        }
+        self.sequence = self
+            .sequence
+            .checked_add(1)
+            .ok_or("E25 witness sequence overflow")?;
+        let mut encoded = String::with_capacity(packet.len() * 2);
+        for byte in packet {
+            use std::fmt::Write;
+            let _ = write!(encoded, "{byte:02x}");
+        }
+        self.pending.push_back(Pending {
+            start,
+            end,
+            packet: encoded,
+            sequence: self.sequence,
+            stamped: false,
+            compression,
+        });
+        Ok(())
+    }
+
+    pub(super) fn needs_clock(&self) -> bool {
+        self.pending.iter().any(|frame| !frame.stamped)
+    }
+
+    pub(super) fn accepted(
+        &mut self,
+        start: usize,
+        count: usize,
+        at_ns: Option<u64>,
+    ) -> Result<()> {
+        let end = start.checked_add(count).ok_or("E25 write range overflow")?;
+        for frame in &mut self.pending {
+            if !frame.stamped && start <= frame.start && frame.start < end {
+                let at_ns = at_ns.ok_or("E25 movement write lacks its syscall timestamp")?;
+                let row = json!({"event":"bot-write","name":self.name,"uuid":format!("{:032x}",self.uuid),
+                    "tile":self.tile,"packet":frame.packet,"send_index":frame.sequence,"at_ns":at_ns,
+                    "compression_threshold":frame.compression,"encryption":false});
+                let mut file = self
+                    .output
+                    .lock()
+                    .map_err(|_| "E25 trace writer poisoned")?;
+                writeln!(file, "{row}").map_err(|error| error.to_string())?;
+                frame.stamped = true;
+            }
+        }
+        while self.pending.front().is_some_and(|frame| frame.end <= end) {
+            self.pending.pop_front();
+        }
+        Ok(())
+    }
+
+    pub(super) fn pending(&self) -> usize {
+        self.pending.len()
+    }
+}
+
+#[cfg(target_os = "macos")]
+pub(super) fn now_ns() -> Result<u64> {
+    let value =
+        nix::time::clock_gettime(nix::time::ClockId::from_raw(nix::libc::CLOCK_MONOTONIC_RAW))
+            .map_err(|error| error.to_string())?;
+    u64::try_from(value.tv_sec())
+        .ok()
+        .and_then(|seconds| seconds.checked_mul(1_000_000_000))
+        .and_then(|base| {
+            u64::try_from(value.tv_nsec())
+                .ok()
+                .and_then(|nanos| base.checked_add(nanos))
+        })
+        .ok_or_else(|| "E25 raw clock cannot be represented".into())
+}
+
+#[cfg(not(target_os = "macos"))]
+pub(super) fn now_ns() -> Result<u64> {
+    Err("E25 latency trace requires macOS".into())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn the_first_accepted_byte_owns_the_stamp_across_partial_writes() {
+        let path =
+            std::env::temp_dir().join(format!("horizon-e25-partial-{}.jsonl", std::process::id()));
+        let file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)
+            .unwrap();
+        let mut trace = Trace {
+            name: "Witness".into(),
+            uuid: 7,
+            tile: "a".into(),
+            output: Arc::new(Mutex::new(file)),
+            pending: VecDeque::new(),
+            sequence: 0,
+        };
+        trace.queued(&[30, 1, 2], 10, 20, Some(256)).unwrap();
+        trace.accepted(0, 5, Some(100)).unwrap();
+        assert!(trace.needs_clock());
+        assert!(std::fs::read_to_string(&path).unwrap().is_empty());
+        trace.accepted(5, 6, Some(200)).unwrap();
+        assert!(!trace.needs_clock());
+        assert_eq!(trace.pending(), 1);
+        trace.accepted(11, 9, None).unwrap();
+        assert_eq!(trace.pending(), 0);
+        let rows = std::fs::read_to_string(&path).unwrap();
+        assert_eq!(rows.lines().count(), 1);
+        let row: serde_json::Value = serde_json::from_str(rows.trim()).unwrap();
+        assert_eq!(row["at_ns"], 200);
+        assert_eq!(row["packet"], "1e0102");
+        assert_eq!(row["compression_threshold"], 256);
+        drop(trace);
+        std::fs::remove_file(path).unwrap();
+    }
+}
