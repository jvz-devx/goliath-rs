+/// Native direct-fixture login, with the same authenticated v1 profile a proxy sends.
+fn forwarded_profile(secret: &[u8], name: &str) -> Vec<u8> {
+    let mut data = Writer::new();
+    data.varint(1);
+    data.string("127.0.0.1");
+    data.uuid(offline_uuid(name));
+    data.string(name);
+    data.varint(0);
+    let mut key = [0u8; 64];
+    if secret.len() > key.len() {
+        key[..32].copy_from_slice(&Sha256::digest(secret));
+    } else {
+        key[..secret.len()].copy_from_slice(secret);
+    }
+    let inner = Sha256::new()
+        .chain_update(key.map(|byte| byte ^ 0x36))
+        .chain_update(&data.data)
+        .finalize();
+    let mut signed = Sha256::new()
+        .chain_update(key.map(|byte| byte ^ 0x5c))
+        .chain_update(inner)
+        .finalize()
+        .to_vec();
+    signed.extend_from_slice(&data.data);
+    signed
+}
