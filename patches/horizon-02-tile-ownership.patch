+impl Game<'_> {
+    /// A final guard for noclip and teleport movement, which can bypass block collisions.
+    pub(super) fn hold_tile_entities(&mut self) {
+        let Some(area) = horizon_core::tile_ownership::area() else {
+            return;
+        };
+        for handle in self.entity_handles() {
+            super::entity::with_entity_mut!(self, handle, e => {
+                let p = e.position();
+                let bounds = e.bounds();
+                let min = bounds.min_position();
+                let max = bounds.max_position();
+                let held = area.hold_body([p.x,p.y,p.z], [(p.x-min.x).max(max.x-p.x), (p.z-min.z).max(max.z-p.z)]);
+                if held != [p.x,p.y,p.z] {
+                    *e.position_mut() = Vec3::new(held[0],held[1],held[2]);
+                    let v = e.velocity_mut();
+                    if held[0] != p.x { v.x = 0.0; }
+                    if held[2] != p.z { v.z = 0.0; }
+                }
+            });
+        }
+        if let Some(dragon) = &mut self.dragon {
+            let p = dragon.position;
+            let held = area.hold_body([p.x, p.y, p.z], [8.0; 2]);
+            dragon.position = Vec3::new(held[0], held[1], held[2]);
+        }
+    }
+}
