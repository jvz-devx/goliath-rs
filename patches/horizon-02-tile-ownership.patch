diff --git a/crates/horizon-core/src/tile_ownership.rs b/crates/horizon-core/src/tile_ownership.rs
new file mode 100644
index 000000000..6dd55e279
--- /dev/null
+++ b/crates/horizon-core/src/tile_ownership.rs
@@ -0,0 +1,138 @@
+//! Static tile ownership and rejected-write accounting for the E7 experiment.
+
+use std::sync::{
+    OnceLock,
+    atomic::{AtomicU64, Ordering},
+};
+
+#[derive(Clone, Copy, Debug)]
+pub struct OwnedArea {
+    pub min: [i32; 2],
+    pub max: [i32; 2],
+}
+
+impl OwnedArea {
+    /// origin x,z, edge in blocks, tile index x,z. Small tiles require an explicit test override.
+    pub fn parse(value: &str, small_test: bool) -> Result<Self, String> {
+        let v = value
+            .split(',')
+            .map(str::parse::<i64>)
+            .collect::<Result<Vec<_>, _>>()
+            .map_err(|_| "tile config needs five comma-separated integers")?;
+        if v.len() != 5 {
+            return Err("tile config needs origin x,z,edge,index x,z".into());
+        }
+        let alignment = if small_test { 16 } else { 512 };
+        if v[2] <= 0 || v[2] % alignment != 0 || v[0] % alignment != 0 || v[1] % alignment != 0 {
+            return Err(format!(
+                "tile edge and origin must align to {alignment} blocks"
+            ));
+        }
+        let mut min = [0; 2];
+        let mut max = [0; 2];
+        for axis in 0..2 {
+            let lo = v[axis]
+                .checked_add(v[2].checked_mul(v[axis + 3]).ok_or("tile overflow")?)
+                .ok_or("tile overflow")?;
+            let hi = lo.checked_add(v[2]).ok_or("tile overflow")?;
+            min[axis] = i32::try_from(lo).map_err(|_| "tile overflow")?;
+            max[axis] = i32::try_from(hi).map_err(|_| "tile overflow")?;
+        }
+        Ok(Self { min, max })
+    }
+    #[inline]
+    pub fn contains(self, x: i32, z: i32) -> bool {
+        x >= self.min[0] && x < self.max[0] && z >= self.min[1] && z < self.max[1]
+    }
+    #[inline]
+    pub fn chunk(self, x: i32, z: i32) -> bool {
+        x >= self.min[0].div_euclid(16)
+            && x < self.max[0].div_euclid(16)
+            && z >= self.min[1].div_euclid(16)
+            && z < self.max[1].div_euclid(16)
+    }
+    pub fn hold(self, mut p: [f64; 3]) -> [f64; 3] {
+        p = self.hold_body(p, [0.3; 2]);
+        p
+    }
+    pub fn hold_body(self, mut p: [f64; 3], radius: [f64; 2]) -> [f64; 3] {
+        for (axis, k) in [0, 2].into_iter().enumerate() {
+            let r = (radius[axis] + 0.001)
+                .min(f64::from(self.max[axis]) * 0.5 - f64::from(self.min[axis]) * 0.5);
+            p[k] = p[k].clamp(f64::from(self.min[axis]) + r, f64::from(self.max[axis]) - r);
+        }
+        p
+    }
+}
+
+static AREA: OnceLock<Option<OwnedArea>> = OnceLock::new();
+static REJECTED: AtomicU64 = AtomicU64::new(0);
+
+pub fn area() -> Option<&'static OwnedArea> {
+    AREA.get_or_init(|| {
+        std::env::var("HORIZON_TILE").ok().map(|value| {
+            OwnedArea::parse(
+                &value,
+                std::env::var("HORIZON_TILE_TEST_SMALL").as_deref() == Ok("1"),
+            )
+            .unwrap_or_else(|why| panic!("invalid HORIZON_TILE: {why}"))
+        })
+    })
+    .as_ref()
+}
+
+#[inline]
+pub fn owns_chunk(x: i32, z: i32) -> bool {
+    area().is_none_or(|a| a.chunk(x, z))
+}
+
+/// Refuse before mutation. Debug builds also fail loudly at the offending writer.
+pub fn allow_write(x: i32, z: i32) -> bool {
+    if owns_chunk(x, z) {
+        return true;
+    }
+    let n = REJECTED.fetch_add(1, Ordering::Relaxed) + 1;
+    if n.is_power_of_two() {
+        eprintln!("E7 tile refused write chunk={x},{z} rejected={n}");
+    }
+    debug_assert!(false, "write outside owned tile: {x},{z}");
+    false
+}
+
+pub fn rejected_writes() -> u64 {
+    REJECTED.load(Ordering::Relaxed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn negative_indices_and_corners_use_euclidean_geometry() {
+        let a = OwnedArea::parse("512,-512,512,-2,-1", false).unwrap();
+        assert_eq!(a.min, [-512, -1024]);
+        assert_eq!(a.max, [0, -512]);
+        for x in -514i32..=2 {
+            for z in -1026i32..=-510 {
+                let expected = (
+                    (i64::from(x) - 512).div_euclid(512),
+                    (i64::from(z) + 512).div_euclid(512),
+                ) == (-2, -1);
+                assert_eq!(a.contains(x, z), expected);
+                assert_eq!(a.chunk(x.div_euclid(16), z.div_euclid(16)), expected);
+            }
+        }
+    }
+    #[test]
+    fn region_alignment_and_overflow_are_required() {
+        for value in [
+            "0,0,16,0,0",
+            "16,0,512,0,0",
+            "0,0,0,0,0",
+            "0,0,512,9223372036854775807,0",
+            "1,2",
+        ] {
+            assert!(OwnedArea::parse(value, false).is_err(), "{value}");
+        }
+        assert!(OwnedArea::parse("-16,0,32,-1,0", true).is_ok());
+    }
+}
