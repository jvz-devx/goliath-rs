@@ -0,0 +1,49 @@
+//! Exercises E7's real Anvil writers, including rejected exterior region creation.
+use horizon_core::{position::ChunkPos, tile_ownership};
+use horizon_world::{
+    nbt::{Compound, Limits, NamedTag, Tag},
+    region::{ChunkRecord, RegionFile, RegionWriter},
+};
+use std::{io, path::PathBuf};
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let root = PathBuf::from(std::env::args().nth(1).ok_or("run directory required")?);
+    let area = tile_ownership::area().ok_or("HORIZON_TILE required")?;
+    let inside = ChunkPos::new(area.min[0].div_euclid(16), area.min[1].div_euclid(16));
+    let outside = ChunkPos::new(inside.x - 1, inside.z);
+    let record = ChunkRecord::from_nbt(
+        &NamedTag {
+            name: "".into(),
+            tag: Tag::Compound(Compound::new()),
+        },
+        horizon_world::compression::Compression::Zlib,
+        1,
+        Limits::saved(),
+    )?;
+    let path = root.join(format!("r.{}.{}.mca", inside.region().x, inside.region().z));
+    let mut file = RegionFile::open_writable(&path, true)?;
+    file.write(inside, &record)?;
+    file.sync()?;
+    let before = std::fs::read(&path)?;
+    assert_eq!(
+        file.write(outside, &record).unwrap_err().kind(),
+        io::ErrorKind::PermissionDenied
+    );
+    assert_eq!(
+        file.clear(outside, 2).unwrap_err().kind(),
+        io::ErrorKind::PermissionDenied
+    );
+    assert_eq!(std::fs::read(&path)?, before);
+    let foreign = root.join(format!(
+        "r.{}.{}.mca",
+        outside.region().x,
+        outside.region().z
+    ));
+    assert!(RegionFile::open_writable(&foreign, true).is_err());
+    assert!(!foreign.exists());
+    assert!(RegionWriter::create(&foreign).is_err());
+    assert!(!foreign.exists());
+    assert_eq!(tile_ownership::rejected_writes(), 4);
+    println!("E7 owned record written, four exterior mutations refused, bytes unchanged");
+    Ok(())
+}
