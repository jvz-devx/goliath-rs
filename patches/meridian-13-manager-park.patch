@@ -0,0 +1,115 @@
+//! A waiting terrain manager is woken by each change of its inputs, and by nothing else.
+use super::*;
+
+const SHORT: Duration = Duration::from_millis(50);
+
+fn walk(player: &mut Connection, source: &mut Connection, x: f64, z: f64) {
+    player
+        .send(
+            &play::Serverbound::MovePlayerPos(play::MovePlayerPos {
+                x,
+                y: 71.0,
+                z,
+                flags: 1,
+            })
+            .encode(),
+        )
+        .unwrap();
+    // The session notes the pose before it forwards the packet.
+    expect(source, ps::MOVE_PLAYER_POS).unwrap();
+}
+
+#[test]
+fn a_move_ends_the_wait_only_when_it_leaves_the_column() {
+    let Bench {
+        handle,
+        run,
+        mut player,
+        mut source,
+    } = bench();
+    walk(&mut player, &mut source, 3.0, 3.0);
+    let seen = handle.terrain_generation();
+    walk(&mut player, &mut source, 15.5, 0.5);
+    walk(&mut player, &mut source, 0.5, 15.5);
+    assert_eq!(handle.terrain_generation(), seen);
+    assert!(!handle.terrain_wait(seen, SHORT));
+    walk(&mut player, &mut source, 16.0, 3.0);
+    assert!(handle.terrain_wait(seen, WAIT));
+    let seen = handle.terrain_generation();
+    walk(&mut player, &mut source, 16.0, -0.5);
+    assert!(handle.terrain_wait(seen, WAIT));
+    drop(player);
+    run.join().unwrap().unwrap();
+}
+
+#[test]
+fn a_change_during_a_wait_ends_it_before_the_limit() {
+    let Bench {
+        handle,
+        run,
+        mut player,
+        mut source,
+    } = bench();
+    walk(&mut player, &mut source, 3.0, 3.0);
+    let seen = handle.terrain_generation();
+    let waiter = {
+        let handle = handle.clone();
+        std::thread::spawn(move || {
+            let began = Instant::now();
+            (handle.terrain_wait(seen, WAIT * 4), began.elapsed())
+        })
+    };
+    std::thread::sleep(SHORT);
+    walk(&mut player, &mut source, 40.0, 3.0);
+    let (changed, waited) = waiter.join().unwrap();
+    assert!(changed);
+    assert!(waited < WAIT * 2, "the wait ran to {waited:?}");
+    drop(player);
+    run.join().unwrap().unwrap();
+}
+
+#[test]
+fn a_server_placement_and_its_acknowledgement_each_end_the_wait() {
+    let Bench {
+        handle,
+        run,
+        mut player,
+        mut source,
+    } = bench();
+    handle.compose_terrain(TerrainOwners {
+        origin: [0, 0],
+        edge: 512,
+        entries: vec![[0, 0]],
+        backends: vec!["source".into()],
+    });
+    let seen = handle.terrain_generation();
+    send_typed(&mut source, &position(7, 200.0));
+    expect(&mut player, pc::PLAYER_POSITION).unwrap();
+    assert!(handle.terrain_wait(seen, WAIT));
+    assert_eq!(handle.terrain_position(), Some([200.0, 70.0, 200.0]));
+    let seen = handle.terrain_generation();
+    send(&mut player, ps::ACCEPT_TELEPORTATION, &[7]);
+    expect(&mut source, ps::ACCEPT_TELEPORTATION).unwrap();
+    assert!(handle.terrain_wait(seen, WAIT));
+    drop(player);
+    run.join().unwrap().unwrap();
+}
+
+#[test]
+fn a_new_backend_and_the_end_of_the_session_each_end_the_wait() {
+    let Bench {
+        handle,
+        run,
+        player,
+        source: _source,
+    } = bench();
+    let seen = handle.terrain_generation();
+    handle.0.set_backend("target");
+    assert!(handle.terrain_wait(seen, WAIT));
+    let seen = handle.terrain_generation();
+    assert!(!handle.terrain_wait(seen, SHORT));
+    drop(player);
+    run.join().unwrap().unwrap();
+    assert!(handle.is_over());
+    assert!(handle.terrain_wait(seen, WAIT));
+}
