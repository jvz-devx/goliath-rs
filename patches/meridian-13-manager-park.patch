+/// Wakes a waiting terrain manager when one of its inputs may have changed.
+///
+/// The manager reads the number before its inputs and waits on that value. A
+/// writer changes its input first and calls [`Wake::changed`] after, so a pass
+/// either read the change or its wait ends at once. This lock is taken last and
+/// never held while another is taken.
+#[derive(Default)]
+pub(crate) struct Wake {
+    generation: Mutex<u64>,
+    changed: Condvar,
+}
+impl Wake {
+    pub(crate) fn changed(&self) {
+        *lock(&self.generation) += 1;
+        self.changed.notify_all();
+    }
+}
+
+/// The column a position stands in. `None` when no column holds it.
+pub(crate) fn cell(at: [f64; 3]) -> Option<(i32, i32)> {
+    (at[0].is_finite() && at[2].is_finite())
+        .then(|| ((at[0].floor() as i32) >> 4, (at[2].floor() as i32) >> 4))
+}
+
+/// Whether a new position can change what the terrain manager decides: it left
+/// the old one's column, or it stands in none.
+pub(crate) fn left_cell(old: Option<[f64; 3]>, new: [f64; 3]) -> bool {
+    let new = cell(new);
+    new.is_none() || old.and_then(cell) != new
+}
