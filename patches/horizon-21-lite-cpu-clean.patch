diff --git a/crates/horizon-client/src/game/dedicated/e26_lite.rs b/crates/horizon-client/src/game/dedicated/e26_lite.rs
new file mode 100644
index 000000000..3e76b0e5c
--- /dev/null
+++ b/crates/horizon-client/src/game/dedicated/e26_lite.rs
@@ -0,0 +1,173 @@
+//! Two-kind main-thread running-CPU accounting, with no pacing-wait probes.
+use serde_json::{Value, json};
+use std::{cell::RefCell, collections::VecDeque, time::Duration};
+
+const LIMIT: usize = 8192;
+
+#[derive(Debug)]
+struct Row {
+    sequence: u64,
+    tick: i64,
+    cycle_ns: u64,
+    warm_ns: u64,
+    warm_calls: u64,
+}
+
+#[derive(Default)]
+struct Probe {
+    enabled: bool,
+    start: Option<Duration>,
+    warm: Duration,
+    calls: u64,
+    sequence: u64,
+    dropped: u64,
+    invalid: u64,
+    rows: VecDeque<Row>,
+}
+
+thread_local! { static PROBE: RefCell<Probe> = RefCell::new(Probe::default()); }
+
+fn cpu() -> Option<Duration> {
+    horizon_client::spans::thread_cpu()
+}
+
+pub(super) struct Warm(Option<Duration>);
+
+impl Drop for Warm {
+    fn drop(&mut self) {
+        let Some(start) = self.0 else { return };
+        let end = cpu();
+        PROBE.with_borrow_mut(|p| {
+            if !p.enabled {
+                return;
+            }
+            p.calls += 1;
+            match end.and_then(|end| end.checked_sub(start)) {
+                Some(elapsed) => p.warm += elapsed,
+                None => p.invalid += 1,
+            }
+        });
+    }
+}
+
+pub(super) fn warm() -> Warm {
+    let enabled = PROBE.with_borrow(|p| p.enabled);
+    Warm(if enabled { cpu() } else { None })
+}
+
+fn append(p: &mut Probe, tick: i64, end: Option<Duration>) {
+    let elapsed = p.start.zip(end).and_then(|(a, b)| b.checked_sub(a));
+    let warm = std::mem::take(&mut p.warm);
+    let calls = std::mem::take(&mut p.calls);
+    p.sequence += 1;
+    if let Some(elapsed) = elapsed.filter(|elapsed| *elapsed >= warm) {
+        if p.rows.len() == LIMIT {
+            p.rows.pop_front();
+            p.dropped += 1;
+        }
+        p.rows.push_back(Row {
+            sequence: p.sequence,
+            tick,
+            cycle_ns: elapsed.as_nanos() as u64,
+            warm_ns: warm.as_nanos() as u64,
+            warm_calls: calls,
+        });
+    } else {
+        p.invalid += 1;
+    }
+}
+
+pub(super) fn finish(tick: i64) {
+    if !PROBE.with_borrow(|p| p.enabled) {
+        return;
+    }
+    let end = cpu();
+    PROBE.with_borrow_mut(|p| append(p, tick, end));
+    // One ending read and one starting read per whole cycle. The interval
+    // crosses pacing sleep, but this clock charges only this thread's CPU.
+    let start = cpu();
+    PROBE.with_borrow_mut(|p| p.start = start);
+}
+
+pub(super) fn command(mode: &str) -> Value {
+    if !matches!(mode, "on" | "off" | "drain") {
+        return json!({"error":"e26-lite takes on, off or drain"});
+    }
+    if mode != "drain" {
+        let start = (mode == "on").then(cpu).flatten();
+        PROBE.with_borrow_mut(|p| {
+            *p = Probe {
+                enabled: mode == "on",
+                start,
+                ..Probe::default()
+            };
+        });
+    }
+    PROBE.with_borrow_mut(|p| {
+        let rows: Vec<_> = p
+            .rows
+            .drain(..)
+            .map(|r| {
+                json!({"sequence":r.sequence,"tick":r.tick,
+            "cycle_cpu_ns":r.cycle_ns,"warm_cpu_ns":r.warm_ns,
+            "other_cpu_ns":r.cycle_ns-r.warm_ns,"warm_calls":r.warm_calls,
+            "clock_reads":2*(1+r.warm_calls)})
+            })
+            .collect();
+        json!({"ok":true,"schema":"E26-running-main-cpu-v1","clock":"CLOCK_THREAD_CPUTIME_ID",
+            "scope":"main-thread running CPU per cycle; between-tick control and pump CPU included",
+            "timer_kinds":["warm","other"],"rows":rows,
+            "dropped":std::mem::take(&mut p.dropped),"invalid":std::mem::take(&mut p.invalid)})
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn warm_and_other_partition_the_same_cpu_cycle() {
+        let mut p = Probe {
+            enabled: true,
+            start: Some(Duration::from_nanos(100)),
+            warm: Duration::from_nanos(25),
+            calls: 3,
+            ..Probe::default()
+        };
+        append(&mut p, 42, Some(Duration::from_nanos(200)));
+        let row = p.rows.pop_front().unwrap();
+        assert_eq!(row.cycle_ns, 100);
+        assert_eq!(row.warm_ns, 25);
+        assert_eq!(row.warm_calls, 3);
+        assert_eq!(row.tick, 42);
+        assert_eq!(p.warm, Duration::ZERO);
+        assert_eq!(p.calls, 0);
+    }
+
+    #[test]
+    fn reversed_or_inconsistent_clocks_are_not_accepted() {
+        let mut p = Probe {
+            start: Some(Duration::from_nanos(200)),
+            ..Probe::default()
+        };
+        append(&mut p, 1, Some(Duration::from_nanos(100)));
+        p.warm = Duration::from_nanos(500);
+        append(&mut p, 2, Some(Duration::from_nanos(300)));
+        assert_eq!(p.invalid, 2);
+        assert!(p.rows.is_empty());
+    }
+
+    #[test]
+    fn overflow_reports_every_lost_cycle() {
+        let mut p = Probe {
+            start: Some(Duration::ZERO),
+            ..Probe::default()
+        };
+        for tick in 0..LIMIT + 2 {
+            append(&mut p, tick as i64, Some(Duration::from_nanos(1)));
+        }
+        assert_eq!(p.rows.len(), LIMIT);
+        assert_eq!(p.dropped, 2);
+        assert_eq!(p.rows.front().unwrap().sequence, 3);
+    }
+}
