@@ -0,0 +1,71 @@
+//! Measures the existing thread CPU clock's cost and represented resolution.
+use horizon_client_render::spans::thread_cpu;
+use serde_json::json;
+use std::{
+    hint::black_box,
+    time::{Duration, Instant},
+};
+
+fn read() -> Duration {
+    thread_cpu().expect("the native thread CPU clock is required")
+}
+
+fn gcd(mut a: u64, mut b: u64) -> u64 {
+    while b != 0 {
+        let next = a % b;
+        a = b;
+        b = next;
+    }
+    a
+}
+
+fn main() {
+    let resolution = rustix::time::clock_getres(rustix::time::ClockId::ThreadCPUTime);
+    let resolution_ns = resolution.tv_sec as u64 * 1_000_000_000 + resolution.tv_nsec as u64;
+    for _ in 0..10_000 {
+        black_box(read());
+    }
+    let mut batches = Vec::new();
+    let reads = 100_000u64;
+    for batch in 0..32 {
+        let wall = Instant::now();
+        let start = read();
+        for _ in 0..reads {
+            black_box(read());
+        }
+        let end = read();
+        let cpu_ns = (end - start).as_nanos() as u64;
+        batches.push(json!({"batch":batch,"reads":reads,"cpu_ns":cpu_ns,
+            "wall_ns":wall.elapsed().as_nanos(),
+            "cpu_ns_per_read_unsubtracted":cpu_ns as f64/reads as f64}));
+    }
+    let mut previous = read();
+    let mut min_step = u64::MAX;
+    let mut step_gcd = 0;
+    let mut zero = 0u64;
+    for _ in 0..100_000 {
+        let next = read();
+        let step = (next - previous).as_nanos() as u64;
+        if step == 0 {
+            zero += 1;
+        } else {
+            min_step = min_step.min(step);
+            step_gcd = gcd(step_gcd, step);
+        }
+        previous = next;
+    }
+    let maximum = batches
+        .iter()
+        .map(|b| b["cpu_ns_per_read_unsubtracted"].as_f64().unwrap())
+        .fold(0.0, f64::max);
+    println!(
+        "{}",
+        json!({"kind":"E26-thread-cpu-clock-calibration",
+        "clock":"CLOCK_THREAD_CPUTIME_ID","reported_resolution_ns":resolution_ns,
+        "observed_min_positive_step_ns":min_step,"observed_step_gcd_ns":step_gcd,
+        "zero_step_reads":zero,"resolution_samples":100_000,"batches":batches,
+        "maximum_batch_cpu_ns_per_read":maximum,
+        "conservative_read_allowance_ns":maximum.ceil() as u64+resolution_ns,
+        "method":"Unsubtracted maximum batch mean includes loop and black-box cost. Add one reported quantum. This is a measured conservative allowance, not a global worst-case latency claim."})
+    );
+}
