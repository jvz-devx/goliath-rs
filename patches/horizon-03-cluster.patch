diff --git a/crates/horizon-client/src/game/dedicated/cluster.rs b/crates/horizon-client/src/game/dedicated/cluster.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/dedicated/cluster.rs
@@ -0,0 +1,240 @@
+//! Store authority checks and generation-aware player recovery for a cluster tile.
+use goliath_store::{
+    Blob, Client, Epoch, Fence, Generation, Operation, PlayerKey, ProcessId, Response, TileId,
+};
+use horizon_client::{Result, save};
+use horizon_world::nbt::{self, Limits, Tag};
+use serde_json::{Value, json};
+use std::{path::Path, time::Duration};
+
+pub(super) const GENERATION: &str = "goliath:generation";
+
+pub(super) fn connection() -> Result<Option<(Client, Fence)>> {
+    let Ok(address) = std::env::var("GOLIATH_STORE") else {
+        return Ok(None);
+    };
+    let tile = std::env::var("GOLIATH_TILE_ID")?.parse()?;
+    let token = std::env::var("HORIZON_E3_FENCE")?;
+    let (process, epoch) = token.split_once(':').ok_or("invalid store fence")?;
+    Ok(Some((
+        Client::new(address.parse()?, Duration::from_secs(3), 3)?,
+        Fence {
+            tile: TileId(tile),
+            process: ProcessId(process.parse()?),
+            epoch: Epoch(epoch.parse()?),
+        },
+    )))
+}
+
+pub(super) fn local_generation(tag: Option<&Tag>) -> Option<u64> {
+    match tag.and_then(|t| t.get(GENERATION)) {
+        Some(Tag::Long(value)) => u64::try_from(*value).ok(),
+        _ => None,
+    }
+}
+
+pub(super) fn mark(tag: &mut Option<Tag>, generation: u64) -> Result<()> {
+    let generation = i64::try_from(generation)?;
+    let tag = tag.get_or_insert_with(|| Tag::compound([] as [(&str, Tag); 0]));
+    if let Tag::Compound(fields) = tag {
+        fields.insert(GENERATION.into(), Tag::Long(generation));
+    } else {
+        return Err("player extra is not a compound".into());
+    }
+    Ok(())
+}
+
+fn current(client: &Client, fence: Fence) -> Result<()> {
+    match client.execute(Operation::Directory)? {
+        Response::Directory(entries) if entries.iter().any(|e| e.active && e.fence == fence) => {
+            Ok(())
+        }
+        _ => Err("stale cluster tile fence".into()),
+    }
+}
+
+/// Validate the exact committed activation body, not just a caller-supplied generation.
+pub(super) fn activation(uuid: u128, body: &Value) -> Result<Option<u64>> {
+    let Some((client, fence)) = connection()? else {
+        return Ok(None);
+    };
+    current(&client, fence)?;
+    let Response::Player(Some(record)) = client.execute(Operation::ReadUuid(PlayerKey(uuid)))?
+    else {
+        return Err("activation has no store record".into());
+    };
+    let committed: Value = serde_json::from_slice(&record.inventory.bytes)?;
+    // Inputs may be attached later, but the player body and placement are exactly committed.
+    for key in ["record", "position", "rotation", "velocity", "on_ground"] {
+        if committed.get(key) != body.get(key) {
+            return Err(format!("activation differs from store: {key}").into());
+        }
+    }
+    if record.owner != fence.tile {
+        return Err("activation belongs to another tile".into());
+    }
+    Ok(Some(record.generation.0))
+}
+
+pub(super) fn reconcile(world: &Path) -> Result<()> {
+    let Some((client, fence)) = connection()? else {
+        return Ok(());
+    };
+    current(&client, fence)?;
+    let mut after = None;
+    loop {
+        let Response::Players(keys) = client.execute(Operation::Players { after })? else {
+            return Err("bad player listing".into());
+        };
+        if keys.is_empty() {
+            break;
+        }
+        after = keys.last().copied();
+        for key in keys {
+            let Response::Player(Some(entry)) = client.execute(Operation::ReadUuid(key))? else {
+                return Err("player missing during recovery".into());
+            };
+            let path = horizon_client::lan::playerdata::path(world, key.0);
+            let local = save::read_dat(&path);
+            let generation = local_generation(local.as_ref());
+            if generation.is_some_and(|g| g > entry.generation.0) {
+                return Err("cut generation is newer than store".into());
+            }
+            if entry.owner != fence.tile {
+                let uuid = horizon_protocol::crypto::uuid_string(key.0);
+                for path in [
+                    path.clone(),
+                    path.with_extension("dat_old"),
+                    world.join(format!("players/stats/{uuid}.json")),
+                    world.join(format!("players/advancements/{uuid}.json")),
+                ] {
+                    match std::fs::remove_file(path) {
+                        Ok(()) => {}
+                        Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+                        Err(e) => return Err(e.into()),
+                    }
+                }
+                continue;
+            }
+            if generation == Some(entry.generation.0) {
+                continue;
+            }
+            let body: Value = serde_json::from_slice(&entry.inventory.bytes)?;
+            let record = &body["record"];
+            if record["uuid"]
+                .as_str()
+                .and_then(horizon_client::lan::arrivals::parse_uuid)
+                != Some(key.0)
+            {
+                return Err("stored record UUID differs from its key".into());
+            }
+            let bytes = record["player"]
+                .as_str()
+                .and_then(horizon_client::skins::base64_decode)
+                .ok_or("bad stored player NBT")?;
+            let (named, _) = nbt::read_named(&bytes, Limits::saved()).map_err(|e| e.to_string())?;
+            let mut tag = Some(named.tag);
+            mark(&mut tag, entry.generation.0)?;
+            let mut tag = tag.ok_or("missing player tag")?;
+            if let (Some(position), Tag::Compound(fields)) =
+                (body.get("position").and_then(Value::as_array), &mut tag)
+            {
+                fields.insert(
+                    "Pos".into(),
+                    Tag::List(
+                        position
+                            .iter()
+                            .map(|v| {
+                                v.as_f64()
+                                    .map(|v| Tag::Double(v.to_bits()))
+                                    .ok_or("bad stored position")
+                            })
+                            .collect::<std::result::Result<_, _>>()?,
+                    ),
+                );
+            }
+            if let Tag::Compound(fields) = &mut tag {
+                for (key, name) in [("rotation", "Rotation"), ("velocity", "Motion")] {
+                    if let Some(values) = body.get(key).and_then(Value::as_array) {
+                        let values = values
+                            .iter()
+                            .map(|v| {
+                                v.as_f64()
+                                    .map(|v| {
+                                        if key == "rotation" {
+                                            Tag::Float((v as f32).to_bits())
+                                        } else {
+                                            Tag::Double(v.to_bits())
+                                        }
+                                    })
+                                    .ok_or("bad stored movement")
+                            })
+                            .collect::<std::result::Result<Vec<_>, _>>()?;
+                        fields.insert(name.into(), Tag::List(values));
+                    }
+                }
+            }
+            save::write_dat_durable(&path, tag)?;
+            let uuid = horizon_protocol::crypto::uuid_string(key.0);
+            for kind in ["stats", "advancements"] {
+                let path = world.join(format!("players/{kind}/{uuid}.json"));
+                save::write_durable(&path, &serde_json::to_vec(&record[kind])?)?;
+            }
+            eprintln!(
+                "E10_RECOVER {}",
+                json!({"uuid":uuid,"generation":entry.generation.0,"tile":fence.tile.0})
+            );
+        }
+    }
+    current(&client, fence)
+}
+
+impl crate::game::Game<'_> {
+    /// New logins have no entry generation. Register before they perform a gameplay tick.
+    pub(super) fn cluster_register_players(&mut self) -> Result<()> {
+        let Some((client, fence)) = connection()? else {
+            return Ok(());
+        };
+        let uuids: Vec<_> = self
+            .lan
+            .as_ref()
+            .map(|h| {
+                h.hub
+                    .guests
+                    .iter()
+                    .filter(|g| {
+                        g.placed && !g.released && local_generation(g.saved.as_ref()).is_none()
+                    })
+                    .map(|g| g.uuid)
+                    .collect()
+            })
+            .unwrap_or_default();
+        for uuid in uuids {
+            let id = horizon_protocol::crypto::uuid_string(uuid);
+            let reply = self.player_request("player-export", &id);
+            if reply["ok"] != true {
+                return Err("new player export failed".into());
+            }
+            let blob = Blob {
+                version: 1,
+                bytes: serde_json::to_vec(&json!({"record":reply["record"]}))?,
+            };
+            match client.execute(Operation::CreateUuid {
+                player: PlayerKey(uuid),
+                owner: fence,
+                blob,
+            })? {
+                Response::Committed(Generation(0)) => {}
+                other => return Err(format!("new player registration failed: {other:?}").into()),
+            }
+            if let Some(g) = self
+                .lan
+                .as_mut()
+                .and_then(|h| h.hub.guests.iter_mut().find(|g| g.uuid == uuid))
+            {
+                mark(&mut g.saved, 0)?;
+            }
+        }
+        Ok(())
+    }
+}
