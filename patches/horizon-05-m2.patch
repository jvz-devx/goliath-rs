+/// Translate the whole immutable vehicle tree by the same crossing displacement.
+pub fn translate_root_vehicle(tag: &mut Tag, destination: [f64; 3]) -> Result<(), String> {
+    if tag.get("RootVehicle").is_none() {
+        return Ok(());
+    }
+    let mut level = Level::default();
+    level.read_player(tag);
+    let previous = level.position.ok_or("vehicle rider has no position")?;
+    let delta = std::array::from_fn(|axis| destination[axis] - previous[axis]);
+    let entity = tag
+        .get_mut("RootVehicle")
+        .and_then(|root| root.get_mut("Entity"))
+        .ok_or("vehicle record has no root entity")?;
+    translate_vehicle(entity, delta)
+}
+fn translate_vehicle(tag: &mut Tag, delta: [f64; 3]) -> Result<(), String> {
+    let Some(Tag::List(position)) = tag.get_mut("Pos") else {
+        return Err("vehicle has no position".into());
+    };
+    if position.len() != 3 {
+        return Err("vehicle position is not three numbers".into());
+    }
+    for (value, delta) in position.iter_mut().zip(delta) {
+        let Tag::Double(bits) = value else {
+            return Err("vehicle position is not double".into());
+        };
+        let next = f64::from_bits(*bits) + delta;
+        if !next.is_finite() || next.abs() > 30_000_000. {
+            return Err("vehicle translated outside world".into());
+        }
+        *bits = next.to_bits();
+    }
+    if let Some(Tag::List(passengers)) = tag.get_mut("Passengers") {
+        for passenger in passengers {
+            translate_vehicle(passenger, delta)?;
+        }
+    }
+    Ok(())
+}
 
