+}
+impl Encoded {
+    fn proto(&mut self, terrain: &Terrain, proto: &Arc<save::SavedProto>) -> Result<Vec<u8>> {
+        let key = (terrain.prefix.clone(), proto.column.x, proto.column.z);
+        if let Some((old, bytes)) = self.protos.get(&key)
+            && old.as_ptr() == Arc::as_ptr(proto)
+        {
+            return Ok(bytes.clone());
+        }
+        let tag = save::encode_proto(
+            proto,
+            terrain.registry,
+            &terrain.biomes,
+            terrain.tables.as_deref(),
+            terrain.shape,
+        );
+        let bytes = Compression::Zlib
+            .encode(&nbt::write_named(&tag, Limits::saved()).map_err(|e| e.to_string())?)?;
+        self.protos
+            .insert(key, (Arc::downgrade(proto), bytes.clone()));
+        Ok(bytes)
+    }
+    fn chunk(&mut self, terrain: &Terrain, chunk: &Arc<Chunk>) -> Result<Vec<u8>> {
+        let key = (terrain.prefix.clone(), chunk.x, chunk.z);
+        if let Some((old, bytes)) = self.chunks.get(&key)
+            && old.as_ptr() == Arc::as_ptr(chunk)
+        {
+            return Ok(bytes.clone());
+        }
+        let tag = save::encode_with(
+            chunk,
+            terrain.registry,
+            &terrain.biomes,
+            terrain.tables.as_deref(),
+            terrain.shape,
+        );
+        let bytes = Compression::Zlib
+            .encode(&nbt::write_named(&tag, Limits::saved()).map_err(|e| e.to_string())?)?;
+        self.chunks
+            .insert(key, (Arc::downgrade(chunk), bytes.clone()));
+        Ok(bytes)
+    }
+    fn prune(&mut self) {
+        self.protos
+            .retain(|_, (image, _)| image.strong_count() != 0);
+        self.chunks
+            .retain(|_, (image, _)| image.strong_count() != 0);
+    }
