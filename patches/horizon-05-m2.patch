diff --git a/crates/horizon-client/src/game/dedicated/transfer/live.rs b/crates/horizon-client/src/game/dedicated/transfer/live.rs
new file mode 100644
--- /dev/null
+++ b/crates/horizon-client/src/game/dedicated/transfer/live.rs
@@ -0,0 +1,161 @@
+//! Ephemeral player controls, live modifiers and cooldowns in one fenced handover record.
+use crate::game::{Game, lan::LanHost};
+use horizon_client::{
+    Result,
+    lan::{attributes, hub::transfer_flags},
+};
+use horizon_protocol::{
+    buf::Reader,
+    entity_data::{Value as Data, serializer},
+    packets::play::{self, Clientbound as C},
+};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+#[derive(Serialize, Deserialize)]
+struct State {
+    attributes: Vec<u8>,
+    abilities: Vec<u8>,
+    metadata: Vec<u8>,
+    input: u8,
+    cooldowns: Vec<(String, i32, i32)>,
+    shield_cooldown: u32,
+}
+fn decode(bytes: &[u8]) -> Result<C> {
+    if bytes.len() > 1024 * 1024 {
+        return Err("live player packet is too large".into());
+    }
+    let mut reader = Reader::new(bytes);
+    let id = reader.varint()?;
+    Ok(C::decode(id, reader.rest())?)
+}
+pub(super) fn capture(host: &LanHost, index: usize) -> Result<Value> {
+    let guest = &host.hub.guests[index];
+    let motion = guest
+        .motion
+        .as_ref()
+        .ok_or("live player body is not ready for a cluster export")?;
+    let play = host.play.get(&guest.conn);
+    let state = State {
+        attributes: C::UpdateAttributes(play::UpdateAttributes {
+            id: guest.entity_id,
+            values: attributes::syncable(&motion.attributes),
+        })
+        .encode(),
+        abilities: guest.abilities().encode(),
+        metadata: C::SetEntityData(play::SetEntityData {
+            id: guest.entity_id,
+            values: vec![
+                (0, serializer::BYTE, Data::Byte(transfer_flags(guest))),
+                (6, serializer::POSE, Data::Id(guest.pose().id())),
+            ],
+        })
+        .encode(),
+        input: guest.input,
+        cooldowns: play.map_or_else(Vec::new, |play| play.cooldowns.handover()),
+        shield_cooldown: play.map_or(0, |play| play.shield_cooldown),
+    };
+    Ok(serde_json::to_value(state)?)
+}
+pub(super) fn apply(
+    game: &mut Game<'_>,
+    host: &mut LanHost,
+    uuid: u128,
+    value: &Value,
+) -> Result<()> {
+    if std::env::var_os("GOLIATH_STORE").is_none() {
+        return Err("live state requires a fenced cluster import".into());
+    }
+    let state: State = serde_json::from_value(value.clone())?;
+    let C::UpdateAttributes(mut attrs) = decode(&state.attributes)? else {
+        return Err("live attribute packet has wrong type".into());
+    };
+    let C::PlayerAbilities(abilities) = decode(&state.abilities)? else {
+        return Err("live abilities packet has wrong type".into());
+    };
+    let C::SetEntityData(mut metadata) = decode(&state.metadata)? else {
+        return Err("live metadata packet has wrong type".into());
+    };
+    let flags = metadata
+        .values
+        .iter()
+        .find_map(|(index, _, value)| {
+            if *index == 0 {
+                if let Data::Byte(flags) = value {
+                    Some(*flags)
+                } else {
+                    None
+                }
+            } else {
+                None
+            }
+        })
+        .ok_or("live flags missing")?;
+    let pose = metadata
+        .values
+        .iter()
+        .find_map(|(index, _, value)| {
+            if *index == 6 {
+                if let Data::Id(pose) = value {
+                    Some(*pose)
+                } else {
+                    None
+                }
+            } else {
+                None
+            }
+        })
+        .ok_or("live pose missing")?;
+    if !(0..=5).contains(&pose)
+        || !abilities.flying_speed.is_finite()
+        || !abilities.walking_speed.is_finite()
+    {
+        return Err("invalid live movement state".into());
+    }
+    let cooldowns = horizon_client::cooldowns::Cooldowns::from_handover(&state.cooldowns)
+        .ok_or("invalid live cooldown state")?;
+    let index = host
+        .hub
+        .guests
+        .iter()
+        .position(|g| g.uuid == uuid)
+        .ok_or("live player missing")?;
+    let guest = &mut host.hub.guests[index];
+    let conn = guest.conn;
+    guest.input = state.input;
+    guest.sprinting = flags & 0x08 != 0;
+    guest.sneaking = flags & 0x02 != 0;
+    guest.fall_flying = (flags as u8) & 0x80 != 0;
+    guest.flying = abilities.flags & 2 != 0;
+    guest.allow_flight = abilities.flags & 4 != 0;
+    guest.flying_speed = abilities.flying_speed;
+    game.as_guest(host, conn, |game| -> Result<()> {
+        let player = game
+            .player
+            .as_mut()
+            .ok_or("live player body not initialized")?;
+        attributes::apply(&mut player.attributes, &attrs.values);
+        player.sprinting = flags & 0x08 != 0;
+        player.swimming = flags & 0x10 != 0;
+        player.pose = horizon_client::pose::Pose::from_id(pose);
+        Ok(())
+    })
+    .ok_or("live player turn unavailable")??;
+    let play = host.play.entry(conn).or_default();
+    play.cooldowns = cooldowns;
+    play.shield_cooldown = state.shield_cooldown;
+    let guest = &host.hub.guests[index];
+    attrs.id = guest.entity_id;
+    metadata.id = guest.entity_id;
+    // These follow the held-login defaults on the same lane, before placement and delta.
+    guest.send(&C::UpdateAttributes(attrs));
+    guest.send(&C::PlayerAbilities(abilities));
+    guest.send(&C::SetEntityData(metadata));
+    for (group, elapsed, total) in state.cooldowns {
+        guest.send(&C::Cooldown(play::Cooldown {
+            group,
+            duration: total - elapsed,
+        }));
+    }
+    Ok(())
+}
