+//! Owns the optional E24 heap profiler and explicit pre-teardown snapshots.
+use serde_json::{Value, json};
+use std::{
+    fs::OpenOptions,
+    path::PathBuf,
+    sync::{Mutex, OnceLock},
+    time::Instant,
+};
+
+static PROFILER: Mutex<Option<dhat::Profiler>> = Mutex::new(None);
+static START: OnceLock<Instant> = OnceLock::new();
+static OUTPUT: OnceLock<PathBuf> = OnceLock::new();
+
+pub(crate) struct Guard;
+
+pub(crate) fn initialize() -> Result<Guard, String> {
+    let Some(path) = std::env::var_os("E24_HEAP_FILE") else {
+        return Ok(Guard);
+    };
+    let path = PathBuf::from(path);
+    if !path.is_absolute() {
+        return Err("E24_HEAP_FILE needs an absolute, fresh diagnostic output path".into());
+    }
+    // Reserve the exact output so the profiler never overwrites a frozen result.
+    OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(&path)
+        .map_err(|e| e.to_string())?;
+    let mut profiler = PROFILER.lock().map_err(|_| "heap profiler lock poisoned")?;
+    START
+        .set(Instant::now())
+        .map_err(|_| "heap profiler already initialized")?;
+    OUTPUT
+        .set(path.clone())
+        .map_err(|_| "heap output already initialized")?;
+    *profiler = Some(
+        dhat::Profiler::builder()
+            .file_name(path)
+            .trim_backtraces(Some(16))
+            .build(),
+    );
+    Ok(Guard)
+}
+
+pub(crate) fn snapshot(dump: bool) -> Result<Value, String> {
+    let mut profiler = PROFILER.lock().map_err(|_| "heap profiler lock poisoned")?;
+    if profiler.is_none() {
+        return Err("E24 heap profiler is not active or was already dumped".into());
+    }
+    let stats = dhat::HeapStats::get();
+    let output = json!({"kind":"E24-proxy-heap","dumped":dump,
+        "elapsed_ms":START.get().ok_or("missing heap origin")?.elapsed().as_millis(),
+        "file":OUTPUT.get().ok_or("missing heap output")?,
+        "total_blocks":stats.total_blocks,"total_bytes":stats.total_bytes,
+        "live_blocks":stats.curr_blocks,"live_bytes":stats.curr_bytes,
+        "maximum_blocks":stats.max_blocks,"maximum_bytes":stats.max_bytes,
+        "sessions_alive":meridian_handoff::sessions_alive(),
+        "scope":"instrumented heap allocations, not RSS or capacity acceptance"});
+    let finished = if dump { profiler.take() } else { None };
+    drop(profiler);
+    // Capture live owners before the fixture closes any player connection.
+    drop(finished);
+    Ok(output)
+}
+
+impl Drop for Guard {
+    fn drop(&mut self) {
+        let _ = snapshot(true);
+    }
+}
